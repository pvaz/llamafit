msgid ""
msgstr ""
"Project-Id-Version: llamafit 0.1.0a1\n"
"Report-Msgid-Bugs-To: https://github.com/pvaz/llamafit/issues\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ms\n"
"Language-Team: Malay\n"
"Plural-Forms: nplurals=1; plural=0;\n"

# Malay has no grammatical plural: a counted noun keeps one shape whatever the number,
# so this catalog declares one form and every plural entry has a single msgstr[0]. CLDR
# gives ms only the "other" category.
#
# Names that are not language are left alone: LlamaFit, llama.cpp, Hugging Face, GGUF,
# JSON, YAML, CUDA, Vulkan, Metal, flags, paths and tool names. So are the words
# Malaysian developers write in English anyway: backend, quant, shard, offset,
# traceback, checksum, thread, bandwidth, static. Where the DBP term is the one actually
# used in Malay computing it is used: fail, ralat, amaran, cakera, pemacu, rangkaian,
# keluaran, lalai.

msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "Hugging Face memulangkan %(status)d semasa menyenaraikan fail untuk %(repo)s."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Tidak dapat membaca senarai fail %(repo)s daripada Hugging Face."

msgid "Check your network connection and try again."
msgstr "Periksa sambungan rangkaian anda dan cuba lagi."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "Respons Hugging Face untuk %(repo)s tidak menyertakan senarai fail."

msgid "Check that the repository id is correct and public."
msgstr "Pastikan id repositori itu betul dan bersifat awam."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "katalog mempunyai %(count)d masalah"

msgid "Run `llamafit catalog validate` for details."
msgstr "Jalankan `llamafit catalog validate` untuk butirannya."

msgid "could not write %(path)s: %(error)s"
msgstr "tidak dapat menulis %(path)s: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "Pastikan direktori itu boleh ditulis dan masih ada ruang."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "%(path)s mempunyai %(count)d masalah, jadi ia tidak boleh dikemas kini"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "Jalankan `llamafit catalog validate` dan betulkan fail itu dahulu."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "%(path)s tidak dapat dibaca sepenuhnya, jadi mengemas kini %(model)s sahaja akan membuang fakta yang dicatatkannya bagi model yang tidak disentuh oleh larian ini: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "Jalankan `llamafit catalog refresh` tanpa --model untuk membina semula keseluruhan fail."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "Cari, ukur, pasang dan sahkan LLM open-weight untuk llama.cpp pada mesin anda sendiri."

msgid "Print machine-readable JSON instead of tables."
msgstr "Mencetak JSON yang boleh dibaca mesin, bukan jadual."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "Menulis butiran ke llamafit.log dalam direktori log dan menunjukkan traceback."

msgid "Disable colours."
msgstr "Mematikan warna."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "Bertutur dalam bahasa ini, contohnya pt_PT. Bahasa yang tiada pada LlamaFit akan berpatah balik kepada bahasa Inggeris, dan ia memberitahu bahasa mana yang ada padanya."

msgid "Print the version and exit."
msgstr "Mencetak versi lalu keluar."

msgid "Unexpected error: %(error)s"
msgstr "Ralat tidak dijangka: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "Jalankan sekali lagi dengan --verbose untuk traceback penuh."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "Menyelenggara katalog: mengesahkan failnya, mengemas kini medan yang berubah-ubah."

msgid "Keep only this use case."
msgstr "Menyimpan kes penggunaan ini sahaja."

msgid "Keep only models with this capability (repeatable)."
msgstr "Menyimpan model dengan keupayaan ini sahaja (boleh diulang)."

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Menyimpan pengecam lesen ini sahaja (boleh diulang)."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "Mengesahkan fail ini sahaja, bukan katalog terbina dan penyesuaian anda sendiri."

msgid "Did you mean: %(ids)s?"
msgstr "Adakah anda maksudkan: %(ids)s?"

msgid "Run `llamafit list` to see every model id."
msgstr "Jalankan `llamafit list` untuk melihat setiap id model."

msgid "no model named %(id)s in the catalog"
msgstr "tiada model bernama %(id)s dalam katalog"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "%(count)d masalah katalog dijumpai; jalankan `llamafit catalog validate` untuk butirannya."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "Tiada model yang sepadan. Cuba --use-case, --capability, --license, --vendor atau --search yang lebih luas."

msgid "invalid --use-case %(value)s"
msgstr "--use-case tidak sah: %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "Kes penggunaan yang sah: %(values)s"

msgid "invalid --capability value: %(values)s"
msgid_plural "invalid --capability values: %(values)s"
msgstr[0] "nilai --capability tidak sah: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "Keupayaan yang sah: %(values)s"

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"Menyenaraikan katalog model, disempitkan oleh mana-mana penapis yang diberi.\n"
"\n"
"Jadual menunjukkan paling banyak tiga keupayaan bagi setiap model, serta penanda +N untuk selebihnya, dan disusun mengikut lajur Kualiti yang ditunjukkan; info atau --json mempunyai setiap keupayaan."

msgid "Keep only this vendor, case-insensitive."
msgstr "Menyimpan vendor ini sahaja, tanpa membezakan huruf besar dan kecil."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "Padanan subrentetan pada id, nama, vendor atau keluarga, tanpa membezakan huruf besar dan kecil."

msgid "Show at most this many."
msgstr "Menunjukkan sebanyak ini sahaja."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "Bentuk singkat bagi llamafit list --search TEXT."

msgid "Text to match against id, name, vendor or family."
msgstr "Teks yang hendak dipadankan dengan id, nama, vendor atau keluarga."

msgid "Show one model's facts, sources and every quant it publishes."
msgstr "Menunjukkan fakta sesebuah model, sumbernya dan setiap quant yang diterbitkannya."

msgid "A catalog model id."
msgstr "Sebuah id model katalog."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "Mengesahkan fail YAML katalog terhadap skema, mencetak satu baris bagi setiap masalah."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "%(count)d fail diperiksa, tiada masalah dijumpai."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "Mengemas kini nama fail, saiz, checksum dan fakta GGUF katalog daripada Hugging Face."

msgid "Refresh only this model id."
msgstr "Mengemas kini id model ini sahaja."

msgid "Compute the refresh but write nothing."
msgstr "Mengira kemas kini itu tetapi tidak menulis apa-apa."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "Keluar dengan 1 jika ada apa-apa yang akan berubah; tidak mengubah apa-apa, untuk kerja CI berjadual."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: amaran: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "amaran: %(warning)s (%(count)d model: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: ralat: %(error)s"

msgid "Hint: %(hint)s"
msgstr "Petunjuk: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "refresh memerlukan capaian rangkaian ke Hugging Face; periksa sambungan anda dan pastikan id repositori itu betul."

msgid "No changes."
msgstr "Tiada perubahan."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "Mencetak entri katalog mentah sesebuah model, sebagai JSON secara lalai atau sebagai YAML dengan --yaml."

msgid "Print YAML instead of JSON."
msgstr "Mencetak YAML, bukan JSON."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "Menerangkan apa yang dikesan, apa yang gagal, dan apa yang akan membuka lebih banyak lagi."

