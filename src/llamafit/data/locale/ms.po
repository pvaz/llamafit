msgstr "Periksa sambungan rangkaian anda dan pastikan URL itu boleh dicapai."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s memulangkan HTTP %(status)d, bukan 206 Partial Content; pelayan itu mungkin tidak menyokong permintaan range."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Pastikan URL itu menunjuk kepada fail GGUF yang boleh dimuat turun."

