msgstr "Tipka"

msgctxt "column heading"
msgid "What it does"
msgstr "Što radi"

msgctxt "dashboard screen"
msgid "Everywhere"
msgstr "Svugdje"

msgctxt "dashboard screen"
msgid "Board"
msgstr "Ljestvica"

msgctxt "dashboard screen"
msgid "Needs"
msgstr "Zahtjevi"

msgctxt "dashboard screen"
msgid "Host"
msgstr "Računalo"

msgctxt "dashboard screen"
msgid "Plan"
msgstr "Plan"

msgctxt "dashboard screen"
msgid "Simulate"
msgstr "Simulacija"

msgid "Press Escape to go back."
msgstr "Pritisnite Escape za povratak."

msgid "Catalog files with a problem"
msgstr "Datoteke kataloga s problemom"

msgid "This machine has not been scanned yet."
msgstr "Ovo računalo još nije pregledano."

msgid "What do you want a model for?"
msgstr "Za što vam treba model?"

msgid "It must be able to:"
msgstr "Mora znati:"

msgid "At least this much context, in tokens:"
msgstr "Barem ovoliko konteksta, u tokenima:"

msgid "Willing to download at most, for example 40G (blank for no limit):"
msgstr "Spremni preuzeti najviše, primjerice 40G (prazno za bez ograničenja):"

msgid "Slowest generation worth having, in tokens per second (blank for the speed a person reads at; 0 when nobody is waiting on the tokens):"
msgstr "Najsporije generiranje koje još vrijedi, u tokenima u sekundi (prazno za brzinu kojom čovjek čita; 0 kada nitko ne čeka na tokene):"

msgid "Licences you will accept (tick none to accept any):"
msgstr "Licence koje prihvaćate (ne označite nijednu da prihvatite sve):"

msgid "Lean the score:"
msgstr "Nagni bodovanje:"

msgid "Keep the vision projector when a model has one"
msgstr "Zadrži vizualni projektor kada ga model ima"

msgid "Apply"
msgstr "Primijeni"

msgid "Reset"
msgstr "Poništi"

msgid "The minimum context is a number of tokens, for example %(example)s."
msgstr "Minimalni kontekst je broj tokena, primjerice %(example)s."

msgid "The minimum context cannot be below zero."
msgstr "Minimalni kontekst ne može biti ispod nule."

msgid "The minimum speed is a number of tokens per second, for example 12."
msgstr "Minimalna brzina je broj tokena u sekundi, primjerice 12."

msgid "The minimum speed cannot be below zero."
msgstr "Minimalna brzina ne može biti ispod nule."

msgid "Choose a row on the Board and press p, and its plan and command line appear here."
msgstr "Odaberite redak na Ljestvici i pritisnite p, pa se ovdje pojavljuju njegov plan i naredbeni redak."

msgid "%(model)s is no longer in the catalog this board was built from."
msgstr "%(model)s više nije u katalogu iz kojeg je ova ljestvica izgrađena."

msgid "Planned with the vision projector; press v to leave it out."
msgstr "Planirano s vizualnim projektorom; pritisnite v da ga izostavite."

msgid "Planned without the vision projector; press v to put it back."
msgstr "Planirano bez vizualnog projektora; pritisnite v da ga vratite."

msgid "The ladder has no rung above %(context)s."
msgstr "Ljestvica nema prečku iznad %(context)s."

msgid "The ladder has no rung below %(context)s."
msgstr "Ljestvica nema prečku ispod %(context)s."

msgid "There is no command line to copy yet."
msgstr "Još nema naredbenog retka za kopiranje."

msgid "The command line is on the clipboard."
msgstr "Naredbeni redak je u međuspremniku."

msgid "Everything on every screen answers about the machine chosen here. While it is not this one, the band at the top says SIMULATED."
msgstr "Sve na svakom zaslonu odgovara o računalu odabranom ovdje. Dok to nije ovo, traka na vrhu kaže SIMULIRANO."

msgid "Answer for this machine instead:"
msgstr "Odgovaraj za ovo računalo umjesto toga:"

msgid "Pretend the graphics card has this much memory (blank to leave it):"
msgstr "Pretvaraj se da grafička kartica ima ovoliko memorije (prazno da ostane):"

msgid "Pretend the machine has this much system memory (blank to leave it):"
msgstr "Pretvaraj se da računalo ima ovoliko memorije sustava (prazno da ostane):"

msgid "Pretend the processor has this many cores (blank to leave it):"
msgstr "Pretvaraj se da procesor ima ovoliko jezgri (prazno da ostane):"

msgid "Back to this machine"
msgstr "Natrag na ovo računalo"

msgctxt "hardware profile"
msgid "this machine"
msgstr "ovo računalo"

msgid "The core count is a whole number, for example 8."
msgstr "Broj jezgri je cijeli broj, primjerice 8."

msgctxt "dashboard header separator"
msgid " · "
msgstr " · "

msgctxt "dashboard header"
msgid "no GPU detected"
msgstr "nije otkriven GPU"

msgid "%(name)s, VRAM unknown"
msgstr "%(name)s, VRAM nepoznat"

msgid "%(name)s, %(free)s free of %(total)s"
msgstr "%(name)s, %(free)s slobodno od %(total)s"

msgid "%(available)s free of %(total)s RAM"
msgstr "%(available)s slobodno od %(total)s RAM-a"

msgid "%(model)s, %(count)d core"
msgid_plural "%(model)s, %(count)d cores"
msgstr[0] "%(model)s, %(count)d jezgra"
msgstr[1] "%(model)s, %(count)d jezgre"
msgstr[2] "%(model)s, %(count)d jezgri"

msgctxt "dashboard header"
msgid "llama.cpp not installed"
msgstr "llama.cpp nije instaliran"

msgctxt "dashboard header"
msgid "llama.cpp installed"
msgstr "llama.cpp je instaliran"

msgid "llama.cpp b%(build)d"
msgstr "llama.cpp b%(build)d"

msgctxt "dashboard header"
msgid "scanning this machine…"
msgstr "pregledava se ovo računalo…"

msgid "These speeds were not all arrived at the same way; the How column says which each row is."
msgstr "Ove brzine nisu sve dobivene na isti način; stupac Kako kaže koja je koja."

msgctxt "thousands separator"
msgid ","
msgstr "."

msgctxt "decimal separator"
msgid "."
msgstr ","

# B is not the English word for a thousand million; it is how these models are named.
# The file is Qwen3-27B and the identifier in this row already says 27B, so a localised
# abbreviation would make one row disagree with itself. Change it only if your readers
# genuinely would not recognise B, and say in a comment here why.
msgctxt "parameter count"
msgid "B"
msgstr "B"

msgctxt "size"
msgid "unknown"
msgstr "nepoznata"

msgid "profile must be a name, not a path: %(value)s"
msgstr "profil mora biti naziv, a ne putanja: %(value)s"

msgid "Ask GET /api/v1/profiles for the names this machine has."
msgstr "Zatražite GET /api/v1/profiles za nazive koje ovo računalo ima."

msgid "unknown query parameter: %(names)s"
msgstr "nepoznat parametar upita: %(names)s"

msgid "This endpoint takes: %(names)s"
msgstr "Ova krajnja točka prima: %(names)s"

msgid "invalid prefer %(value)s"
msgstr "neispravna vrijednost za prefer: %(value)s"

msgid "invalid sort %(value)s"
msgstr "neispravna vrijednost za sort: %(value)s"

msgid "%(host)s:%(port)d is not this machine only. Anyone who can reach this computer on that port can read everything the dashboard shows -- your hardware, your disks, your file paths and the models you have downloaded. There is no password, because LlamaFit is meant for the person sitting at the keyboard. Press Ctrl+C now if you did not mean this."
msgstr "%(host)s:%(port)d nije samo ovo računalo. Svatko tko na tom portu može doprijeti do ovog računala može pročitati sve što ploča prikazuje — vaš hardver, vaše diskove, vaše putanje do datoteka i modele koje ste preuzeli. Lozinke nema jer je LlamaFit namijenjen osobi koja sjedi za tipkovnicom. Pritisnite Ctrl+C sada ako niste ovo namjeravali."

msgid "the web dashboard needs FastAPI and uvicorn, which are not installed"
msgstr "web ploča treba FastAPI i uvicorn, koji nisu instalirani"

msgid "Install them with: pip install \"llamafit[web]\""
msgstr "Instalirajte ih s: pip install \"llamafit[web]\""

msgid "%(host)s is not a loopback address, and the dashboard has no authentication"
msgstr "%(host)s nije adresa povratne petlje, a ploča nema provjere autentičnosti"

msgid "Leave --host alone to serve this machine only, or pass it to mean it."
msgstr "Ostavite --host na miru da poslužuje samo ovo računalo ili ga predajte s namjerom."

msgid "Why this row"
msgstr "Zašto ovaj redak"

msgid "Plan this"
msgstr "Planiraj ovo"

msgid "Already on this machine"
msgstr "Već na ovom računalu"

msgid "Score"
msgstr "Bodovi"

msgid "What the model is for"
msgstr "Čemu model služi"

msgid "Capabilities it must have"
msgstr "Mogućnosti koje mora imati"

msgid "Lean the weights"
msgstr "Nagni težine"

msgid "Smallest context worth having"
msgstr "Najmanji kontekst koji vrijedi"

msgid "Most you will download"
msgstr "Najviše što ćete preuzeti"

msgid "Show every quantisation"
msgstr "Prikaži svaku kvantizaciju"

msgid "Keep the vision projector"
msgstr "Zadrži vizualni projektor"

msgid "Rows to show"
msgstr "Redaka za prikaz"

msgid "Scan again"
msgstr "Pregledaj ponovno"

msgid "llama.cpp"
msgstr "llama.cpp"

msgid "Quantisation"
msgstr "Kvantizacija"

msgid "Context"
msgstr "Kontekst"

msgid "Micro-batch"
msgstr "Mikroserija"

msgid "Plan it"
msgstr "Planiraj"

msgid "Copy"
msgstr "Kopiraj"

msgid "Copied"
msgstr "Kopirano"

msgid "Flags"
msgstr "Zastavice"

msgid "Speed"
msgstr "Brzina"

msgid "Choose a row on the board first."
msgstr "Najprije odaberite redak na ljestvici."

msgid "Hardware profile"
msgstr "Profil hardvera"

msgid "This machine, as scanned"
msgstr "Ovo računalo, kako je pregledano"

msgid "Graphics memory"
msgstr "Grafička memorija"

msgid "System memory"
msgstr "Memorija sustava"

msgid "Processor cores"
msgstr "Jezgre procesora"

msgid "Score against that machine"
msgstr "Bodovanje prema tom računalu"

msgid "What runs here, how fast, and with which settings."
msgstr "Što ovdje radi, koliko brzo i s kojim postavkama."

msgid "Working…"
msgstr "Radi se…"

msgid "Something went wrong"
msgstr "Nešto je pošlo po zlu"

msgid "Hint"
msgstr "Savjet"

msgid "Command"
msgstr "Naredba"

msgid "Source code (AGPL-3.0-or-later)"
msgstr "Izvorni kod (AGPL-3.0-or-later)"

msgid "This dashboard is served from your own machine and sends nothing anywhere."
msgstr "Ova se ploča poslužuje s vašeg računala i ne šalje ništa nikamo."

msgid "Answer for the machine this hardware profile describes instead of this one. Nothing about this machine is probed, and every answer is marked as simulated. `llamafit hardware list` names the profiles you have."
msgstr "Odgovara za računalo koje opisuje ovaj profil hardvera umjesto za ovo. O ovom se računalu ništa ne ispituje, a svaki je odgovor označen kao simuliran. `llamafit hardware list` imenuje profile koje imate."

msgid "Pretend the graphics card has this much memory, for example 24G. Everything else stays as scanned, and every answer is marked as simulated."
msgstr "Pretvara se da grafička kartica ima ovoliko memorije, primjerice 24G. Sve ostalo ostaje kako je pregledano, a svaki je odgovor označen kao simuliran."

msgid "Pretend the machine has this much system memory, for example 128GiB. Every answer is marked as simulated."
msgstr "Pretvara se da računalo ima ovoliko memorije sustava, primjerice 128GiB. Svaki je odgovor označen kao simuliran."

msgid "Pretend the processor has this many physical cores. Every answer is marked as simulated."
msgstr "Pretvara se da procesor ima ovoliko fizičkih jezgri. Svaki je odgovor označen kao simuliran."

msgid "Plan, report and score no context longer than this. It caps the model's own length; it does not describe a machine."
msgstr "Planira, izvještava i boduje kontekst ne dulji od ovoga. Ograničava vlastitu duljinu modela; ne opisuje računalo."

msgid "%(ceiling)s %(max)s is below %(floor)s %(min)s"
msgstr "%(ceiling)s %(max)s je ispod %(floor)s %(min)s"

msgid "Raise %(ceiling)s, or lower %(floor)s."
msgstr "Podignite %(ceiling)s ili snizite %(floor)s."

msgid "`llamafit %(command)s` reports on the machine LlamaFit is running on"
msgstr "`llamafit %(command)s` izvještava o računalu na kojem LlamaFit radi"

msgid "Drop --profile, --memory, --ram and --cpu-cores. To see the machine a profile describes, run `llamafit hardware show NAME --as-host`."
msgstr "Izostavite --profile, --memory, --ram i --cpu-cores. Da vidite računalo koje profil opisuje, pokrenite `llamafit hardware show NAME --as-host`."

msgid "Fit on the simulated machine"
msgstr "Kako stane na simulirano računalo"

msgid "Roomy: there is room for a longer context or a second model."
msgstr "Prostrano: ima mjesta za dulji kontekst ili drugi model."

msgid "--min-tps %(tps)s: this board wanted at least that many tokens per second, and anything slower is excluded below rather than ranked here."
msgstr "--min-tps %(tps)s: ova je ljestvica htjela barem toliko tokena u sekundi, pa je sve sporije isključeno ispod, a ne rangirano ovdje."

msgid "--min-tps 0: nobody is waiting on these tokens, so nothing was excluded for generating more slowly than a person reads."
msgstr "--min-tps 0: nitko ne čeka na ove tokene, pa ništa nije isključeno zbog toga što generira sporije nego što čovjek čita."

msgid "Exclude candidates generating fewer tokens per second than this, in place of the speed a person reads at. Pass 0 when nobody is waiting on the tokens."
msgstr "Isključuje kandidate koji generiraju manje tokena u sekundi od ovoga, umjesto brzine kojom čovjek čita. Predajte 0 kada nitko ne čeka na tokene."

msgid "Order the rows drawn: score, speed, quality, context, size, prompt, card, ram, fit, model or quant, largest or best first unless :asc says otherwise. The # column keeps the ranking."
msgstr "Određuje redoslijed iscrtanih redaka: score, speed, quality, context, size, prompt, card, ram, fit, model ili quant, najveće ili najbolje prvo osim ako :asc ne kaže drukčije. Stupac # zadržava rang."

msgid "Draw only rows whose id, name or quantisation contains this text."
msgstr "Iscrtava samo retke čiji id, naziv ili kvantizacija sadrže ovaj tekst."

msgid "Draw only rows whose file is already on this machine."
msgstr "Iscrtava samo retke čija je datoteka već na ovom računalu."

msgid "Draw only rows that run this way: gpu, moe-offload, hybrid or cpu."
msgstr "Iscrtava samo retke koji rade ovako: gpu, moe-offload, hybrid ili cpu."

msgid "Draw only rows at or above this verdict: comfortable, fits or tight. The ranking is unchanged and a hidden row is still counted."
msgstr "Iscrtava samo retke s ovom ocjenom ili boljom: comfortable, fits ili tight. Rangiranje se ne mijenja, a skriveni se redak i dalje broji."

msgid "Draw exactly these columns, comma-separated, in this order, named as --json names them: rank, model, quant, size, have, score, quality, gen, prompt, confidence, mode, vram, ram, verdict, context."
msgstr "Iscrtava točno ove stupce, odvojene zarezima, ovim redom, imenovane kako ih imenuje --json: rank, model, quant, size, have, score, quality, gen, prompt, confidence, mode, vram, ram, verdict, context."

msgid "Draw every column whatever the terminal's width; a cell that does not fit folds."
msgstr "Iscrtava svaki stupac bez obzira na širinu terminala; ćelija koja ne stane prelama se."

msgid "Leave the candidates that were not ranked off the table. The reasons are still printed under it."
msgstr "Izostavlja iz tablice kandidate koji nisu rangirani. Razlozi se i dalje ispisuju ispod nje."

msgid "Showing the best %(shown)s of %(total)s that qualified; --limit sets how many, and the rest are neither worse-behaved nor hidden, only further down."
msgstr "Prikazuje se najboljih %(shown)s od %(total)s koji su prošli; --limit određuje koliko, a ostali nisu ni lošiji ni skriveni, samo su niže."

msgid "%(gpus)s is on this machine and nothing could read how much of it is free, so every speed above is a CPU-only speed. `llamafit doctor` says how to fix that."
msgstr "%(gpus)s je na ovom računalu i ništa nije moglo pročitati koliko je od nje slobodno, pa je svaka brzina gore brzina samo za CPU. `llamafit doctor` kaže kako to popraviti."

msgid "generates %(tps)s tokens per second, below the %(floor)s a person reads at: a batch tool on this machine and not one to sit in front of; a smaller model or quantisation would keep up"
msgstr "generira %(tps)s tokena u sekundi, ispod %(floor)s koliko čovjek čita: na ovom računalu alat za skupnu obradu, a ne nešto pred čime se sjedi; manji model ili kvantizacija držali bi korak"

msgid "generates %(tps)s tokens per second, below the %(floor)s this request asks for; lower --min-tps or choose a smaller model or quantisation"
msgstr "generira %(tps)s tokena u sekundi, ispod %(floor)s koliko ovaj zahtjev traži; snizite --min-tps ili odaberite manji model ili kvantizaciju"

msgid "Showing the best %(shown)s of %(total)s that qualified; raise “Rows to show” for the rest, which are neither worse-behaved nor hidden, only further down."
msgstr "Prikazuje se najboljih %(shown)s od %(total)s koji su prošli; podignite „Redaka za prikaz“ za ostale, koji nisu ni lošiji ni skriveni, samo su niže."

msgctxt "exclusion tag"
msgid "no %(capability)s"
msgstr "bez %(capability)s"

msgid "no %(capability)s capability; drop it from the request, or ask for a use case that does not need it"
msgstr "nema mogućnosti %(capability)s; izostavite je iz zahtjeva ili zatražite slučaj uporabe kojemu ne treba"

msgctxt "exclusion tag"
msgid "no estimate"
msgstr "bez procjene"

msgctxt "exclusion tag"
msgid "no room"
msgstr "nema mjesta"

msgctxt "exclusion tag"
msgid "no facts"
msgstr "bez podataka"

msgctxt "exclusion tag"
msgid "not ranked"
msgstr "nerangirano"

msgctxt "board cell with no figure"
msgid "–"
msgstr "–"

msgid "%(term)s is not a filter; the terms are %(terms)s, and anything else is text to look for."
msgstr "%(term)s nije filtar; pojmovi su %(terms)s, a sve ostalo je tekst za traženje."

msgid "fit>= takes one of %(values)s"
msgstr "fit>= prima jednu od %(values)s"

msgid "runs= takes one of %(values)s"
msgstr "runs= prima jednu od %(values)s"

msgid "%(term)s needs a number"
msgstr "%(term)s treba broj"

msgid "%(term)s needs a size such as 8G, 7.5GiB or 512M"
msgstr "%(term)s treba veličinu poput 8G, 7.5GiB ili 512M"

msgctxt "exclusion tag"
msgid "short context"
msgstr "kratak kontekst"

msgid "holds fewer than the %(minimum)s tokens asked for; lower the minimum context or free memory to see it ranked"
msgstr "drži manje od %(minimum)s traženih tokena; snizite minimalni kontekst ili oslobodite memoriju da bude rangiran"

msgctxt "exclusion tag"
msgid "too big"
msgstr "prevelik"

msgid "larger to download than the %(limit)s this request allows"
msgstr "veći za preuzimanje od %(limit)s koliko ovaj zahtjev dopušta"

msgctxt "exclusion tag"
msgid "too slow"
msgstr "prespor"

msgctxt "exclusion tag"
msgid "unknown quant"
msgstr "nepoznata kvant."

msgid "a quantisation whose cost in quality is not known, so it cannot be scored"
msgstr "kvantizacija čija cijena u kvaliteti nije poznata, pa se ne može bodovati"

msgctxt "exclusion tag"
msgid "unsupported"
msgstr "nepodržano"

msgid "About these figures"
msgstr "O ovim brojkama"

msgid "Close"
msgstr "Zatvori"

msgid "%(shown)s of %(total)s in the catalog"
msgstr "%(shown)s od %(total)s u katalogu"
