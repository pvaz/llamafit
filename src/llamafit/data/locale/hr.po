# Croatian translation of LlamaFit.
# This file is distributed under the same licence as LlamaFit.
#
# NOT YET REVIEWED BY A NATIVE SPEAKER. It was written from the English template in one
# pass and it has had no second reader. By the standard docs/translations.md sets for
# every language, that is not enough: please read it line by line and correct it in a
# pull request.
#
# Croatian has three plural forms: 1, 21, 31 ... take the nominative singular; 2-4, 22-24
# ... take the paucal; everything else, 0 and 5-20 included, takes the genitive plural.
# The verb agrees too, which is why "Pronađen je 1 problem", "Pronađena su 2 problema"
# and "Pronađeno je 5 problema" are three different sentences and not one with a suffix.
#
msgid ""
msgstr ""
"Project-Id-Version: llamafit 0.1.0a1\n"
"Report-Msgid-Bugs-To: https://github.com/pvaz/llamafit/issues\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: hr\n"
"Language-Team: Croatian\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "Hugging Face vratio je %(status)d pri ispisu datoteka za %(repo)s."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Nije bilo moguće pročitati popis datoteka za %(repo)s s usluge Hugging Face."

msgid "Check your network connection and try again."
msgstr "Provjerite mrežnu vezu i pokušajte ponovno."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "Odgovor usluge Hugging Face za %(repo)s nije sadržavao popis datoteka."

msgid "Check that the repository id is correct and public."
msgstr "Provjerite je li identifikator repozitorija ispravan i javan."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "katalog ima %(count)d problem"
msgstr[1] "katalog ima %(count)d problema"
msgstr[2] "katalog ima %(count)d problema"

msgid "Run `llamafit catalog validate` for details."
msgstr "Pokrenite `llamafit catalog validate` za pojedinosti."

msgid "could not write %(path)s: %(error)s"
msgstr "nije bilo moguće zapisati %(path)s: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "Provjerite je li u direktorij moguće pisati i ima li u njemu mjesta."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "%(path)s ima %(count)d problem i ne može se osvježiti"
msgstr[1] "%(path)s ima %(count)d problema i ne može se osvježiti"
msgstr[2] "%(path)s ima %(count)d problema i ne može se osvježiti"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "Pokrenite `llamafit catalog validate` i najprije ispravite datoteku."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "%(path)s nije bilo moguće pročitati u cijelosti, pa bi osvježavanje samo modela %(model)s odbacilo podatke koje datoteka bilježi za modele koje ovo pokretanje ne dira: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "Pokrenite `llamafit catalog refresh` bez --model da biste ponovno izgradili cijelu datoteku."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "Pronađite, izmjerite, instalirajte i provjerite jezične modele otvorenih težina za llama.cpp na vlastitom računalu."

msgid "Print machine-readable JSON instead of tables."
msgstr "Ispisuje strojno čitljiv JSON umjesto tablica."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "Zapisuje pojedinosti u llamafit.log u direktoriju zapisa i prikazuje tragove pogrešaka."

msgid "Disable colours."
msgstr "Isključuje boje."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "Govori ovim jezikom, primjerice pt_PT. Jezik koji LlamaFit nema vraća se na engleski, uz popis jezika koje ima."

msgid "Print the version and exit."
msgstr "Ispisuje inačicu i izlazi."

msgid "Unexpected error: %(error)s"
msgstr "Neočekivana pogreška: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "Pokrenite ponovno s --verbose za cijeli trag pogreške."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "Održava katalog: provjerava njegove datoteke, osvježava promjenjiva polja."

msgid "Keep only this use case."
msgstr "Zadržava samo ovaj slučaj uporabe."

msgid "Keep only models with this capability (repeatable)."
msgstr "Zadržava samo modele s ovom mogućnošću (može se ponoviti)."

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Zadržava samo ove identifikatore licenci (može se ponoviti)."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "Provjerava samo ovu datoteku umjesto priloženog kataloga i prilagodbi."

msgid "Did you mean: %(ids)s?"
msgstr "Jeste li mislili: %(ids)s?"

msgid "Run `llamafit list` to see every model id."
msgstr "Pokrenite `llamafit list` da biste vidjeli sve identifikatore modela."

msgid "no model named %(id)s in the catalog"
msgstr "u katalogu nema modela pod nazivom %(id)s"

# The verb agrees with the count as well as the noun, so all three forms differ.
msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "Pronađen je %(count)d problem u katalogu; pokrenite `llamafit catalog validate` za pojedinosti."
msgstr[1] "Pronađena su %(count)d problema u katalogu; pokrenite `llamafit catalog validate` za pojedinosti."
msgstr[2] "Pronađeno je %(count)d problema u katalogu; pokrenite `llamafit catalog validate` za pojedinosti."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "Nijedan model ne odgovara. Pokušajte sa širim --use-case, --capability, --license, --vendor ili --search."

msgid "invalid --use-case %(value)s"
msgstr "neispravna vrijednost za --use-case: %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "Ispravni slučajevi uporabe: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "Ispravne mogućnosti: %(values)s"

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"Ispisuje katalog modela, sužen zadanim filtrima.\n"
"\n"
"Tablica prikazuje najviše tri mogućnosti po modelu, uz oznaku +N za ostale, i poredana je prema prikazanom stupcu Kvaliteta; info ili --json prikazuju sve mogućnosti."

msgid "Keep only this vendor, case-insensitive."
msgstr "Zadržava samo ovog proizvođača, bez razlikovanja velikih i malih slova."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "Podudaranje dijela teksta u identifikatoru, nazivu, proizvođaču ili obitelji, bez razlikovanja velikih i malih slova."

msgid "Show at most this many."
msgstr "Prikazuje najviše ovoliko."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "Kratica za llamafit list --search TEXT."

msgid "Text to match against id, name, vendor or family."
msgstr "Tekst za podudaranje s identifikatorom, nazivom, proizvođačem ili obitelji."

msgid "A catalog model id."
msgstr "Identifikator modela iz kataloga."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "Provjerava YAML datoteke kataloga prema shemi i ispisuje po jedan redak za svaki problem."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "Provjerena je %(count)d datoteka, nije pronađen nijedan problem."
msgstr[1] "Provjerene su %(count)d datoteke, nije pronađen nijedan problem."
msgstr[2] "Provjereno je %(count)d datoteka, nije pronađen nijedan problem."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "Osvježava nazive datoteka, veličine, kontrolne sume i GGUF podatke kataloga s usluge Hugging Face."

msgid "Refresh only this model id."
msgstr "Osvježava samo ovaj identifikator modela."

msgid "Compute the refresh but write nothing."
msgstr "Izračunava osvježavanje, ali ništa ne zapisuje."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "Izlazi s 1 ako bi se išta promijenilo; ništa ne mijenja, za zakazani CI posao."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: upozorenje: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "upozorenje: %(warning)s (%(count)d model: %(models)s)"
msgstr[1] "upozorenje: %(warning)s (%(count)d modela: %(models)s)"
msgstr[2] "upozorenje: %(warning)s (%(count)d modela: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: pogreška: %(error)s"

msgid "Hint: %(hint)s"
msgstr "Savjet: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "osvježavanje treba mrežni pristup usluzi Hugging Face; provjerite vezu i ispravnost identifikatora repozitorija."

msgid "No changes."
msgstr "Nema promjena."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "Ispisuje sirovi kataloški zapis jednog modela, prema zadanome kao JSON ili kao YAML uz --yaml."

msgid "Print YAML instead of JSON."
msgstr "Ispisuje YAML umjesto JSON-a."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "Objašnjava što je otkriveno, što nije uspjelo i što bi otključalo više."

