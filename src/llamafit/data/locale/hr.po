# Croatian translation of LlamaFit.
# This file is distributed under the same licence as LlamaFit.
#
# NOT YET REVIEWED BY A NATIVE SPEAKER. It was written from the English template in one
# pass and it has had no second reader. By the standard docs/translations.md sets for
# every language, that is not enough: please read it line by line and correct it in a
# pull request.
#
# Croatian has three plural forms: 1, 21, 31 ... take the nominative singular; 2-4, 22-24
# ... take the paucal; everything else, 0 and 5-20 included, takes the genitive plural.
# The verb agrees too, which is why "Pronađen je 1 problem", "Pronađena su 2 problema"
# and "Pronađeno je 5 problema" are three different sentences and not one with a suffix.
#
msgid ""
msgstr ""
"Project-Id-Version: llamafit 0.1.0a1\n"
"Report-Msgid-Bugs-To: https://github.com/pvaz/llamafit/issues\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: hr\n"
"Language-Team: Croatian\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"

msgid "nothing measured touches this term, so there is no equation it appears in"
msgstr "nijedno mjerenje ne dotiče ovaj član, pa ne postoji jednadžba u kojoj se pojavljuje"

msgid "%(measurements)d distinct configurations for %(parameters)d free parameters; fewer points than parameters gives numbers that look precise and are arbitrary"
msgstr "%(measurements)d različitih konfiguracija za %(parameters)d slobodnih parametara; manje točaka nego parametara daje brojeve koji izgledaju precizno, a proizvoljni su"

msgid "the %(measurements)d configurations do not vary independently enough to separate %(parameters)d parameters"
msgstr "tih %(measurements)d konfiguracija ne varira dovoljno neovisno da bi se razdvojilo %(parameters)d parametara"

msgid "the fit put it at %(value)s, which its own definition does not allow; the measurements disagree with each other under section 10.1's model"
msgstr "prilagodba ga je smjestila na %(value)s, što njegova vlastita definicija ne dopušta; mjerenja se međusobno ne slažu prema modelu iz odjeljka 10.1"

msgid "it came out at %(value)s, but another parameter of the same fit was impossible, and least squares chose them against each other"
msgstr "ispao je %(value)s, ali drugi parametar iste prilagodbe bio je nemoguć, pa ih je metoda najmanjih kvadrata odabrala jedan protiv drugoga"

msgid "the estimator has no such term: section 10.1 removed the per-layer overhead, which for a 28-layer model exceeded the whole measured token"
msgstr "procjenitelj nema takav član: odjeljak 10.1 uklonio je režiju po sloju, koja je za model s 28 slojeva premašivala cijeli izmjereni token"

msgid "generation (llama-bench)"
msgstr "generiranje (llama-bench)"

msgid "prompt (llama-bench)"
msgstr "prompt (llama-bench)"

msgid "generation, first request"
msgstr "generiranje, prvi zahtjev"

msgid "generation, 1K prompt"
msgstr "generiranje, prompt od 1K"

msgid "prompt, 1K request"
msgstr "prompt, zahtjev od 1K"

msgid "peak VRAM"
msgstr "vršni VRAM"

msgid "no graphics card"
msgstr "nema grafičke kartice"

msgid "%(os)s %(version)s, %(cpu)s, %(ram)s, %(gpu)s%(driver)s"
msgstr "%(os)s %(version)s, %(cpu)s, %(ram)s, %(gpu)s%(driver)s"

msgid "%(flag)s was asked for as %(wanted)s but the run reports %(actual)s"
msgstr "%(flag)s je zatražen kao %(wanted)s, ali pokretanje prijavljuje %(actual)s"

msgid "The card was full and generation came in below three fifths of the estimate: the driver was paging to system memory, which does not fail and does not appear in the log."
msgstr "Kartica je bila puna, a generiranje je palo ispod tri petine procjene: upravljački program straničio je u memoriju sustava, što ne pada i ne pojavljuje se u zapisu."

msgid "Peak VRAM stayed clear of the card's total, so there was nothing for the driver to page."
msgstr "Vršni VRAM ostao je ispod ukupne memorije kartice, pa upravljački program nije imao što straničiti."

msgid "The card was full, which a good plan is meant to be, and the speed was close enough to the estimate that nothing was paging."
msgstr "Kartica je bila puna, kakav dobar plan i treba biti, a brzina je bila dovoljno blizu procjeni da ništa nije straničilo."

msgid "No VRAM reading was taken during the run, so this configuration has not been cleared of paging; it has only not been checked."
msgstr "Tijekom pokretanja VRAM nije očitan, pa ova konfiguracija nije oslobođena sumnje na straničenje; samo nije provjerena."

msgid "The card's total memory is unknown, so a reading of what was in use says nothing about how close to full it was."
msgstr "Ukupna memorija kartice nije poznata, pa očitanje koliko je bilo u uporabi ne govori ništa o tome koliko je bila blizu pune."

msgid "There was no estimate to compare the measured speed against, so the second half of the signature could not be tested."
msgstr "Nije bilo procjene s kojom bi se izmjerena brzina usporedila, pa druga polovica potpisa nije mogla biti provjerena."

msgid "llama-bench did not produce JSON"
msgstr "llama-bench nije proizveo JSON"

msgid "llama-bench JSON is not a list of results"
msgstr "JSON iz llama-bencha nije popis rezultata"

msgid "llama-bench JSON held no readable results"
msgstr "JSON iz llama-bencha nije sadržavao čitljive rezultate"

msgid "no llama-bench result rows found"
msgstr "nisu pronađeni redci s rezultatima llama-bencha"

msgid "could not open %(path)s for the server log"
msgstr "nije bilo moguće otvoriti %(path)s za zapis poslužitelja"

msgid "could not start llama-server"
msgstr "nije bilo moguće pokrenuti llama-server"

msgid "no output"
msgstr "nema izlaza"

msgid "llama-bench exited with code %(code)d: %(detail)s"
msgstr "llama-bench je izašao s kodom %(code)d: %(detail)s"

msgid "llama-bench output could not be read: %(error)s"
msgstr "izlaz llama-bencha nije bilo moguće pročitati: %(error)s"

msgid "llama-server did not become healthy"
msgstr "llama-server nije postao ispravan"

msgid "Its whole output is in the log file `bench` named; the end says why."
msgstr "Cijeli njegov izlaz je u datoteci zapisa koju je `bench` naveo; kraj govori zašto."

msgid "%(path)s was written by a newer LlamaFit (benchmark format %(found)d, this build reads %(known)d)"
msgstr "%(path)s je zapisao noviji LlamaFit (format mjerenja %(found)d, ova gradnja čita %(known)d)"

msgid "Upgrade LlamaFit, or move the file aside to start a new one."
msgstr "Nadogradite LlamaFit ili premjestite datoteku u stranu i započnite novu."

msgid "a benchmark cannot be recorded against a simulated machine"
msgstr "mjerenje se ne može zabilježiti prema simuliranom računalu"

msgid "Run `llamafit bench` on the machine itself, without --profile."
msgstr "Pokrenite `llamafit bench` na samom računalu, bez --profile."

msgid "the run did not use the settings it was given: %(problems)s"
msgstr "pokretanje nije koristilo postavke koje je dobilo: %(problems)s"

msgid "Nothing was stored. A result filed under flags it was not taken with would be believed later by everything that reads it."
msgstr "Ništa nije pohranjeno. Rezultatu zavedenom pod zastavicama s kojima nije snimljen kasnije bi vjerovalo sve što ga čita."

msgid "a conservative default; nobody has measured this card's backend overhead"
msgstr "konzervativna zadana vrijednost; režiju pozadinskog sustava ove kartice nitko nije izmjerio"

msgid "measured on this card with driver %(driver)s and llama.cpp %(build)s; one machine"
msgstr "izmjereno na ovoj kartici s upravljačkim programom %(driver)s i llama.cpp %(build)s; jedno računalo"

msgid "A hybrid placement has to say how many layers are on the graphics card."
msgstr "Hibridni smještaj mora reći koliko je slojeva na grafičkoj kartici."

msgid "Pass gpu_layers, which is what -ngl would be."
msgstr "Predajte gpu_layers, što je vrijednost za -ngl."

msgid "LlamaFit has not read %(model)s's %(quant)s file, so it cannot size it."
msgstr "LlamaFit nije pročitao datoteku %(quant)s modela %(model)s, pa mu ne može odrediti veličinu."

msgid "Run `llamafit catalog refresh` to read the file's header."
msgstr "Pokrenite `llamafit catalog refresh` da se pročita zaglavlje datoteke."

msgid "the server process before any model buffer"
msgstr "proces poslužitelja prije bilo kojeg međuspremnika modela"

msgid "fitted to one machine's measurements; the least certain line here"
msgstr "prilagođeno mjerenjima jednog računala; najmanje pouzdan redak ovdje"

msgid "room for one logit per vocabulary entry per token of the batch"
msgstr "prostor za jedan logit po unosu rječnika i tokenu serije"

msgid "LlamaFit cannot size a %(kv_type)s key-value cache."
msgstr "LlamaFit ne može odrediti veličinu KV predmemorije vrste %(kv_type)s."

msgid "Use one of: %(types)s."
msgstr "Upotrijebite jednu od: %(types)s."

msgid "This model's file does not say how large its key-value cache is per token."
msgstr "Datoteka ovog modela ne govori kolika mu je KV predmemorija po tokenu."

msgid "Refresh the catalog so the file's header is read again."
msgstr "Osvježite katalog da se zaglavlje datoteke pročita ponovno."

msgid "the attention-layer count was assumed, not counted"
msgstr "broj slojeva pozornosti bio je pretpostavljen, a ne prebrojan"

msgid "%(arch)s allocates more cache than its header describes; see the line below"
msgstr "%(arch)s dodjeljuje više predmemorije nego što opisuje njegovo zaglavlje; vidi redak ispod"

msgid "what %(arch)s allocates beyond its header, measured rather than derived"
msgstr "ono što %(arch)s dodjeljuje izvan svojeg zaglavlja, izmjereno, a ne izvedeno"

msgid "from the architecture's state dimensions; it does not grow with context"
msgstr "iz dimenzija stanja arhitekture; ne raste s kontekstom"

msgid "the projector file itself"
msgstr "sama datoteka projektora"

msgid "the projector's own compute space, measured at 248 MiB"
msgstr "vlastiti računski prostor projektora, izmjeren na 248 MiB"

msgid "attention projections, feed-forward weights and norms"
msgstr "projekcije pozornosti, težine unaprijedne mreže i norme"

msgid "always-on experts, which run for every token"
msgstr "uvijek uključeni stručnjaci, koji rade za svaki token"

msgid "routed experts, read across the bus once per micro-batch"
msgstr "usmjereni stručnjaci, čitaju se preko sabirnice jednom po mikroseriji"

msgid "this model ties its output projection to its embedding table"
msgstr "ovaj model veže svoju izlaznu projekciju uz tablicu embeddinga"

msgid "llama.cpp keeps the embedding table in memory even at full offload"
msgstr "llama.cpp drži tablicu embeddinga u memoriji i pri punom prebacivanju na GPU"

msgid "streamed from disk as it is needed, not held in memory"
msgstr "streama se s diska po potrebi, ne drži se u memoriji"

msgid "held in memory, since streaming from disk was turned off"
msgstr "drži se u memoriji jer je streamanje s diska isključeno"

msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "Hugging Face vratio je %(status)d pri ispisu datoteka za %(repo)s."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Nije bilo moguće pročitati popis datoteka za %(repo)s s usluge Hugging Face."

msgid "Check your network connection and try again."
msgstr "Provjerite mrežnu vezu i pokušajte ponovno."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "Odgovor usluge Hugging Face za %(repo)s nije sadržavao popis datoteka."

msgid "Check that the repository id is correct and public."
msgstr "Provjerite je li identifikator repozitorija ispravan i javan."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "katalog ima %(count)d problem"
msgstr[1] "katalog ima %(count)d problema"
msgstr[2] "katalog ima %(count)d problema"

msgid "Run `llamafit catalog validate` for details."
msgstr "Pokrenite `llamafit catalog validate` za pojedinosti."

msgid "could not write %(path)s: %(error)s"
msgstr "nije bilo moguće zapisati %(path)s: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "Provjerite je li u direktorij moguće pisati i ima li u njemu mjesta."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "%(path)s ima %(count)d problem i ne može se osvježiti"
msgstr[1] "%(path)s ima %(count)d problema i ne može se osvježiti"
msgstr[2] "%(path)s ima %(count)d problema i ne može se osvježiti"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "Pokrenite `llamafit catalog validate` i najprije ispravite datoteku."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "%(path)s nije bilo moguće pročitati u cijelosti, pa bi osvježavanje samo modela %(model)s odbacilo podatke koje datoteka bilježi za modele koje ovo pokretanje ne dira: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "Pokrenite `llamafit catalog refresh` bez --model da biste ponovno izgradili cijelu datoteku."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "Pronađite, izmjerite, instalirajte i provjerite jezične modele otvorenih težina za llama.cpp na vlastitom računalu."

msgid "With no command, llamafit opens the terminal dashboard; in a pipe, or with --json, it prints what `llamafit recommend` would."
msgstr "Bez naredbe llamafit otvara terminalsku ploču; u cjevovodu ili s --json ispisuje ono što bi ispisao `llamafit recommend`."

msgid "Print machine-readable JSON instead of tables."
msgstr "Ispisuje strojno čitljiv JSON umjesto tablica."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "Zapisuje pojedinosti u llamafit.log u direktoriju zapisa i prikazuje tragove pogrešaka."

msgid "Disable colours."
msgstr "Isključuje boje."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "Govori ovim jezikom, primjerice pt_PT. Jezik koji LlamaFit nema vraća se na engleski, uz popis jezika koje ima."

msgid "Print the version and exit."
msgstr "Ispisuje inačicu i izlazi."

msgid "the output's encoding"
msgstr "kodiranje izlaza"

msgid "%(count)d character could not be written in %(encoding)s and is shown as ?."
msgid_plural "%(count)d characters could not be written in %(encoding)s and are shown as ?."
msgstr[0] "%(count)d znak nije bilo moguće zapisati u kodiranju %(encoding)s i prikazan je kao ?."
msgstr[1] "%(count)d znaka nije bilo moguće zapisati u kodiranju %(encoding)s i prikazana su kao ?."
msgstr[2] "%(count)d znakova nije bilo moguće zapisati u kodiranju %(encoding)s i prikazani su kao ?."

msgid "Set PYTHONUTF8=1 in the environment and run again: Python then writes UTF-8, which carries every language."
msgstr "Postavite PYTHONUTF8=1 u okruženju i pokrenite ponovno: Python tada zapisuje UTF-8, koji nosi svaki jezik."

msgid "%(option)s is an option of llamafit itself, so it goes before the command: `llamafit %(option)s %(rest)s`."
msgstr "%(option)s je opcija samog llamafita, pa ide prije naredbe: `llamafit %(option)s %(rest)s`."

msgid "Unexpected error: %(error)s"
msgstr "Neočekivana pogreška: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "Pokrenite ponovno s --verbose za cijeli trag pogreške."

msgid "A catalog model id."
msgstr "Identifikator modela iz kataloga."

msgid "Benchmark this quantisation instead of the planned one."
msgstr "Mjeri ovu kvantizaciju umjesto planirane."

msgid "Size for this many tokens."
msgstr "Dimenzionira za ovoliko tokena."

msgid "Set the micro-batch by hand; the budget is rebuilt around it."
msgstr "Postavlja mikroseriju ručno; proračun se obnavlja oko nje."

msgid ""
"Measure a model on this machine and show the measurement beside the estimate.\n"
"\n"
"Runs llama-bench and a real server at the planned flags, stores the result with the conditions it was taken under, and flags a configuration the driver was paging. With --calibrate, fits the estimator's constants to this machine from every stored result and says by name which ones the measurements do not determine."
msgstr ""
"Mjeri model na ovom računalu i prikazuje mjerenje uz procjenu.\n"
"\n"
"Pokreće llama-bench i pravi poslužitelj s planiranim zastavicama, pohranjuje rezultat s uvjetima u kojima je snimljen i označava konfiguraciju u kojoj je upravljački program straničio. Uz --calibrate prilagođava konstante procjenitelja ovom računalu iz svih pohranjenih rezultata i poimence kaže koje od njih mjerenja ne određuju."

msgid "Measure prompt processing at every micro-batch of the ladder, not only the planned one. Section 10.2 has two free parameters and one micro-batch is one equation, so without this the prompt half of a calibration cannot be fitted at all."
msgstr "Mjeri obradu prompta pri svakoj mikroseriji s ljestvice, a ne samo pri planiranoj. Odjeljak 10.2 ima dva slobodna parametra, a jedna mikroserija je jedna jednadžba, pa se bez ovoga promptna polovica kalibracije uopće ne može prilagoditi."

msgid "Run llama-bench only. Faster, and it gives up the paging check, the buffer sizes and the tool-call test, all of which need a real server."
msgstr "Pokreće samo llama-bench. Brže je, ali se odriče provjere straničenja, veličina međuspremnika i testa poziva alata, a sve to treba pravi poslužitelj."

msgid "Print the result without writing it to the database."
msgstr "Ispisuje rezultat bez zapisivanja u bazu."

msgid "Print the commands that would run, and run nothing."
msgstr "Ispisuje naredbe koje bi se pokrenule i ne pokreće ništa."

msgid "Fit the estimator's constants to this machine from every result."
msgstr "Prilagođava konstante procjenitelja ovom računalu iz svih rezultata."

msgid "List what is already stored and stop."
msgstr "Ispisuje što je već pohranjeno i staje."

msgid "`llamafit bench` needs a model to measure"
msgstr "`llamafit bench` treba model koji će mjeriti"

msgid "Try `llamafit bench <model>`, `--calibrate` on its own, or `--show`."
msgstr "Pokušajte s `llamafit bench <model>`, samim `--calibrate` ili `--show`."

msgid "llama.cpp was not found, so there is nothing to benchmark with"
msgstr "llama.cpp nije pronađen, pa nema čime mjeriti"

msgid "Run `llamafit doctor` to see where it was looked for."
msgstr "Pokrenite `llamafit doctor` da vidite gdje se tražio."

msgid "%(path)s has llama-server but no llama-bench"
msgstr "%(path)s ima llama-server, ali ne i llama-bench"

msgid "Some release archives leave it out; a full build has it beside the server."
msgstr "Neki arhivi izdanja izostavljaju ga; puna gradnja ima ga uz poslužitelj."

msgid "this host is simulated, and a simulated machine cannot be measured"
msgstr "ovo je računalo simulirano, a simulirano računalo ne može se mjeriti"

msgid "Run `llamafit bench` on the machine itself."
msgstr "Pokrenite `llamafit bench` na samom računalu."

msgid "the model file is not on this machine: %(path)s"
msgstr "datoteka modela nije na ovom računalu: %(path)s"

msgid "Download it first; `llamafit plan` shows the path the command line uses."
msgstr "Najprije je preuzmite; `llamafit plan` pokazuje putanju koju naredbeni redak koristi."

msgid "Would run:"
msgstr "Pokrenulo bi se:"

msgid "Nothing has been measured on this machine yet."
msgstr "Na ovom računalu još ništa nije izmjereno."

msgid "Stored measurements"
msgstr "Pohranjena mjerenja"

msgid "model"
msgstr "model"

msgid "kind"
msgstr "vrsta"

msgid "gen tok/s"
msgstr "gen tok/s"

msgid "prompt tok/s"
msgstr "prompt tok/s"

msgid "taken"
msgstr "snimljeno"

msgid "flags"
msgstr "zastavice"

msgid "Nothing was written to the database, so no estimate will be relabelled."
msgstr "U bazu nije ništa zapisano, pa se nijedna procjena neće preoznačiti."

msgid "Estimated against measured"
msgstr "Procijenjeno naspram izmjerenog"

msgid "figure"
msgstr "brojka"

msgid "context"
msgstr "kontekst"

msgid "micro-batch"
msgstr "mikroserija"

msgid "estimated"
msgstr "procijenjeno"

msgid "measured"
msgstr "izmjereno"

msgid "ratio"
msgstr "omjer"

msgid "The plan sizes this configuration for %(context)s tokens and estimates %(tps)s generated tokens per second there. Nothing above ran at that context, so that figure is reported and not compared."
msgstr "Plan dimenzionira ovu konfiguraciju za %(context)s tokena i ondje procjenjuje %(tps)s generiranih tokena u sekundi. Ništa gore nije radilo pri tom kontekstu, pa se ta brojka navodi, a ne uspoređuje."

msgid "%(count)d figure is outside the 0.8 to 1.25 band an uncalibrated formula is expected to land in."
msgid_plural "%(count)d figures are outside the 0.8 to 1.25 band an uncalibrated formula is expected to land in."
msgstr[0] "%(count)d brojka je izvan pojasa od 0,8 do 1,25 u koji se očekuje da nekalibrirana formula padne."
msgstr[1] "%(count)d brojke su izvan pojasa od 0,8 do 1,25 u koji se očekuje da nekalibrirana formula padne."
msgstr[2] "%(count)d brojki je izvan pojasa od 0,8 do 1,25 u koji se očekuje da nekalibrirana formula padne."

msgid "This configuration was paging."
msgstr "Ova je konfiguracija straničila."

msgid "This configuration was not paging."
msgstr "Ova konfiguracija nije straničila."

msgid "Paging could not be checked."
msgstr "Straničenje nije bilo moguće provjeriti."

msgid "Peak VRAM was %(percent)s percent of the card, and generation was %(speed)s percent of the estimate."
msgstr "Vršni VRAM bio je %(percent)s posto kartice, a generiranje %(speed)s posto procjene."

msgid "Peak VRAM was %(percent)s percent of the card. Generation was not compared with the estimate."
msgstr "Vršni VRAM bio je %(percent)s posto kartice. Generiranje nije uspoređeno s procjenom."

msgid "The largest context on the ladder that would not page is %(tokens)s."
msgstr "Najveći kontekst na ljestvici koji ne bi straničio jest %(tokens)s."

msgid "Calibration"
msgstr "Kalibracija"

msgid "constant"
msgstr "konstanta"

msgid "value"
msgstr "vrijednost"

msgid "from"
msgstr "iz"

msgid "%(base)s + %(slope)s per 1K"
msgstr "%(base)s + %(slope)s po 1K"

msgid "%(count)d measured context"
msgid_plural "%(count)d measured contexts"
msgstr[0] "%(count)d izmjeren kontekst"
msgstr[1] "%(count)d izmjerena konteksta"
msgstr[2] "%(count)d izmjerenih konteksta"

msgid "Nothing was fitted. Every line below says what its constant was missing; a calibration made from less than that would look precise and be arbitrary."
msgstr "Ništa nije prilagođeno. Svaki redak ispod kaže što je njegovoj konstanti nedostajalo; kalibracija napravljena od manje od toga izgledala bi precizno, a bila bi proizvoljna."

msgid "%(name)s was not fitted: %(reason)s"
msgstr "%(name)s nije prilagođen: %(reason)s"

msgid "%(count)d measured configuration"
msgid_plural "%(count)d measured configurations"
msgstr[0] "%(count)d izmjerena konfiguracija"
msgstr[1] "%(count)d izmjerene konfiguracije"
msgstr[2] "%(count)d izmjerenih konfiguracija"

msgid "What the model is for. It sets the score weights, the speed target and the context a candidate is measured against."
msgstr "Čemu model služi. Postavlja težine bodova, ciljanu brzinu i kontekst prema kojem se kandidat mjeri."

msgid "Capability the model must have; a model without it is excluded "
msgstr "Mogućnost koju model mora imati; model bez nje je isključen "

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Zadržava samo ove identifikatore licenci (može se ponoviti)."

msgid "balanced, quality or speed: moves a tenth of the weight between quality and speed. It leans the board; it does not replace the weights."
msgstr "balanced, quality ili speed: premješta desetinu težine između kvalitete i brzine. Naginje ljestvicu; ne zamjenjuje težine."

msgid "Exclude anything larger to download, for example 40G or 7.5GiB."
msgstr "Isključuje sve veće za preuzimanje, primjerice 40G ili 7.5GiB."

msgid "The worst verdict to list: comfortable, fits or tight."
msgstr "Najgora ocjena koja se još ispisuje: comfortable, fits ili tight."

msgid "invalid --min-fit %(value)s"
msgstr "neispravna vrijednost za --min-fit: %(value)s"

msgid "Valid values: %(values)s"
msgstr "Ispravne vrijednosti: %(values)s"

msgid "invalid --prefer %(value)s"
msgstr "neispravna vrijednost za --prefer: %(value)s"

msgid "invalid --runs %(value)s"
msgstr "neispravna vrijednost za --runs: %(value)s"

msgid "invalid --sort %(value)s"
msgstr "neispravna vrijednost za --sort: %(value)s"

msgid "invalid --columns %(value)s"
msgstr "neispravna vrijednost za --columns: %(value)s"

msgid ""
"Rank the catalog for what you want to do on this machine.\n"
"\n"
"Every candidate is planned, sized and estimated here, so the first run scans the machine. Speeds compare candidates at 8K tokens of context; --explain expands a row into the scores, the weights, the budget and the speed breakdown that produced it."
msgstr ""
"Rangira katalog prema onome što želite raditi na ovom računalu.\n"
"\n"
"Svaki kandidat se ovdje planira, dimenzionira i procjenjuje, pa prvo pokretanje pregledava računalo. Brzine uspoređuju kandidate pri 8K tokena konteksta; --explain proširuje redak u bodove, težine, proračun i raščlambu brzine iz kojih je nastao."

msgid "Exclude candidates that cannot hold at least this many tokens."
msgstr "Isključuje kandidate koji ne mogu držati barem ovoliko tokena."

msgid "Show at most this many rows."
msgstr "Prikazuje najviše ovoliko redaka."

msgid "Show every quantisation instead of the best one per model."
msgstr "Prikazuje svaku kvantizaciju umjesto najbolje po modelu."

msgid "Expand every row shown into the scores, weights, budget and speed breakdown behind it. Combine with --limit 1 for one model."
msgstr "Proširuje svaki prikazani redak u bodove, težine, proračun i raščlambu brzine iza njega. Spojite s --limit 1 za jedan model."

msgid "Plan without a vision projector, freeing its memory."
msgstr "Planira bez vizualnog projektora i oslobađa njegovu memoriju."

msgid "Nothing was ranked. Every candidate is listed below with the reason; widen the request or free some memory."
msgstr "Ništa nije rangirano. Svaki kandidat je ispod naveden s razlogom; proširite zahtjev ili oslobodite memoriju."

msgid ""
"Rank every model by how well it uses this machine, whatever it is for.\n"
"\n"
"No use case, no weights and no score: this is the memory question on its own. Models are sized for 32K tokens of context, and the context column is the largest each one holds in the mode shown."
msgstr ""
"Rangira svaki model prema tome koliko dobro koristi ovo računalo, čemu god služio.\n"
"\n"
"Nema slučaja uporabe, nema težina i nema bodova: ovo je pitanje memorije samo za sebe. Modeli se dimenzioniraju za 32K tokena konteksta, a stupac konteksta je najveći koji svaki od njih drži u prikazanom načinu rada."

msgid "Only the configurations that use the machine well: at least half its memory held in weights, and no pool past four fifths."
msgstr "Samo konfiguracije koje dobro koriste računalo: barem polovica njegove memorije u težinama i nijedan spremnik preko četiri petine."

msgid "Nothing fits this machine at that threshold. Try --min-fit tight, or drop --perfect."
msgstr "Ništa ne stane na ovo računalo uz taj prag. Pokušajte s --min-fit tight ili izostavite --perfect."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "Održava katalog: provjerava njegove datoteke, osvježava promjenjiva polja."

msgid "Keep only this use case."
msgstr "Zadržava samo ovaj slučaj uporabe."

msgid "Keep only models with this capability (repeatable)."
msgstr "Zadržava samo modele s ovom mogućnošću (može se ponoviti)."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "Provjerava samo ovu datoteku umjesto priloženog kataloga i prilagodbi."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "Nijedan model ne odgovara. Pokušajte sa širim --use-case, --capability, --license, --vendor ili --search."

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"Ispisuje katalog modela, sužen zadanim filtrima.\n"
"\n"
"Tablica prikazuje najviše tri mogućnosti po modelu, uz oznaku +N za ostale, i poredana je prema prikazanom stupcu Kvaliteta; info ili --json prikazuju sve mogućnosti."

msgid "Keep only this vendor, case-insensitive."
msgstr "Zadržava samo ovog proizvođača, bez razlikovanja velikih i malih slova."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "Podudaranje dijela teksta u identifikatoru, nazivu, proizvođaču ili obitelji, bez razlikovanja velikih i malih slova."

msgid "Show at most this many."
msgstr "Prikazuje najviše ovoliko."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "Kratica za llamafit list --search TEXT."

msgid "Text to match against id, name, vendor or family."
msgstr "Tekst za podudaranje s identifikatorom, nazivom, proizvođačem ili obitelji."

msgid ""
"Show one model: its facts, the quants it publishes, and what each would cost on this machine.\n"
"\n"
"The last table is sized against this machine, so the first run scans it. One line per quantisation; plan opens one of those rows into the memory budget, the context ladder and the command line."
msgstr ""
"Prikazuje jedan model: njegove podatke, kvantizacije koje objavljuje i koliko bi svaka stajala na ovom računalu.\n"
"\n"
"Posljednja tablica dimenzionirana je prema ovom računalu, pa ga prvo pokretanje pregledava. Jedan redak po kvantizaciji; plan otvara jedan od tih redaka u proračun memorije, ljestvicu konteksta i naredbeni redak."

msgid "Show only this quantisation, matched case-insensitively, in both tables."
msgstr "Prikazuje samo ovu kvantizaciju, bez razlikovanja velikih i malih slova, u obje tablice."

msgid "Size every quantisation for this many tokens instead of the usual 32,768."
msgstr "Dimenzionira svaku kvantizaciju za ovoliko tokena umjesto uobičajenih 32.768."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "Provjerava YAML datoteke kataloga prema shemi i ispisuje po jedan redak za svaki problem."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "Provjerena je %(count)d datoteka, nije pronađen nijedan problem."
msgstr[1] "Provjerene su %(count)d datoteke, nije pronađen nijedan problem."
msgstr[2] "Provjereno je %(count)d datoteka, nije pronađen nijedan problem."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "Osvježava nazive datoteka, veličine, kontrolne sume i GGUF podatke kataloga s usluge Hugging Face."

msgid "Refresh only this model id."
msgstr "Osvježava samo ovaj identifikator modela."

msgid "Compute the refresh but write nothing."
msgstr "Izračunava osvježavanje, ali ništa ne zapisuje."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "Izlazi s 1 ako bi se išta promijenilo; ništa ne mijenja, za zakazani CI posao."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: upozorenje: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "upozorenje: %(warning)s (%(count)d model: %(models)s)"
msgstr[1] "upozorenje: %(warning)s (%(count)d modela: %(models)s)"
msgstr[2] "upozorenje: %(warning)s (%(count)d modela: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: pogreška: %(error)s"

msgid "Hint: %(hint)s"
msgstr "Savjet: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "osvježavanje treba mrežni pristup usluzi Hugging Face; provjerite vezu i ispravnost identifikatora repozitorija."

msgid "No changes."
msgstr "Nema promjena."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "Ispisuje sirovi kataloški zapis jednog modela, prema zadanome kao JSON ili kao YAML uz --yaml."

msgid "Print YAML instead of JSON."
msgstr "Ispisuje YAML umjesto JSON-a."

msgid "Did you mean: %(ids)s?"
msgstr "Jeste li mislili: %(ids)s?"

msgid "Run `llamafit list` to see every model id."
msgstr "Pokrenite `llamafit list` da biste vidjeli sve identifikatore modela."

msgid "no model named %(id)s in the catalog"
msgstr "u katalogu nema modela pod nazivom %(id)s"

# The verb agrees with the count as well as the noun, so all three forms differ.
msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "Pronađen je %(count)d problem u katalogu; pokrenite `llamafit catalog validate` za pojedinosti."
msgstr[1] "Pronađena su %(count)d problema u katalogu; pokrenite `llamafit catalog validate` za pojedinosti."
msgstr[2] "Pronađeno je %(count)d problema u katalogu; pokrenite `llamafit catalog validate` za pojedinosti."

msgid "invalid --use-case %(value)s"
msgstr "neispravna vrijednost za --use-case: %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "Ispravni slučajevi uporabe: %(values)s"

msgid "invalid %(option)s value: %(values)s"
msgid_plural "invalid %(option)s values: %(values)s"
msgstr[0] "neispravna vrijednost za %(option)s: %(values)s"
msgstr[1] "neispravne vrijednosti za %(option)s: %(values)s"
msgstr[2] "neispravne vrijednosti za %(option)s: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "Ispravne mogućnosti: %(values)s"

msgid "%(option)s is not a size: %(value)s"
msgstr "%(option)s nije veličina: %(value)s"

msgid "Sizes look like 8G, 7.5GiB or 512M; a bare number is bytes."
msgstr "Veličine izgledaju kao 8G, 7.5GiB ili 512M; goli broj su bajtovi."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "Objašnjava što je otkriveno, što nije uspjelo i što bi otključalo više."

msgid "Hardware profiles: describe a machine in a file and score models against it."
msgstr "Profili hardvera: opišite računalo u datoteci i bodujte modele prema njemu."

msgid "Validate only this file instead of every bundled and user profile."
msgstr "Provjerava samo ovu datoteku umjesto svih priloženih i korisničkih profila."

msgid "A profile name, or a path to a profile file."
msgstr "Naziv profila ili putanja do datoteke profila."

msgid "%(count)d hardware profile problem found; run `llamafit hardware validate` for details."
msgid_plural "%(count)d hardware profile problems found; run `llamafit hardware validate` for details."
msgstr[0] "Pronađen je %(count)d problem u profilima hardvera; pokrenite `llamafit hardware validate` za pojedinosti."
msgstr[1] "Pronađena su %(count)d problema u profilima hardvera; pokrenite `llamafit hardware validate` za pojedinosti."
msgstr[2] "Pronađeno je %(count)d problema u profilima hardvera; pokrenite `llamafit hardware validate` za pojedinosti."

msgid "List the hardware profiles LlamaFit has: the bundled ones and your own."
msgstr "Ispisuje profile hardvera koje LlamaFit ima: priložene i vaše vlastite."

msgid "No hardware profiles. Run `llamafit hardware path` to see where yours would go."
msgstr "Nema profila hardvera. Pokrenite `llamafit hardware path` da vidite kamo bi vaši išli."

msgid ""
"Show one profile; with --as-host, the machine it stands in for.\n"
"\n"
"A host built from a profile is marked as simulated, in the table and in the JSON, so a what-if is never mistaken for a scan of this machine."
msgstr ""
"Prikazuje jedan profil; uz --as-host računalo koje zastupa.\n"
"\n"
"Računalo izgrađeno iz profila označeno je kao simulirano, i u tablici i u JSON-u, pa se pretpostavka nikada ne zamijeni s pregledom ovog računala."

msgid "Show the host this profile substitutes, as `llamafit system` would."
msgstr "Prikazuje računalo koje ovaj profil zamjenjuje, onako kako bi to učinio `llamafit system`."

msgid "Check hardware profile files against the schema, printing one line per problem."
msgstr "Provjerava datoteke profila hardvera prema shemi i ispisuje po jedan redak za svaki problem."

msgid "Print the directory your own hardware profiles go in."
msgstr "Ispisuje direktorij u koji idu vaši profili hardvera."

msgid "It does not exist yet; create it and put a %(suffix)s file in it."
msgstr "Još ne postoji; stvorite ga i stavite u njega datoteku %(suffix)s."

msgid "Install what it takes to run a model: llama.cpp itself, and the weights."
msgstr "Instalira ono što treba za pokretanje modela: sam llama.cpp i težine."

msgid "Install this backend instead of the one chosen for your GPU: cuda, vulkan, hip, sycl, metal or cpu."
msgstr "Instalira ovaj pozadinski sustav umjesto onoga odabranog za vašu grafičku karticu: cuda, vulkan, hip, sycl, metal ili cpu."

msgid "Install here instead of ~/.llamafit/llama.cpp."
msgstr "Instalira ovdje umjesto u ~/.llamafit/llama.cpp."

msgid "Install this release tag, for example b6100, not the latest."
msgstr "Instalira ovu oznaku izdanja, primjerice b6100, a ne najnoviju."

msgid "invalid --backend %(value)s"
msgstr "neispravna vrijednost za --backend: %(value)s"

msgid "Valid backends: %(values)s"
msgstr "Ispravni pozadinski sustavi: %(values)s"

msgid "release %(tag)s publishes no %(backend)s build for %(os)s %(arch)s."
msgstr "izdanje %(tag)s ne objavljuje gradnju %(backend)s za %(os)s %(arch)s."

msgid "Leave --backend out and LlamaFit will choose a published one."
msgstr "Izostavite --backend i LlamaFit će odabrati neku od objavljenih."

msgid "release %(tag)s publishes nothing for %(os)s %(arch)s."
msgstr "izdanje %(tag)s ne objavljuje ništa za %(os)s %(arch)s."

msgid "Build llama.cpp from source; see the project's own instructions."
msgstr "Izgradite llama.cpp iz izvornog koda; vidite upute samog projekta."

msgid "Release"
msgstr "Izdanje"

msgid "%(tag)s (build %(build)s)"
msgstr "%(tag)s (gradnja %(build)s)"

msgid "Backend"
msgstr "Pozadinski sustav"

msgid "Archive"
msgstr "Arhiva"

msgid "Also"
msgstr "Također"

msgid "Download"
msgstr "Preuzimanje"

msgid "%(size)s (%(done)s already on disk)"
msgstr "%(size)s (%(done)s već na disku)"

msgid "Checksum"
msgstr "Kontrolna suma"

msgid "published, checked before anything is unpacked"
msgstr "objavljena, provjerava se prije nego što se išta raspakira"

msgid "none published"
msgstr "nijedna nije objavljena"

msgid "Install into"
msgstr "Instalirati u"

msgid "Directory"
msgstr "Direktorij"

msgid "Free space"
msgstr "Slobodan prostor"

msgid "Free space (cache)"
msgstr "Slobodan prostor (predmemorija)"

msgid "%(free)s on %(path)s, %(needed)s needed"
msgstr "%(free)s na %(path)s, potrebno %(needed)s"

msgid "will be created"
msgstr "bit će stvoren"

msgid "exists and is empty"
msgstr "postoji i prazan je"

msgid "holds %(tag)s, installed by LlamaFit; it will be replaced"
msgstr "sadrži %(tag)s koji je instalirao LlamaFit; bit će zamijenjen"

msgid "installed by LlamaFit; it will be replaced"
msgstr "instalirao LlamaFit; bit će zamijenjeno"

msgid "was not installed by LlamaFit"
msgstr "nije ga instalirao LlamaFit"

msgid "Downloading"
msgstr "Preuzimanje"

msgid "Installed llama.cpp %(tag)s into %(path)s."
msgstr "llama.cpp %(tag)s instaliran je u %(path)s."

msgid "Replaced %(tag)s."
msgstr "Zamijenjen je %(tag)s."

msgid "Backends found in it: %(backends)s"
msgstr "Pronađeni pozadinski sustavi: %(backends)s"

msgid "none"
msgstr "nijedan"

msgid "Check it with `llamafit doctor`."
msgstr "Provjerite to s `llamafit doctor`."

msgid "Change your PATH?"
msgstr "Promijeniti PATH?"

msgid "PATH left alone."
msgstr "PATH je ostavljen na miru."

msgid "PATH changed. Open a new terminal for it to take effect."
msgstr "PATH je promijenjen. Otvorite novi terminal da bi to stupilo na snagu."

msgid ""
"Download a published llama.cpp build and install it into ~/.llamafit/llama.cpp.\n"
"\n"
"The plan is printed before anything is written. The archive's checksum is verified before it is unpacked, an interrupted download continues where it stopped, and a directory LlamaFit did not create is never overwritten."
msgstr ""
"Preuzima objavljenu gradnju llama.cpp-a i instalira je u ~/.llamafit/llama.cpp.\n"
"\n"
"Plan se ispisuje prije nego što se išta zapiše. Kontrolna suma arhive provjerava se prije raspakiravanja, prekinuto preuzimanje nastavlja se ondje gdje je stalo, a direktorij koji LlamaFit nije stvorio nikada se ne prepisuje."

msgid "Offer to add the bin directory to your PATH, showing the undo first."
msgstr "Nudi dodavanje direktorija bin u vaš PATH, uz prethodni prikaz kako to poništiti."

msgid "Install over a directory LlamaFit did not create. Ask yourself twice."
msgstr "Instalira preko direktorija koji LlamaFit nije stvorio. Promislite dvaput."

msgid "Install an archive that publishes no checksum. Nothing can be checked."
msgstr "Instalira arhivu koja ne objavljuje kontrolnu sumu. Ništa se ne može provjeriti."

msgid "Print the plan and write nothing."
msgstr "Ispisuje plan i ništa ne zapisuje."

msgid "Do not ask; assume yes."
msgstr "Ne pita; pretpostavlja da."

msgid "Install this?"
msgstr "Instalirati ovo?"

msgid "Nothing was written."
msgstr "Ništa nije zapisano."

msgid "Fetch this quantisation instead of the first the catalog publishes."
msgstr "Dohvaća ovu kvantizaciju umjesto prve koju katalog objavljuje."

msgid "Put the files here instead of under the configured downloads directory."
msgstr "Stavlja datoteke ovdje umjesto u postavljeni direktorij za preuzimanja."

msgid "Use at most this much bandwidth, for example 5M. Shared across every worker, so the figure is the figure whatever --workers says."
msgstr "Koristi najviše ovoliko propusnosti, primjerice 5M. Dijeli se na sve radnike, pa brojka vrijedi što god --workers kaže."

msgid "How many requests to keep in flight. More is not always faster, and a home connection is shared with whoever else is using it."
msgstr "Koliko zahtjeva držati u letu. Više nije uvijek brže, a kućnu vezu dijelite sa svima koji je koriste."

msgid "Do not ask before starting."
msgstr "Ne pita prije početka."

msgid "Show what would be fetched and stop before fetching it."
msgstr "Prikazuje što bi se dohvatilo i staje prije dohvaćanja."

msgid "Fetch only the weights, not the vision projector or the draft model."
msgstr "Dohvaća samo težine, ne i vizualni projektor ni nacrtni model."

msgid "Re-read files that are already here and check them against the catalog."
msgstr "Ponovno čita datoteke koje su već ovdje i provjerava ih prema katalogu."

msgid "Fetch files the catalog holds no checksum for. Nothing will be able to tell you whether they arrived intact."
msgstr "Dohvaća datoteke za koje katalog nema kontrolnu sumu. Ništa vam neće moći reći jesu li stigle neoštećene."

msgid "Show at most this many entries."
msgstr "Prikazuje najviše ovoliko unosa."

msgid "already here"
msgstr "već ovdje"

msgid "to fetch"
msgstr "za dohvat"

msgid "About to download"
msgstr "Priprema se preuzimanje"

msgid "File"
msgstr "Datoteka"

msgid "Role"
msgstr "Uloga"

msgid "Size"
msgstr "Veličina"

msgid "Status"
msgstr "Stanje"

msgid "%(name)s %(quant)s from %(repo)s"
msgstr "%(name)s %(quant)s iz %(repo)s"

msgid "%(count)d file, %(total)s in all, %(needed)s still to fetch."
msgid_plural "%(count)d files, %(total)s in all, %(needed)s still to fetch."
msgstr[0] "%(count)d datoteka, ukupno %(total)s, još %(needed)s za dohvat."
msgstr[1] "%(count)d datoteke, ukupno %(total)s, još %(needed)s za dohvat."
msgstr[2] "%(count)d datoteka, ukupno %(total)s, još %(needed)s za dohvat."

msgid "Into %(path)s, which has %(free)s free; %(after)s would be left."
msgstr "U %(path)s, gdje je slobodno %(free)s; ostalo bi %(after)s."

msgid "The catalog holds no checksum for %(files)s."
msgid_plural "The catalog holds no checksums for %(files)s."
msgstr[0] "Katalog nema kontrolnu sumu za %(files)s."
msgstr[1] "Katalog nema kontrolne sume za %(files)s."
msgstr[2] "Katalog nema kontrolne sume za %(files)s."

msgid "Download a model's weights, resuming anything an earlier run left and checking every file against the catalog's checksum."
msgstr "Preuzima težine modela, nastavlja ono što je ranije pokretanje ostavilo i provjerava svaku datoteku prema kontrolnoj sumi iz kataloga."

msgid "%(model)s %(quant)s is already here; nothing to do."
msgstr "%(model)s %(quant)s već je ovdje; nema se što raditi."

msgid "Start the download?"
msgstr "Započeti preuzimanje?"

msgid "Stopped. What arrived is kept; run `llamafit install model %(model)s` again to carry on from there."
msgstr "Zaustavljeno. Ono što je stiglo čuva se; pokrenite `llamafit install model %(model)s` ponovno da se nastavi odande."

msgid "%(count)d file, %(size)s, checked against the catalog."
msgid_plural "%(count)d files, %(size)s, checked against the catalog."
msgstr[0] "%(count)d datoteka, %(size)s, provjereno prema katalogu."
msgstr[1] "%(count)d datoteke, %(size)s, provjereno prema katalogu."
msgstr[2] "%(count)d datoteka, %(size)s, provjereno prema katalogu."

msgid "In %(path)s. Run `llamafit plan %(model)s` for the command line that runs it."
msgstr "U %(path)s. Pokrenite `llamafit plan %(model)s` za naredbeni redak koji ga pokreće."

msgid "Show what has been downloaded, newest first."
msgstr "Prikazuje što je preuzeto, najnovije prvo."

msgid "Nothing has been downloaded yet."
msgstr "Još ništa nije preuzeto."

msgid "Downloads"
msgstr "Preuzimanja"

msgid "When"
msgstr "Kada"

msgid "Model"
msgstr "Model"

msgid "Quant"
