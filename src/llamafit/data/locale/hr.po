msgid "no hardware profile file at %(path)s"
msgstr "nema datoteke profila hardvera na %(path)s"

msgid "Run `llamafit hardware list` to see the profiles LlamaFit has."
msgstr "Pokrenite `llamafit hardware list` da vidite profile koje LlamaFit ima."

msgid "%(path)s is not a valid hardware profile: %(details)s"
msgstr "%(path)s nije valjan profil hardvera: %(details)s"

