msgid "%(mode)s at %(context)s tokens, micro-batch %(ub)s, %(kv)s cache, %(threads)s threads."
msgstr "%(mode)s pri %(context)s tokena, mikroserija %(ub)s, predmemorija %(kv)s, dretvi: %(threads)s."

msgid "This reaches the %(target)s tokens per second asked for."
msgstr "Ovo doseže %(target)s tokena u sekundi koliko je traženo."

msgid "It does not reach %(target)s tokens per second here, but %(context)s tokens of context would: pass --context %(tokens)s."
msgstr "Ovdje ne doseže %(target)s tokena u sekundi, ali %(context)s tokena konteksta bi: predajte --context %(tokens)s."

msgid "Nothing this model and quantisation can do on this machine reaches %(target)s tokens per second; the fastest configuration tried is %(best)s. A smaller model or a smaller quantisation is the change that would."
msgstr "Ništa što ovaj model i kvantizacija mogu na ovom računalu ne doseže %(target)s tokena u sekundi; najbrža isprobana konfiguracija je %(best)s. Promjena koja bi to postigla jest manji model ili manja kvantizacija."

msgid "%(name)s %(quant)s"
msgstr "%(name)s %(quant)s"

msgid "Memory budget"
msgstr "Proračun memorije"

msgid "The %(context)s tokens asked for would have cost"
msgstr "Traženih %(context)s tokena stajalo bi"

msgid "Command line"
msgstr "Naredbeni redak"

msgid "Model file: %(path)s."
msgstr "Datoteka modela: %(path)s."

msgid "Model file: %(path)s, which is not on this machine yet; that is where a download would put it. %(size)s to fetch."
msgstr "Datoteka modela: %(path)s, koje još nema na ovom računalu; ondje bi je preuzimanje smjestilo. Za dohvat %(size)s."

msgid "%(shown)d of %(total)d candidate shown."
msgid_plural "%(shown)d of %(total)d candidates shown."
msgstr[0] "Prikazano %(shown)d od %(total)d kandidata."
msgstr[1] "Prikazano %(shown)d od %(total)d kandidata."
msgstr[2] "Prikazano %(shown)d od %(total)d kandidata."

msgid "Bind to this address instead of 127.0.0.1. Anything but loopback puts the dashboard on your network, where there is no password and no login; it prints what that exposes before it starts."
msgstr "Veže se na ovu adresu umjesto na 127.0.0.1. Sve osim povratne petlje stavlja ploču na vašu mrežu, gdje nema lozinke ni prijave; prije pokretanja ispisuje što time izlažete."

msgid "Listen on this port."
msgstr "Sluša na ovom portu."

msgid ""
"Open the dashboard in a browser: the board, the machine and the plans.\n"
"\n"
"It serves the same numbers `--json` prints, from the same code, on this machine only. Nothing is fetched from the internet to draw the page."
msgstr ""
"Otvara ploču u pregledniku: ljestvicu, računalo i planove.\n"
"\n"
"Poslužuje iste brojeve koje ispisuje `--json`, iz istog koda, samo na ovom računalu. Ništa se ne dohvaća s interneta da bi se stranica iscrtala."

msgid "Open the page in your browser."
msgstr "Otvara stranicu u vašem pregledniku."

msgid "Drop --profile, --memory, --ram and --cpu-cores, then open the Simulate panel on the page: it substitutes a machine for as long as you want it, and marks every answer it produces."
msgstr "Izostavite --profile, --memory, --ram i --cpu-cores, pa otvorite ploču Simulacija na stranici: ona zamjenjuje računalo koliko god želite i označava svaki odgovor koji time nastane."

msgid "LlamaFit is at %(url)s. Press Ctrl+C to stop it."
msgstr "LlamaFit je na %(url)s. Pritisnite Ctrl+C za zaustavljanje."

msgid "Show what this machine has: CPU, memory, GPUs, disks and llama.cpp."
msgstr "Prikazuje što ovo računalo ima: CPU, memoriju, grafičke kartice, diskove i llama.cpp."

msgid "Skip the RAM bandwidth measurement."
msgstr "Preskače mjerenje propusnosti RAM-a."

msgid "Measure RAM bandwidth again instead of reading back the figure kept for this machine, and keep the new one."
msgstr "Ponovno mjeri propusnost RAM-a umjesto čitanja brojke sačuvane za ovo računalo i čuva novu."

msgid "%(url)s answered a range request with the whole file."
msgstr "%(url)s je na zahtjev za raspon odgovorio cijelom datotekom."

msgid "%(url)s is rate-limiting this download (HTTP %(status)d)."
msgstr "%(url)s ograničava brzinu ovog preuzimanja (HTTP %(status)d)."

msgid "Check your network connection and run the command again to resume."
msgstr "Provjerite mrežnu vezu i pokrenite naredbu ponovno da se nastavi."

msgid "%(file)s needs authorisation (HTTP %(status)d)."
msgstr "%(file)s zahtijeva ovlaštenje (HTTP %(status)d)."

msgid "This repository is gated. Accept its terms on Hugging Face and set HF_TOKEN to a token that can read it."
msgstr "Ovaj je repozitorij zatvoren. Prihvatite njegove uvjete na Hugging Faceu i postavite HF_TOKEN na token koji ga može čitati."

msgid "%(file)s is not at %(url)s any more (HTTP 404)."
msgstr "%(file)s više nije na %(url)s (HTTP 404)."

msgid "Run `llamafit catalog refresh` to pick up the repository's current files."
msgstr "Pokrenite `llamafit catalog refresh` da se preuzmu trenutne datoteke repozitorija."

msgid "%(url)s returned HTTP %(status)d."
msgstr "%(url)s je vratio HTTP %(status)d."

msgid "Confirm the URL points at a downloadable file."
msgstr "Potvrdite da URL upućuje na datoteku koja se može preuzeti."

msgid "%(url)s did not say how big %(file)s is."
msgstr "%(url)s nije rekao koliko je %(file)s velika."

msgid "%(file)s is %(actual)s on the server but the catalog says %(expected)s; the repository has been re-uploaded since the catalog was refreshed."
msgstr "%(file)s je na poslužitelju %(actual)s, a katalog kaže %(expected)s; repozitorij je ponovno postavljen otkako je katalog osvježen."

msgid "Run `llamafit catalog refresh` and try again."
msgstr "Pokrenite `llamafit catalog refresh` i pokušajte ponovno."

msgid "%(file)s: the server sent %(actual)d bytes of a %(expected)d byte range."
msgstr "%(file)s: poslužitelj je poslao %(actual)d bajtova od raspona od %(expected)d bajtova."

msgid "Run the command again; the parts that did arrive are kept."
msgstr "Pokrenite naredbu ponovno; dijelovi koji su stigli se čuvaju."

msgid "Stopped."
msgstr "Zaustavljeno."

msgid "%(file)s: the server asked for fewer connections; using %(count)d."
msgstr "%(file)s: poslužitelj je zatražio manje veza; koristi se %(count)d."

msgid "%(file)s: this server will not serve byte ranges; fetching it in one stream."
msgstr "%(file)s: ovaj poslužitelj ne poslužuje bajtne raspone; dohvaća se u jednom toku."

msgid "%(file)s does not match its checksum; fetching it again."
msgstr "%(file)s ne odgovara svojoj kontrolnoj sumi; dohvaća se ponovno."

msgid "Check that the download directory is writable."
msgstr "Provjerite je li u direktorij za preuzimanja moguće pisati."

msgid "%(needed)s is needed for this model but %(path)s has only %(free)s free, %(short)s short of what is wanted with %(headroom)s left spare."
msgstr "Za ovaj model potrebno je %(needed)s, a %(path)s ima samo %(free)s slobodno, %(short)s manje od onoga što treba uz %(headroom)s rezerve."

msgid "Free some space, or choose another directory with --dir, or a smaller quantisation with --quant."
msgstr "Oslobodite prostor, odaberite drugi direktorij s --dir ili manju kvantizaciju s --quant."

msgid "could not measure the free space on %(path)s: %(error)s"
msgstr "nije bilo moguće izmjeriti slobodan prostor na %(path)s: %(error)s"

msgid "Check that the download directory's volume is available."
msgstr "Provjerite je li disk s direktorijem za preuzimanja dostupan."

msgid "%(model)s has no downloadable source in the catalog."
msgstr "%(model)s nema izvor za preuzimanje u katalogu."

msgid "Only Hugging Face sources can be installed; this entry has none."
msgstr "Instalirati se mogu samo izvori s Hugging Facea; ovaj unos nema nijedan."

msgid "the catalog has no file list for %(model)s %(quant)s."
msgstr "katalog nema popis datoteka za %(model)s %(quant)s."

msgid "Run `llamafit catalog refresh` to fill in the file names."
msgstr "Pokrenite `llamafit catalog refresh` da se popune nazivi datoteka."

msgid "%(model)s publishes no quantisations."
msgstr "%(model)s ne objavljuje nijednu kvantizaciju."

msgid "%(model)s does not publish a %(quant)s quantisation."
msgstr "%(model)s ne objavljuje kvantizaciju %(quant)s."

msgid "It publishes: %(quants)s"
msgstr "Objavljuje: %(quants)s"

msgid "the catalog does not record how big %(quant)s is."
msgstr "katalog ne bilježi kolika je %(quant)s."

msgid "Run `llamafit catalog refresh` to fill in the sizes."
msgstr "Pokrenite `llamafit catalog refresh` da se popune veličine."

msgid "the catalog holds no checksum for %(files)s."
msgid_plural "the catalog holds no checksums for %(files)s."
msgstr[0] "katalog nema kontrolnu sumu za %(files)s."
msgstr[1] "katalog nema kontrolne sume za %(files)s."
msgstr[2] "katalog nema kontrolne sume za %(files)s."

msgid "Run `llamafit catalog refresh` to fetch them, or pass --allow-unverified to download anyway and check the files yourself."
msgstr "Pokrenite `llamafit catalog refresh` da ih dohvati, ili predajte --allow-unverified da se ipak preuzme i sami provjerite datoteke."

msgid "%(done)s of %(total)s"
msgstr "%(done)s od %(total)s"

msgid "%(rate)s/s"
msgstr "%(rate)s/s"

msgid "Fetching %(file)s (%(size)s)"
msgstr "Dohvaća se %(file)s (%(size)s)"

msgid "Checking %(file)s against its checksum"
msgstr "Provjerava se %(file)s prema svojoj kontrolnoj sumi"

msgid "Done: %(file)s"
msgstr "Gotovo: %(file)s"

msgid "could not create %(path)s: %(error)s"
msgstr "nije bilo moguće stvoriti %(path)s: %(error)s"

msgid "Check that the download directory is writable and has room."
msgstr "Provjerite je li u direktorij za preuzimanja moguće pisati i ima li u njemu mjesta."

msgid "could not move %(source)s into place: %(error)s"
msgstr "nije bilo moguće premjestiti %(source)s na mjesto: %(error)s"

msgid "could not record progress in %(path)s: %(error)s"
msgstr "nije bilo moguće zabilježiti napredak u %(path)s: %(error)s"

msgid "could not fetch %(url)s: %(error)s"
msgstr "nije bilo moguće dohvatiti %(url)s: %(error)s"

msgid "Stopped before the checksum was finished."
msgstr "Zaustavljeno prije nego što je kontrolna suma dovršena."

msgid "could not read %(path)s: %(error)s"
msgstr "nije bilo moguće pročitati %(path)s: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "Provjerite postoji li datoteka i je li čitljiva."

msgid "%(file)s is %(actual)d bytes, but the catalog says %(expected)d"
msgstr "%(file)s ima %(actual)d bajtova, a katalog kaže %(expected)d"

msgid "The transfer was cut short. Run the command again to fetch it properly."
msgstr "Prijenos je prekinut. Pokrenite naredbu ponovno da se datoteka dohvati kako treba."

msgid "%(file)s does not match the checksum the catalog holds."
msgstr "%(file)s ne odgovara kontrolnoj sumi koju katalog drži."

msgid "Expected %(expected)s but the file hashes to %(actual)s. The bad copy has been deleted; run the command again to fetch it."
msgstr "Očekivano %(expected)s, a datoteka daje %(actual)s. Neispravna kopija je izbrisana; pokrenite naredbu ponovno da se dohvati."

msgid "Command: %(command)s"
msgstr "Naredba: %(command)s"

msgid "truncated GGUF header: wanted %(wanted)d byte at offset %(offset)d, got %(got)d"
msgid_plural "truncated GGUF header: wanted %(wanted)d bytes at offset %(offset)d, got %(got)d"
msgstr[0] "skraćeno GGUF zaglavlje: tražen je %(wanted)d bajt na odmaku %(offset)d, dobiveno %(got)d"
msgstr[1] "skraćeno GGUF zaglavlje: tražena su %(wanted)d bajta na odmaku %(offset)d, dobiveno %(got)d"
msgstr[2] "skraćeno GGUF zaglavlje: traženo je %(wanted)d bajtova na odmaku %(offset)d, dobiveno %(got)d"

msgid "The file may still be downloading, or the URL may not be a GGUF file."
msgstr "Datoteka se možda još preuzima ili URL možda ne upućuje na GGUF datoteku."

msgid "unknown GGUF value type %(type)d at offset %(offset)d"
msgstr "nepoznata vrsta GGUF vrijednosti %(type)d na odmaku %(offset)d"

msgid "This file may use a newer GGUF metadata type than LlamaFit supports."
msgstr "Ova datoteka možda koristi noviju vrstu GGUF metapodataka nego što LlamaFit podržava."

msgid "not a GGUF file: bad magic %(magic)s at offset 0"
msgstr "nije GGUF datoteka: neispravan potpis %(magic)s na odmaku 0"

msgid "Check that this file is actually a .gguf model."
msgstr "Provjerite je li ova datoteka doista .gguf model."

msgid "unsupported GGUF version %(version)d at offset 4"
msgstr "nepodržana GGUF inačica %(version)d na odmaku 4"

msgid "LlamaFit supports GGUF versions %(versions)s."
msgstr "LlamaFit podržava GGUF inačice %(versions)s."

msgid "A memory budget built without these tensors would be too small, so none is built. If llama.cpp loads the file, LlamaFit's tensor-size table is missing the type."
msgstr "Proračun memorije izgrađen bez tih tenzora bio bi premalen, pa se nijedan ne gradi. Ako llama.cpp učita datoteku, LlamaFitovoj tablici veličina tenzora nedostaje ta vrsta."

msgid "%(type)d (%(count)d tensor, first %(name)s)"
msgid_plural "%(type)d (%(count)d tensors, first %(name)s)"
msgstr[0] "%(type)d (%(count)d tenzor, prvi %(name)s)"
msgstr[1] "%(type)d (%(count)d tenzora, prvi %(name)s)"
msgstr[2] "%(type)d (%(count)d tenzora, prvi %(name)s)"

msgid "cannot size this GGUF file: %(count)d tensor uses a GGML type LlamaFit does not know: %(details)s"
msgid_plural "cannot size this GGUF file: %(count)d tensors use GGML types LlamaFit does not know: %(details)s"
msgstr[0] "ovoj GGUF datoteci ne može se odrediti veličina: %(count)d tenzor koristi GGML vrstu koju LlamaFit ne poznaje: %(details)s"
msgstr[1] "ovoj GGUF datoteci ne može se odrediti veličina: %(count)d tenzora koriste GGML vrste koje LlamaFit ne poznaje: %(details)s"
msgstr[2] "ovoj GGUF datoteci ne može se odrediti veličina: %(count)d tenzora koristi GGML vrste koje LlamaFit ne poznaje: %(details)s"

msgid "%(count)d shard"
msgid_plural "%(count)d shards"
msgstr[0] "%(count)d dio"
msgstr[1] "%(count)d dijela"
msgstr[2] "%(count)d dijelova"

msgid "these GGUF files are not one split model: they disagree about '%(key)s', declaring %(values)s"
msgstr "ove GGUF datoteke nisu jedan podijeljeni model: ne slažu se oko '%(key)s' i navode %(values)s"

msgid "Pass the shards of one model, not of several."
msgstr "Predajte dijelove jednog modela, a ne više njih."

msgid "no GGUF header to read facts from"
msgstr "nema GGUF zaglavlja iz kojeg bi se pročitali podaci"

msgid "Pass the model's file, or every shard of a split model."
msgstr "Predajte datoteku modela ili svaki dio podijeljenog modela."

msgid "%(count)d GGUF file of the %(total)d given carries no '%(key)s' key, so its place in a split model cannot be established"
msgid_plural "%(count)d GGUF files of the %(total)d given carry no '%(key)s' key, so their place in a split model cannot be established"
msgstr[0] "%(count)d GGUF datoteka od %(total)d zadanih ne nosi ključ '%(key)s', pa se njezino mjesto u podijeljenom modelu ne može utvrditi"
msgstr[1] "%(count)d GGUF datoteke od %(total)d zadanih ne nose ključ '%(key)s', pa se njihovo mjesto u podijeljenom modelu ne može utvrditi"
msgstr[2] "%(count)d GGUF datoteka od %(total)d zadanih ne nosi ključ '%(key)s', pa se njihovo mjesto u podijeljenom modelu ne može utvrditi"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "Predajte jednu nepodijeljenu datoteku samu za sebe ili svaki dio jednog podijeljenog modela."

msgid "incomplete shard set: the model declares %(shards)s and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "nepotpun skup dijelova: model navodi %(shards)s, a stiglo ih je %(arrived)d (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "Predajte svaki dio podijeljenog modela."

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "nedostaje dio koji nosi metapodatke modela: primljeno %(key)s %(numbers)s, a očekivalo se da jedan od njih bude 0"

msgid "Pass every shard of the split model, including the first."
msgstr "Predajte svaki dio podijeljenog modela, uključujući prvi."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "nepotpun skup dijelova: očekivalo se %(key)s od 0 do %(last)d, primljeno %(numbers)s"

msgid "Pass each shard of the split model exactly once."
msgstr "Predajte svaki dio podijeljenog modela točno jedanput."

msgid "incomplete shard set: the model declares %(tensors)s and its %(shards)s hold %(held)d between them"
msgstr "nepotpun skup dijelova: model navodi %(tensors)s, a njegovih %(shards)s drži %(held)d ukupno"

msgid "%(count)d tensor"
msgid_plural "%(count)d tensors"
msgstr[0] "%(count)d tenzor"
msgstr[1] "%(count)d tenzora"
msgstr[2] "%(count)d tenzora"

msgid "Check your network connection and that the URL is reachable."
msgstr "Provjerite mrežnu vezu i je li URL dostupan."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s je vratio HTTP %(status)d umjesto 206 Partial Content; poslužitelj možda ne podržava zahtjeve za rasponom."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Potvrdite da URL upućuje na GGUF datoteku koja se može preuzeti."

