msgid "Its weights hold %(weights)s of this machine's %(memory)s and the tightest pool is %(share)s full. The score wants at least %(low)s of the memory taken and no more than %(high)s of any one pool."
msgstr "Njegove težine drže %(weights)s od %(memory)s ovog računala, a najtjesnji spremnik pun je %(share)s. Bodovanje traži barem %(low)s zauzete memorije i najviše %(high)s bilo kojeg pojedinog spremnika."

msgid "Holds %(fit)s tokens of the %(requested)s this request is scored against."
msgstr "Drži %(fit)s tokena od %(requested)s prema kojima se ovaj zahtjev boduje."

