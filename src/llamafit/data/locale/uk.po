msgid "could not read %(path)s: %(error)s"
msgstr "не вдалося прочитати %(path)s: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "Перевірте, що файл існує і доступний для читання."

msgid "could not fetch %(url)s: %(error)s"
msgstr "не вдалося отримати %(url)s: %(error)s"

msgid "Check your network connection and that the URL is reachable."
msgstr "Перевірте мережеве з'єднання та доступність цієї URL-адреси."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s повернув HTTP %(status)d замість 206 Partial Content; можливо, сервер не підтримує запити діапазонів."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Переконайтеся, що URL-адреса вказує на завантажуваний файл GGUF."

