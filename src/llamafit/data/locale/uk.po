msgstr "установлено LlamaFit; буде замінено"

msgid "was not installed by LlamaFit"
msgstr "установлено не LlamaFit"

msgid "Installed llama.cpp %(tag)s into %(path)s."
msgstr "llama.cpp %(tag)s установлено в %(path)s."

msgid "Replaced %(tag)s."
msgstr "Замінено: %(tag)s."

msgid "Backends found in it: %(backends)s"
msgstr "Знайдені в ньому бекенди: %(backends)s"

msgid "none"
msgstr "немає"

msgid "Check it with `llamafit doctor`."
msgstr "Перевірте це командою `llamafit doctor`."

