msgctxt "bits per weight"
msgid "unknown"
msgstr "अज्ञात"

msgid "Show what this machine has: CPU, memory, GPUs, disks and llama.cpp."
msgstr "दिखाता है कि इस मशीन में क्या है: CPU, मेमोरी, GPU, डिस्क और llama.cpp।"

msgid "Skip the RAM bandwidth measurement."
msgstr "RAM बैंडविड्थ का मापन छोड़ देता है।"

msgid "Command: %(command)s"
msgstr "कमांड: %(command)s"

msgid "truncated GGUF header: wanted %(wanted)d bytes at offset %(offset)d, got %(got)d"
msgstr "कटा हुआ GGUF हेडर: offset %(offset)d पर %(wanted)d बाइट चाहिए थे, मिले %(got)d"

msgid "The file may still be downloading, or the URL may not be a GGUF file."
msgstr "फ़ाइल अभी डाउनलोड हो रही हो सकती है, या URL किसी GGUF फ़ाइल का न हो।"

msgid "unknown GGUF value type %(type)d at offset %(offset)d"
msgstr "offset %(offset)d पर अज्ञात GGUF मान प्रकार %(type)d"

msgid "This file may use a newer GGUF metadata type than LlamaFit supports."
msgstr "यह फ़ाइल GGUF मेटाडेटा का ऐसा प्रकार उपयोग कर सकती है जो LlamaFit के समर्थन से नया है।"

msgid "not a GGUF file: bad magic %(magic)s at offset 0"
msgstr "यह GGUF फ़ाइल नहीं है: offset 0 पर गलत magic %(magic)s"

msgid "Check that this file is actually a .gguf model."
msgstr "जाँचें कि यह फ़ाइल सचमुच एक .gguf मॉडल है।"

msgid "unsupported GGUF version %(version)d at offset 4"
msgstr "offset 4 पर असमर्थित GGUF संस्करण %(version)d"

msgid "LlamaFit supports GGUF versions %(versions)s."
msgstr "LlamaFit GGUF के %(versions)s संस्करण समर्थित करता है।"

msgid "these GGUF files are not one split model: they disagree about '%(key)s', declaring %(values)s"
msgstr "ये GGUF फ़ाइलें एक ही split मॉडल की नहीं हैं: '%(key)s' पर इनमें मतभेद है, ये %(values)s घोषित करती हैं"

msgid "Pass the shards of one model, not of several."
msgstr "एक ही मॉडल के shard दें, कई मॉडलों के नहीं।"

msgid "no GGUF header to read facts from"
msgstr "तथ्य पढ़ने के लिए कोई GGUF हेडर नहीं है"

msgid "Pass the model's file, or every shard of a split model."
msgstr "मॉडल की फ़ाइल दें, या split मॉडल का हर shard दें।"

msgid "%(count)d of %(total)d GGUF files carry no '%(key)s' key, so their place in a split model cannot be established"
msgstr "%(total)d में से %(count)d GGUF फ़ाइलों में '%(key)s' कुंजी नहीं है, इसलिए split मॉडल में उनका स्थान तय नहीं हो सकता"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "या तो एक अकेली बिना-split फ़ाइल दें, या एक ही split मॉडल का हर shard दें।"

msgid "incomplete shard set: the model declares %(declared)d shards and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "अधूरा shard समूह: मॉडल %(declared)d shard घोषित करता है और आए %(arrived)d (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "split मॉडल का हर shard दें।"

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "मॉडल का मेटाडेटा रखने वाला shard गायब है: %(key)s %(numbers)s मिले, इनमें से किसी एक का 0 होना अपेक्षित था"

msgid "Pass every shard of the split model, including the first."
msgstr "split मॉडल का हर shard दें, पहला भी।"

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "अधूरा shard समूह: %(key)s 0 से %(last)d तक अपेक्षित था, मिले %(numbers)s"

msgid "Pass each shard of the split model exactly once."
msgstr "split मॉडल का हर shard ठीक एक बार दें।"

msgid "incomplete shard set: the model declares %(declared)d tensors and its %(shards)d shards hold %(held)d between them"
msgstr "अधूरा shard समूह: मॉडल %(declared)d टेंसर घोषित करता है और उसके %(shards)d shard मिलकर %(held)d रखते हैं"

msgid "could not read %(path)s: %(error)s"
msgstr "%(path)s नहीं पढ़ा जा सका: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "जाँचें कि फ़ाइल मौजूद है और पढ़ने योग्य है।"

msgid "could not fetch %(url)s: %(error)s"
msgstr "%(url)s नहीं लाया जा सका: %(error)s"

msgid "Check your network connection and that the URL is reachable."
msgstr "अपना नेटवर्क कनेक्शन जाँचें और यह भी कि URL तक पहुँचा जा सकता है।"

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s ने 206 Partial Content के बजाय HTTP %(status)d लौटाया; हो सकता है सर्वर range अनुरोध समर्थित न करता हो।"

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "पक्का करें कि URL किसी डाउनलोड करने योग्य GGUF फ़ाइल की ओर इशारा करता है।"

msgctxt "CPU model"
msgid "unknown"
msgstr "अज्ञात"

msgid "nvidia-smi returned no GPUs"
msgstr "nvidia-smi ने कोई GPU नहीं लौटाया"

msgid "rocm-smi returned no cards"
msgstr "rocm-smi ने कोई कार्ड नहीं लौटाया"

msgid "system_profiler returned no displays"
msgstr "system_profiler ने कोई डिस्प्ले नहीं लौटाया"

msgid "WMI returned no video controllers"
msgstr "WMI ने कोई वीडियो कंट्रोलर नहीं लौटाया"

msgid "lspci found no display controllers"
msgstr "lspci को कोई डिस्प्ले कंट्रोलर नहीं मिला"

msgid "no populated memory modules"
msgstr "कोई भरा हुआ मेमोरी मॉड्यूल नहीं"

msgid "no SPMemoryDataType"
msgstr "कोई SPMemoryDataType नहीं"

msgid "empty command"
msgstr "खाली कमांड"

msgid "%(program)s: timed out after %(seconds)ss"
msgstr "%(program)s: %(seconds)ss के बाद समय समाप्त"

msgid "%(program)s: %(error)s"
msgstr "%(program)s: %(error)s"

msgid "%(program)s: not found"
msgstr "%(program)s: नहीं मिला"

msgid "no output"
msgstr "कोई आउटपुट नहीं"

msgid "exit code %(code)d: %(detail)s"
msgstr "exit code %(code)d: %(detail)s"

msgid "llama.cpp not found: no llama-server on PATH, in LLAMA_CPP_PATH or in the usual directories"
msgstr "llama.cpp नहीं मिला: न PATH पर, न LLAMA_CPP_PATH में, न सामान्य डायरेक्टरियों में कोई llama-server है"

msgid "no ggml backend libraries found next to llama-server; the build may be static"
msgstr "llama-server के साथ कोई ggml backend लाइब्रेरी नहीं मिली; बिल्ड static हो सकता है"

msgid "no llama-server answering"
msgstr "कोई llama-server जवाब नहीं दे रहा"

msgid "unexpected response: %(error)s"
msgstr "अप्रत्याशित प्रतिक्रिया: %(error)s"

msgid "Install or repair the NVIDIA driver; nvidia-smi ships with it and must be on PATH."
msgstr "NVIDIA ड्राइवर स्थापित करें या ठीक करें; nvidia-smi उसी के साथ आता है और उसका PATH पर होना ज़रूरी है।"

msgid "Install ROCm (Linux) to expose AMD VRAM figures; without it the GPU is listed by name only."
msgstr "AMD की VRAM संख्याएँ देखने के लिए ROCm (Linux) स्थापित करें; उसके बिना GPU केवल नाम से सूचीबद्ध होता है।"

msgid "PowerShell could not list video controllers; run from a normal user session."
msgstr "PowerShell वीडियो कंट्रोलर सूचीबद्ध नहीं कर सका; इसे किसी सामान्य उपयोगकर्ता सत्र से चलाएँ।"

msgid "Install pciutils to list GPUs by name when no vendor tool is available."
msgstr "जब कोई वेंडर टूल उपलब्ध न हो तब GPU नाम से सूचीबद्ध करने के लिए pciutils स्थापित करें।"

msgid "DDR type and speed were not readable; on Linux run once with sudo (dmidecode) or accept the measured bandwidth instead."
msgstr "DDR का प्रकार और गति पढ़ी नहीं जा सकी; Linux पर एक बार sudo के साथ चलाएँ (dmidecode) या इसके बदले मापी गई बैंडविड्थ स्वीकार करें।"

msgid "py-cpuinfo failed; the CPU model and instruction sets are unknown."
msgstr "py-cpuinfo विफल रहा; CPU का मॉडल और instruction set अज्ञात हैं।"

msgid "psutil could not count the CPU cores; thread choice falls back to one core. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil CPU कोर गिन नहीं सका; थ्रेड का चुनाव एक ही कोर पर लौट आता है। psutil को `pip install --force-reinstall psutil` से फिर से स्थापित करें।"

msgid "psutil could not read the memory totals; budgets cannot be computed until this works. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil मेमोरी के कुल आँकड़े नहीं पढ़ सका; जब तक यह काम नहीं करता, बजट की गणना नहीं हो सकती। psutil को `pip install --force-reinstall psutil` से फिर से स्थापित करें।"

msgid "Could not read performance-core count from sysctl."
msgstr "sysctl से परफ़ॉर्मेंस कोर की संख्या नहीं पढ़ी जा सकी।"

msgid "llama-server exists but did not report a version; the binary may be broken."
msgstr "llama-server मौजूद तो है पर उसने कोई संस्करण नहीं बताया; बाइनरी खराब हो सकती है।"

msgid "system_profiler failed; GPU information is unavailable."
msgstr "system_profiler विफल रहा; GPU की जानकारी उपलब्ध नहीं है।"

msgid "No vendor tool reported the GPU's memory size; record the size in a hardware profile so budgets can be computed for this machine."
msgstr "किसी वेंडर टूल ने GPU की मेमोरी का आकार नहीं बताया; यह आकार किसी hardware profile में दर्ज करें ताकि इस मशीन के लिए बजट की गणना हो सके।"

msgid "llama.cpp installed"
msgstr "llama.cpp स्थापित है"

msgid "build %(build)s at %(path)s, backends: %(backends)s"
msgstr "%(path)s पर बिल्ड %(build)s, backends: %(backends)s"

msgctxt "llama.cpp build"
msgid "unknown"
msgstr "अज्ञात"

msgid "llama.cpp not found"
msgstr "llama.cpp नहीं मिला"

msgid "no llama-server binary was found"
msgstr "कोई llama-server बाइनरी नहीं मिली"

msgid "Install llama.cpp (LlamaFit phase 2 will do this: `llamafit install llama.cpp`); until then download a release from https://github.com/ggml-org/llama.cpp/releases and put its bin directory on PATH or in LLAMA_CPP_PATH."
msgstr "llama.cpp स्थापित करें (LlamaFit का चरण 2 यह काम करेगा: `llamafit install llama.cpp`); तब तक https://github.com/ggml-org/llama.cpp/releases से कोई रिलीज़ डाउनलोड करें और उसकी bin डायरेक्टरी को PATH पर या LLAMA_CPP_PATH में रखें।"

msgid "Memory size unknown"
msgstr "मेमोरी का आकार अज्ञात"

msgid "LlamaFit could not read this machine's memory totals, so it cannot work out what will fit."
msgstr "LlamaFit इस मशीन की कुल मेमोरी नहीं पढ़ सका, इसलिए यह तय नहीं कर सकता कि इसमें क्या समाएगा।"

msgid "%(gpu)s: no %(backend)s backend in llama.cpp"
msgstr "%(gpu)s: llama.cpp में कोई %(backend)s backend नहीं है"

msgid "llama.cpp was built with: %(backends)s"
msgstr "llama.cpp इनके साथ बना है: %(backends)s"

