msgstr "%(tag)s को बदल दिया।"

msgid "Backends found in it: %(backends)s"
msgstr "उसमें मिले backend: %(backends)s"

msgid "none"
msgstr "कोई नहीं"

msgid "Check it with `llamafit doctor`."
msgstr "इसे `llamafit doctor` से जाँचें।"

