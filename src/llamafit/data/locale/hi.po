msgstr "इस मशीन पर कोई भी रन मोड इस मॉडल को समर्थित नहीं करता"

msgctxt "exclusion tag"
msgid "short context"
msgstr "छोटा context"

msgid "holds fewer than the %(minimum)s tokens asked for; lower the minimum context or free memory to see it ranked"
msgstr "जितने %(minimum)s टोकन माँगे गए थे उससे कम रखता है; इसे क्रम में देखने के लिए न्यूनतम context घटाएँ या मेमोरी खाली करें"

msgctxt "exclusion tag"
msgid "no estimate"
msgstr "कोई अनुमान नहीं"

