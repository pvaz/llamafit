msgid ""
msgstr ""
"Project-Id-Version: llamafit 0.1.0a1\n"
"Report-Msgid-Bugs-To: https://github.com/pvaz/llamafit/issues\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: id\n"
"Language-Team: Indonesian\n"
"Plural-Forms: nplurals=1; plural=0;\n"

# Indonesian has no grammatical plural: a counted noun keeps one shape whatever the
# number, so this catalog declares one form and every plural entry has a single
# msgstr[0]. (The GNU gettext manual's old table lists Bahasa Indonesia among the
# two-form languages; CLDR, which is the newer and correct source, gives it only
# "other".)
#
# Names that are not language are left alone: LlamaFit, llama.cpp, Hugging Face, GGUF,
# JSON, YAML, CUDA, Vulkan, Metal, flags, paths and tool names. So are the words
# Indonesian developers write in English anyway: file, backend, quant, shard, offset,
# traceback, checksum, thread, build. Where Indonesian has a term that is genuinely in
# use it is used: kesalahan, peringatan, memori, jaringan, konteks, keluaran.

msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "Hugging Face mengembalikan %(status)d saat mendaftar file untuk %(repo)s."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Tidak dapat membaca daftar file %(repo)s dari Hugging Face."

msgid "Check your network connection and try again."
msgstr "Periksa koneksi jaringan Anda lalu coba lagi."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "Respons Hugging Face untuk %(repo)s tidak memuat daftar file."

msgid "Check that the repository id is correct and public."
msgstr "Pastikan id repositori benar dan bersifat publik."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "katalog memiliki %(count)d masalah"

msgid "Run `llamafit catalog validate` for details."
msgstr "Jalankan `llamafit catalog validate` untuk rinciannya."

msgid "could not write %(path)s: %(error)s"
msgstr "tidak dapat menulis %(path)s: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "Pastikan direktori itu dapat ditulisi dan masih punya ruang."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "%(path)s memiliki %(count)d masalah sehingga tidak dapat diperbarui"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "Jalankan `llamafit catalog validate` dan perbaiki file itu lebih dulu."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "%(path)s tidak dapat dibaca seluruhnya, sehingga memperbarui %(model)s saja akan membuang fakta yang dicatatnya untuk model yang tidak disentuh proses ini: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "Jalankan `llamafit catalog refresh` tanpa --model untuk membangun ulang seluruh file."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "Temukan, ukur, pasang dan verifikasi LLM open-weight untuk llama.cpp di mesin Anda sendiri."

msgid "Print machine-readable JSON instead of tables."
msgstr "Mencetak JSON yang terbaca mesin, bukan tabel."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "Menulis rincian ke llamafit.log di direktori log dan menampilkan traceback."

msgid "Disable colours."
msgstr "Mematikan warna."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "Berbicara dalam bahasa ini, misalnya pt_PT. Bahasa yang tidak dimiliki LlamaFit akan jatuh kembali ke bahasa Inggris, dan LlamaFit menyebutkan bahasa apa saja yang dimilikinya."

msgid "Print the version and exit."
msgstr "Mencetak versi lalu keluar."

msgid "Unexpected error: %(error)s"
msgstr "Kesalahan tak terduga: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "Jalankan lagi dengan --verbose untuk traceback lengkapnya."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "Merawat katalog: memvalidasi file-nya, memperbarui bidang yang berubah-ubah."

msgid "Keep only this use case."
msgstr "Hanya mempertahankan kasus penggunaan ini."

msgid "Keep only models with this capability (repeatable)."
msgstr "Hanya mempertahankan model dengan kemampuan ini (dapat diulang)."

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Hanya mempertahankan pengenal lisensi ini (dapat diulang)."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "Hanya memvalidasi file ini, bukan katalog bawaan dan penyesuaian Anda sendiri."

msgid "Did you mean: %(ids)s?"
msgstr "Apakah maksud Anda: %(ids)s?"

msgid "Run `llamafit list` to see every model id."
msgstr "Jalankan `llamafit list` untuk melihat setiap id model."

msgid "no model named %(id)s in the catalog"
msgstr "tidak ada model bernama %(id)s di katalog"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "Ditemukan %(count)d masalah katalog; jalankan `llamafit catalog validate` untuk rinciannya."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "Tidak ada model yang cocok. Coba --use-case, --capability, --license, --vendor atau --search yang lebih luas."

msgid "invalid --use-case %(value)s"
msgstr "--use-case tidak sah: %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "Kasus penggunaan yang sah: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "Kemampuan yang sah: %(values)s"

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"Menampilkan katalog model, dipersempit oleh filter apa pun yang diberikan.\n"
"\n"
"Tabel menampilkan paling banyak tiga kemampuan per model, ditambah penanda +N untuk sisanya, dan diurutkan menurut kolom Kualitas yang ditampilkan; info atau --json memuat setiap kemampuan."

msgid "Keep only this vendor, case-insensitive."
msgstr "Hanya mempertahankan vendor ini, tanpa membedakan huruf besar dan kecil."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "Pencocokan substring pada id, nama, vendor atau keluarga, tanpa membedakan huruf besar dan kecil."

msgid "Show at most this many."
msgstr "Menampilkan paling banyak sekian."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "Bentuk singkat untuk llamafit list --search TEXT."

msgid "Text to match against id, name, vendor or family."
msgstr "Teks yang dicocokkan dengan id, nama, vendor atau keluarga."

msgid "A catalog model id."
msgstr "Sebuah id model katalog."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "Memvalidasi file YAML katalog terhadap skema, mencetak satu baris per masalah."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "%(count)d file diperiksa, tidak ada masalah ditemukan."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "Memperbarui nama file, ukuran, checksum dan fakta GGUF katalog dari Hugging Face."

msgid "Refresh only this model id."
msgstr "Hanya memperbarui id model ini."

msgid "Compute the refresh but write nothing."
msgstr "Menghitung pembaruan tetapi tidak menulis apa pun."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "Keluar dengan 1 jika ada yang akan berubah; tidak mengubah apa pun, untuk tugas CI terjadwal."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: peringatan: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "peringatan: %(warning)s (%(count)d model: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: kesalahan: %(error)s"

msgid "Hint: %(hint)s"
msgstr "Petunjuk: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "refresh memerlukan akses jaringan ke Hugging Face; periksa koneksi Anda dan pastikan id repositori benar."

msgid "No changes."
msgstr "Tidak ada perubahan."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "Mencetak entri katalog mentah satu model, sebagai JSON secara bawaan atau sebagai YAML dengan --yaml."

msgid "Print YAML instead of JSON."
msgstr "Mencetak YAML, bukan JSON."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "Menjelaskan apa yang terdeteksi, apa yang gagal, dan apa yang akan membuka lebih banyak."

