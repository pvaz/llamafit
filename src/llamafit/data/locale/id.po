msgstr "%(file)s: server meminta lebih sedikit koneksi; memakai %(count)d."

msgid "%(file)s: this server will not serve byte ranges; fetching it in one stream."
msgstr "%(file)s: server ini tidak melayani range byte; mengambilnya dalam satu aliran."

