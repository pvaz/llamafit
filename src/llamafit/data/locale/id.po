msgstr "%(file)s membutuhkan otorisasi (HTTP %(status)d)."

msgid "This repository is gated. Accept its terms on Hugging Face and set HF_TOKEN to a token that can read it."
msgstr "Repositori ini terkunci. Terima ketentuannya di Hugging Face lalu atur HF_TOKEN ke token yang dapat membacanya."

msgid "%(file)s is not at %(url)s any more (HTTP 404)."
msgstr "%(file)s tidak lagi ada di %(url)s (HTTP 404)."

msgid "Run `llamafit catalog refresh` to pick up the repository's current files."
msgstr "Jalankan `llamafit catalog refresh` untuk mengambil file repositori yang sekarang."

msgid "%(url)s returned HTTP %(status)d."
msgstr "%(url)s mengembalikan HTTP %(status)d."

msgid "Confirm the URL points at a downloadable file."
msgstr "Pastikan URL itu menunjuk ke file yang dapat diunduh."

