msgid "already on this machine"
msgstr "যা আগে থেকেই এই মেশিনে আছে"

msgid "%(counted)s, by %(sort)s, showing %(filter)s."
msgstr "%(counted)s, %(sort)s অনুসারে, %(filter)s দেখানো হচ্ছে।"

msgid "Nothing was ranked. Every candidate is listed below with the reason; widen the request or free some memory."
msgstr "কাউকে ক্রম দেওয়া যায়নি। প্রতিটি প্রার্থী কারণসহ নিচে তালিকাভুক্ত; অনুরোধটি চওড়া করুন বা কিছু মেমরি খালি করুন।"

msgid "Recommended"
msgstr "সুপারিশ করা"

msgid "--min-tps 0: nobody is waiting on these tokens, so nothing was excluded for generating more slowly than a person reads."
msgstr "--min-tps 0: এই টোকেনের জন্য কেউ অপেক্ষা করছে না, তাই মানুষ যে গতিতে পড়ে তার চেয়ে ধীরে তৈরি করার জন্য কাউকেই বাদ দেওয়া হয়নি।"

msgid "--min-tps %(tps)s: this board wanted at least that many tokens per second, and anything slower is excluded below rather than ranked here."
msgstr "--min-tps %(tps)s: এই বোর্ড সেকেন্ডে অন্তত ততগুলি টোকেন চেয়েছিল, আর তার চেয়ে ধীর সবকিছু এখানে ক্রম না পেয়ে নিচে বাদ পড়েছে।"

msgid "Showing the best %(shown)s of %(total)s that qualified; --limit sets how many, and the rest are neither worse-behaved nor hidden, only further down."
msgstr "যে %(total)s যোগ্য হয়েছিল তার মধ্যে সেরা %(shown)s দেখানো হচ্ছে; কতগুলি দেখানো হবে তা --limit ঠিক করে, আর বাকিগুলি খারাপও নয়, লুকোনোও নয়, কেবল আরও নিচে।"

msgid "%(gpus)s is on this machine and nothing could read how much of it is free, so every speed above is a CPU-only speed. `llamafit doctor` says how to fix that."
msgstr "%(gpus)s এই মেশিনে আছে, আর তার কতটা খালি তা কিছুই পড়তে পারেনি, তাই উপরের প্রতিটি গতি কেবল CPU-র গতি। এটি কীভাবে ঠিক করবেন তা `llamafit doctor` বলে।"

msgid "Speeds are for %(working)s tokens of context so every row compares like with like; the context column is the largest each one holds. Sized and scored for %(use_case)s at %(requested)s tokens."
msgstr "গতিগুলি %(working)s টোকেন context-এর জন্য, যাতে প্রতিটি সারির তুলনা সমানে সমানে হয়; context কলামে প্রতিটি যতটা বড় context ধরে তা থাকে। %(use_case)s-এর জন্য %(requested)s টোকেনে মাপ ও নম্বর করা হয়েছে।"

msgid "Speeds are for %(working)s tokens of context so every row compares like with like; the context column is the largest each one holds. Sized for %(planned)s tokens and scored for %(use_case)s against %(requested)s."
msgstr "গতিগুলি %(working)s টোকেন context-এর জন্য, যাতে প্রতিটি সারির তুলনা সমানে সমানে হয়; context কলামে প্রতিটি যতটা বড় context ধরে তা থাকে। মাপ %(planned)s টোকেনের জন্য, আর নম্বর %(use_case)s-এর জন্য %(requested)s-এর সাপেক্ষে।"

msgid "Weights: %(weights)s."
msgstr "ওজন: %(weights)s।"

msgid "Computed with %(ram_free)s of %(ram_total)s system memory free, no card."
msgstr "%(ram_total)s সিস্টেম মেমরির মধ্যে %(ram_free)s খালি ধরে হিসাব করা, কোনো কার্ড নেই।"

msgid "Computed with %(ram_free)s of %(ram_total)s system memory free and %(vram_free)s of %(vram_total)s free on the %(gpu)s."
msgstr "%(ram_total)s সিস্টেম মেমরির মধ্যে %(ram_free)s খালি এবং %(gpu)s-এ %(vram_total)s-এর মধ্যে %(vram_free)s খালি ধরে হিসাব করা।"

msgid "Every speed above is derived from %(bandwidth)s of memory bandwidth."
msgstr "উপরের প্রতিটি গতি %(bandwidth)s মেমরি ব্যান্ডউইথ থেকে বার করা।"

msgid "That bandwidth was kept from an earlier run on this machine; `llamafit system --refresh-bandwidth` times it again."
msgstr "ওই ব্যান্ডউইথ এই মেশিনের আগের কোনো চালানো থেকে রেখে দেওয়া; `llamafit system --refresh-bandwidth` সেটি আবার মাপে।"

msgid "generates fewer than the %(floor)s tokens per second this request asks for; lower --min-tps or choose a smaller model or quantisation"
msgstr "এই অনুরোধ সেকেন্ডে যে %(floor)s টোকেন চায় তার চেয়ে কম তৈরি করে; --min-tps কমান বা ছোট কোনো মডেল বা quantisation বেছে নিন"

msgid "generates fewer than the %(floor)s tokens per second a person reads at: a batch tool on this machine and not one to sit in front of; a smaller model or quantisation would keep up"
msgstr "একজন মানুষ সেকেন্ডে যে %(floor)s টোকেন পড়ে তার চেয়ে কম তৈরি করে: এই মেশিনে এটি batch-এর যন্ত্র, সামনে বসে ব্যবহারের নয়; ছোট কোনো মডেল বা quantisation তাল মেলাতে পারত"

msgid "%(tps)s tok/s"
msgstr "%(tps)s tok/s"

