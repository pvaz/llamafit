msgstr[1] "ক্যাটালগে %(files)s-এর কোনো checksum নেই।"

msgid "%(model)s %(quant)s is already here; nothing to do."
msgstr "%(model)s %(quant)s আগে থেকেই এখানে আছে; কিছু করার নেই।"

