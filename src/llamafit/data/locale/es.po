msgid "Show what this machine has: CPU, memory, GPUs, disks and llama.cpp."
msgstr "Muestra lo que tiene esta máquina: CPU, memoria, GPU, discos y llama.cpp."

msgid "Skip the RAM bandwidth measurement."
msgstr "Omite la medición del ancho de banda de la RAM."

msgid "Command: %(command)s"
msgstr "Comando: %(command)s"

msgid "truncated GGUF header: wanted %(wanted)d bytes at offset %(offset)d, got %(got)d"
msgstr "cabecera GGUF truncada: esperaba %(wanted)d bytes en la posición %(offset)d y obtuvo %(got)d"

msgid "The file may still be downloading, or the URL may not be a GGUF file."
msgstr "El archivo puede seguir descargándose, o la URL puede no ser un archivo GGUF."

msgid "unknown GGUF value type %(type)d at offset %(offset)d"
msgstr "tipo de valor GGUF desconocido %(type)d en la posición %(offset)d"

msgid "This file may use a newer GGUF metadata type than LlamaFit supports."
msgstr "Este archivo puede usar un tipo de metadatos GGUF más reciente de los que admite LlamaFit."

msgid "not a GGUF file: bad magic %(magic)s at offset 0"
msgstr "no es un archivo GGUF: firma no válida %(magic)s en la posición 0"

msgid "Check that this file is actually a .gguf model."
msgstr "Compruebe que este archivo es realmente un modelo .gguf."

msgid "unsupported GGUF version %(version)d at offset 4"
msgstr "versión de GGUF no admitida %(version)d en la posición 4"

msgid "LlamaFit supports GGUF versions %(versions)s."
msgstr "LlamaFit admite las versiones de GGUF %(versions)s."

msgid "these GGUF files are not one split model: they disagree about '%(key)s', declaring %(values)s"
msgstr "estos archivos GGUF no son un solo modelo dividido: discrepan en '%(key)s' y declaran %(values)s"

msgid "Pass the shards of one model, not of several."
msgstr "Indique los fragmentos de un solo modelo, no de varios."

msgid "no GGUF header to read facts from"
msgstr "no hay ninguna cabecera GGUF de la que leer los datos"

msgid "Pass the model's file, or every shard of a split model."
msgstr "Indique el archivo del modelo, o todos los fragmentos de un modelo dividido."

msgid "%(count)d of %(total)d GGUF files carry no '%(key)s' key, so their place in a split model cannot be established"
msgstr "%(count)d de %(total)d archivos GGUF no llevan la clave '%(key)s', así que no se puede determinar su lugar en un modelo dividido"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "Indique un único archivo sin dividir por sí solo, o todos los fragmentos de un mismo modelo dividido."

msgid "incomplete shard set: the model declares %(declared)d shards and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "conjunto de fragmentos incompleto: el modelo declara %(declared)d fragmentos y han llegado %(arrived)d (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "Indique todos los fragmentos del modelo dividido."

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "falta el fragmento que contiene los metadatos del modelo: se obtuvo %(key)s %(numbers)s y se esperaba que uno de ellos fuera 0"

msgid "Pass every shard of the split model, including the first."
msgstr "Indique todos los fragmentos del modelo dividido, incluido el primero."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "conjunto de fragmentos incompleto: se esperaba %(key)s de 0 a %(last)d y se obtuvo %(numbers)s"

msgid "Pass each shard of the split model exactly once."
msgstr "Indique cada fragmento del modelo dividido exactamente una vez."

msgid "incomplete shard set: the model declares %(declared)d tensors and its %(shards)d shards hold %(held)d between them"
msgstr "conjunto de fragmentos incompleto: el modelo declara %(declared)d tensores y sus %(shards)d fragmentos contienen %(held)d entre todos"

msgid "could not read %(path)s: %(error)s"
msgstr "no se pudo leer %(path)s: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "Compruebe que el archivo existe y se puede leer."

msgid "could not fetch %(url)s: %(error)s"
msgstr "no se pudo obtener %(url)s: %(error)s"

msgid "Check your network connection and that the URL is reachable."
msgstr "Compruebe su conexión de red y que la URL es accesible."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s devolvió HTTP %(status)d en lugar de 206 Partial Content; puede que el servidor no admita peticiones por rangos."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Confirme que la URL apunta a un archivo GGUF descargable."

