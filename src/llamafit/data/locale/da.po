msgid "Show what this machine has: CPU, memory, GPUs, disks and llama.cpp."
msgstr "Viser, hvad denne maskine har: CPU, hukommelse, GPU'er, diske og llama.cpp."

msgid "Skip the RAM bandwidth measurement."
msgstr "Springer målingen af RAM-båndbredden over."

msgid "Command: %(command)s"
msgstr "Kommando: %(command)s"

msgid "truncated GGUF header: wanted %(wanted)d bytes at offset %(offset)d, got %(got)d"
msgstr "afkortet GGUF-header: ventede %(wanted)d byte på position %(offset)d, fik %(got)d"

msgid "The file may still be downloading, or the URL may not be a GGUF file."
msgstr "Filen hentes måske stadig, eller adressen peger ikke på en GGUF-fil."

msgid "unknown GGUF value type %(type)d at offset %(offset)d"
msgstr "ukendt GGUF-værditype %(type)d på position %(offset)d"

msgid "This file may use a newer GGUF metadata type than LlamaFit supports."
msgstr "Filen bruger måske en nyere GGUF-metadatatype, end LlamaFit understøtter."

msgid "not a GGUF file: bad magic %(magic)s at offset 0"
msgstr "ikke en GGUF-fil: forkert signatur %(magic)s på position 0"

msgid "Check that this file is actually a .gguf model."
msgstr "Kontrollér, at filen virkelig er en .gguf-model."

msgid "unsupported GGUF version %(version)d at offset 4"
msgstr "GGUF-version %(version)d understøttes ikke, på position 4"

msgid "LlamaFit supports GGUF versions %(versions)s."
msgstr "LlamaFit understøtter GGUF-versionerne %(versions)s."

msgid "these GGUF files are not one split model: they disagree about '%(key)s', declaring %(values)s"
msgstr "disse GGUF-filer er ikke én opdelt model: de er uenige om '%(key)s' og angiver %(values)s"

# "Shard" is the word Danish developers use for a piece of a split model; the literal
# "skår" would read as a piece of broken glass.
msgid "Pass the shards of one model, not of several."
msgstr "Angiv shards fra én model, ikke fra flere."

msgid "no GGUF header to read facts from"
msgstr "ingen GGUF-header at læse fakta fra"

msgid "Pass the model's file, or every shard of a split model."
msgstr "Angiv modellens fil, eller hver shard i en opdelt model."

msgid "%(count)d of %(total)d GGUF files carry no '%(key)s' key, so their place in a split model cannot be established"
msgstr "%(count)d af %(total)d GGUF-filer mangler nøglen '%(key)s', så deres plads i en opdelt model kan ikke fastslås"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "Angiv enten én ikke-opdelt fil for sig, eller hver shard i én opdelt model."

msgid "incomplete shard set: the model declares %(declared)d shards and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "ufuldstændigt sæt shards: modellen angiver %(declared)d shards, og %(arrived)d nåede frem (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "Angiv hver shard i den opdelte model."

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "den shard, der bærer modellens metadata, mangler: fik %(key)s %(numbers)s, ventede at én af dem var 0"

msgid "Pass every shard of the split model, including the first."
msgstr "Angiv hver shard i den opdelte model, også den første."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "ufuldstændigt sæt shards: ventede %(key)s 0 til %(last)d, fik %(numbers)s"

msgid "Pass each shard of the split model exactly once."
msgstr "Angiv hver shard i den opdelte model præcis én gang."

msgid "incomplete shard set: the model declares %(declared)d tensors and its %(shards)d shards hold %(held)d between them"
msgstr "ufuldstændigt sæt shards: modellen angiver %(declared)d tensorer, og dens %(shards)d shards rummer %(held)d tilsammen"

msgid "could not read %(path)s: %(error)s"
msgstr "kunne ikke læse %(path)s: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "Kontrollér, at filen findes og kan læses."

msgid "could not fetch %(url)s: %(error)s"
msgstr "kunne ikke hente %(url)s: %(error)s"

msgid "Check your network connection and that the URL is reachable."
msgstr "Kontrollér din netværksforbindelse, og at adressen kan nås."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s svarede HTTP %(status)d i stedet for 206 Partial Content; serveren understøtter måske ikke range-forespørgsler."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Bekræft, at adressen peger på en GGUF-fil, der kan hentes."

