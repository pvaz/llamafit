msgstr "%(url)s begrænser hastigheden på denne hentning (HTTP %(status)d)."

msgid "Check your network connection and run the command again to resume."
msgstr "Kontrollér din netværksforbindelse, og kør kommandoen igen for at fortsætte."

msgid "%(file)s needs authorisation (HTTP %(status)d)."
msgstr "%(file)s kræver godkendelse (HTTP %(status)d)."

msgid "This repository is gated. Accept its terms on Hugging Face and set HF_TOKEN to a token that can read it."
msgstr "Dette repositorie er lukket. Accepter dets betingelser på Hugging Face, og sæt HF_TOKEN til et token, der må læse det."

msgid "%(file)s is not at %(url)s any more (HTTP 404)."
msgstr "%(file)s ligger ikke på %(url)s længere (HTTP 404)."

msgid "Run `llamafit catalog refresh` to pick up the repository's current files."
msgstr "Kør `llamafit catalog refresh` for at hente repositoriets nuværende filer."

msgid "%(url)s returned HTTP %(status)d."
msgstr "%(url)s svarede HTTP %(status)d."

msgid "Confirm the URL points at a downloadable file."
msgstr "Bekræft, at adressen peger på en fil, der kan hentes."

msgid "%(url)s did not say how big %(file)s is."
msgstr "%(url)s sagde ikke, hvor stor %(file)s er."

msgid "%(file)s is %(actual)s on the server but the catalog says %(expected)s; the repository has been re-uploaded since the catalog was refreshed."
msgstr "%(file)s er %(actual)s på serveren, men kataloget siger %(expected)s; repositoriet er blevet lagt op igen, siden kataloget blev opdateret."

msgid "Run `llamafit catalog refresh` and try again."
msgstr "Kør `llamafit catalog refresh`, og prøv igen."

msgid "%(file)s: the server sent %(actual)d bytes of a %(expected)d byte range."
msgstr "%(file)s: serveren sendte %(actual)d bytes af et interval på %(expected)d bytes."

msgid "Run the command again; the parts that did arrive are kept."
msgstr "Kør kommandoen igen; de dele, der nåede frem, beholdes."

msgid "Stopped."
msgstr "Stoppet."

msgid "%(file)s: the server asked for fewer connections; using %(count)d."
msgstr "%(file)s: serveren bad om færre forbindelser; bruger %(count)d."

msgid "%(file)s: this server will not serve byte ranges; fetching it in one stream."
msgstr "%(file)s: denne server vil ikke levere byte-intervaller; henter den i én strøm."

msgid "%(file)s does not match its checksum; fetching it again."
msgstr "%(file)s passer ikke med sin kontrolsum; henter den igen."

msgid "Check that the download directory is writable."
msgstr "Kontrollér, at der kan skrives til mappen til hentede filer."

msgid "%(needed)s is needed for this model but %(path)s has only %(free)s free, %(short)s short of what is wanted with %(headroom)s left spare."
msgstr "Der kræves %(needed)s til denne model, men %(path)s har kun %(free)s ledig, %(short)s for lidt i forhold til det ønskede med %(headroom)s til overs."

msgid "Free some space, or choose another directory with --dir, or a smaller quantisation with --quant."
msgstr "Frigør noget plads, eller vælg en anden mappe med --dir, eller en mindre kvantisering med --quant."

msgid "could not measure the free space on %(path)s: %(error)s"
msgstr "kunne ikke måle den ledige plads på %(path)s: %(error)s"

msgid "Check that the download directory's volume is available."
msgstr "Kontrollér, at drevet med mappen til hentede filer er tilgængeligt."

msgid "%(model)s has no downloadable source in the catalog."
msgstr "%(model)s har ingen kilde i kataloget, der kan hentes."

msgid "Only Hugging Face sources can be installed; this entry has none."
msgstr "Kun kilder fra Hugging Face kan installeres; denne post har ingen."

msgid "the catalog has no file list for %(model)s %(quant)s."
msgstr "kataloget har ingen filliste for %(model)s %(quant)s."

msgid "Run `llamafit catalog refresh` to fill in the file names."
msgstr "Kør `llamafit catalog refresh` for at udfylde filnavnene."

msgid "%(model)s publishes no quantisations."
msgstr "%(model)s udgiver ingen kvantiseringer."

msgid "%(model)s does not publish a %(quant)s quantisation."
msgstr "%(model)s udgiver ikke en %(quant)s-kvantisering."

msgid "It publishes: %(quants)s"
msgstr "Den udgiver: %(quants)s"

msgid "the catalog does not record how big %(quant)s is."
msgstr "kataloget noterer ikke, hvor stor %(quant)s er."

msgid "Run `llamafit catalog refresh` to fill in the sizes."
msgstr "Kør `llamafit catalog refresh` for at udfylde størrelserne."

msgid "the catalog holds no checksum for %(files)s."
msgid_plural "the catalog holds no checksums for %(files)s."
msgstr[0] "kataloget har ingen kontrolsum for %(files)s."
msgstr[1] "kataloget har ingen kontrolsummer for %(files)s."

msgid "Run `llamafit catalog refresh` to fetch them, or pass --allow-unverified to download anyway and check the files yourself."
msgstr "Kør `llamafit catalog refresh` for at hente dem, eller angiv --allow-unverified for at hente alligevel og selv kontrollere filerne."

msgid "%(done)s of %(total)s"
msgstr "%(done)s af %(total)s"

msgid "%(rate)s/s"
msgstr "%(rate)s/s"

msgid "Fetching %(file)s (%(size)s)"
msgstr "Henter %(file)s (%(size)s)"

msgid "Checking %(file)s against its checksum"
msgstr "Kontrollerer %(file)s mod dens kontrolsum"

msgid "Done: %(file)s"
msgstr "Færdig: %(file)s"

msgid "could not create %(path)s: %(error)s"
msgstr "kunne ikke oprette %(path)s: %(error)s"

msgid "Check that the download directory is writable and has room."
msgstr "Kontrollér, at der kan skrives til mappen til hentede filer, og at der er plads."

msgid "could not move %(source)s into place: %(error)s"
msgstr "kunne ikke flytte %(source)s på plads: %(error)s"

msgid "could not record progress in %(path)s: %(error)s"
msgstr "kunne ikke notere fremdriften i %(path)s: %(error)s"

msgid "could not fetch %(url)s: %(error)s"
msgstr "kunne ikke hente %(url)s: %(error)s"

msgid "Stopped before the checksum was finished."
msgstr "Stoppet, før kontrolsummen var færdig."

msgid "could not read %(path)s: %(error)s"
msgstr "kunne ikke læse %(path)s: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "Kontrollér, at filen findes og kan læses."

msgid "%(file)s is %(actual)d bytes, but the catalog says %(expected)d"
msgstr "%(file)s er %(actual)d bytes, men kataloget siger %(expected)d"

msgid "The transfer was cut short. Run the command again to fetch it properly."
msgstr "Overførslen blev afbrudt. Kør kommandoen igen for at hente den ordentligt."

msgid "%(file)s does not match the checksum the catalog holds."
msgstr "%(file)s passer ikke med den kontrolsum, kataloget har."

msgid "Expected %(expected)s but the file hashes to %(actual)s. The bad copy has been deleted; run the command again to fetch it."
msgstr "Forventede %(expected)s, men filen hasher til %(actual)s. Den dårlige kopi er slettet; kør kommandoen igen for at hente den."

msgid "Command: %(command)s"
msgstr "Kommando: %(command)s"

msgid "truncated GGUF header: wanted %(wanted)d byte at offset %(offset)d, got %(got)d"
msgid_plural "truncated GGUF header: wanted %(wanted)d bytes at offset %(offset)d, got %(got)d"
msgstr[0] "afkortet GGUF-header: ville have %(wanted)d byte på position %(offset)d, fik %(got)d"
msgstr[1] "afkortet GGUF-header: ville have %(wanted)d bytes på position %(offset)d, fik %(got)d"

msgid "The file may still be downloading, or the URL may not be a GGUF file."
msgstr "Filen hentes måske stadig, eller adressen peger ikke på en GGUF-fil."

msgid "unknown GGUF value type %(type)d at offset %(offset)d"
msgstr "ukendt GGUF-værditype %(type)d på position %(offset)d"

msgid "This file may use a newer GGUF metadata type than LlamaFit supports."
msgstr "Filen bruger måske en nyere GGUF-metadatatype, end LlamaFit understøtter."

msgid "not a GGUF file: bad magic %(magic)s at offset 0"
msgstr "ikke en GGUF-fil: forkert signatur %(magic)s på position 0"

msgid "Check that this file is actually a .gguf model."
msgstr "Kontrollér, at filen virkelig er en .gguf-model."

msgid "unsupported GGUF version %(version)d at offset 4"
msgstr "GGUF-version %(version)d understøttes ikke, på position 4"

msgid "LlamaFit supports GGUF versions %(versions)s."
msgstr "LlamaFit understøtter GGUF-versionerne %(versions)s."

msgid "A memory budget built without these tensors would be too small, so none is built. If llama.cpp loads the file, LlamaFit's tensor-size table is missing the type."
msgstr "Et hukommelsesbudget bygget uden disse tensorer ville være for lille, så der bygges ingen. Hvis llama.cpp indlæser filen, mangler typen i LlamaFits tabel over tensorstørrelser."

msgid "%(type)d (%(count)d tensor, first %(name)s)"
msgid_plural "%(type)d (%(count)d tensors, first %(name)s)"
msgstr[0] "%(type)d (%(count)d tensor, første %(name)s)"
msgstr[1] "%(type)d (%(count)d tensorer, første %(name)s)"

msgid "cannot size this GGUF file: %(count)d tensor uses a GGML type LlamaFit does not know: %(details)s"
msgid_plural "cannot size this GGUF file: %(count)d tensors use GGML types LlamaFit does not know: %(details)s"
msgstr[0] "kan ikke dimensionere denne GGUF-fil: %(count)d tensor bruger en GGML-type, LlamaFit ikke kender: %(details)s"
msgstr[1] "kan ikke dimensionere denne GGUF-fil: %(count)d tensorer bruger GGML-typer, LlamaFit ikke kender: %(details)s"

msgid "%(count)d shard"
msgid_plural "%(count)d shards"
msgstr[0] "%(count)d shard"
msgstr[1] "%(count)d shards"

msgid "these GGUF files are not one split model: they disagree about '%(key)s', declaring %(values)s"
msgstr "disse GGUF-filer er ikke én opdelt model: de er uenige om '%(key)s' og angiver %(values)s"

# "Shard" is the word Danish developers use for a piece of a split model; the literal
# "skår" would read as a piece of broken glass.
msgid "Pass the shards of one model, not of several."
msgstr "Angiv shards fra én model, ikke fra flere."

msgid "no GGUF header to read facts from"
msgstr "ingen GGUF-header at læse fakta fra"

msgid "Pass the model's file, or every shard of a split model."
msgstr "Angiv modellens fil, eller hver shard i en opdelt model."

msgid "%(count)d GGUF file of the %(total)d given carries no '%(key)s' key, so its place in a split model cannot be established"
msgid_plural "%(count)d GGUF files of the %(total)d given carry no '%(key)s' key, so their place in a split model cannot be established"
msgstr[0] "%(count)d GGUF-fil ud af de %(total)d angivne bærer ingen '%(key)s'-nøgle, så dens plads i en opdelt model kan ikke fastslås"
msgstr[1] "%(count)d GGUF-filer ud af de %(total)d angivne bærer ingen '%(key)s'-nøgle, så deres plads i en opdelt model kan ikke fastslås"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "Angiv enten én ikke-opdelt fil for sig, eller hver shard i én opdelt model."

msgid "incomplete shard set: the model declares %(shards)s and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "ufuldstændigt sæt shards: modellen angiver %(shards)s, og %(arrived)d nåede frem (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "Angiv hver shard i den opdelte model."

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "den shard, der bærer modellens metadata, mangler: fik %(key)s %(numbers)s, ventede at én af dem var 0"

msgid "Pass every shard of the split model, including the first."
msgstr "Angiv hver shard i den opdelte model, også den første."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "ufuldstændigt sæt shards: ventede %(key)s 0 til %(last)d, fik %(numbers)s"

msgid "Pass each shard of the split model exactly once."
msgstr "Angiv hver shard i den opdelte model præcis én gang."

msgid "incomplete shard set: the model declares %(tensors)s and its %(shards)s hold %(held)d between them"
msgstr "ufuldstændigt sæt shards: modellen angiver %(tensors)s, og dens %(shards)s rummer %(held)d tilsammen"

msgid "%(count)d tensor"
msgid_plural "%(count)d tensors"
msgstr[0] "%(count)d tensor"
msgstr[1] "%(count)d tensorer"

msgid "Check your network connection and that the URL is reachable."
msgstr "Kontrollér din netværksforbindelse, og at adressen kan nås."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s svarede HTTP %(status)d i stedet for 206 Partial Content; serveren understøtter måske ikke range-forespørgsler."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Bekræft, at adressen peger på en GGUF-fil, der kan hentes."

msgctxt "CPU model"
msgid "unknown"
msgstr "ukendt"

msgid "nvidia-smi returned no GPUs"
msgstr "nvidia-smi gav ingen GPU'er"

msgid "rocm-smi returned no cards"
msgstr "rocm-smi gav ingen kort"

msgid "system_profiler returned no displays"
msgstr "system_profiler gav ingen skærme"

msgid "WMI returned no video controllers"
msgstr "WMI gav ingen skærmcontrollere"

msgid "lspci found no display controllers"
msgstr "lspci fandt ingen skærmcontrollere"

msgid "vulkaninfo reported no discrete device with a memory heap"
msgstr "vulkaninfo meldte ingen diskret enhed med en hukommelsesheap"

msgid "no populated memory modules"
msgstr "ingen bestykkede hukommelsesmoduler"

msgid "no SPMemoryDataType"
msgstr "ingen SPMemoryDataType"

msgid "%(program)s: timed out after %(seconds)s second"
msgid_plural "%(program)s: timed out after %(seconds)s seconds"
msgstr[0] "%(program)s: fik timeout efter %(seconds)s sekund"
msgstr[1] "%(program)s: fik timeout efter %(seconds)s sekunder"

msgid "empty command"
msgstr "tom kommando"

msgid "%(program)s: %(error)s"
msgstr "%(program)s: %(error)s"

msgid "%(program)s: not found"
msgstr "%(program)s: ikke fundet"

msgid "exit code %(code)d: %(detail)s"
msgstr "afslutningskode %(code)d: %(detail)s"

msgid "no hardware profile file at %(path)s"
msgstr "ingen hardwareprofilfil på %(path)s"

msgid "Run `llamafit hardware list` to see the profiles LlamaFit has."
msgstr "Kør `llamafit hardware list` for at se de profiler, LlamaFit har."

msgid "%(path)s is not a valid hardware profile: %(details)s"
msgstr "%(path)s er ikke en gyldig hardwareprofil: %(details)s"

msgid "Run `llamafit hardware validate FILE` for the whole list."
msgstr "Kør `llamafit hardware validate FIL` for hele listen."

msgid "no hardware profile named %(name)s"
msgstr "ingen hardwareprofil ved navn %(name)s"

msgid "Profiles LlamaFit has: %(names)s"
msgstr "Profiler, LlamaFit har: %(names)s"

msgid "Run `llamafit hardware path` to see where your own profiles go."
msgstr "Kør `llamafit hardware path` for at se, hvor dine egne profiler skal ligge."

msgid "this machine has no graphics card, so there is no VRAM to override"
msgstr "denne maskine har intet grafikkort, så der er ingen VRAM at tilsidesætte"

msgid "Describe the whole machine in a hardware profile and pass --profile."
msgstr "Beskriv hele maskinen i en hardwareprofil, og angiv --profile."

msgid "this machine has one memory pool shared with the graphics card"
msgstr "denne maskine har én hukommelsespulje, der deles med grafikkortet"

msgid "Use --ram to resize the pool; --memory would change only half of it."
msgstr "Brug --ram til at ændre puljens størrelse; --memory ville kun ændre halvdelen af den."

msgid "%(option)s needs a value above zero"
msgstr "%(option)s skal have en værdi over nul"

msgid "no build number in the version output: %(text)s"
msgstr "intet buildnummer i versionsudskriften: %(text)s"

msgid "llama.cpp not found: no llama-server on PATH, in LLAMA_CPP_PATH or in the usual directories"
msgstr "llama.cpp blev ikke fundet: ingen llama-server i PATH, i LLAMA_CPP_PATH eller i de sædvanlige mapper"

msgid "no ggml backend libraries found next to llama-server; the build may be static"
msgstr "fandt ingen ggml-backend-biblioteker ved siden af llama-server; buildet er måske statisk"

msgid "%(path)s is a file, not a directory."
msgstr "%(path)s er en fil, ikke en mappe."

msgid "%(path)s cannot be read: %(error)s"
msgstr "%(path)s kan ikke læses: %(error)s"

msgid "%(path)s has a marker file that cannot be read."
msgstr "%(path)s har en markørfil, der ikke kan læses."

msgid "%(path)s already holds %(count)d file that LlamaFit did not install."
msgid_plural "%(path)s already holds %(count)d files that LlamaFit did not install."
msgstr[0] "%(path)s indeholder allerede %(count)d fil, som LlamaFit ikke har installeret."
msgstr[1] "%(path)s indeholder allerede %(count)d filer, som LlamaFit ikke har installeret."

msgid "%(name)s has no published checksum, so it cannot be verified."
msgstr "%(name)s har ingen udgivet kontrolsum og kan derfor ikke verificeres."

msgid "Pass --allow-unverified to install it anyway, knowing the archive is unchecked."
msgstr "Angiv --allow-unverified for at installere den alligevel, vel vidende at arkivet er ukontrolleret."

msgid "could not download %(url)s: %(error)s"
msgstr "kunne ikke hente %(url)s: %(error)s"

msgid "the connection was closed"
msgstr "forbindelsen blev lukket"

msgid "Run the command again; it continues from where it stopped."
msgstr "Kør kommandoen igen; den fortsætter, hvor den stoppede."

msgid "the download of %(url)s stopped early: %(error)s"
msgstr "hentningen af %(url)s stoppede for tidligt: %(error)s"

msgid "%(got)s of %(want)s arrived"
msgstr "%(got)s af %(want)s nåede frem"

msgid "the disk holding %(path)s is full."
msgstr "disken med %(path)s er fuld."

msgid "Free some space and run the command again; the download resumes."
msgstr "Frigør noget plads, og kør kommandoen igen; hentningen fortsætter."

msgid "Check that the directory exists and is writable."
msgstr "Kontrollér, at mappen findes, og at der kan skrives til den."

msgid "%(name)s did not match its published checksum and was discarded."
msgstr "%(name)s passede ikke med sin udgivne kontrolsum og blev kasseret."

msgid "Nothing was unpacked. Run the command again: the archive arrived damaged, which a second download usually fixes."
msgstr "Intet blev pakket ud. Kør kommandoen igen: arkivet kom beskadiget frem, hvilket en ny hentning som regel retter."

msgid "%(archive)s contains %(name)s, which would be written outside the install directory."
msgstr "%(archive)s indeholder %(name)s, som ville blive skrevet uden for installationsmappen."

msgid "Do not install this archive; report it to the llama.cpp project."
msgstr "Installér ikke dette arkiv; meld det til llama.cpp-projektet."

msgid "%(name)s is not an archive LlamaFit knows how to unpack."
msgstr "%(name)s er ikke et arkiv, LlamaFit ved, hvordan man pakker ud."

msgid "%(name)s could not be unpacked: %(error)s"
msgstr "%(name)s kunne ikke pakkes ud: %(error)s"

msgid "Delete it and run the command again to download it afresh."
msgstr "Slet den, og kør kommandoen igen for at hente den forfra."

msgid "the archive holds no %(name)s."
msgstr "arkivet indeholder ingen %(name)s."

msgid "Report this; the release layout has changed."
msgstr "Meld dette; udgivelsens opbygning er ændret."

msgid "%(path)s was not installed by LlamaFit."
msgstr "%(path)s blev ikke installeret af LlamaFit."

msgid "Pass --force to replace it, or --dir to install somewhere else. LlamaFit never overwrites an installation it did not create."
msgstr "Angiv --force for at erstatte den, eller --dir for at installere et andet sted. LlamaFit overskriver aldrig en installation, den ikke selv har oprettet."

msgid "%(path)s has %(free)s free; this install needs %(needed)s."
msgstr "%(path)s har %(free)s ledig; denne installation kræver %(needed)s."

msgid "Free some space, or pass --dir to install on another volume."
msgstr "Frigør noget plads, eller angiv --dir for at installere på et andet drev."

msgid "the %(backend)s libraries are not in the installed directory."
msgstr "%(backend)s-bibliotekerne ligger ikke i den installerede mappe."

msgid "no ggml backend libraries were installed; the build may be a static one."
msgstr "der blev ikke installeret nogen ggml-backend-biblioteker; buildet er måske statisk."

msgid "Your PATH could not be read, so it will not be changed."
msgstr "Din PATH kunne ikke læses, så den bliver ikke ændret."

msgid "Add %(path)s to your user PATH (HKCU\\Environment)."
msgstr "Føj %(path)s til din bruger-PATH (HKCU\\Environment)."

msgid "To undo: run `setx PATH \"%(previous)s\"`, or remove the entry in System > About > Advanced system settings > Environment Variables."
msgstr "Sådan fortrydes det: kør `setx PATH \"%(previous)s\"`, eller fjern posten i System > Om > Avancerede systemindstillinger > Miljøvariabler."

msgid "%(path)s is already on your PATH."
msgstr "%(path)s står allerede i din PATH."

msgid "Nothing to undo."
msgstr "Intet at fortryde."

msgid "Append a PATH line for %(path)s to %(file)s."
msgstr "Føj en PATH-linje for %(path)s til %(file)s."

msgid "To undo: delete the two lines marked `%(mark)s` from %(file)s."
msgstr "Sådan fortrydes det: slet de to linjer mærket `%(mark)s` fra %(file)s."

msgid "your PATH could not be changed: %(error)s"
msgstr "din PATH kunne ikke ændres: %(error)s"

msgid "To remove it later, delete %(path)s."
msgstr "For at fjerne den senere: slet %(path)s."

msgid "the most recent %(count)d llama.cpp releases hold no build."
msgstr "de %(count)d nyeste llama.cpp-udgivelser indeholder intet build."

msgid "Name one with `llamafit install llama.cpp --tag ...`."
msgstr "Nævn en med `llamafit install llama.cpp --tag ...`."

msgid "could not reach GitHub at %(url)s: %(error)s"
msgstr "kunne ikke nå GitHub på %(url)s: %(error)s"

msgid "GitHub refused the request for %(url)s: the rate limit is exhausted."
msgstr "GitHub afviste forespørgslen om %(url)s: hastighedsgrænsen er opbrugt."

msgid "Wait for the limit to reset, or set GITHUB_TOKEN to a personal access token with no scopes."
msgstr "Vent på, at grænsen nulstilles, eller sæt GITHUB_TOKEN til et personligt adgangstoken uden scopes."

msgid "GitHub has no release at %(url)s."
msgstr "GitHub har ingen udgivelse på %(url)s."

msgid "Check the tag with `llamafit install llama.cpp --tag ...`."
msgstr "Kontrollér mærket med `llamafit install llama.cpp --tag ...`."

msgid "GitHub returned %(status)d for %(url)s."
msgstr "GitHub svarede %(status)d for %(url)s."

msgid "GitHub's answer for %(url)s was not JSON."
msgstr "GitHubs svar for %(url)s var ikke JSON."

msgid "GitHub's answer did not describe a release."
msgstr "GitHubs svar beskrev ikke en udgivelse."

msgid "no llama-server answering"
msgstr "ingen llama-server svarer"

msgid "unexpected response: %(error)s"
msgstr "uventet svar: %(error)s"

msgid "%(model)s holds %(native)s tokens, fewer than the %(minimum)s asked for."
msgstr "%(model)s rummer %(native)s tokens, færre end de %(minimum)s, der blev bedt om."

msgid "No configuration of this model fits this machine."
msgstr "Ingen konfiguration af denne model er der plads til på denne maskine."

msgid "Routed experts are held in system memory, and so are the always-on shared experts, which is what -ot ffn_.*_shexp=CPU does; attention and the KV cache stay on the card."
msgstr "De ruterede eksperter holdes i systemhukommelsen, og det gør de altid aktive delte eksperter også, hvilket er det, -ot ffn_.*_shexp=CPU gør; attention og KV-cachen bliver på kortet."

msgid "Routed experts are held in system memory; attention, the KV cache and the shared experts stay on the card."
msgstr "De ruterede eksperter holdes i systemhukommelsen; attention, KV-cachen og de delte eksperter bliver på kortet."

msgid "%(layers)s layers are on the card and the rest run on the processor."
msgstr "%(layers)s lag ligger på kortet, og resten kører på processoren."

msgid "Nothing runs on a graphics card: every weight is in system memory."
msgstr "Intet kører på et grafikkort: hver vægt ligger i systemhukommelsen."

msgid "%(gpus)s is here, but nothing could read how much of it is free, so this plan was made as if it were not. The real machine will be faster than these figures."
msgstr "%(gpus)s sidder her, men intet kunne læse, hvor meget af det der er ledigt, så denne plan blev lagt, som om det ikke var der. Den virkelige maskine bliver hurtigere end disse tal."

msgid "Sized for %(context)s tokens rather than the %(requested)s asked for."
msgstr "Dimensioneret til %(context)s tokens frem for de %(requested)s, der blev bedt om."

msgid "The KV cache is quantised to %(type)s to reach this context."
msgstr "KV-cachen er kvantiseret til %(type)s for at nå denne kontekst."

msgid "Vision is off: the projector did not fit, on the card or in system memory."
msgstr "Billede er slået fra: der var ikke plads til projektoren, hverken på kortet eller i systemhukommelsen."

msgid "The vision projector is in system memory (--no-mmproj-offload), which costs nothing measurable for text and makes images slower."
msgstr "Billedprojektoren ligger i systemhukommelsen (--no-mmproj-offload), hvilket ikke koster noget målbart for tekst og gør billeder langsommere."

msgid "%(threads)s threads, not the %(available)s this processor has: the efficiency cores are left out because generation measures slower with them, and what is left is the threads the performance cores provide."
msgstr "%(threads)s tråde, ikke de %(available)s denne processor har: effektivitetskernerne udelades, fordi genereringen måler langsommere med dem, og det, der er tilbage, er de tråde, ydelseskernerne giver."

msgid "Tight: %(vram)s of the graphics card is free and this needs %(needed)s, so another program can push it over. The context tier table is how a launch script recovers."
msgstr "Trangt: %(vram)s af grafikkortet er ledigt, og dette kræver %(needed)s, så et andet program kan skubbe det over kanten. Tabellen med konteksttrin er den måde, et startscript retter op på det."

msgid "no %(capability)s capability, which %(use_case)s needs; ask for a different use case, or add it to the entry when the model really has it"
msgstr "ingen %(capability)s-egenskab, som %(use_case)s kræver; bed om en anden anvendelse, eller føj den til posten, når modellen virkelig har den"

msgid "no %(capability)s capability; drop it from the request to see this model"
msgstr "ingen %(capability)s-egenskab; drop den fra forespørgslen for at se denne model"

msgid "%(size)s to download, over the %(limit)s this request allows"
msgstr "%(size)s at hente, over de %(limit)s, denne forespørgsel tillader"

msgid "unknown quantisation %(quant)s, so its cost in quality cannot be told"
msgstr "ukendt kvantisering %(quant)s, så dens pris i kvalitet kan ikke opgøres"

msgid "nowhere to put it: no placement fits this machine at any context"
msgstr "ingen steder at lægge den: ingen placering er der plads til på denne maskine ved nogen kontekst"

msgid "holds %(fit)s tokens at most, under the %(minimum)s asked for; lower the minimum context or free memory to see it ranked"
msgstr "rummer højst %(fit)s tokens, under de %(minimum)s, der blev bedt om; sænk minimumskonteksten, eller frigør hukommelse for at se den rangeret"

msgid "generates %(tps)s tokens per second, below the %(floor)s this request asks for; lower --min-tps or choose a smaller model or quantisation"
msgstr "genererer %(tps)s tokens i sekundet, under de %(floor)s, denne forespørgsel beder om; sænk --min-tps, eller vælg en mindre model eller kvantisering"

msgid "generates %(tps)s tokens per second, below the %(floor)s a person reads at: a batch tool on this machine and not one to sit in front of; a smaller model or quantisation would keep up"
msgstr "genererer %(tps)s tokens i sekundet, under de %(floor)s, et menneske læser med: et batchværktøj på denne maskine og ikke et at sidde foran; en mindre model eller kvantisering ville kunne følge med"

msgid "unknown use case %(use_case)s"
msgstr "ukendt anvendelse %(use_case)s"

msgid "Known use cases: %(known)s."
msgstr "Kendte anvendelser: %(known)s."

msgid "unknown score part %(part)s in the weights for %(use_case)s"
msgstr "ukendt scoredel %(part)s i vægtene for %(use_case)s"

msgid "The parts are: %(parts)s."
msgstr "Delene er: %(parts)s."

msgid "the weights for %(use_case)s leave out %(part)s"
msgstr "vægtene for %(use_case)s udelader %(part)s"

msgid "Overriding a use case means giving all four parts: %(parts)s."
msgstr "At tilsidesætte en anvendelse betyder at angive alle fire dele: %(parts)s."

msgid "the weight for %(part)s in %(use_case)s is below zero"
msgstr "vægten for %(part)s i %(use_case)s er under nul"

msgid "A weight says how much a part counts; it cannot count less than none."
msgstr "En vægt siger, hvor meget en del tæller; den kan ikke tælle mindre end intet."

msgid "the weights for %(use_case)s add up to nothing"
msgstr "vægtene for %(use_case)s lægger sammen til intet"

msgid "At least one part has to count for something."
msgstr "Mindst én del skal tælle for noget."

msgid "unknown preference %(prefer)s"
msgstr "ukendt præference %(prefer)s"

msgid "Preferences: %(known)s."
msgstr "Præferencer: %(known)s."

msgid "Install or repair the NVIDIA driver; nvidia-smi ships with it and must be on PATH."
msgstr "Installér eller reparér NVIDIA-driveren; nvidia-smi følger med den og skal ligge i PATH."

msgid "Install ROCm (Linux) to expose AMD VRAM figures; without it the GPU is listed by name only."
msgstr "Installér ROCm (Linux) for at få AMD's VRAM-tal frem; uden ROCm vises GPU'en kun med navn."

msgid "PowerShell could not list video controllers; run from a normal user session."
msgstr "PowerShell kunne ikke vise skærmcontrollerne; kør fra en almindelig brugersession."

msgid "Install pciutils to list GPUs by name when no vendor tool is available."
msgstr "Installér pciutils for at vise GPU'er med navn, når der ikke findes et værktøj fra leverandøren."

msgid "DDR type and speed were not readable; on Linux run once with sudo (dmidecode) or accept the measured bandwidth instead."
msgstr "DDR-type og -hastighed kunne ikke læses; kør én gang med sudo på Linux (dmidecode), eller nøjes med den målte båndbredde i stedet."

msgid "py-cpuinfo failed; the CPU model and instruction sets are unknown."
msgstr "py-cpuinfo mislykkedes; CPU-modellen og instruktionssættene er ukendte."

msgid "psutil could not count the CPU cores; thread choice falls back to one core. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil kunne ikke tælle CPU-kernerne; valget af tråde falder tilbage til én kerne. Installér psutil igen med `pip install --force-reinstall psutil`."

msgid "psutil could not read the memory totals; budgets cannot be computed until this works. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil kunne ikke læse de samlede hukommelsestal; så længe det ikke virker, kan der ikke beregnes budgetter. Installér psutil igen med `pip install --force-reinstall psutil`."

msgid "Could not read performance-core count from sysctl."
msgstr "Antallet af ydelseskerner kunne ikke læses fra sysctl."

msgid "llama-server exists but did not report a version; the binary may be broken."
msgstr "llama-server findes, men oplyste ingen version; programfilen er måske ødelagt."

msgid "system_profiler failed; GPU information is unavailable."
msgstr "system_profiler mislykkedes; der er ingen oplysninger om GPU'en."

msgid "Install the Vulkan tools (vulkan-tools on Linux, the vendor's Vulkan runtime on Windows) so an unsized card's memory can be read from its driver. This probe runs only when no vendor tool sized the card, so it is the last source there is."
msgstr "Installér Vulkan-værktøjerne (vulkan-tools på Linux, leverandørens Vulkan-runtime på Windows), så hukommelsen på et umålt kort kan læses fra dets driver. Denne test kører kun, når intet værktøj fra leverandøren har målt kortet, så den er den sidste kilde, der er."

msgid "No vendor tool reported the GPU's memory size; record the size in a hardware profile so budgets can be computed for this machine."
msgstr "Intet værktøj fra leverandøren oplyste GPU'ens hukommelsesstørrelse; skriv størrelsen ind i en hardwareprofil, så der kan beregnes budgetter for denne maskine."

msgid "llama.cpp installed"
msgstr "llama.cpp installeret"

msgid "build %(build)s at %(path)s, backends: %(backends)s"
msgstr "build %(build)s i %(path)s, backends: %(backends)s"

msgctxt "llama.cpp build"
msgid "unknown"
msgstr "ukendt"

msgid "llama.cpp not found"
msgstr "llama.cpp blev ikke fundet"

msgid "no llama-server binary was found"
msgstr "der blev ikke fundet nogen llama-server-programfil"

msgid "Run `llamafit install llama.cpp`, which picks the right build for this machine, checks it against its published checksum, and never touches an installation LlamaFit did not create."
msgstr "Kør `llamafit install llama.cpp`, som vælger det rigtige build til denne maskine, kontrollerer det mod dets udgivne kontrolsum og aldrig rører en installation, LlamaFit ikke selv har oprettet."

msgid "Memory size unknown"
msgstr "Hukommelsesstørrelsen er ukendt"

msgid "LlamaFit could not read this machine's memory totals, so it cannot work out what will fit."
msgstr "LlamaFit kunne ikke læse de samlede hukommelsestal for denne maskine og kan derfor ikke regne ud, hvad der er plads til."

msgid "%(gpu)s: no %(backend)s backend in llama.cpp"
msgstr "%(gpu)s: ingen %(backend)s-backend i llama.cpp"

msgid "llama.cpp was built with: %(backends)s"
msgstr "llama.cpp blev bygget med: %(backends)s"

msgctxt "backends"
msgid "unknown"
msgstr "ukendte"

msgid "Install a llama.cpp build with the %(backend)s or Vulkan backend to use %(gpu)s."
msgstr "Installér et build af llama.cpp med backend %(backend)s eller Vulkan for at kunne bruge %(gpu)s."

msgid "%(gpu)s: VRAM size unknown"
msgstr "%(gpu)s: VRAM-størrelsen er ukendt"

msgid "the vendor tool that reports memory was not available"
msgstr "værktøjet fra leverandøren, der oplyser hukommelsen, var ikke tilgængeligt"

msgid "%(gpus)s: planned around, not planned on"
msgstr "%(gpus)s: planlagt uden om, ikke planlagt på"

msgid "with no reading of how much of the card is free, every budget and every speed on this machine was computed as if there were no card: they are CPU-only figures, and the real machine will be faster."
msgstr "uden en aflæsning af, hvor meget af kortet der er ledigt, blev hvert budget og hver hastighed på denne maskine regnet ud, som om der ikke var noget kort: det er tal for CPU alene, og den virkelige maskine bliver hurtigere."

msgid "Install the Vulkan tools so the size can be read from the driver, or record it in a hardware profile (`llamafit hardware path` says where those go) and pass --profile."
msgstr "Installér Vulkan-værktøjerne, så størrelsen kan læses fra driveren, eller notér den i en hardwareprofil (`llamafit hardware path` siger, hvor de skal ligge), og angiv --profile."

msgid "No GPU detected"
msgstr "Ingen GPU fundet"

msgid "models will run on the CPU only"
msgstr "modeller kommer kun til at køre på CPU'en"

msgid "If a GPU is present, check that its driver tools are installed."
msgstr "Hvis der er en GPU, så kontrollér, at driverværktøjerne til den er installeret."

msgid "RAM bandwidth assumed"
msgstr "RAM-båndbredden er antaget"

msgid "using %(gbps)s GB/s as a default"
msgstr "%(gbps)s GB/s bruges som standardværdi"

msgid "Install numpy (`pip install llamafit[fast]`) so LlamaFit can measure the RAM bandwidth."
msgstr "Installér numpy (`pip install llamafit[fast]`), så LlamaFit kan måle RAM-båndbredden."

msgid "Probe %(probe)s failed"
msgstr "Testen %(probe)s mislykkedes"

msgctxt "probe error"
msgid "unknown error"
msgstr "ukendt fejl"

msgid "llama-server running at %(url)s"
msgstr "llama-server kører på %(url)s"

msgid "model %(model)s, context %(context)s"
msgstr "model %(model)s, kontekst %(context)s"

msgctxt "model name"
msgid "unknown"
msgstr "ukendt"

msgid "Low disk space on %(path)s"
msgstr "Lidt diskplads på %(path)s"

msgid "%(size)s free"
msgstr "%(size)s ledig"

msgid "Most useful models need 5 to 120 GB; free space or change the downloads directory."
msgstr "De fleste brugbare modeller kræver 5 til 120 GB; frigør plads, eller skift mappen til hentede filer."

msgid "%(model)s has no %(quant)s quantisation"
msgstr "%(model)s har ingen %(quant)s-kvantisering"

msgid "It publishes: %(names)s"
msgstr "Den udgiver: %(names)s"

msgid "licensed %(spdx)s, which this request does not allow"
msgstr "licenseret %(spdx)s, hvilket denne forespørgsel ikke tillader"

msgid "System memory bandwidth was not measured; %(gbps)s GB/s assumed for %(arch)s."
msgstr "Systemhukommelsens båndbredde blev ikke målt; %(gbps)s GB/s antaget for %(arch)s."

msgid "%(gpu)s bandwidth is unknown; the %(backend)s fallback of %(gbps)s GB/s stands in."
msgstr "Båndbredden for %(gpu)s er ukendt; %(backend)s-reserveværdien på %(gbps)s GB/s træder i stedet."

msgid "No graphics card compute figure: prompt processing is estimated on the CPU."
msgstr "Intet tal for grafikkortets regnekraft: promptbehandlingen estimeres på CPU'en."

msgid "%(gb)s GB of routed experts is read from system memory per token at %(eff)s of its %(raw)s GB/s, because each token selects a different handful of experts and the read is a scatter of small blocks rather than a stream."
msgstr "%(gb)s GB ruterede eksperter læses fra systemhukommelsen pr. token ved %(eff)s af dens %(raw)s GB/s, fordi hvert token vælger en ny håndfuld eksperter, og læsningen er en spredning af små blokke frem for en strøm."

msgid "%(gb)s GB of contiguous weights is read from system memory per token at %(eff)s of its %(raw)s GB/s."
msgstr "%(gb)s GB sammenhængende vægte læses fra systemhukommelsen pr. token ved %(eff)s af dens %(raw)s GB/s."

msgid "No active parameter count was supplied; it was inferred from the weight bytes."
msgstr "Der blev ikke angivet noget antal aktive parametre; det blev udledt af vægtenes bytes."

msgid "%(pct)s percent of the layers sit in system memory, so that share of the prompt arithmetic is charged to the CPU at %(tflops)s TFLOP/s rather than to the card. Both rates come from one small dense model on one machine."
msgstr "%(pct)s procent af lagene ligger i systemhukommelsen, så den andel af promptregnestykket henføres til CPU'en ved %(tflops)s TFLOP/s frem for til kortet. Begge rater kommer fra én lille tæt model på én maskine."

msgid "%(gb)s GB of the expert set is streamed across the link once per micro-batch at %(gbps)s GB/s. That rate was fitted on the one model whose expert set does not fit in system memory, so part of its read comes off the disk; an expert set that stays in the page cache streams about three times faster, and for one of those this term is that much too slow."
msgstr "%(gb)s GB af ekspertsættet streames over forbindelsen én gang pr. mikrobatch ved %(gbps)s GB/s. Den rate blev tilpasset på den ene model, hvis ekspertsæt der ikke er plads til i systemhukommelsen, så en del af dens læsning kommer fra disken; et ekspertsæt, der bliver i sidecachen, streamer omkring tre gange hurtigere, og for et sådant er dette led netop så meget for langsomt."

msgid "%(gb)s GB of the expert set is read out of system memory once per micro-batch at %(gbps)s GB/s, because there is no card to stream it to."
msgstr "%(gb)s GB af ekspertsættet læses ud af systemhukommelsen én gang pr. mikrobatch ved %(gbps)s GB/s, fordi der ikke er noget kort at streame det til."

msgid "No placement of this model on this machine could run it."
msgstr "Ingen placering af denne model på denne maskine kunne køre den."

msgid "Generation is a benchmark of this configuration, not a prediction."
msgstr "Genereringen er en måling af denne konfiguration, ikke en forudsigelse."

msgid "Generation is the formula corrected by %(factor)s, from a benchmark of %(profile)s on this machine taken on %(date)s."
msgstr "Genereringen er formlen korrigeret med %(factor)s ud fra en måling af %(profile)s på denne maskine taget den %(date)s."

msgid "Prompt processing is a benchmark of this configuration."
msgstr "Promptbehandlingen er en måling af denne konfiguration."

msgid "Prompt processing is the formula corrected by %(factor)s from a benchmark."
msgstr "Promptbehandlingen er formlen korrigeret med %(factor)s ud fra en måling."

msgid "That benchmark's command line does not record how many layers went to the card, so the correction assumes it ran at this placement."
msgstr "Kommandolinjen for den måling noterer ikke, hvor mange lag der kom på kortet, så korrektionen går ud fra, at den kørte ved denne placering."

msgid "This figure assumes nothing pages: a placement this tight often does, silently."
msgstr "Dette tal går ud fra, at intet swapper: en placering så trang som denne gør det ofte, i stilhed."

