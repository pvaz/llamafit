msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "Hugging Face svarede %(status)d, da fillisten for %(repo)s blev hentet."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Fillisten for %(repo)s kunne ikke læses fra Hugging Face."

msgid "Check your network connection and try again."
msgstr "Kontrollér din netværksforbindelse, og prøv igen."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "Svaret fra Hugging Face for %(repo)s indeholdt ingen filliste."

msgid "Check that the repository id is correct and public."
msgstr "Kontrollér, at repositoriets id er rigtigt, og at repositoriet er offentligt."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "kataloget har %(count)d problem"
msgstr[1] "kataloget har %(count)d problemer"

msgid "Run `llamafit catalog validate` for details."
msgstr "Kør `llamafit catalog validate` for at se detaljerne."

msgid "could not write %(path)s: %(error)s"
msgstr "kunne ikke skrive %(path)s: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "Kontrollér, at mappen kan skrives til og har plads tilbage."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "%(path)s har %(count)d problem og kan ikke opdateres"
msgstr[1] "%(path)s har %(count)d problemer og kan ikke opdateres"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "Kør `llamafit catalog validate`, og ret filen først."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "%(path)s kunne ikke læses helt, så det at opdatere kun %(model)s ville smide oplysninger væk, som filen har om modeller, denne kørsel ikke rører: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "Kør `llamafit catalog refresh` uden --model for at bygge hele filen op igen."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "Find, dimensionér, installér og verificér LLM'er med åbne vægte til llama.cpp på din egen maskine."

msgid "Print machine-readable JSON instead of tables."
msgstr "Skriver maskinlæsbar JSON i stedet for tabeller."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "Skriver detaljerne til llamafit.log i logmappen og viser tracebacks."

msgid "Disable colours."
msgstr "Slår farverne fra."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "Taler dette sprog, for eksempel pt_PT. Et sprog, LlamaFit ikke har, falder tilbage til engelsk, og så oplyses det, hvilke sprog der findes."

msgid "Print the version and exit."
msgstr "Skriver versionen og afslutter."

msgid "Unexpected error: %(error)s"
msgstr "Uventet fejl: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "Kør igen med --verbose for at se hele tracebacken."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "Vedligeholder kataloget: validerer dets filer, opdaterer de foranderlige felter."

msgid "Keep only this use case."
msgstr "Beholder kun denne anvendelse."

msgid "Keep only models with this capability (repeatable)."
msgstr "Beholder kun modeller med denne egenskab (kan gentages)."

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Beholder kun disse licensbetegnelser (kan gentages)."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "Validerer kun denne fil i stedet for det medfølgende katalog og de egne tilpasninger."

msgid "Did you mean: %(ids)s?"
msgstr "Mente du: %(ids)s?"

msgid "Run `llamafit list` to see every model id."
msgstr "Kør `llamafit list` for at se alle model-id'er."

msgid "no model named %(id)s in the catalog"
msgstr "ingen model ved navn %(id)s i kataloget"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "Fandt %(count)d problem i kataloget; kør `llamafit catalog validate` for at se detaljerne."
msgstr[1] "Fandt %(count)d problemer i kataloget; kør `llamafit catalog validate` for at se detaljerne."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "Ingen modeller passede. Prøv et bredere --use-case, --capability, --license, --vendor eller --search."

msgid "invalid --use-case %(value)s"
msgstr "ugyldig --use-case: %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "Gyldige anvendelser: %(values)s"

msgid "invalid --capability value: %(values)s"
msgid_plural "invalid --capability values: %(values)s"
msgstr[0] "ugyldig værdi til --capability: %(values)s"
msgstr[1] "ugyldige værdier til --capability: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "Gyldige egenskaber: %(values)s"

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"Viser modelkataloget, afgrænset af de filtre, der er angivet.\n"
"\n"
"Tabellen viser højst tre egenskaber pr. model plus en markering +N for resten, og den er sorteret efter den viste kolonne Kvalitet; info eller --json har alle egenskaberne."

msgid "Keep only this vendor, case-insensitive."
msgstr "Beholder kun denne leverandør, uden forskel på store og små bogstaver."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "Søger i en del af id, navn, leverandør eller familie, uden forskel på store og små bogstaver."

msgid "Show at most this many."
msgstr "Viser højst så mange."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "Kort form for llamafit list --search TEKST."

msgid "Text to match against id, name, vendor or family."
msgstr "Tekst, der skal søges efter i id, navn, leverandør eller familie."

msgid "Show one model's facts, sources and every quant it publishes."
msgstr "Viser fakta om én model, dens kilder og hver kvantisering, den udgiver."

msgid "A catalog model id."
msgstr "Et model-id fra kataloget."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "Validerer katalogets YAML-filer mod skemaet og skriver én linje pr. problem."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "%(count)d fil kontrolleret, ingen problemer fundet."
msgstr[1] "%(count)d filer kontrolleret, ingen problemer fundet."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "Opdaterer katalogets filnavne, størrelser, kontrolsummer og GGUF-fakta fra Hugging Face."

msgid "Refresh only this model id."
msgstr "Opdaterer kun dette model-id."

msgid "Compute the refresh but write nothing."
msgstr "Beregner opdateringen, men skriver ingenting."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "Afslutter med 1, hvis noget ville blive ændret; ændrer ingenting, til et planlagt CI-job."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: advarsel: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "advarsel: %(warning)s (%(count)d model: %(models)s)"
msgstr[1] "advarsel: %(warning)s (%(count)d modeller: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: fejl: %(error)s"

msgid "Hint: %(hint)s"
msgstr "Tip: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "opdateringen kræver netværksadgang til Hugging Face; kontrollér din forbindelse, og at repositoriets id er rigtigt."

msgid "No changes."
msgstr "Ingen ændringer."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "Skriver den rå katalogpost for én model, som JSON til daglig eller som YAML med --yaml."

msgid "Print YAML instead of JSON."
msgstr "Skriver YAML i stedet for JSON."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "Forklarer, hvad der blev fundet, hvad der gik galt, og hvad der ville give mere."

