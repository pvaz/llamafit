msgid "%(program)s: not found"
msgstr "%(program)s: ikke fundet"

msgid "no output"
msgstr "intet output"

msgid "exit code %(code)d: %(detail)s"
msgstr "afslutningskode %(code)d: %(detail)s"

msgid "llama.cpp not found: no llama-server on PATH, in LLAMA_CPP_PATH or in the usual directories"
msgstr "llama.cpp blev ikke fundet: ingen llama-server i PATH, i LLAMA_CPP_PATH eller i de sædvanlige mapper"

msgid "no ggml backend libraries found next to llama-server; the build may be static"
msgstr "fandt ingen ggml-backend-biblioteker ved siden af llama-server; buildet er måske statisk"

msgid "no llama-server answering"
msgstr "ingen llama-server svarer"

msgid "unexpected response: %(error)s"
msgstr "uventet svar: %(error)s"

msgid "Install or repair the NVIDIA driver; nvidia-smi ships with it and must be on PATH."
msgstr "Installér eller reparér NVIDIA-driveren; nvidia-smi følger med den og skal ligge i PATH."

msgid "Install ROCm (Linux) to expose AMD VRAM figures; without it the GPU is listed by name only."
msgstr "Installér ROCm (Linux) for at få AMD's VRAM-tal frem; uden ROCm vises GPU'en kun med navn."

msgid "PowerShell could not list video controllers; run from a normal user session."
msgstr "PowerShell kunne ikke vise skærmcontrollerne; kør fra en almindelig brugersession."

msgid "Install pciutils to list GPUs by name when no vendor tool is available."
msgstr "Installér pciutils for at vise GPU'er med navn, når der ikke findes et værktøj fra leverandøren."

msgid "DDR type and speed were not readable; on Linux run once with sudo (dmidecode) or accept the measured bandwidth instead."
msgstr "DDR-type og -hastighed kunne ikke læses; kør én gang med sudo på Linux (dmidecode), eller nøjes med den målte båndbredde i stedet."

msgid "py-cpuinfo failed; the CPU model and instruction sets are unknown."
msgstr "py-cpuinfo mislykkedes; CPU-modellen og instruktionssættene er ukendte."

msgid "psutil could not count the CPU cores; thread choice falls back to one core. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil kunne ikke tælle CPU-kernerne; valget af tråde falder tilbage til én kerne. Installér psutil igen med `pip install --force-reinstall psutil`."

msgid "psutil could not read the memory totals; budgets cannot be computed until this works. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil kunne ikke læse de samlede hukommelsestal; så længe det ikke virker, kan der ikke beregnes budgetter. Installér psutil igen med `pip install --force-reinstall psutil`."

msgid "Could not read performance-core count from sysctl."
msgstr "Antallet af ydelseskerner kunne ikke læses fra sysctl."

msgid "llama-server exists but did not report a version; the binary may be broken."
msgstr "llama-server findes, men oplyste ingen version; programfilen er måske ødelagt."

msgid "system_profiler failed; GPU information is unavailable."
msgstr "system_profiler mislykkedes; der er ingen oplysninger om GPU'en."

msgid "No vendor tool reported the GPU's memory size; record the size in a hardware profile so budgets can be computed for this machine."
msgstr "Intet værktøj fra leverandøren oplyste GPU'ens hukommelsesstørrelse; skriv størrelsen ind i en hardwareprofil, så der kan beregnes budgetter for denne maskine."

msgid "llama.cpp installed"
msgstr "llama.cpp installeret"

msgid "build %(build)s at %(path)s, backends: %(backends)s"
msgstr "build %(build)s i %(path)s, backends: %(backends)s"

msgctxt "llama.cpp build"
msgid "unknown"
msgstr "ukendt"

msgid "llama.cpp not found"
msgstr "llama.cpp blev ikke fundet"

msgid "no llama-server binary was found"
msgstr "der blev ikke fundet nogen llama-server-programfil"

msgid "Install llama.cpp (LlamaFit phase 2 will do this: `llamafit install llama.cpp`); until then download a release from https://github.com/ggml-org/llama.cpp/releases and put its bin directory on PATH or in LLAMA_CPP_PATH."
msgstr "Installér llama.cpp (fase 2 af LlamaFit klarer dette: `llamafit install llama.cpp`); hent indtil da en udgivelse fra https://github.com/ggml-org/llama.cpp/releases, og læg dens bin-mappe i PATH eller i LLAMA_CPP_PATH."

msgid "Memory size unknown"
msgstr "Hukommelsesstørrelsen er ukendt"

msgid "LlamaFit could not read this machine's memory totals, so it cannot work out what will fit."
msgstr "LlamaFit kunne ikke læse de samlede hukommelsestal for denne maskine og kan derfor ikke regne ud, hvad der er plads til."

msgid "%(gpu)s: no %(backend)s backend in llama.cpp"
msgstr "%(gpu)s: ingen %(backend)s-backend i llama.cpp"

msgid "llama.cpp was built with: %(backends)s"
msgstr "llama.cpp blev bygget med: %(backends)s"

msgctxt "backends"
msgid "unknown"
msgstr "ukendte"

msgid "Install a llama.cpp build with the %(backend)s or Vulkan backend to use %(gpu)s."
msgstr "Installér et build af llama.cpp med backend %(backend)s eller Vulkan for at kunne bruge %(gpu)s."

msgid "%(gpu)s: VRAM size unknown"
msgstr "%(gpu)s: VRAM-størrelsen er ukendt"

msgid "the vendor tool that reports memory was not available"
msgstr "værktøjet fra leverandøren, der oplyser hukommelsen, var ikke tilgængeligt"

msgid "No GPU detected"
msgstr "Ingen GPU fundet"

msgid "models will run on the CPU only"
msgstr "modeller kommer kun til at køre på CPU'en"

msgid "If a GPU is present, check that its driver tools are installed."
msgstr "Hvis der er en GPU, så kontrollér, at driverværktøjerne til den er installeret."

msgid "RAM bandwidth assumed"
msgstr "RAM-båndbredden er antaget"

msgid "using %(gbps)s GB/s as a default"
msgstr "%(gbps)s GB/s bruges som standardværdi"

msgid "Install numpy (`pip install llamafit[fast]`) so LlamaFit can measure the RAM bandwidth."
msgstr "Installér numpy (`pip install llamafit[fast]`), så LlamaFit kan måle RAM-båndbredden."

msgid "Probe %(probe)s failed"
msgstr "Testen %(probe)s mislykkedes"

msgid "unknown error"
msgstr "ukendt fejl"

msgid "llama-server running at %(url)s"
msgstr "llama-server kører på %(url)s"

msgid "model %(model)s, context %(context)s"
msgstr "model %(model)s, kontekst %(context)s"

