msgid "Install a llama.cpp build with the %(backend)s or Vulkan backend to use %(gpu)s."
msgstr "Installez un build de llama.cpp avec le backend %(backend)s ou Vulkan pour utiliser %(gpu)s."

msgid "%(gpu)s: VRAM size unknown"
msgstr "%(gpu)s : taille de la VRAM inconnue"

