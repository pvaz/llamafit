msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "Hugging Face a renvoyé %(status)d lors du listage des fichiers de %(repo)s."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Impossible de lire la liste des fichiers de %(repo)s sur Hugging Face."

msgid "Check your network connection and try again."
msgstr "Vérifiez votre connexion réseau et réessayez."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "La réponse de Hugging Face pour %(repo)s ne contenait pas de liste de fichiers."

msgid "Check that the repository id is correct and public."
msgstr "Vérifiez que l'identifiant du dépôt est correct et public."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "le catalogue a %(count)d problème"
msgstr[1] "le catalogue a %(count)d problèmes"

msgid "Run `llamafit catalog validate` for details."
msgstr "Lancez `llamafit catalog validate` pour le détail."

msgid "could not write %(path)s: %(error)s"
msgstr "impossible d'écrire %(path)s : %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "Vérifiez que le répertoire est accessible en écriture et qu'il y reste de la place."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "%(path)s a %(count)d problème et ne peut pas être actualisé"
msgstr[1] "%(path)s a %(count)d problèmes et ne peut pas être actualisé"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "Lancez `llamafit catalog validate` et corrigez d'abord le fichier."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "%(path)s n'a pas pu être lu en entier ; n'actualiser que %(model)s ferait donc perdre des caractéristiques qu'il conserve pour les modèles auxquels cette exécution ne touche pas : %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "Lancez `llamafit catalog refresh` sans --model pour reconstruire tout le fichier."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "Trouver, dimensionner, installer et vérifier des LLM à poids ouverts pour llama.cpp sur votre propre machine."

msgid "Print machine-readable JSON instead of tables."
msgstr "Afficher du JSON lisible par une machine au lieu de tableaux."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "Écrire le détail dans llamafit.log, dans le répertoire des journaux, et afficher les traces d'appels."

msgid "Disable colours."
msgstr "Désactiver les couleurs."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "Parler cette langue, par exemple pt_PT. Une langue que LlamaFit n'a pas revient à l'anglais, et il indique celles qu'il a."

msgid "Print the version and exit."
msgstr "Afficher la version et quitter."

msgid "Unexpected error: %(error)s"
msgstr "Erreur inattendue : %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "Relancez avec --verbose pour la trace d'appels complète."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "Entretenir le catalogue : valider ses fichiers, actualiser les champs volatils."

msgid "Keep only this use case."
msgstr "Ne garder que ce cas d'usage."

msgid "Keep only models with this capability (repeatable)."
msgstr "Ne garder que les modèles ayant cette capacité (répétable)."

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Ne garder que ces identifiants de licence (répétable)."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "Ne valider que ce fichier, au lieu du catalogue fourni et des personnalisations."

msgid "Did you mean: %(ids)s?"
msgstr "Vouliez-vous dire : %(ids)s ?"

msgid "Run `llamafit list` to see every model id."
msgstr "Lancez `llamafit list` pour voir tous les identifiants de modèle."

msgid "no model named %(id)s in the catalog"
msgstr "aucun modèle nommé %(id)s dans le catalogue"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "%(count)d problème trouvé dans le catalogue ; lancez `llamafit catalog validate` pour le détail."
msgstr[1] "%(count)d problèmes trouvés dans le catalogue ; lancez `llamafit catalog validate` pour le détail."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "Aucun modèle ne correspond. Essayez un --use-case, --capability, --license, --vendor ou --search plus large."

msgid "invalid --use-case %(value)s"
msgstr "--use-case invalide : %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "Cas d'usage valides : %(values)s"

msgid "invalid --capability value: %(values)s"
msgid_plural "invalid --capability values: %(values)s"
msgstr[0] "valeur invalide pour --capability : %(values)s"
msgstr[1] "valeurs invalides pour --capability : %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "Capacités valides : %(values)s"

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"Lister le catalogue de modèles, restreint par les filtres donnés.\n"
"\n"
"Le tableau montre au plus trois capacités par modèle, plus un marqueur +N pour le reste, et il est trié sur la colonne Qualité affichée ; info ou --json donnent toutes les capacités."

msgid "Keep only this vendor, case-insensitive."
msgstr "Ne garder que ce fabricant, sans distinction de casse."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "Correspondance partielle, sans distinction de casse, sur l'identifiant, le nom, le fabricant ou la famille."

msgid "Show at most this many."
msgstr "N'en afficher au plus que ce nombre."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "Raccourci pour llamafit list --search TEXTE."

msgid "Text to match against id, name, vendor or family."
msgstr "Texte à rechercher dans l'identifiant, le nom, le fabricant ou la famille."

msgid "Show one model's facts, sources and every quant it publishes."
msgstr "Afficher les caractéristiques d'un modèle, ses sources et chaque quantification qu'il publie."

msgid "A catalog model id."
msgstr "Un identifiant de modèle du catalogue."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "Valider les fichiers YAML du catalogue face au schéma, en écrivant une ligne par problème."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "%(count)d fichier vérifié, aucun problème trouvé."
msgstr[1] "%(count)d fichiers vérifiés, aucun problème trouvé."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "Actualiser depuis Hugging Face les noms de fichiers, les tailles, les sommes de contrôle et les caractéristiques GGUF du catalogue."

msgid "Refresh only this model id."
msgstr "N'actualiser que cet identifiant de modèle."

msgid "Compute the refresh but write nothing."
msgstr "Calculer l'actualisation sans rien écrire."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "Sortir avec 1 si quelque chose devait changer ; ne modifie rien, pour une tâche CI planifiée."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s : avertissement : %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "avertissement : %(warning)s (%(count)d modèle : %(models)s)"
msgstr[1] "avertissement : %(warning)s (%(count)d modèles : %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s : erreur : %(error)s"

msgid "Hint: %(hint)s"
msgstr "Conseil : %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "l'actualisation a besoin d'un accès réseau à Hugging Face ; vérifiez votre connexion et que l'identifiant du dépôt est correct."

msgid "No changes."
msgstr "Aucun changement."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "Afficher l'entrée brute du catalogue pour un modèle, en JSON par défaut ou en YAML avec --yaml."

msgid "Print YAML instead of JSON."
msgstr "Afficher du YAML au lieu du JSON."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "Expliquer ce qui a été détecté, ce qui a échoué et ce qui débloquerait davantage."

