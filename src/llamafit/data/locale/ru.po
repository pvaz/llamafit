msgid "Capability the model must have; a model without it is excluded "
msgstr "Возможность, которая должна быть у модели; модель без неё исключается."

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Оставить только эти идентификаторы лицензий (можно повторять)."

# balanced, quality and speed are the values --prefer takes, so they stay in English
# here, as do the values of --sort, --runs, --columns and --min-fit below.
# balanced, quality and speed are the values --prefer takes, so they stay in English
# here, as do the values of --sort, --runs, --columns and --min-fit below.
# balanced, quality and speed are the values --prefer takes, so they stay in English
