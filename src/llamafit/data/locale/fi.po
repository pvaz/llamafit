msgstr "mallin metatiedot sisältävä osa puuttuu: saatiin %(key)s %(numbers)s, yhden niistä olisi pitänyt olla 0"

msgid "Pass every shard of the split model, including the first."
msgstr "Anna jaetun mallin kaikki osat, myös ensimmäinen."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "epätäydellinen osajoukko: odotettiin avaimen %(key)s arvoja 0-%(last)d, saatiin %(numbers)s"

msgid "Pass each shard of the split model exactly once."
msgstr "Anna jaetun mallin jokainen osa täsmälleen kerran."

