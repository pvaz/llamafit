msgstr[1] "Katalog nie ma sum kontrolnych dla %(files)s."
msgstr[2] "Katalog nie ma sum kontrolnych dla %(files)s."

msgid "%(model)s %(quant)s is already here; nothing to do."
msgstr "%(model)s %(quant)s jest już tutaj; nie ma nic do zrobienia."

msgid "Stopped. What arrived is kept; run `llamafit install model %(model)s` again to carry on from there."
msgstr "Zatrzymano. To, co dotarło, zostaje; uruchom `llamafit install model %(model)s` ponownie, aby kontynuować od tego miejsca."

msgid "%(count)d file, %(size)s, checked against the catalog."
msgid_plural "%(count)d files, %(size)s, checked against the catalog."
msgstr[0] "%(count)d plik, %(size)s, sprawdzony względem katalogu."
msgstr[1] "%(count)d pliki, %(size)s, sprawdzone względem katalogu."
msgstr[2] "%(count)d plików, %(size)s, sprawdzonych względem katalogu."

msgid "In %(path)s. Run `llamafit plan %(model)s` for the command line that runs it."
msgstr "W %(path)s. Uruchom `llamafit plan %(model)s`, aby zobaczyć wiersz poleceń, który go uruchamia."

