msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "Hugging Face zwrócił %(status)d podczas pobierania listy plików dla %(repo)s."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Nie udało się pobrać z Hugging Face listy plików dla %(repo)s."

msgid "Check your network connection and try again."
msgstr "Sprawdź połączenie sieciowe i spróbuj ponownie."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "Odpowiedź Hugging Face dla %(repo)s nie zawierała listy plików."

msgid "Check that the repository id is correct and public."
msgstr "Sprawdź, czy identyfikator repozytorium jest poprawny i czy repozytorium jest publiczne."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "katalog ma %(count)d problem"
msgstr[1] "katalog ma %(count)d problemy"
msgstr[2] "katalog ma %(count)d problemów"

msgid "Run `llamafit catalog validate` for details."
msgstr "Uruchom `llamafit catalog validate`, aby zobaczyć szczegóły."

msgid "could not write %(path)s: %(error)s"
msgstr "nie udało się zapisać %(path)s: %(error)s"

# "Directory" is a folder on disk here, and "katalog" is already this project's word for
# the model catalog, so every filesystem directory says "folder" instead.
msgid "Check that the directory is writable and has room."
msgstr "Sprawdź, czy do folderu można pisać i czy jest w nim miejsce."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "%(path)s ma %(count)d problem i nie może zostać odświeżony"
msgstr[1] "%(path)s ma %(count)d problemy i nie może zostać odświeżony"
msgstr[2] "%(path)s ma %(count)d problemów i nie może zostać odświeżony"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "Najpierw uruchom `llamafit catalog validate` i popraw plik."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "Pliku %(path)s nie udało się odczytać w całości, więc odświeżenie samego %(model)s usunęłoby fakty, które zapisuje on o modelach nietkniętych przez to uruchomienie: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "Uruchom `llamafit catalog refresh` bez --model, aby przebudować cały plik."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "Znajdź, oszacuj rozmiar, zainstaluj i sprawdź modele LLM o otwartych wagach dla llama.cpp na własnej maszynie."

msgid "Print machine-readable JSON instead of tables."
msgstr "Wypisuj JSON czytelny dla maszyn zamiast tabel."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "Zapisuj szczegóły do llamafit.log w folderze dzienników i pokazuj ślady stosu."

msgid "Disable colours."
msgstr "Wyłącz kolory."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "Mów w tym języku, na przykład pt_PT. Język, którego LlamaFit nie ma, sprowadza się do angielskiego, a program mówi, które języki ma."

msgid "Print the version and exit."
msgstr "Wypisz wersję i zakończ."

msgid "Unexpected error: %(error)s"
msgstr "Nieoczekiwany błąd: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "Uruchom ponownie z --verbose, aby zobaczyć pełny ślad stosu."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "Utrzymuj katalog: sprawdzaj jego pliki, odświeżaj zmienne pola."

msgid "Keep only this use case."
msgstr "Zachowaj tylko to zastosowanie."

msgid "Keep only models with this capability (repeatable)."
msgstr "Zachowaj tylko modele z tą możliwością (można powtarzać)."

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Zachowaj tylko te identyfikatory licencji (można powtarzać)."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "Sprawdź tylko ten plik zamiast dołączonego katalogu i własnych nadpisań."

msgid "Did you mean: %(ids)s?"
msgstr "Czy chodziło o: %(ids)s?"

msgid "Run `llamafit list` to see every model id."
msgstr "Uruchom `llamafit list`, aby zobaczyć wszystkie identyfikatory modeli."

msgid "no model named %(id)s in the catalog"
msgstr "w katalogu nie ma modelu o nazwie %(id)s"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "Znaleziono %(count)d problem w katalogu; uruchom `llamafit catalog validate`, aby zobaczyć szczegóły."
msgstr[1] "Znaleziono %(count)d problemy w katalogu; uruchom `llamafit catalog validate`, aby zobaczyć szczegóły."
msgstr[2] "Znaleziono %(count)d problemów w katalogu; uruchom `llamafit catalog validate`, aby zobaczyć szczegóły."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "Żaden model nie pasuje. Spróbuj szerszego --use-case, --capability, --license, --vendor lub --search."

msgid "invalid --use-case %(value)s"
msgstr "nieprawidłowa wartość --use-case: %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "Prawidłowe zastosowania: %(values)s"

msgid "invalid --capability value: %(values)s"
msgid_plural "invalid --capability values: %(values)s"
msgstr[0] "nieprawidłowa wartość --capability: %(values)s"
msgstr[1] "nieprawidłowe wartości --capability: %(values)s"
msgstr[2] "nieprawidłowe wartości --capability: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "Prawidłowe możliwości: %(values)s"

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"Wypisz katalog modeli, zawężony podanymi filtrami.\n"
"\n"
"Tabela pokazuje najwyżej trzy możliwości na model plus znacznik +N dla pozostałych i jest posortowana według pokazanej kolumny Jakość; info lub --json podaje wszystkie możliwości."

msgid "Keep only this vendor, case-insensitive."
msgstr "Zachowaj tylko tego dostawcę, bez rozróżniania wielkości liter."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "Dopasowanie fragmentu tekstu do identyfikatora, nazwy, dostawcy lub rodziny, bez rozróżniania wielkości liter."

msgid "Show at most this many."
msgstr "Pokaż najwyżej tyle pozycji."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "Skrót dla llamafit list --search TEKST."

msgid "Text to match against id, name, vendor or family."
msgstr "Tekst dopasowywany do identyfikatora, nazwy, dostawcy lub rodziny."

msgid "Show one model's facts, sources and every quant it publishes."
msgstr "Pokaż fakty o jednym modelu, jego źródła i każdą publikowaną przez niego kwantyzację."

msgid "A catalog model id."
msgstr "Identyfikator modelu z katalogu."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "Sprawdź pliki YAML katalogu względem schematu, wypisując jeden wiersz na problem."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "Sprawdzono %(count)d plik, nie znaleziono problemów."
msgstr[1] "Sprawdzono %(count)d pliki, nie znaleziono problemów."
msgstr[2] "Sprawdzono %(count)d plików, nie znaleziono problemów."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "Odśwież nazwy plików, rozmiary, sumy kontrolne i fakty GGUF katalogu na podstawie Hugging Face."

msgid "Refresh only this model id."
msgstr "Odśwież tylko ten identyfikator modelu."

msgid "Compute the refresh but write nothing."
msgstr "Oblicz odświeżenie, ale nic nie zapisuj."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "Zakończ z kodem 1, jeśli cokolwiek by się zmieniło; niczego nie zmienia, dla zaplanowanego zadania CI."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: ostrzeżenie: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "ostrzeżenie: %(warning)s (%(count)d model: %(models)s)"
msgstr[1] "ostrzeżenie: %(warning)s (%(count)d modele: %(models)s)"
msgstr[2] "ostrzeżenie: %(warning)s (%(count)d modeli: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: błąd: %(error)s"

msgid "Hint: %(hint)s"
msgstr "Wskazówka: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "odświeżanie wymaga dostępu sieciowego do Hugging Face; sprawdź połączenie i poprawność identyfikatora repozytorium."

msgid "No changes."
msgstr "Bez zmian."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "Wypisz surowy wpis katalogu jednego modelu, domyślnie jako JSON albo jako YAML z --yaml."

msgid "Print YAML instead of JSON."
msgstr "Wypisuj YAML zamiast JSON."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "Wyjaśnij, co wykryto, co się nie udało i co odblokowałoby więcej."

