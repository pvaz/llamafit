#
# NOT YET REVIEWED BY A NATIVE SPEAKER. இந்த மொழிபெயர்ப்பு ஆங்கிலத் தொகுப்பிலிருந்து ஒரே
# முறையில் எழுதப்பட்டது; இரண்டாவது ஒருவர் இதைப் படிக்கவில்லை. ஒவ்வொரு மொழிக்கும்
# docs/translations.md வைக்கும் தரத்தின்படி இது போதாது: தயவுசெய்து வரி வரியாகப் படித்து,
# ஒரு pull request இல் திருத்தவும்.
#
msgid ""
msgstr ""
"Project-Id-Version: llamafit 0.1.0a1\n"
"Report-Msgid-Bugs-To: https://github.com/pvaz/llamafit/issues\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ta\n"
"Language-Team: Tamil\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# Tamil counts one apart from everything else, zero included, so the rule is the same
# shape as English's: CLDR puts ta in the group whose singular is exactly n = 1.
#
# Tamil computing has real words of its own and they are used here: கோப்பு, கோப்பகம்,
# நினைவகம், வட்டு, சேவையகம், பிழை, எச்சரிக்கை, இயக்கி, களஞ்சியம், அளவுரு. What stays in
# Latin is what a Tamil developer only ever writes in English: LlamaFit, llama.cpp,
# Hugging Face, GGUF, JSON, YAML, CUDA, Vulkan, Metal, flags, paths, tool names, and the
# jargon backend, quant, shard, offset, header, key, schema, build, binary, traceback,
# checksum, benchmark, bandwidth, tensor, expert, Params, context.

msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "%(repo)s-க்கான கோப்புகளைப் பட்டியலிடும்போது Hugging Face %(status)d என்பதைத் திருப்பியது."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Hugging Face-இலிருந்து %(repo)s-க்கான கோப்புப் பட்டியலைப் படிக்க முடியவில்லை."

msgid "Check your network connection and try again."
msgstr "உங்கள் பிணைய இணைப்பைச் சரிபார்த்து மீண்டும் முயற்சிக்கவும்."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "%(repo)s-க்கான Hugging Face-இன் பதிலில் கோப்புப் பட்டியல் இல்லை."

msgid "Check that the repository id is correct and public."
msgstr "களஞ்சிய id சரியானது என்பதையும் பொதுவானது என்பதையும் சரிபார்க்கவும்."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "காட்டலாக்கில் %(count)d சிக்கல் உள்ளது"
msgstr[1] "காட்டலாக்கில் %(count)d சிக்கல்கள் உள்ளன"

msgid "Run `llamafit catalog validate` for details."
msgstr "விவரங்களுக்கு `llamafit catalog validate` ஐ இயக்கவும்."

msgid "could not write %(path)s: %(error)s"
msgstr "%(path)s ஐ எழுத முடியவில்லை: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "அந்தக் கோப்பகத்தில் எழுத முடியும் என்பதையும் இடம் உள்ளது என்பதையும் சரிபார்க்கவும்."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "%(path)s இல் %(count)d சிக்கல் உள்ளது, எனவே அதைப் புதுப்பிக்க முடியாது"
msgstr[1] "%(path)s இல் %(count)d சிக்கல்கள் உள்ளன, எனவே அதைப் புதுப்பிக்க முடியாது"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "முதலில் `llamafit catalog validate` ஐ இயக்கி, கோப்பைச் சரிசெய்யவும்."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "%(path)s ஐ முழுமையாகப் படிக்க முடியவில்லை; எனவே %(model)s ஐ மட்டும் புதுப்பித்தால், இந்த இயக்கம் தொடாத மாடல்களுக்காக அதில் பதிவாகியுள்ள தகவல்கள் அழிந்துவிடும்: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "முழுக் கோப்பையும் மீண்டும் உருவாக்க `llamafit catalog refresh` ஐ --model இல்லாமல் இயக்கவும்."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "உங்கள் சொந்த இயந்திரத்தில் llama.cpp-க்கான open-weight LLM-களைக் கண்டறியவும், அளவிடவும், நிறுவவும், சரிபார்க்கவும்."

msgid "Print machine-readable JSON instead of tables."
msgstr "அட்டவணைகளுக்குப் பதிலாக இயந்திரம் படிக்கக்கூடிய JSON ஐ அச்சிடும்."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "பதிவுக் கோப்பகத்தில் உள்ள llamafit.log இல் விவரங்களை எழுதி traceback ஐக் காட்டும்."

msgid "Disable colours."
msgstr "வண்ணங்களை முடக்கும்."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "இந்த மொழியில் பேசும், எடுத்துக்காட்டாக pt_PT. LlamaFit-இடம் இல்லாத மொழிக்கு அது ஆங்கிலத்துக்குத் திரும்பும், மேலும் தன்னிடம் எந்தெந்த மொழிகள் உள்ளன என்பதைச் சொல்லும்."

msgid "Print the version and exit."
msgstr "பதிப்பை அச்சிட்டு வெளியேறும்."

msgid "Unexpected error: %(error)s"
msgstr "எதிர்பாராத பிழை: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "முழு traceback-க்காக --verbose உடன் மீண்டும் இயக்கவும்."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "காட்டலாக்கைப் பராமரிக்கும்: அதன் கோப்புகளைச் சரிபார்க்கும், மாறிக்கொண்டே இருக்கும் புலங்களைப் புதுப்பிக்கும்."

msgid "Keep only this use case."
msgstr "இந்தப் பயன்பாட்டு வகையை மட்டும் வைத்திருக்கும்."

msgid "Keep only models with this capability (repeatable)."
msgstr "இந்தத் திறன் உள்ள மாடல்களை மட்டும் வைத்திருக்கும் (மீண்டும் தரலாம்)."

msgid "Keep only these licence identifiers (repeatable)."
msgstr "இந்த உரிம அடையாளங்களை மட்டும் வைத்திருக்கும் (மீண்டும் தரலாம்)."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "உடன் வரும் காட்டலாக் மற்றும் உங்கள் சொந்த மாற்றங்களுக்குப் பதிலாக இந்தக் கோப்பை மட்டும் சரிபார்க்கும்."

msgid "Did you mean: %(ids)s?"
msgstr "நீங்கள் சொல்ல வந்தது: %(ids)s?"

msgid "Run `llamafit list` to see every model id."
msgstr "ஒவ்வொரு மாடல் id ஐயும் பார்க்க `llamafit list` ஐ இயக்கவும்."

msgid "no model named %(id)s in the catalog"
msgstr "காட்டலாக்கில் %(id)s என்ற பெயரில் மாடல் எதுவும் இல்லை"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "காட்டலாக்கில் %(count)d சிக்கல் கண்டறியப்பட்டது; விவரங்களுக்கு `llamafit catalog validate` ஐ இயக்கவும்."
msgstr[1] "காட்டலாக்கில் %(count)d சிக்கல்கள் கண்டறியப்பட்டன; விவரங்களுக்கு `llamafit catalog validate` ஐ இயக்கவும்."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "எந்த மாடலும் பொருந்தவில்லை. --use-case, --capability, --license, --vendor அல்லது --search ஐ இன்னும் விரிவாக முயற்சிக்கவும்."

msgid "invalid --use-case %(value)s"
msgstr "செல்லாத --use-case %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "செல்லுபடியாகும் பயன்பாட்டு வகைகள்: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "செல்லுபடியாகும் திறன்கள்: %(values)s"

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"தரப்பட்ட வடிகட்டிகளால் சுருக்கப்பட்ட மாடல் காட்டலாக்கைப் பட்டியலிடும்.\n"
"\n"
"அட்டவணை ஒரு மாடலுக்கு அதிகபட்சம் மூன்று திறன்களையும், மீதியவற்றுக்கு ஒரு +N குறியீட்டையும் காட்டும்; அது காட்டப்படும் தரம் நெடுவரிசையின்படி வரிசைப்படுத்தப்பட்டுள்ளது; ஒவ்வொரு திறனும் info அல்லது --json இல் உள்ளது."

msgid "Keep only this vendor, case-insensitive."
msgstr "இந்த வழங்குநரை மட்டும் வைத்திருக்கும், பெரிய-சிறிய எழுத்து வேறுபாடு இல்லாமல்."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "id, பெயர், வழங்குநர் அல்லது குடும்பத்தில் துணைச்சரப் பொருத்தம், பெரிய-சிறிய எழுத்து வேறுபாடு இல்லாமல்."

msgid "Show at most this many."
msgstr "அதிகபட்சம் இத்தனையை மட்டும் காட்டும்."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "llamafit list --search TEXT-இன் சுருக்க வடிவம்."

msgid "Text to match against id, name, vendor or family."
msgstr "id, பெயர், வழங்குநர் அல்லது குடும்பத்துடன் பொருத்த வேண்டிய உரை."

msgid "Show one model's facts, sources and every quant it publishes."
msgstr "ஒரு மாடலின் தகவல்கள், அதன் மூலங்கள், அது வெளியிடும் ஒவ்வொரு quant ஆகியவற்றைக் காட்டும்."

msgid "A catalog model id."
msgstr "ஒரு காட்டலாக் மாடல் id."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "காட்டலாக்கின் YAML கோப்புகளை schema-வுக்கு எதிராகச் சரிபார்த்து, ஒவ்வொரு சிக்கலுக்கும் ஒரு வரியை அச்சிடும்."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "%(count)d கோப்பு சரிபார்க்கப்பட்டது, சிக்கல் எதுவும் இல்லை."
msgstr[1] "%(count)d கோப்புகள் சரிபார்க்கப்பட்டன, சிக்கல் எதுவும் இல்லை."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "காட்டலாக்கிற்கான கோப்புப் பெயர்கள், அளவுகள், checksum-கள், GGUF தகவல்களை Hugging Face-இலிருந்து புதுப்பிக்கும்."

msgid "Refresh only this model id."
msgstr "இந்த மாடல் id ஐ மட்டும் புதுப்பிக்கும்."

msgid "Compute the refresh but write nothing."
msgstr "புதுப்பிப்பைக் கணக்கிடும், ஆனால் எதையும் எழுதாது."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "ஏதேனும் மாறும் நிலையில் 1 உடன் வெளியேறும்; எதையும் மாற்றாது, திட்டமிட்ட CI job-க்காக."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: எச்சரிக்கை: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "எச்சரிக்கை: %(warning)s (%(count)d மாடல்: %(models)s)"
msgstr[1] "எச்சரிக்கை: %(warning)s (%(count)d மாடல்கள்: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: பிழை: %(error)s"

msgid "Hint: %(hint)s"
msgstr "குறிப்பு: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "refresh-க்கு Hugging Face வரை பிணைய அணுகல் தேவை; உங்கள் இணைப்பையும், களஞ்சிய id சரியானது என்பதையும் சரிபார்க்கவும்."

msgid "No changes."
msgstr "மாற்றங்கள் இல்லை."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "ஒரு மாடலின் மூலக் காட்டலாக் உள்ளீட்டை அச்சிடும், இயல்பாக JSON ஆக அல்லது --yaml உடன் YAML ஆக."

msgid "Print YAML instead of JSON."
msgstr "JSON-க்குப் பதிலாக YAML ஐ அச்சிடும்."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "எது கண்டறியப்பட்டது, எது தோல்வியடைந்தது, எது மேலும் திறக்கும் என்பதை விளக்கும்."

