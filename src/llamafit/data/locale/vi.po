msgstr "không rõ"

msgid "Show what this machine has: CPU, memory, GPUs, disks and llama.cpp."
msgstr "Hiện những gì máy này có: CPU, bộ nhớ, GPU, đĩa và llama.cpp."

msgid "Skip the RAM bandwidth measurement."
msgstr "Bỏ qua bước đo băng thông RAM."

msgid "Command: %(command)s"
msgstr "Lệnh: %(command)s"

msgid "truncated GGUF header: wanted %(wanted)d bytes at offset %(offset)d, got %(got)d"
msgstr "phần đầu GGUF bị cắt cụt: cần %(wanted)d byte tại vị trí %(offset)d, chỉ có %(got)d"

msgid "The file may still be downloading, or the URL may not be a GGUF file."
msgstr "Tệp có thể vẫn đang tải về, hoặc URL không trỏ tới một tệp GGUF."

msgid "unknown GGUF value type %(type)d at offset %(offset)d"
msgstr "kiểu giá trị GGUF không rõ %(type)d tại vị trí %(offset)d"

msgid "This file may use a newer GGUF metadata type than LlamaFit supports."
msgstr "Tệp này có thể dùng kiểu siêu dữ liệu GGUF mới hơn những gì LlamaFit hỗ trợ."

msgid "not a GGUF file: bad magic %(magic)s at offset 0"
msgstr "không phải tệp GGUF: chuỗi nhận dạng %(magic)s tại vị trí 0 không hợp lệ"

msgid "Check that this file is actually a .gguf model."
msgstr "Hãy kiểm tra xem tệp này có đúng là mô hình .gguf không."

msgid "unsupported GGUF version %(version)d at offset 4"
msgstr "phiên bản GGUF %(version)d không được hỗ trợ, tại vị trí 4"

msgid "LlamaFit supports GGUF versions %(versions)s."
msgstr "LlamaFit hỗ trợ các phiên bản GGUF %(versions)s."

msgid "these GGUF files are not one split model: they disagree about '%(key)s', declaring %(values)s"
msgstr "các tệp GGUF này không thuộc cùng một mô hình chia mảnh: chúng khai báo '%(key)s' khác nhau, là %(values)s"

msgid "Pass the shards of one model, not of several."
msgstr "Hãy đưa vào các mảnh của một mô hình, không phải của nhiều mô hình."

msgid "no GGUF header to read facts from"
msgstr "không có phần đầu GGUF để đọc dữ kiện"

msgid "Pass the model's file, or every shard of a split model."
msgstr "Hãy đưa vào tệp của mô hình, hoặc mọi mảnh của một mô hình chia mảnh."

msgid "%(count)d of %(total)d GGUF files carry no '%(key)s' key, so their place in a split model cannot be established"
msgstr "%(count)d trong %(total)d tệp GGUF không có khóa '%(key)s', nên không xác định được vị trí của chúng trong mô hình chia mảnh"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "Hãy đưa vào một tệp không chia mảnh riêng lẻ, hoặc mọi mảnh của một mô hình chia mảnh."

msgid "incomplete shard set: the model declares %(declared)d shards and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "bộ mảnh chưa đủ: mô hình khai báo %(declared)d mảnh mà chỉ có %(arrived)d mảnh tới (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "Hãy đưa vào mọi mảnh của mô hình chia mảnh."

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "thiếu mảnh chứa siêu dữ liệu của mô hình: nhận được %(key)s %(numbers)s, trong đó phải có một mảnh mang số 0"

msgid "Pass every shard of the split model, including the first."
msgstr "Hãy đưa vào mọi mảnh của mô hình chia mảnh, kể cả mảnh đầu tiên."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "bộ mảnh chưa đủ: cần %(key)s từ 0 đến %(last)d, nhận được %(numbers)s"

msgid "Pass each shard of the split model exactly once."
msgstr "Hãy đưa mỗi mảnh của mô hình chia mảnh đúng một lần."

msgid "incomplete shard set: the model declares %(declared)d tensors and its %(shards)d shards hold %(held)d between them"
msgstr "bộ mảnh chưa đủ: mô hình khai báo %(declared)d tensor mà %(shards)d mảnh của nó gộp lại chỉ có %(held)d"

msgid "could not read %(path)s: %(error)s"
msgstr "không đọc được %(path)s: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "Hãy kiểm tra xem tệp có tồn tại và đọc được không."

msgid "could not fetch %(url)s: %(error)s"
msgstr "không tải được %(url)s: %(error)s"

msgid "Check your network connection and that the URL is reachable."
msgstr "Hãy kiểm tra kết nối mạng và xem URL có truy cập được không."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s trả về HTTP %(status)d thay vì 206 Partial Content; máy chủ có thể không hỗ trợ yêu cầu theo dải."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Hãy xác nhận URL trỏ tới một tệp GGUF tải về được."

