# Vietnamese translation of LlamaFit.
# This file is distributed under the same licence as LlamaFit.
#
# NOT YET REVIEWED BY A NATIVE SPEAKER. It was written from the template in one pass and
# has had no second reader. By the standard docs/translations.md sets for every language,
# that is not enough: please read it line by line and correct it in a pull request.
#
# Vietnamese takes one plural form, so every plural message has a single msgstr[0] and
# the count is carried by %(count)d, as it already is in the English.
#
msgid ""
msgstr ""
"Project-Id-Version: llamafit 0.1.0a1\n"
"Report-Msgid-Bugs-To: https://github.com/pvaz/llamafit/issues\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: vi\n"
"Language-Team: Vietnamese\n"
"Plural-Forms: nplurals=1; plural=0;\n"

msgid "nothing measured touches this term, so there is no equation it appears in"
msgstr "không có phép đo nào chạm tới số hạng này, nên không có phương trình nào chứa nó"

msgid "%(measurements)d distinct configurations for %(parameters)d free parameters; fewer points than parameters gives numbers that look precise and are arbitrary"
msgstr "%(measurements)d cấu hình khác nhau cho %(parameters)d tham số tự do; ít điểm đo hơn số tham số thì ra những con số trông chính xác mà thực ra tùy tiện"

msgid "the %(measurements)d configurations do not vary independently enough to separate %(parameters)d parameters"
msgstr "%(measurements)d cấu hình đó không biến thiên đủ độc lập để tách được %(parameters)d tham số"

msgid "the fit put it at %(value).3f, which its own definition does not allow; the measurements disagree with each other under section 10.1's model"
msgstr "phép khớp cho ra %(value).3f, giá trị mà chính định nghĩa của nó không cho phép; các phép đo mâu thuẫn với nhau theo mô hình ở mục 10.1"

msgid "it came out at %(value).3f, but another parameter of the same fit was impossible, and least squares chose them against each other"
msgstr "kết quả là %(value).3f, nhưng một tham số khác trong cùng phép khớp lại bất khả, và bình phương tối thiểu đã chọn chúng bù trừ cho nhau"

msgid "the estimator has no such term: section 10.1 removed the per-layer overhead, which for a 28-layer model exceeded the whole measured token"
msgstr "bộ ước lượng không có số hạng đó: mục 10.1 đã bỏ phần phụ trội theo mỗi lớp, vì với một mô hình 28 lớp thì phần đó lớn hơn cả token đo được"

msgid "generation (llama-bench)"
msgstr "sinh (llama-bench)"

msgid "prompt (llama-bench)"
msgstr "prompt (llama-bench)"

msgid "generation, first request"
msgstr "sinh, yêu cầu đầu tiên"

msgid "generation, 1K prompt"
msgstr "sinh, prompt 1K"

msgid "prompt, 1K request"
msgstr "prompt, yêu cầu 1K"

msgid "peak VRAM"
msgstr "VRAM đỉnh"

msgid "no graphics card"
msgstr "không có card đồ họa"

msgid "%(os)s %(version)s, %(cpu)s, %(ram)s, %(gpu)s%(driver)s"
msgstr "%(os)s %(version)s, %(cpu)s, %(ram)s, %(gpu)s%(driver)s"

msgid "%(flag)s was asked for as %(wanted)s but the run reports %(actual)s"
msgstr "%(flag)s được yêu cầu là %(wanted)s nhưng lần chạy báo %(actual)s"

msgid "The card was full and generation came in below three fifths of the estimate: the driver was paging to system memory, which does not fail and does not appear in the log."
msgstr "Card đã đầy và tốc độ sinh thấp hơn ba phần năm ước tính: trình điều khiển đã đẩy phần thừa sang bộ nhớ hệ thống, việc này không báo lỗi và không xuất hiện trong nhật ký."

msgid "Peak VRAM stayed clear of the card's total, so there was nothing for the driver to page."
msgstr "VRAM đỉnh vẫn cách xa tổng dung lượng của card, nên trình điều khiển không có gì để đẩy đi."

msgid "The card was full, which a good plan is meant to be, and the speed was close enough to the estimate that nothing was paging."
msgstr "Card đã đầy, đúng như một kế hoạch tốt phải thế, và tốc độ đủ sát ước tính để thấy rằng không có gì bị đẩy đi."

msgid "No VRAM reading was taken during the run, so this configuration has not been cleared of paging; it has only not been checked."
msgstr "Không có số đo VRAM nào trong lần chạy này, nên cấu hình này chưa được xác nhận là không đẩy bộ nhớ; chỉ là chưa kiểm tra thôi."

msgid "The card's total memory is unknown, so a reading of what was in use says nothing about how close to full it was."
msgstr "Không rõ tổng bộ nhớ của card, nên biết đang dùng bao nhiêu cũng không cho biết nó gần đầy đến đâu."

msgid "There was no estimate to compare the measured speed against, so the second half of the signature could not be tested."
msgstr "Không có ước tính nào để so với tốc độ đo được, nên nửa sau của dấu hiệu này không kiểm tra được."

msgid "llama-bench did not produce JSON"
msgstr "llama-bench không tạo ra JSON"

msgid "llama-bench JSON is not a list of results"
msgstr "JSON của llama-bench không phải là một danh sách kết quả"

msgid "llama-bench JSON held no readable results"
msgstr "JSON của llama-bench không chứa kết quả nào đọc được"

msgid "no llama-bench result rows found"
msgstr "không tìm thấy dòng kết quả nào của llama-bench"

msgid "could not open %(path)s for the server log"
msgstr "không mở được %(path)s để ghi nhật ký máy chủ"

msgid "could not start llama-server"
msgstr "không khởi động được llama-server"

msgid "no output"
msgstr "không có kết xuất"

msgid "llama-bench exited with code %(code)d: %(detail)s"
msgstr "llama-bench thoát với mã %(code)d: %(detail)s"

msgid "llama-bench output could not be read: %(error)s"
msgstr "không đọc được kết xuất của llama-bench: %(error)s"

msgid "llama-server did not become healthy"
msgstr "llama-server không đạt trạng thái lành mạnh"

msgid "Its whole output is in the log file `bench` named; the end says why."
msgstr "Toàn bộ kết xuất nằm trong tệp nhật ký mà `bench` đã nêu tên; phần cuối cho biết vì sao."

msgid "%(path)s was written by a newer LlamaFit (benchmark format %(found)d, this build reads %(known)d)"
msgstr "%(path)s do một bản LlamaFit mới hơn ghi ra (định dạng phép đo %(found)d, bản dựng này đọc %(known)d)"

msgid "Upgrade LlamaFit, or move the file aside to start a new one."
msgstr "Hãy nâng cấp LlamaFit, hoặc chuyển tệp đi chỗ khác để bắt đầu một tệp mới."

msgid "a benchmark cannot be recorded against a simulated machine"
msgstr "không thể ghi một phép đo cho một máy mô phỏng"

msgid "Run `llamafit bench` on the machine itself, without --profile."
msgstr "Hãy chạy `llamafit bench` ngay trên máy đó, không kèm --profile."

msgid "the run did not use the settings it was given: %(problems)s"
msgstr "lần chạy không dùng đúng các thiết lập đã cho: %(problems)s"

msgid "Nothing was stored. A result filed under flags it was not taken with would be believed later by everything that reads it."
msgstr "Không lưu gì cả. Một kết quả lưu dưới những cờ mà nó không hề chạy với sẽ được mọi thứ đọc nó về sau tin là thật."

msgid "a conservative default; nobody has measured this card's backend overhead"
msgstr "một giá trị mặc định dè dặt; chưa ai đo phần phụ trội của backend trên card này"

msgid "measured on this card with driver %(driver)s and llama.cpp %(build)s; one machine"
msgstr "đo trên chính card này với trình điều khiển %(driver)s và llama.cpp %(build)s; một máy"

msgid "A hybrid placement has to say how many layers are on the graphics card."
msgstr "Một cách bố trí lai phải nói rõ có bao nhiêu lớp nằm trên card đồ họa."

msgid "Pass gpu_layers, which is what -ngl would be."
msgstr "Hãy truyền gpu_layers, tức là giá trị của -ngl."

msgid "LlamaFit has not read %(model)s's %(quant)s file, so it cannot size it."
msgstr "LlamaFit chưa đọc tệp %(quant)s của %(model)s nên không ước lượng được kích thước."

msgid "Run `llamafit catalog refresh` to read the file's header."
msgstr "Hãy chạy `llamafit catalog refresh` để đọc phần đầu của tệp."

msgid "the server process before any model buffer"
msgstr "tiến trình máy chủ trước mọi bộ đệm của mô hình"

msgid "fitted to one machine's measurements; the least certain line here"
msgstr "khớp theo phép đo trên một máy; dòng kém chắc chắn nhất ở đây"

msgid "room for one logit per vocabulary entry per token of the batch"
msgstr "chỗ cho một logit trên mỗi mục từ vựng, cho mỗi token của lô"

msgid "LlamaFit cannot size a %(kv_type)s key-value cache."
msgstr "LlamaFit không ước lượng được kích thước bộ đệm khóa-giá trị kiểu %(kv_type)s."

msgid "Use one of: %(types)s."
msgstr "Hãy dùng một trong: %(types)s."

msgid "This model's file does not say how large its key-value cache is per token."
msgstr "Tệp của mô hình này không nói bộ đệm khóa-giá trị lớn bao nhiêu cho mỗi token."

msgid "Refresh the catalog so the file's header is read again."
msgstr "Hãy làm mới danh mục để phần đầu của tệp được đọc lại."

msgid "the attention-layer count was assumed, not counted"
msgstr "số lớp chú ý là giả định chứ không phải đếm được"

msgid "%(arch)s allocates more cache than its header describes; see the line below"
msgstr "%(arch)s cấp phát nhiều bộ đệm hơn phần đầu của nó mô tả; xem dòng dưới"

msgid "what %(arch)s allocates beyond its header, measured rather than derived"
msgstr "phần %(arch)s cấp phát vượt quá phần đầu của nó, đo được chứ không suy ra"

msgid "from the architecture's state dimensions; it does not grow with context"
msgstr "từ các chiều trạng thái của kiến trúc; nó không lớn lên theo ngữ cảnh"

msgid "the projector file itself"
msgstr "bản thân tệp projector"

msgid "the projector's own compute space, measured at 248 MiB"
msgstr "không gian tính toán của riêng projector, đo được là 248 MiB"

msgid "attention projections, feed-forward weights and norms"
msgstr "các phép chiếu chú ý, trọng số feed-forward và norm"

msgid "always-on experts, which run for every token"
msgstr "các chuyên gia luôn bật, chạy cho mọi token"

msgid "routed experts, read across the bus once per micro-batch"
msgstr "các chuyên gia được định tuyến, đọc qua bus mỗi lô nhỏ một lần"

msgid "this model ties its output projection to its embedding table"
msgstr "mô hình này dùng chung phép chiếu đầu ra với bảng embedding"

msgid "llama.cpp keeps the embedding table in memory even at full offload"
msgstr "llama.cpp giữ bảng embedding trong bộ nhớ ngay cả khi đẩy hết lên card"

msgid "streamed from disk as it is needed, not held in memory"
msgstr "đọc thẳng từ đĩa khi cần, không giữ trong bộ nhớ"

msgid "held in memory, since streaming from disk was turned off"
msgstr "giữ trong bộ nhớ, vì việc đọc thẳng từ đĩa đã bị tắt"

msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "Hugging Face trả về %(status)d khi liệt kê tệp của %(repo)s."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Không đọc được danh sách tệp của %(repo)s từ Hugging Face."

msgid "Check your network connection and try again."
msgstr "Hãy kiểm tra kết nối mạng rồi thử lại."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "Phản hồi của Hugging Face cho %(repo)s không có danh sách tệp."

msgid "Check that the repository id is correct and public."
msgstr "Hãy kiểm tra xem id kho có đúng và có công khai không."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "danh mục có %(count)d vấn đề"

msgid "Run `llamafit catalog validate` for details."
msgstr "Chạy `llamafit catalog validate` để xem chi tiết."

msgid "could not write %(path)s: %(error)s"
msgstr "không ghi được %(path)s: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "Hãy kiểm tra xem thư mục có ghi được và còn chỗ trống không."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "%(path)s có %(count)d vấn đề nên không làm mới được"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "Hãy chạy `llamafit catalog validate` và sửa tệp trước đã."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "không đọc được trọn vẹn %(path)s, nên nếu chỉ làm mới %(model)s thì sẽ mất những dữ kiện mà tệp ghi cho các mô hình mà lần chạy này không đụng tới: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "Chạy `llamafit catalog refresh` không kèm --model để dựng lại toàn bộ tệp."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "Tìm, ước lượng kích thước, cài đặt và kiểm chứng các LLM trọng số mở cho llama.cpp ngay trên máy của bạn."

msgid "With no command, llamafit opens the terminal dashboard; in a pipe, or with --json, it prints what `llamafit recommend` would."
msgstr "Không kèm lệnh nào thì llamafit mở bảng điều khiển trên terminal; khi nằm trong một ống dẫn, hoặc khi có --json, nó in ra những gì `llamafit recommend` sẽ in."

msgid "Print machine-readable JSON instead of tables."
msgstr "In ra JSON cho máy đọc thay vì bảng."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "Ghi chi tiết vào llamafit.log trong thư mục nhật ký và hiển thị traceback."

msgid "Disable colours."
msgstr "Tắt màu."

msgid "Answer for the machine this hardware profile describes instead of this one. Nothing about this machine is probed, and every answer is marked as simulated. `llamafit hardware list` names the profiles you have."
msgstr "Trả lời cho cỗ máy mà hồ sơ phần cứng này mô tả, thay vì cho máy này. Không dò gì trên máy này, và mọi câu trả lời đều được đánh dấu là mô phỏng. `llamafit hardware list` cho biết bạn có những hồ sơ nào."

msgid "Pretend the graphics card has this much memory, for example 24G. Everything else stays as scanned, and every answer is marked as simulated."
msgstr "Giả vờ card đồ họa có chừng này bộ nhớ, ví dụ 24G. Mọi thứ khác vẫn như đã dò, và mọi câu trả lời đều được đánh dấu là mô phỏng."

msgid "Pretend the machine has this much system memory, for example 128GiB. Every answer is marked as simulated."
msgstr "Giả vờ máy có chừng này bộ nhớ hệ thống, ví dụ 128GiB. Mọi câu trả lời đều được đánh dấu là mô phỏng."

msgid "Pretend the processor has this many physical cores. Every answer is marked as simulated."
msgstr "Giả vờ bộ xử lý có chừng này nhân vật lý. Mọi câu trả lời đều được đánh dấu là mô phỏng."

msgid "Plan, report and score no context longer than this. It caps the model's own length; it does not describe a machine."
msgstr "Không lập kế hoạch, không báo cáo và không chấm điểm cho ngữ cảnh dài hơn mức này. Nó chặn trên độ dài của chính mô hình; nó không mô tả một cỗ máy."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "Dùng ngôn ngữ này, ví dụ pt_PT. Ngôn ngữ mà LlamaFit không có sẽ quay về tiếng Anh, và nó cho biết những ngôn ngữ nào đang có."

msgid "Print the version and exit."
msgstr "In phiên bản rồi thoát."

msgid "the output's encoding"
msgstr "bảng mã của kết xuất"

msgid "%(count)d character could not be written in %(encoding)s and is shown as ?."
msgid_plural "%(count)d characters could not be written in %(encoding)s and are shown as ?."
msgstr[0] "%(count)d ký tự không ghi được trong %(encoding)s và được hiển thị thành ?."

msgid "Set PYTHONUTF8=1 in the environment and run again: Python then writes UTF-8, which carries every language."
msgstr "Hãy đặt PYTHONUTF8=1 trong môi trường rồi chạy lại: khi đó Python ghi UTF-8, thứ chứa được mọi ngôn ngữ."

msgid "%(option)s is an option of llamafit itself, so it goes before the command: `llamafit %(option)s %(rest)s`."
msgstr "%(option)s là tùy chọn của chính llamafit, nên nó đứng trước lệnh: `llamafit %(option)s %(rest)s`."

msgid "Unexpected error: %(error)s"
msgstr "Lỗi ngoài dự kiến: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "Chạy lại với --verbose để xem traceback đầy đủ."

msgid "A catalog model id."
msgstr "Một id mô hình trong danh mục."

msgid "Benchmark this quantisation instead of the planned one."
msgstr "Đo bản lượng tử hóa này thay vì bản đã định trong kế hoạch."

msgid "Size for this many tokens."
msgstr "Tính kích thước cho chừng này token."

msgid "Set the micro-batch by hand; the budget is rebuilt around it."
msgstr "Đặt lô nhỏ bằng tay; mức phân bổ được dựng lại quanh nó."

msgid ""
"Measure a model on this machine and show the measurement beside the estimate.\n"
"\n"
"Runs llama-bench and a real server at the planned flags, stores the result with the conditions it was taken under, and flags a configuration the driver was paging. With --calibrate, fits the estimator's constants to this machine from every stored result and says by name which ones the measurements do not determine."
msgstr ""
"Đo một mô hình trên máy này và hiện số đo bên cạnh ước tính.\n"
"\n"
"Chạy llama-bench và một máy chủ thật với các cờ đã định, lưu kết quả kèm điều kiện đo, và đánh dấu cấu hình nào bị trình điều khiển đẩy bộ nhớ. Kèm --calibrate, nó khớp các hằng số của bộ ước lượng vào máy này từ mọi kết quả đã lưu và nêu đích danh những hằng số mà các phép đo không xác định được."

msgid "Measure prompt processing at every micro-batch of the ladder, not only the planned one. Section 10.2 has two free parameters and one micro-batch is one equation, so without this the prompt half of a calibration cannot be fitted at all."
msgstr "Đo việc xử lý prompt ở mọi lô nhỏ trên thang, không chỉ ở lô đã định. Mục 10.2 có hai tham số tự do mà một lô nhỏ chỉ là một phương trình, nên thiếu tùy chọn này thì nửa prompt của một lần hiệu chuẩn không khớp được chút nào."

msgid "Run llama-bench only. Faster, and it gives up the paging check, the buffer sizes and the tool-call test, all of which need a real server."
msgstr "Chỉ chạy llama-bench. Nhanh hơn, đổi lại bỏ mất phép kiểm tra đẩy bộ nhớ, các kích thước bộ đệm và phép thử gọi công cụ, tất cả đều cần một máy chủ thật."

msgid "Print the result without writing it to the database."
msgstr "In kết quả mà không ghi vào cơ sở dữ liệu."

msgid "Print the commands that would run, and run nothing."
msgstr "In các lệnh sẽ chạy, và không chạy gì cả."

msgid "Fit the estimator's constants to this machine from every result."
msgstr "Khớp các hằng số của bộ ước lượng vào máy này từ mọi kết quả."

msgid "List what is already stored and stop."
msgstr "Liệt kê những gì đã lưu rồi dừng."

msgid "`llamafit bench` needs a model to measure"
msgstr "`llamafit bench` cần một mô hình để đo"

msgid "Try `llamafit bench <model>`, `--calibrate` on its own, or `--show`."
msgstr "Hãy thử `llamafit bench <model>`, `--calibrate` một mình, hoặc `--show`."

msgid "llama.cpp was not found, so there is nothing to benchmark with"
msgstr "không tìm thấy llama.cpp, nên không có gì để đo cùng"

msgid "Run `llamafit doctor` to see where it was looked for."
msgstr "Hãy chạy `llamafit doctor` để xem nó đã tìm ở đâu."

msgid "%(path)s has llama-server but no llama-bench"
msgstr "%(path)s có llama-server nhưng không có llama-bench"

msgid "Some release archives leave it out; a full build has it beside the server."
msgstr "Một số gói phát hành bỏ nó ra; một bản dựng đầy đủ có nó nằm cạnh máy chủ."

msgid "this host is simulated, and a simulated machine cannot be measured"
msgstr "máy này là mô phỏng, mà một cỗ máy mô phỏng thì không đo được"

msgid "Run `llamafit bench` on the machine itself."
msgstr "Hãy chạy `llamafit bench` ngay trên máy đó."

msgid "the model file is not on this machine: %(path)s"
msgstr "tệp mô hình không có trên máy này: %(path)s"

msgid "Download it first; `llamafit plan` shows the path the command line uses."
msgstr "Hãy tải về trước; `llamafit plan` cho biết đường dẫn mà dòng lệnh dùng."

msgid "Would run:"
msgstr "Sẽ chạy:"

msgid "Nothing has been measured on this machine yet."
msgstr "Chưa đo gì trên máy này cả."

msgid "Stored measurements"
msgstr "Các phép đo đã lưu"

msgid "model"
msgstr "mô hình"

msgid "kind"
msgstr "loại"

msgid "gen tok/s"
msgstr "sinh tok/s"

msgid "prompt tok/s"
msgstr "prompt tok/s"

msgid "taken"
msgstr "đo lúc"

msgid "flags"
msgstr "cờ"

msgid "Nothing was written to the database, so no estimate will be relabelled."
msgstr "Không ghi gì vào cơ sở dữ liệu, nên không ước tính nào bị dán nhãn lại."

msgid "Estimated against measured"
msgstr "Ước tính so với đo được"

msgid "figure"
msgstr "chỉ số"

msgid "context"
msgstr "ngữ cảnh"

msgid "micro-batch"
msgstr "lô nhỏ"

msgid "estimated"
msgstr "ước tính"

msgid "measured"
msgstr "đo được"

msgid "ratio"
msgstr "tỉ lệ"

msgid "The plan sizes this configuration for %(context)s tokens and estimates %(tps)s generated tokens per second there. Nothing above ran at that context, so that figure is reported and not compared."
msgstr "Kế hoạch tính cấu hình này cho %(context)s token và ước tính sinh %(tps)s token mỗi giây ở đó. Không có lần chạy nào ở trên dùng ngữ cảnh ấy, nên con số này được báo lại chứ không đem ra so."

msgid "%(count)d figure is outside the 0.8 to 1.25 band an uncalibrated formula is expected to land in."
msgid_plural "%(count)d figures are outside the 0.8 to 1.25 band an uncalibrated formula is expected to land in."
msgstr[0] "%(count)d chỉ số nằm ngoài dải 0,8 đến 1,25 mà một công thức chưa hiệu chuẩn được kỳ vọng rơi vào."

msgid "This configuration was paging."
msgstr "Cấu hình này đang đẩy bộ nhớ."

msgid "This configuration was not paging."
msgstr "Cấu hình này không đẩy bộ nhớ."

msgid "Paging could not be checked."
msgstr "Không kiểm tra được việc đẩy bộ nhớ."

msgid "Peak VRAM was %(percent)s percent of the card, and generation was %(speed)s percent of the estimate."
msgstr "VRAM đỉnh bằng %(percent)s phần trăm dung lượng card, và tốc độ sinh bằng %(speed)s phần trăm ước tính."

msgid "Peak VRAM was %(percent)s percent of the card. Generation was not compared with the estimate."
msgstr "VRAM đỉnh bằng %(percent)s phần trăm dung lượng card. Tốc độ sinh không được đem so với ước tính."

msgid "The largest context on the ladder that would not page is %(tokens)s."
msgstr "Ngữ cảnh lớn nhất trên thang mà không bị đẩy bộ nhớ là %(tokens)s."

msgid "Calibration"
msgstr "Hiệu chuẩn"

msgid "constant"
msgstr "hằng số"

msgid "value"
msgstr "giá trị"

msgid "from"
msgstr "từ"

msgid "%(base)s + %(slope)s per 1K"
msgstr "%(base)s + %(slope)s mỗi 1K"

msgid "%(count)d measured context"
msgid_plural "%(count)d measured contexts"
msgstr[0] "%(count)d ngữ cảnh đã đo"

msgid "Nothing was fitted. Every line below says what its constant was missing; a calibration made from less than that would look precise and be arbitrary."
msgstr "Không khớp được gì. Mỗi dòng dưới đây nói hằng số của nó thiếu cái gì; một lần hiệu chuẩn làm từ ít hơn thế sẽ trông chính xác mà thực ra tùy tiện."

msgid "%(name)s was not fitted: %(reason)s"
msgstr "%(name)s không khớp được: %(reason)s"

msgid "%(count)d measured configuration"
msgid_plural "%(count)d measured configurations"
msgstr[0] "%(count)d cấu hình đã đo"

msgid "What the model is for. It sets the score weights, the speed target and the context a candidate is measured against."
msgstr "Mô hình dùng để làm gì. Nó quyết định trọng số điểm, mức tốc độ mong muốn và ngữ cảnh dùng để đo ứng viên."

msgid "Capability the model must have; a model without it is excluded "
msgstr "Khả năng mà mô hình bắt buộc phải có; mô hình không có thì bị loại"

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Chỉ giữ các mã giấy phép này (dùng được nhiều lần)."

msgid "balanced, quality or speed: moves a tenth of the weight between quality and speed. It leans the board; it does not replace the weights."
msgstr "balanced, quality hoặc speed: chuyển một phần mười trọng số giữa chất lượng và tốc độ. Nó làm nghiêng bảng xếp hạng, chứ không thay thế các trọng số."

msgid "Exclude anything larger to download, for example 40G or 7.5GiB."
msgstr "Loại những gì phải tải về lớn hơn mức này, ví dụ 40G hoặc 7.5GiB."

msgid "The worst verdict to list: comfortable, fits or tight."
msgstr "Kết luận thấp nhất còn được liệt kê: comfortable, fits hoặc tight."

msgid "Exclude candidates generating fewer tokens per second than this, in place of the speed a person reads at. Pass 0 when nobody is waiting on the tokens."
msgstr "Loại các ứng viên sinh ít token mỗi giây hơn mức này, thay cho tốc độ đọc của một người. Hãy truyền 0 khi không ai phải chờ các token đó."

msgid "Order the rows drawn: score, speed, quality, context, size, prompt, card, ram, fit, model or quant, largest or best first unless :asc says otherwise. The # column keeps the ranking."
msgstr "Thứ tự vẽ các dòng: score, speed, quality, context, size, prompt, card, ram, fit, model hoặc quant; lớn nhất hoặc tốt nhất đứng trước, trừ khi thêm :asc. Cột # vẫn giữ nguyên thứ hạng."

msgid "Draw only rows whose id, name or quantisation contains this text."
msgstr "Chỉ vẽ những dòng có id, tên hoặc bản lượng tử hóa chứa chuỗi này."

msgid "Draw only rows whose file is already on this machine."
msgstr "Chỉ vẽ những dòng mà tệp đã có sẵn trên máy này."

msgid "Draw only rows that run this way: gpu, moe-offload, hybrid or cpu."
msgstr "Chỉ vẽ những dòng chạy theo cách này: gpu, moe-offload, hybrid hoặc cpu."

msgid "Draw only rows at or above this verdict: comfortable, fits or tight. The ranking is unchanged and a hidden row is still counted."
msgstr "Chỉ vẽ những dòng đạt kết luận này trở lên: comfortable, fits hoặc tight. Thứ hạng không đổi và dòng bị ẩn vẫn được đếm."

msgid "Draw exactly these columns, comma-separated, in this order, named as --json names them: rank, model, quant, size, have, score, quality, gen, prompt, confidence, mode, vram, ram, verdict, context."
msgstr "Chỉ vẽ đúng những cột này, phân cách bằng dấu phẩy, theo thứ tự này, với tên như --json đặt: rank, model, quant, size, have, score, quality, gen, prompt, confidence, mode, vram, ram, verdict, context."

msgid "Draw every column whatever the terminal's width; a cell that does not fit folds."
msgstr "Vẽ mọi cột bất kể bề ngang của terminal; ô nào không vừa thì xuống dòng."

msgid "Leave the candidates that were not ranked off the table. The reasons are still printed under it."
msgstr "Bỏ các ứng viên không được xếp hạng ra khỏi bảng. Lý do vẫn được in bên dưới."

msgid "invalid --min-fit %(value)s"
msgstr "--min-fit không hợp lệ: %(value)s"

msgid "Valid values: %(values)s"
msgstr "Các giá trị hợp lệ: %(values)s"

msgid "invalid --prefer %(value)s"
msgstr "--prefer không hợp lệ: %(value)s"

msgid "invalid --runs %(value)s"
msgstr "--runs không hợp lệ: %(value)s"

msgid "invalid --sort %(value)s"
msgstr "--sort không hợp lệ: %(value)s"

msgid "invalid --columns %(value)s"
msgstr "--columns không hợp lệ: %(value)s"

msgid ""
"Rank the catalog for what you want to do on this machine.\n"
"\n"
"Every candidate is planned, sized and estimated here, so the first run scans the machine. Speeds compare candidates at 8K tokens of context; --explain expands a row into the scores, the weights, the budget and the speed breakdown that produced it."
msgstr ""
"Xếp hạng danh mục theo việc bạn muốn làm trên máy này.\n"
"\n"
"Mọi ứng viên đều được lập kế hoạch, ước lượng kích thước và ước tính tốc độ ngay tại đây, nên lần chạy đầu sẽ dò máy. Tốc độ so sánh các ứng viên ở ngữ cảnh 8K token; --explain mở một dòng ra thành các điểm, trọng số, mức phân bổ và phân tích tốc độ đã tạo ra nó."

msgid "Exclude candidates that cannot hold at least this many tokens."
msgstr "Loại các ứng viên không giữ nổi ít nhất chừng này token."

msgid "Show at most this many rows."
msgstr "Hiển thị nhiều nhất chừng này dòng."

msgid "Show every quantisation instead of the best one per model."
msgstr "Hiện mọi bản lượng tử hóa thay vì bản tốt nhất của mỗi mô hình."

msgid "Expand every row shown into the scores, weights, budget and speed breakdown behind it. Combine with --limit 1 for one model."
msgstr "Mở mọi dòng đang hiện thành các điểm, trọng số, mức phân bổ và phân tích tốc độ đằng sau nó. Kết hợp với --limit 1 để xem một mô hình."

msgid "Plan without a vision projector, freeing its memory."
msgstr "Lập kế hoạch mà không có projector thị giác, giải phóng phần bộ nhớ của nó."

msgid ""
"Rank every model by how well it uses this machine, whatever it is for.\n"
"\n"
"No use case, no weights and no score: this is the memory question on its own. Models are sized for 32K tokens of context, and the context column is the largest each one holds in the mode shown."
msgstr ""
"Xếp hạng mọi mô hình theo mức độ tận dụng máy này, bất kể dùng để làm gì.\n"
"\n"
"Không có trường hợp sử dụng, không trọng số và không điểm: đây chỉ là câu hỏi về bộ nhớ. Các mô hình được tính kích thước cho ngữ cảnh 32K token, và cột ngữ cảnh là mức lớn nhất mà mỗi mô hình giữ được ở chế độ đang hiện."

msgid "Only the configurations that use the machine well: at least half its memory held in weights, and no pool past four fifths."
msgstr "Chỉ những cấu hình tận dụng tốt cỗ máy: ít nhất một nửa bộ nhớ nằm trong trọng số, và không vùng nhớ nào vượt bốn phần năm."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "Bảo trì danh mục: kiểm tra các tệp, làm mới những trường hay thay đổi."

msgid "Keep only this use case."
msgstr "Chỉ giữ trường hợp sử dụng này."

msgid "Keep only models with this capability (repeatable)."
msgstr "Chỉ giữ các mô hình có khả năng này (dùng được nhiều lần)."

msgid "Show only this quantisation, matched case-insensitively, in both tables."
msgstr "Chỉ hiện bản lượng tử hóa này, khớp không phân biệt hoa thường, ở cả hai bảng."

msgid "Size every quantisation for this many tokens instead of the usual 32,768."
msgstr "Tính kích thước mọi bản lượng tử hóa cho chừng này token thay vì mức 32.768 thường dùng."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "Chỉ kiểm tra tệp này thay vì danh mục đi kèm và các tệp ghi đè riêng."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "Không có mô hình nào khớp. Hãy nới rộng --use-case, --capability, --license, --vendor hoặc --search."

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"Liệt kê danh mục mô hình, thu hẹp theo các bộ lọc đã cho.\n"
"\n"
"Bảng hiển thị tối đa ba khả năng cho mỗi mô hình, kèm dấu +N cho phần còn lại, và được sắp theo cột Chất lượng đang hiển thị; info hoặc --json có đủ mọi khả năng."

msgid "Keep only this vendor, case-insensitive."
msgstr "Chỉ giữ nhà cung cấp này, không phân biệt hoa thường."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "Khớp chuỗi con trong id, tên, nhà cung cấp hoặc dòng, không phân biệt hoa thường."

msgid "Show at most this many."
msgstr "Hiển thị nhiều nhất bấy nhiêu mục."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "Cách viết tắt của llamafit list --search TEXT."

msgid "Text to match against id, name, vendor or family."
msgstr "Chuỗi cần khớp với id, tên, nhà cung cấp hoặc dòng."

msgid ""
"Show one model: its facts, the quants it publishes, and what each would cost on this machine.\n"
"\n"
"The last table is sized against this machine, so the first run scans it. One line per quantisation; plan opens one of those rows into the memory budget, the context ladder and the command line."
msgstr ""
"Hiện một mô hình: các dữ kiện của nó, các bản lượng tử hóa nó công bố, và mỗi bản sẽ tốn bao nhiêu trên máy này.\n"
"\n"
"Bảng cuối được tính theo máy này, nên lần chạy đầu sẽ dò máy. Mỗi bản lượng tử hóa một dòng; plan mở một trong các dòng đó thành mức phân bổ bộ nhớ, thang ngữ cảnh và dòng lệnh."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "Kiểm tra các tệp YAML của danh mục theo lược đồ, in mỗi vấn đề một dòng."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "Đã kiểm tra %(count)d tệp, không thấy vấn đề nào."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "Làm mới tên tệp, kích thước, tổng kiểm tra và dữ kiện GGUF của danh mục từ Hugging Face."

msgid "Refresh only this model id."
msgstr "Chỉ làm mới id mô hình này."

msgid "Compute the refresh but write nothing."
msgstr "Tính toán việc làm mới nhưng không ghi gì cả."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "Thoát với mã 1 nếu có gì đó thay đổi; không thay đổi gì, dành cho tác vụ CI chạy theo lịch."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: cảnh báo: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "cảnh báo: %(warning)s (%(count)d mô hình: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: lỗi: %(error)s"

msgid "Hint: %(hint)s"
msgstr "Gợi ý: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "việc làm mới cần truy cập mạng tới Hugging Face; hãy kiểm tra kết nối và xem id kho có đúng không."

msgid "No changes."
msgstr "Không có thay đổi."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "In mục danh mục thô của một mô hình, mặc định là JSON, hoặc YAML nếu có --yaml."

msgid "Print YAML instead of JSON."
msgstr "In YAML thay vì JSON."

msgid "Did you mean: %(ids)s?"
msgstr "Có phải bạn muốn tìm: %(ids)s?"

msgid "Run `llamafit list` to see every model id."
msgstr "Chạy `llamafit list` để xem mọi id mô hình."

msgid "no model named %(id)s in the catalog"
msgstr "không có mô hình nào tên %(id)s trong danh mục"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "Tìm thấy %(count)d vấn đề trong danh mục; chạy `llamafit catalog validate` để xem chi tiết."

msgid "invalid --use-case %(value)s"
msgstr "--use-case không hợp lệ: %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "Các trường hợp sử dụng hợp lệ: %(values)s"

msgid "invalid %(option)s value: %(values)s"
msgid_plural "invalid %(option)s values: %(values)s"
msgstr[0] "%(option)s có giá trị không hợp lệ: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "Các khả năng hợp lệ: %(values)s"

msgid "%(option)s is not a size: %(value)s"
msgstr "%(option)s không phải là một kích thước: %(value)s"

msgid "Sizes look like 8G, 7.5GiB or 512M; a bare number is bytes."
msgstr "Kích thước trông như 8G, 7.5GiB hoặc 512M; một con số trần là byte."

msgid "%(ceiling)s %(max)s is below %(floor)s %(min)s"
msgstr "%(ceiling)s %(max)s thấp hơn %(floor)s %(min)s"

msgid "Raise %(ceiling)s, or lower %(floor)s."
msgstr "Hãy nâng %(ceiling)s, hoặc hạ %(floor)s."

msgid "`llamafit %(command)s` reports on the machine LlamaFit is running on"
msgstr "`llamafit %(command)s` báo cáo về chính cỗ máy đang chạy LlamaFit"

msgid "Drop --profile, --memory, --ram and --cpu-cores. To see the machine a profile describes, run `llamafit hardware show NAME --as-host`."
msgstr "Hãy bỏ --profile, --memory, --ram và --cpu-cores. Để xem cỗ máy mà một hồ sơ mô tả, hãy chạy `llamafit hardware show NAME --as-host`."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "Giải thích những gì phát hiện được, những gì thất bại, và làm gì thì mở ra thêm."

msgid "Hardware profiles: describe a machine in a file and score models against it."
msgstr "Hồ sơ phần cứng: mô tả một cỗ máy trong một tệp rồi chấm điểm các mô hình theo nó."

msgid "Validate only this file instead of every bundled and user profile."
msgstr "Chỉ kiểm tra tệp này thay vì mọi hồ sơ đi kèm và hồ sơ của bạn."

msgid "A profile name, or a path to a profile file."
msgstr "Tên một hồ sơ, hoặc đường dẫn tới tệp hồ sơ."

msgid "%(count)d hardware profile problem found; run `llamafit hardware validate` for details."
msgid_plural "%(count)d hardware profile problems found; run `llamafit hardware validate` for details."
msgstr[0] "Tìm thấy %(count)d vấn đề trong hồ sơ phần cứng; chạy `llamafit hardware validate` để xem chi tiết."

msgid "List the hardware profiles LlamaFit has: the bundled ones and your own."
msgstr "Liệt kê các hồ sơ phần cứng LlamaFit có: các hồ sơ đi kèm và của riêng bạn."

msgid "No hardware profiles. Run `llamafit hardware path` to see where yours would go."
msgstr "Không có hồ sơ phần cứng nào. Hãy chạy `llamafit hardware path` để xem hồ sơ của bạn sẽ nằm ở đâu."

msgid ""
"Show one profile; with --as-host, the machine it stands in for.\n"
"\n"
"A host built from a profile is marked as simulated, in the table and in the JSON, so a what-if is never mistaken for a scan of this machine."
msgstr ""
"Hiện một hồ sơ; kèm --as-host thì hiện cỗ máy mà nó đứng thay.\n"
"\n"
"Một máy dựng từ hồ sơ luôn được đánh dấu là mô phỏng, cả trong bảng lẫn trong JSON, nên một giả định sẽ không bao giờ bị nhầm là kết quả dò máy này."

msgid "Show the host this profile substitutes, as `llamafit system` would."
msgstr "Hiện cỗ máy mà hồ sơ này thay thế, như `llamafit system` vẫn hiện."

msgid "Check hardware profile files against the schema, printing one line per problem."
msgstr "Kiểm tra các tệp hồ sơ phần cứng theo lược đồ, in mỗi vấn đề một dòng."

msgid "Print the directory your own hardware profiles go in."
msgstr "In thư mục chứa các hồ sơ phần cứng của riêng bạn."

msgid "It does not exist yet; create it and put a %(suffix)s file in it."
msgstr "Thư mục đó chưa tồn tại; hãy tạo nó và đặt vào một tệp %(suffix)s."

msgid "Install what it takes to run a model: llama.cpp itself, and the weights."
msgstr "Cài những gì cần để chạy một mô hình: chính llama.cpp, và bộ trọng số."

msgid "Fetch this quantisation instead of the first the catalog publishes."
msgstr "Tải bản lượng tử hóa này thay vì bản đầu tiên mà danh mục công bố."

msgid "Put the files here instead of under the configured downloads directory."
msgstr "Đặt các tệp vào đây thay vì vào thư mục tải về đã cấu hình."

msgid "Use at most this much bandwidth, for example 5M. Shared across every worker, so the figure is the figure whatever --workers says."
msgstr "Dùng nhiều nhất chừng này băng thông, ví dụ 5M. Con số này chia chung cho mọi luồng làm việc, nên nó không đổi dù --workers là bao nhiêu."

msgid "How many requests to keep in flight. More is not always faster, and a home connection is shared with whoever else is using it."
msgstr "Số yêu cầu giữ cùng lúc. Nhiều hơn không phải lúc nào cũng nhanh hơn, và đường truyền ở nhà còn chia cho những người khác trong nhà."

msgid "Do not ask before starting."
msgstr "Không hỏi trước khi bắt đầu."

msgid "Show what would be fetched and stop before fetching it."
msgstr "Hiện những gì sẽ tải rồi dừng lại trước khi tải."

msgid "Fetch only the weights, not the vision projector or the draft model."
msgstr "Chỉ tải bộ trọng số, không tải projector thị giác hay mô hình nháp."

msgid "Re-read files that are already here and check them against the catalog."
msgstr "Đọc lại các tệp đã có ở đây và đối chiếu với danh mục."

msgid "Fetch files the catalog holds no checksum for. Nothing will be able to tell you whether they arrived intact."
msgstr "Tải cả những tệp mà danh mục không có tổng kiểm tra. Sẽ không có gì cho bạn biết chúng đến nơi còn nguyên vẹn hay không."

msgid "Show at most this many entries."
msgstr "Hiển thị nhiều nhất chừng này mục."

msgid "Download a model's weights, resuming anything an earlier run left and checking every file against the catalog's checksum."
msgstr "Tải bộ trọng số của một mô hình, tiếp tục những gì lần chạy trước còn dở và đối chiếu mọi tệp với tổng kiểm tra trong danh mục."

msgid "Start the download?"
msgstr "Bắt đầu tải về?"

msgid "Show what has been downloaded, newest first."
msgstr "Hiện những gì đã tải, mới nhất trước."

msgid "Nothing has been downloaded yet."
msgstr "Chưa tải về gì cả."

msgid "Install this backend instead of the one chosen for your GPU: cuda, vulkan, hip, sycl, metal or cpu."
msgstr "Cài backend này thay vì backend được chọn cho GPU của bạn: cuda, vulkan, hip, sycl, metal hoặc cpu."

msgid "Install here instead of ~/.llamafit/llama.cpp."
msgstr "Cài vào đây thay vì ~/.llamafit/llama.cpp."

msgid "Install this release tag, for example b6100, not the latest."
msgstr "Cài bản phát hành mang thẻ này, ví dụ b6100, chứ không phải bản mới nhất."

msgid "invalid --backend %(value)s"
msgstr "--backend không hợp lệ: %(value)s"

msgid "Valid backends: %(values)s"
msgstr "Các backend hợp lệ: %(values)s"

msgid "release %(tag)s publishes no %(backend)s build for %(os)s %(arch)s."
msgstr "bản phát hành %(tag)s không công bố bản dựng %(backend)s nào cho %(os)s %(arch)s."

msgid "Leave --backend out and LlamaFit will choose a published one."
msgstr "Hãy bỏ --backend ra và LlamaFit sẽ chọn một bản dựng đã công bố."

msgid "release %(tag)s publishes nothing for %(os)s %(arch)s."
msgstr "bản phát hành %(tag)s không công bố gì cho %(os)s %(arch)s."

msgid "Build llama.cpp from source; see the project's own instructions."
msgstr "Hãy tự dựng llama.cpp từ mã nguồn; xem hướng dẫn của chính dự án đó."

msgid "Downloading"
msgstr "Đang tải về"

msgid "Change your PATH?"
msgstr "Đổi PATH của bạn?"

msgid "PATH left alone."
msgstr "PATH được giữ nguyên."

msgid "PATH changed. Open a new terminal for it to take effect."
msgstr "Đã đổi PATH. Hãy mở một terminal mới để nó có hiệu lực."

msgid ""
"Download a published llama.cpp build and install it into ~/.llamafit/llama.cpp.\n"
"\n"
"The plan is printed before anything is written. The archive's checksum is verified before it is unpacked, an interrupted download continues where it stopped, and a directory LlamaFit did not create is never overwritten."
msgstr ""
"Tải một bản dựng llama.cpp đã công bố và cài vào ~/.llamafit/llama.cpp.\n"
"\n"
"Kế hoạch được in ra trước khi ghi bất cứ thứ gì. Tổng kiểm tra của tệp nén được xác minh trước khi giải nén, một lần tải bị gián đoạn sẽ tiếp tục từ chỗ dừng, và một thư mục không do LlamaFit tạo thì không bao giờ bị ghi đè."

msgid "Offer to add the bin directory to your PATH, showing the undo first."
msgstr "Hỏi xem có thêm thư mục bin vào PATH không, và cho xem cách hoàn tác trước."

msgid "Install over a directory LlamaFit did not create. Ask yourself twice."
msgstr "Cài đè lên một thư mục không do LlamaFit tạo. Hãy nghĩ lại hai lần."

msgid "Install an archive that publishes no checksum. Nothing can be checked."
msgstr "Cài một tệp nén không công bố tổng kiểm tra. Không kiểm được gì cả."

msgid "Print the plan and write nothing."
msgstr "In kế hoạch và không ghi gì."

msgid "Do not ask; assume yes."
msgstr "Không hỏi; coi như đồng ý."

msgid "Install this?"
msgstr "Cài cái này?"

msgid "Nothing was written."
msgstr "Không ghi gì cả."

msgid "Plan this quantisation instead of the one that scores best on this machine."
msgstr "Lập kế hoạch với bản lượng tử hóa này thay vì bản đạt điểm cao nhất trên máy này."

msgid "Size for this many tokens. When it does not fit, the plan sizes down and shows what the context you asked for would have cost."
msgstr "Tính kích thước cho chừng này token. Khi không vừa, kế hoạch sẽ hạ xuống và cho thấy ngữ cảnh bạn hỏi lẽ ra tốn bao nhiêu."

msgid "Set the micro-batch by hand. The whole budget is rebuilt around it, since it moves the compute buffer and with it the verdict."
msgstr "Đặt lô nhỏ bằng tay. Toàn bộ mức phân bổ được dựng lại quanh nó, vì nó làm đổi bộ đệm tính toán và kéo theo cả kết luận."

msgid "A generation speed to answer against: whether this reaches it, and what context would."
msgstr "Một tốc độ sinh để đối chiếu: cấu hình này có đạt tới đó không, và ngữ cảnh nào thì đạt."

msgid "%(model)s publishes no quantisations"
msgstr "%(model)s không công bố bản lượng tử hóa nào"

msgid "Run `llamafit catalog refresh --model %(model)s`."
msgstr "Hãy chạy `llamafit catalog refresh --model %(model)s`."

msgid ""
"Place one model on this machine and print the command line that runs it.\n"
"\n"
"Shows the memory budget component by component, the context ladder a launch script chooses from, where a token's time goes, and any run the catalog records for comparison."
msgstr ""
"Đặt một mô hình lên máy này và in ra dòng lệnh chạy nó.\n"
"\n"
"Nó cho thấy mức phân bổ bộ nhớ theo từng phần, thang ngữ cảnh mà một kịch bản khởi chạy chọn trong đó, thời gian của một token đi đâu, và mọi lần chạy mà danh mục có ghi để đem so."

msgid "Leave the vision projector out, freeing its memory for context."
msgstr "Bỏ projector thị giác ra, dành phần bộ nhớ của nó cho ngữ cảnh."

msgid "Write the files here instead of in LlamaFit's own presets directory."
msgstr "Ghi các tệp vào đây thay vì vào thư mục preset của chính LlamaFit."

msgid "Bind this port instead of llama.cpp's default 8080."
msgstr "Mở cổng này thay vì cổng 8080 mặc định của llama.cpp."

msgid "Size for this many tokens. It becomes the top of the ladder the script chooses from; the script never goes above it."
msgstr "Tính kích thước cho chừng này token. Nó thành bậc cao nhất của thang mà kịch bản chọn trong đó; kịch bản không bao giờ vượt lên trên."

msgid "%(model)s does not fit this machine in any configuration"
msgstr "%(model)s không vừa máy này ở bất kỳ cấu hình nào"

msgid "Run `llamafit plan %(model)s` to see what it would need."
msgstr "Hãy chạy `llamafit plan %(model)s` để xem nó cần những gì."

msgid ""
"Write launch scripts for one model: a script that picks its context from free card memory at start time, a router section, and a README.\n"
"\n"
"A file you have edited is never overwritten without --force."
msgstr ""
"Ghi các kịch bản khởi chạy cho một mô hình: một kịch bản tự chọn ngữ cảnh theo bộ nhớ card còn trống lúc khởi động, một phần định tuyến, và một README.\n"
"\n"
"Tệp bạn đã sửa thì không bao giờ bị ghi đè nếu không có --force."

msgid "Overwrite files you have edited. It says which ones it discarded."
msgstr "Ghi đè cả những tệp bạn đã sửa. Nó cho biết đã bỏ đi những tệp nào."

msgid "Run a model's preset, wait for the server to answer, and print its endpoints. --stop stops the server LlamaFit started."
msgstr "Chạy preset của một mô hình, chờ máy chủ trả lời, rồi in các điểm cuối của nó. --stop dừng máy chủ mà LlamaFit đã khởi động."

msgid "Stop the server LlamaFit started for this model."
msgstr "Dừng máy chủ mà LlamaFit đã khởi động cho mô hình này."

msgid "Seconds to wait for /health before reporting that it has not answered."
msgstr "Số giây chờ /health trước khi báo rằng nó chưa trả lời."

msgid "the preset could not be written"
msgstr "không ghi được preset"

msgid "Wrote a preset first: %(path)s"
msgstr "Đã ghi một preset trước: %(path)s"

msgid "Nothing to stop: LlamaFit has no record of starting %(model)s."
msgstr "Không có gì để dừng: LlamaFit không ghi nhận đã khởi động %(model)s."

msgid "Stopped %(model)s, which was serving on %(url)s."
msgstr "Đã dừng %(model)s, vốn đang phục vụ tại %(url)s."

msgid "Preset for %(name)s (%(quant)s) in %(dir)s"
msgstr "Preset cho %(name)s (%(quant)s) trong %(dir)s"

msgid "The server will answer on %(url)s."
msgstr "Máy chủ sẽ trả lời tại %(url)s."

msgid "Your edits were kept. Nothing above was written to those files; run the command again with --force to replace them."
msgstr "Các sửa đổi của bạn được giữ nguyên. Không có gì ở trên được ghi vào những tệp đó; hãy chạy lại lệnh kèm --force để thay chúng."

msgid "At start time the script reads how much card memory is free, keeps %(reserve)s MiB back, and takes the largest context that still fits."
msgstr "Lúc khởi động, kịch bản đọc xem bộ nhớ card còn trống bao nhiêu, chừa lại %(reserve)s MiB, rồi lấy ngữ cảnh lớn nhất vẫn còn vừa."

msgid "This machine has nothing the script can ask for free card memory, so it will start at %(context)s tokens; the script's header says why."
msgstr "Máy này không có gì để kịch bản hỏi về bộ nhớ card còn trống, nên nó sẽ khởi động ở %(context)s token; phần đầu của kịch bản nói rõ vì sao."

