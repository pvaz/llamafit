msgid ""
"Open the dashboard in a browser: the board, the machine and the plans.\n"
"\n"
"It serves the same numbers `--json` prints, from the same code, on this machine only. Nothing is fetched from the internet to draw the page."
msgstr ""
"Mở bảng điều khiển trong trình duyệt: bảng xếp hạng, cỗ máy và các kế hoạch.\n"
"\n"
"Nó phục vụ đúng những con số mà --json in ra, từ cùng một mã nguồn, chỉ trên máy này. Không có gì được lấy từ internet để vẽ trang này."

msgid "Open the page in your browser."
msgstr "Mở trang trong trình duyệt của bạn."

msgid "Drop --profile, --memory, --ram and --cpu-cores, then open the Simulate panel on the page: it substitutes a machine for as long as you want it, and marks every answer it produces."
msgstr "Hãy bỏ --profile, --memory, --ram và --cpu-cores, rồi mở bảng Mô phỏng trên trang: nó thay thế một cỗ máy trong bao lâu tùy bạn, và đánh dấu mọi câu trả lời mà nó tạo ra."

msgid "LlamaFit is at %(url)s. Press Ctrl+C to stop it."
msgstr "LlamaFit đang ở %(url)s. Nhấn Ctrl+C để dừng."

msgid "Show what this machine has: CPU, memory, GPUs, disks and llama.cpp."
msgstr "Hiện những gì máy này có: CPU, bộ nhớ, GPU, đĩa và llama.cpp."

msgid "Skip the RAM bandwidth measurement."
msgstr "Bỏ qua bước đo băng thông RAM."

msgid "Measure RAM bandwidth again instead of reading back the figure kept for this machine, and keep the new one."
msgstr "Đo lại băng thông RAM thay vì đọc lại con số đã lưu cho máy này, và giữ con số mới."

msgid "%(url)s answered a range request with the whole file."
msgstr "%(url)s đáp lại một yêu cầu theo dải bằng cả tệp."

msgid "%(url)s is rate-limiting this download (HTTP %(status)d)."
msgstr "%(url)s đang giới hạn tốc độ của lần tải này (HTTP %(status)d)."

msgid "Check your network connection and run the command again to resume."
msgstr "Hãy kiểm tra kết nối mạng rồi chạy lại lệnh để tiếp tục."

msgid "%(file)s needs authorisation (HTTP %(status)d)."
msgstr "%(file)s cần quyền truy cập (HTTP %(status)d)."

msgid "This repository is gated. Accept its terms on Hugging Face and set HF_TOKEN to a token that can read it."
msgstr "Kho này bị hạn chế. Hãy chấp nhận điều khoản của nó trên Hugging Face và đặt HF_TOKEN thành một token đọc được nó."

msgid "%(file)s is not at %(url)s any more (HTTP 404)."
msgstr "%(file)s không còn ở %(url)s nữa (HTTP 404)."

msgid "Run `llamafit catalog refresh` to pick up the repository's current files."
msgstr "Hãy chạy `llamafit catalog refresh` để lấy danh sách tệp hiện thời của kho."

msgid "%(url)s returned HTTP %(status)d."
msgstr "%(url)s trả về HTTP %(status)d."

msgid "Confirm the URL points at a downloadable file."
msgstr "Hãy xác nhận URL trỏ tới một tệp tải về được."

msgid "%(url)s did not say how big %(file)s is."
msgstr "%(url)s không cho biết %(file)s lớn bao nhiêu."

msgid "%(file)s is %(actual)s on the server but the catalog says %(expected)s; the repository has been re-uploaded since the catalog was refreshed."
msgstr "%(file)s trên máy chủ là %(actual)s nhưng danh mục ghi %(expected)s; kho đã được tải lên lại kể từ lần làm mới danh mục."

msgid "Run `llamafit catalog refresh` and try again."
msgstr "Hãy chạy `llamafit catalog refresh` rồi thử lại."

msgid "%(file)s: the server sent %(actual)d bytes of a %(expected)d byte range."
msgstr "%(file)s: máy chủ gửi %(actual)d byte của một dải %(expected)d byte."

msgid "Run the command again; the parts that did arrive are kept."
msgstr "Hãy chạy lại lệnh; những phần đã đến nơi vẫn được giữ."

msgid "Stopped."
msgstr "Đã dừng."

msgid "%(file)s: the server asked for fewer connections; using %(count)d."
msgstr "%(file)s: máy chủ đòi ít kết nối hơn; đang dùng %(count)d."

msgid "%(file)s: this server will not serve byte ranges; fetching it in one stream."
msgstr "%(file)s: máy chủ này không phục vụ theo dải byte; đang tải nó trong một luồng."

msgid "%(file)s does not match its checksum; fetching it again."
msgstr "%(file)s không khớp tổng kiểm tra của nó; đang tải lại."

msgid "Check that the download directory is writable."
msgstr "Hãy kiểm tra xem thư mục tải về có ghi được không."

msgid "%(needed)s is needed for this model but %(path)s has only %(free)s free, %(short)s short of what is wanted with %(headroom)s left spare."
msgstr "Mô hình này cần %(needed)s nhưng %(path)s chỉ còn trống %(free)s, thiếu %(short)s so với mức mong muốn có chừa %(headroom)s dự phòng."

msgid "Free some space, or choose another directory with --dir, or a smaller quantisation with --quant."
msgstr "Hãy giải phóng dung lượng, hoặc chọn thư mục khác bằng --dir, hoặc một bản lượng tử hóa nhỏ hơn bằng --quant."

msgid "could not measure the free space on %(path)s: %(error)s"
msgstr "không đo được chỗ trống trên %(path)s: %(error)s"

msgid "Check that the download directory's volume is available."
msgstr "Hãy kiểm tra xem ổ chứa thư mục tải về có sẵn sàng không."

msgid "%(model)s has no downloadable source in the catalog."
msgstr "%(model)s không có nguồn tải về nào trong danh mục."

msgid "Only Hugging Face sources can be installed; this entry has none."
msgstr "Chỉ các nguồn Hugging Face mới cài được; mục này không có nguồn nào."

msgid "the catalog has no file list for %(model)s %(quant)s."
msgstr "danh mục không có danh sách tệp cho %(model)s %(quant)s."

msgid "Run `llamafit catalog refresh` to fill in the file names."
msgstr "Hãy chạy `llamafit catalog refresh` để điền tên tệp."

msgid "%(model)s publishes no quantisations."
msgstr "%(model)s không công bố bản lượng tử hóa nào."

msgid "%(model)s does not publish a %(quant)s quantisation."
msgstr "%(model)s không công bố bản lượng tử hóa %(quant)s."

msgid "It publishes: %(quants)s"
msgstr "Nó công bố: %(quants)s"

msgid "the catalog does not record how big %(quant)s is."
msgstr "danh mục không ghi %(quant)s lớn bao nhiêu."

msgid "Run `llamafit catalog refresh` to fill in the sizes."
msgstr "Hãy chạy `llamafit catalog refresh` để điền kích thước."

msgid "the catalog holds no checksum for %(files)s."
msgid_plural "the catalog holds no checksums for %(files)s."
msgstr[0] "danh mục không có tổng kiểm tra cho %(files)s."

msgid "Run `llamafit catalog refresh` to fetch them, or pass --allow-unverified to download anyway and check the files yourself."
msgstr "Hãy chạy `llamafit catalog refresh` để lấy chúng, hoặc truyền --allow-unverified để cứ tải về rồi tự kiểm tra các tệp."

msgid "%(done)s of %(total)s"
msgstr "%(done)s trên %(total)s"

msgid "%(rate)s/s"
msgstr "%(rate)s/s"

msgid "Fetching %(file)s (%(size)s)"
msgstr "Đang tải %(file)s (%(size)s)"

msgid "Checking %(file)s against its checksum"
msgstr "Đang đối chiếu %(file)s với tổng kiểm tra của nó"

msgid "Done: %(file)s"
msgstr "Xong: %(file)s"

msgid "could not create %(path)s: %(error)s"
msgstr "không tạo được %(path)s: %(error)s"

msgid "Check that the download directory is writable and has room."
msgstr "Hãy kiểm tra xem thư mục tải về có ghi được và còn chỗ không."

msgid "could not move %(source)s into place: %(error)s"
msgstr "không chuyển được %(source)s vào đúng chỗ: %(error)s"

msgid "could not record progress in %(path)s: %(error)s"
msgstr "không ghi được tiến độ vào %(path)s: %(error)s"

msgid "could not fetch %(url)s: %(error)s"
msgstr "không tải được %(url)s: %(error)s"

msgid "Stopped before the checksum was finished."
msgstr "Đã dừng trước khi kiểm xong tổng kiểm tra."

msgid "could not read %(path)s: %(error)s"
msgstr "không đọc được %(path)s: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "Hãy kiểm tra xem tệp có tồn tại và đọc được không."

msgid "%(file)s is %(actual)d bytes, but the catalog says %(expected)d"
msgstr "%(file)s có %(actual)d byte, nhưng danh mục ghi %(expected)d"

msgid "The transfer was cut short. Run the command again to fetch it properly."
msgstr "Lần truyền bị cắt ngang. Hãy chạy lại lệnh để tải cho đúng."

msgid "%(file)s does not match the checksum the catalog holds."
msgstr "%(file)s không khớp tổng kiểm tra mà danh mục giữ."

msgid "Expected %(expected)s but the file hashes to %(actual)s. The bad copy has been deleted; run the command again to fetch it."
msgstr "Lẽ ra phải là %(expected)s nhưng tệp băm ra %(actual)s. Bản hỏng đã bị xóa; hãy chạy lại lệnh để tải nó."

msgid "Command: %(command)s"
msgstr "Lệnh: %(command)s"

msgid "truncated GGUF header: wanted %(wanted)d byte at offset %(offset)d, got %(got)d"
msgid_plural "truncated GGUF header: wanted %(wanted)d bytes at offset %(offset)d, got %(got)d"
msgstr[0] "phần đầu GGUF bị cắt cụt: cần %(wanted)d byte ở vị trí %(offset)d, nhận được %(got)d"

msgid "The file may still be downloading, or the URL may not be a GGUF file."
msgstr "Tệp có thể vẫn đang tải về, hoặc URL không trỏ tới một tệp GGUF."

msgid "unknown GGUF value type %(type)d at offset %(offset)d"
msgstr "kiểu giá trị GGUF không rõ %(type)d tại vị trí %(offset)d"

msgid "This file may use a newer GGUF metadata type than LlamaFit supports."
msgstr "Tệp này có thể dùng kiểu siêu dữ liệu GGUF mới hơn những gì LlamaFit hỗ trợ."

msgid "not a GGUF file: bad magic %(magic)s at offset 0"
msgstr "không phải tệp GGUF: chuỗi nhận dạng %(magic)s tại vị trí 0 không hợp lệ"

msgid "Check that this file is actually a .gguf model."
msgstr "Hãy kiểm tra xem tệp này có đúng là mô hình .gguf không."

msgid "unsupported GGUF version %(version)d at offset 4"
msgstr "phiên bản GGUF %(version)d không được hỗ trợ, tại vị trí 4"

msgid "LlamaFit supports GGUF versions %(versions)s."
msgstr "LlamaFit hỗ trợ các phiên bản GGUF %(versions)s."

msgid "A memory budget built without these tensors would be too small, so none is built. If llama.cpp loads the file, LlamaFit's tensor-size table is missing the type."
msgstr "Một mức phân bổ bộ nhớ dựng mà thiếu các tensor này sẽ quá nhỏ, nên không dựng gì cả. Nếu llama.cpp nạp được tệp thì bảng kích thước tensor của LlamaFit đang thiếu kiểu đó."

msgid "%(type)d (%(count)d tensor, first %(name)s)"
msgid_plural "%(type)d (%(count)d tensors, first %(name)s)"
msgstr[0] "%(type)d (%(count)d tensor, đầu tiên là %(name)s)"

msgid "cannot size this GGUF file: %(count)d tensor uses a GGML type LlamaFit does not know: %(details)s"
msgid_plural "cannot size this GGUF file: %(count)d tensors use GGML types LlamaFit does not know: %(details)s"
msgstr[0] "không ước lượng được kích thước tệp GGUF này: %(count)d tensor dùng kiểu GGML mà LlamaFit không biết: %(details)s"

msgid "%(count)d shard"
msgid_plural "%(count)d shards"
msgstr[0] "%(count)d mảnh"

msgid "these GGUF files are not one split model: they disagree about '%(key)s', declaring %(values)s"
msgstr "các tệp GGUF này không thuộc cùng một mô hình chia mảnh: chúng khai báo '%(key)s' khác nhau, là %(values)s"

msgid "Pass the shards of one model, not of several."
msgstr "Hãy đưa vào các mảnh của một mô hình, không phải của nhiều mô hình."

msgid "no GGUF header to read facts from"
msgstr "không có phần đầu GGUF để đọc dữ kiện"

msgid "Pass the model's file, or every shard of a split model."
msgstr "Hãy đưa vào tệp của mô hình, hoặc mọi mảnh của một mô hình chia mảnh."

msgid "%(count)d GGUF file of the %(total)d given carries no '%(key)s' key, so its place in a split model cannot be established"
msgid_plural "%(count)d GGUF files of the %(total)d given carry no '%(key)s' key, so their place in a split model cannot be established"
msgstr[0] "%(count)d tệp GGUF trong số %(total)d tệp đã đưa vào không mang khóa '%(key)s', nên không xác định được chỗ của nó trong một mô hình chia mảnh"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "Hãy đưa vào một tệp không chia mảnh riêng lẻ, hoặc mọi mảnh của một mô hình chia mảnh."

msgid "incomplete shard set: the model declares %(shards)s and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "bộ mảnh chưa đủ: mô hình khai báo %(shards)s mà chỉ có %(arrived)d mảnh tới nơi (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "Hãy đưa vào mọi mảnh của mô hình chia mảnh."

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "thiếu mảnh chứa siêu dữ liệu của mô hình: nhận được %(key)s %(numbers)s, trong đó phải có một mảnh mang số 0"

msgid "Pass every shard of the split model, including the first."
msgstr "Hãy đưa vào mọi mảnh của mô hình chia mảnh, kể cả mảnh đầu tiên."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "bộ mảnh chưa đủ: cần %(key)s từ 0 đến %(last)d, nhận được %(numbers)s"

msgid "Pass each shard of the split model exactly once."
msgstr "Hãy đưa mỗi mảnh của mô hình chia mảnh đúng một lần."

msgid "incomplete shard set: the model declares %(tensors)s and its %(shards)s hold %(held)d between them"
msgstr "bộ mảnh chưa đủ: mô hình khai báo %(tensors)s mà %(shards)s của nó gộp lại chỉ giữ %(held)d"

msgid "%(count)d tensor"
msgid_plural "%(count)d tensors"
msgstr[0] "%(count)d tensor"

msgid "Check your network connection and that the URL is reachable."
msgstr "Hãy kiểm tra kết nối mạng và xem URL có truy cập được không."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s trả về HTTP %(status)d thay vì 206 Partial Content; máy chủ có thể không hỗ trợ yêu cầu theo dải."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Hãy xác nhận URL trỏ tới một tệp GGUF tải về được."

msgctxt "CPU model"
msgid "unknown"
msgstr "không rõ"

msgid "nvidia-smi returned no GPUs"
msgstr "nvidia-smi không trả về GPU nào"

msgid "rocm-smi returned no cards"
msgstr "rocm-smi không trả về card nào"

msgid "system_profiler returned no displays"
msgstr "system_profiler không trả về màn hình nào"

msgid "WMI returned no video controllers"
msgstr "WMI không trả về bộ điều khiển video nào"

msgid "lspci found no display controllers"
msgstr "lspci không tìm thấy bộ điều khiển hiển thị nào"

msgid "vulkaninfo reported no discrete device with a memory heap"
msgstr "vulkaninfo không báo thiết bị rời nào có vùng nhớ heap"

msgid "no populated memory modules"
msgstr "không có thanh nhớ nào được gắn"

msgid "no SPMemoryDataType"
msgstr "không có SPMemoryDataType"

msgid "%(program)s: timed out after %(seconds)s second"
msgid_plural "%(program)s: timed out after %(seconds)s seconds"
msgstr[0] "%(program)s: hết thời gian sau %(seconds)s giây"

msgid "empty command"
msgstr "lệnh rỗng"

msgid "%(program)s: %(error)s"
msgstr "%(program)s: %(error)s"

msgid "%(program)s: not found"
msgstr "%(program)s: không tìm thấy"

msgid "exit code %(code)d: %(detail)s"
msgstr "mã thoát %(code)d: %(detail)s"

msgid "no hardware profile file at %(path)s"
msgstr "không có tệp hồ sơ phần cứng ở %(path)s"

msgid "Run `llamafit hardware list` to see the profiles LlamaFit has."
msgstr "Hãy chạy `llamafit hardware list` để xem LlamaFit có những hồ sơ nào."

msgid "%(path)s is not a valid hardware profile: %(details)s"
msgstr "%(path)s không phải là một hồ sơ phần cứng hợp lệ: %(details)s"

msgid "Run `llamafit hardware validate FILE` for the whole list."
msgstr "Hãy chạy `llamafit hardware validate FILE` để xem trọn danh sách."

msgid "no hardware profile named %(name)s"
msgstr "không có hồ sơ phần cứng nào tên %(name)s"

msgid "Profiles LlamaFit has: %(names)s"
msgstr "Các hồ sơ LlamaFit có: %(names)s"

msgid "Run `llamafit hardware path` to see where your own profiles go."
msgstr "Hãy chạy `llamafit hardware path` để xem hồ sơ của riêng bạn nằm ở đâu."

msgid "this machine has no graphics card, so there is no VRAM to override"
msgstr "máy này không có card đồ họa, nên không có VRAM nào để thay"

msgid "Describe the whole machine in a hardware profile and pass --profile."
msgstr "Hãy mô tả trọn cỗ máy trong một hồ sơ phần cứng rồi truyền --profile."

msgid "this machine has one memory pool shared with the graphics card"
msgstr "máy này có một vùng nhớ duy nhất dùng chung với card đồ họa"

msgid "Use --ram to resize the pool; --memory would change only half of it."
msgstr "Hãy dùng --ram để đổi kích thước vùng nhớ; --memory chỉ đổi một nửa của nó."

msgid "%(option)s needs a value above zero"
msgstr "%(option)s cần một giá trị lớn hơn không"

msgid "no build number in the version output: %(text)s"
msgstr "không có số bản dựng trong kết xuất phiên bản: %(text)s"

msgid "llama.cpp not found: no llama-server on PATH, in LLAMA_CPP_PATH or in the usual directories"
msgstr "không tìm thấy llama.cpp: không có llama-server trên PATH, trong LLAMA_CPP_PATH hay trong các thư mục thông thường"

msgid "no ggml backend libraries found next to llama-server; the build may be static"
msgstr "không tìm thấy thư viện backend ggml bên cạnh llama-server; bản dựng có thể là bản tĩnh"

msgid "%(path)s is a file, not a directory."
msgstr "%(path)s là một tệp, không phải một thư mục."

msgid "%(path)s cannot be read: %(error)s"
msgstr "không đọc được %(path)s: %(error)s"

msgid "%(path)s has a marker file that cannot be read."
msgstr "%(path)s có một tệp đánh dấu mà không đọc được."

msgid "%(path)s already holds %(count)d file that LlamaFit did not install."
msgid_plural "%(path)s already holds %(count)d files that LlamaFit did not install."
msgstr[0] "%(path)s đã chứa %(count)d tệp không do LlamaFit cài."

msgid "%(name)s has no published checksum, so it cannot be verified."
msgstr "%(name)s không có tổng kiểm tra công bố, nên không kiểm chứng được."

msgid "Pass --allow-unverified to install it anyway, knowing the archive is unchecked."
msgstr "Hãy truyền --allow-unverified để vẫn cài nó, biết rằng tệp nén chưa được kiểm."

msgid "could not download %(url)s: %(error)s"
msgstr "không tải được %(url)s: %(error)s"

msgid "the connection was closed"
msgstr "kết nối đã bị đóng"

msgid "Run the command again; it continues from where it stopped."
msgstr "Hãy chạy lại lệnh; nó tiếp tục từ chỗ đã dừng."

msgid "the download of %(url)s stopped early: %(error)s"
msgstr "lần tải %(url)s dừng sớm: %(error)s"

msgid "%(got)s of %(want)s arrived"
msgstr "%(got)s trên %(want)s đã tới nơi"

msgid "the disk holding %(path)s is full."
msgstr "đĩa chứa %(path)s đã đầy."

msgid "Free some space and run the command again; the download resumes."
msgstr "Hãy giải phóng dung lượng rồi chạy lại lệnh; lần tải sẽ tiếp tục."

msgid "Check that the directory exists and is writable."
msgstr "Hãy kiểm tra xem thư mục có tồn tại và ghi được không."

msgid "%(name)s did not match its published checksum and was discarded."
msgstr "%(name)s không khớp tổng kiểm tra đã công bố và đã bị bỏ đi."

msgid "Nothing was unpacked. Run the command again: the archive arrived damaged, which a second download usually fixes."
msgstr "Không có gì được giải nén. Hãy chạy lại lệnh: tệp nén tới nơi đã hỏng, mà tải lại lần nữa thường là xong."

msgid "%(archive)s contains %(name)s, which would be written outside the install directory."
msgstr "%(archive)s chứa %(name)s, thứ sẽ được ghi ra ngoài thư mục cài đặt."

msgid "Do not install this archive; report it to the llama.cpp project."
msgstr "Đừng cài tệp nén này; hãy báo cho dự án llama.cpp."

msgid "%(name)s is not an archive LlamaFit knows how to unpack."
msgstr "%(name)s không phải là loại tệp nén mà LlamaFit biết cách giải."

msgid "%(name)s could not be unpacked: %(error)s"
msgstr "không giải nén được %(name)s: %(error)s"

msgid "Delete it and run the command again to download it afresh."
msgstr "Hãy xóa nó rồi chạy lại lệnh để tải mới."

msgid "the archive holds no %(name)s."
msgstr "tệp nén không chứa %(name)s."

msgid "Report this; the release layout has changed."
msgstr "Hãy báo việc này; bố cục bản phát hành đã thay đổi."

msgid "%(path)s was not installed by LlamaFit."
msgstr "%(path)s không do LlamaFit cài."

msgid "Pass --force to replace it, or --dir to install somewhere else. LlamaFit never overwrites an installation it did not create."
msgstr "Hãy truyền --force để thay nó, hoặc --dir để cài chỗ khác. LlamaFit không bao giờ ghi đè lên một bản cài mà nó không tạo ra."

msgid "%(path)s has %(free)s free; this install needs %(needed)s."
msgstr "%(path)s còn trống %(free)s; lần cài này cần %(needed)s."

msgid "Free some space, or pass --dir to install on another volume."
msgstr "Hãy giải phóng dung lượng, hoặc truyền --dir để cài lên ổ khác."

msgid "the %(backend)s libraries are not in the installed directory."
msgstr "các thư viện %(backend)s không có trong thư mục đã cài."

msgid "no ggml backend libraries were installed; the build may be a static one."
msgstr "không có thư viện backend ggml nào được cài; có thể đây là một bản dựng tĩnh."

msgid "Your PATH could not be read, so it will not be changed."
msgstr "Không đọc được PATH của bạn, nên nó sẽ không bị đổi."

msgid "Add %(path)s to your user PATH (HKCU\\Environment)."
msgstr "Thêm %(path)s vào PATH người dùng của bạn (HKCU\\Environment)."

msgid "To undo: run `setx PATH \"%(previous)s\"`, or remove the entry in System > About > Advanced system settings > Environment Variables."
msgstr "Để hoàn tác: chạy `setx PATH \"%(previous)s\"`, hoặc xóa mục đó trong System > About > Advanced system settings > Environment Variables."

msgid "%(path)s is already on your PATH."
msgstr "%(path)s đã có trên PATH của bạn."

msgid "Nothing to undo."
msgstr "Không có gì để hoàn tác."

msgid "Append a PATH line for %(path)s to %(file)s."
msgstr "Thêm một dòng PATH cho %(path)s vào %(file)s."

msgid "To undo: delete the two lines marked `%(mark)s` from %(file)s."
msgstr "Để hoàn tác: xóa hai dòng có dấu `%(mark)s` khỏi %(file)s."

msgid "your PATH could not be changed: %(error)s"
msgstr "không đổi được PATH của bạn: %(error)s"

msgid "To remove it later, delete %(path)s."
msgstr "Để gỡ sau này, hãy xóa %(path)s."

msgid "the most recent %(count)d llama.cpp releases hold no build."
msgstr "%(count)d bản phát hành llama.cpp gần nhất không có bản dựng nào."

msgid "Name one with `llamafit install llama.cpp --tag ...`."
msgstr "Hãy nêu tên một bản bằng `llamafit install llama.cpp --tag ...`."

msgid "could not reach GitHub at %(url)s: %(error)s"
msgstr "không tới được GitHub ở %(url)s: %(error)s"

msgid "GitHub refused the request for %(url)s: the rate limit is exhausted."
msgstr "GitHub từ chối yêu cầu cho %(url)s: đã hết hạn mức truy cập."

msgid "Wait for the limit to reset, or set GITHUB_TOKEN to a personal access token with no scopes."
msgstr "Hãy đợi hạn mức đặt lại, hoặc đặt GITHUB_TOKEN thành một personal access token không có phạm vi nào."

msgid "GitHub has no release at %(url)s."
msgstr "GitHub không có bản phát hành nào ở %(url)s."

msgid "Check the tag with `llamafit install llama.cpp --tag ...`."
msgstr "Hãy kiểm tra thẻ bằng `llamafit install llama.cpp --tag ...`."

msgid "GitHub returned %(status)d for %(url)s."
msgstr "GitHub trả về %(status)d cho %(url)s."

msgid "GitHub's answer for %(url)s was not JSON."
msgstr "Câu trả lời của GitHub cho %(url)s không phải JSON."

msgid "GitHub's answer did not describe a release."
msgstr "Câu trả lời của GitHub không mô tả một bản phát hành."

msgid "no llama-server answering"
msgstr "không có llama-server nào trả lời"

msgid "unexpected response: %(error)s"
msgstr "phản hồi ngoài dự kiến: %(error)s"

msgid "%(model)s holds %(native)s tokens, fewer than the %(minimum)s asked for."
msgstr "%(model)s giữ %(native)s token, ít hơn mức %(minimum)s đã hỏi."

msgid "No configuration of this model fits this machine."
msgstr "Không cấu hình nào của mô hình này vừa máy này."

msgid "Routed experts are held in system memory, and so are the always-on shared experts, which is what -ot ffn_.*_shexp=CPU does; attention and the KV cache stay on the card."
msgstr "Các chuyên gia được định tuyến nằm trong bộ nhớ hệ thống, và các chuyên gia dùng chung luôn bật cũng vậy, đó là việc mà -ot ffn_.*_shexp=CPU làm; phần chú ý và bộ đệm KV vẫn ở trên card."

msgid "Routed experts are held in system memory; attention, the KV cache and the shared experts stay on the card."
msgstr "Các chuyên gia được định tuyến nằm trong bộ nhớ hệ thống; phần chú ý, bộ đệm KV và các chuyên gia dùng chung vẫn ở trên card."

msgid "%(layers)s layers are on the card and the rest run on the processor."
msgstr "%(layers)s lớp nằm trên card và phần còn lại chạy trên bộ xử lý."

msgid "Nothing runs on a graphics card: every weight is in system memory."
msgstr "Không có gì chạy trên card đồ họa: mọi trọng số đều nằm trong bộ nhớ hệ thống."

msgid "%(gpus)s is here, but nothing could read how much of it is free, so this plan was made as if it were not. The real machine will be faster than these figures."
msgstr "%(gpus)s có ở đây, nhưng không gì đọc được nó còn trống bao nhiêu, nên kế hoạch này được lập như thể không có nó. Cỗ máy thật sẽ nhanh hơn các con số này."

msgid "Sized for %(context)s tokens rather than the %(requested)s asked for."
msgstr "Tính cho %(context)s token thay vì %(requested)s như đã hỏi."

msgid "The KV cache is quantised to %(type)s to reach this context."
msgstr "Bộ đệm KV được lượng tử hóa thành %(type)s để đạt tới ngữ cảnh này."

msgid "Vision is off: the projector did not fit, on the card or in system memory."
msgstr "Thị giác đã tắt: projector không vừa, cả trên card lẫn trong bộ nhớ hệ thống."

msgid "The vision projector is in system memory (--no-mmproj-offload), which costs nothing measurable for text and makes images slower."
msgstr "Projector thị giác nằm trong bộ nhớ hệ thống (--no-mmproj-offload), việc này không tốn gì đáng kể với văn bản và làm ảnh chậm hơn."

msgid "%(threads)s threads, not the %(available)s this processor has: the efficiency cores are left out because generation measures slower with them, and what is left is the threads the performance cores provide."
msgstr "%(threads)s luồng, không phải %(available)s luồng mà bộ xử lý này có: các nhân tiết kiệm điện bị bỏ ra vì có chúng thì tốc độ sinh đo được còn chậm hơn, và phần còn lại là số luồng mà các nhân hiệu năng cung cấp."

msgid "Tight: %(vram)s of the graphics card is free and this needs %(needed)s, so another program can push it over. The context tier table is how a launch script recovers."
msgstr "Sát: card đồ họa còn trống %(vram)s mà cái này cần %(needed)s, nên một chương trình khác có thể đẩy nó quá mức. Bảng các bậc ngữ cảnh là cách một kịch bản khởi chạy lùi lại."

msgid "no %(capability)s capability, which %(use_case)s needs; ask for a different use case, or add it to the entry when the model really has it"
msgstr "không có khả năng %(capability)s, thứ mà %(use_case)s cần; hãy hỏi một trường hợp sử dụng khác, hoặc thêm khả năng đó vào mục khi mô hình thật sự có"

msgid "no %(capability)s capability; drop it from the request to see this model"
msgstr "không có khả năng %(capability)s; hãy bỏ nó khỏi yêu cầu để thấy mô hình này"

msgid "%(size)s to download, over the %(limit)s this request allows"
msgstr "phải tải về %(size)s, vượt mức %(limit)s mà yêu cầu này cho phép"

msgid "unknown quantisation %(quant)s, so its cost in quality cannot be told"
msgstr "bản lượng tử hóa %(quant)s không rõ, nên không biết nó mất bao nhiêu chất lượng"

msgid "nowhere to put it: no placement fits this machine at any context"
msgstr "không có chỗ đặt: không cách bố trí nào vừa máy này ở bất kỳ ngữ cảnh nào"

msgid "holds %(fit)s tokens at most, under the %(minimum)s asked for; lower the minimum context or free memory to see it ranked"
msgstr "giữ được nhiều nhất %(fit)s token, dưới mức %(minimum)s đã hỏi; hãy hạ ngữ cảnh tối thiểu hoặc giải phóng bộ nhớ để thấy nó được xếp hạng"

msgid "generates %(tps)s tokens per second, below the %(floor)s this request asks for; lower --min-tps or choose a smaller model or quantisation"
msgstr "sinh %(tps)s token mỗi giây, dưới mức %(floor)s mà yêu cầu này đòi hỏi; hãy hạ --min-tps hoặc chọn mô hình hay bản lượng tử hóa nhỏ hơn"

msgid "generates %(tps)s tokens per second, below the %(floor)s a person reads at: a batch tool on this machine and not one to sit in front of; a smaller model or quantisation would keep up"
msgstr "sinh %(tps)s token mỗi giây, dưới tốc độ đọc %(floor)s của một người: trên máy này nó là công cụ chạy nền chứ không phải thứ để ngồi trước mà dùng; một mô hình hay bản lượng tử hóa nhỏ hơn sẽ theo kịp"

msgid "unknown use case %(use_case)s"
msgstr "trường hợp sử dụng không rõ: %(use_case)s"

msgid "Known use cases: %(known)s."
msgstr "Các trường hợp sử dụng đã biết: %(known)s."

msgid "unknown score part %(part)s in the weights for %(use_case)s"
msgstr "phần điểm không rõ %(part)s trong các trọng số của %(use_case)s"

msgid "The parts are: %(parts)s."
msgstr "Các phần là: %(parts)s."

msgid "the weights for %(use_case)s leave out %(part)s"
msgstr "các trọng số của %(use_case)s bỏ sót %(part)s"

msgid "Overriding a use case means giving all four parts: %(parts)s."
msgstr "Ghi đè một trường hợp sử dụng nghĩa là phải cho đủ bốn phần: %(parts)s."

msgid "the weight for %(part)s in %(use_case)s is below zero"
msgstr "trọng số của %(part)s trong %(use_case)s nhỏ hơn không"

msgid "A weight says how much a part counts; it cannot count less than none."
msgstr "Một trọng số nói một phần đáng kể đến đâu; nó không thể đáng kể ít hơn không."

msgid "the weights for %(use_case)s add up to nothing"
msgstr "các trọng số của %(use_case)s cộng lại bằng không"

msgid "At least one part has to count for something."
msgstr "Ít nhất một phần phải đáng kể một chút."

msgid "unknown preference %(prefer)s"
msgstr "thiên hướng không rõ: %(prefer)s"

msgid "Preferences: %(known)s."
msgstr "Các thiên hướng: %(known)s."

msgid "Install or repair the NVIDIA driver; nvidia-smi ships with it and must be on PATH."
msgstr "Hãy cài hoặc sửa trình điều khiển NVIDIA; nvidia-smi đi kèm với nó và phải nằm trên PATH."

msgid "Install ROCm (Linux) to expose AMD VRAM figures; without it the GPU is listed by name only."
msgstr "Hãy cài ROCm (Linux) để lộ ra các con số VRAM của AMD; không có nó thì GPU chỉ được liệt kê bằng tên."

msgid "PowerShell could not list video controllers; run from a normal user session."
msgstr "PowerShell không liệt kê được bộ điều khiển video; hãy chạy từ một phiên người dùng bình thường."

msgid "Install pciutils to list GPUs by name when no vendor tool is available."
msgstr "Hãy cài pciutils để liệt kê GPU theo tên khi không có công cụ của nhà cung cấp."

msgid "DDR type and speed were not readable; on Linux run once with sudo (dmidecode) or accept the measured bandwidth instead."
msgstr "Không đọc được loại và tốc độ DDR; trên Linux hãy chạy một lần với sudo (dmidecode), hoặc chấp nhận băng thông đo được."

msgid "py-cpuinfo failed; the CPU model and instruction sets are unknown."
msgstr "py-cpuinfo thất bại; không rõ kiểu CPU và các tập lệnh."

msgid "psutil could not count the CPU cores; thread choice falls back to one core. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil không đếm được số nhân CPU; số luồng lùi về một nhân. Hãy cài lại psutil bằng `pip install --force-reinstall psutil`."

msgid "psutil could not read the memory totals; budgets cannot be computed until this works. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil không đọc được tổng bộ nhớ; chưa thể tính mức phân bổ cho đến khi việc này chạy được. Hãy cài lại psutil bằng `pip install --force-reinstall psutil`."

msgid "Could not read performance-core count from sysctl."
msgstr "Không đọc được số nhân hiệu năng từ sysctl."

msgid "llama-server exists but did not report a version; the binary may be broken."
msgstr "llama-server có tồn tại nhưng không báo phiên bản; tệp thực thi có thể đã hỏng."

msgid "system_profiler failed; GPU information is unavailable."
msgstr "system_profiler thất bại; không có thông tin về GPU."

msgid "Install the Vulkan tools (vulkan-tools on Linux, the vendor's Vulkan runtime on Windows) so an unsized card's memory can be read from its driver. This probe runs only when no vendor tool sized the card, so it is the last source there is."
msgstr "Hãy cài bộ công cụ Vulkan (vulkan-tools trên Linux, bản Vulkan runtime của nhà cung cấp trên Windows) để dung lượng của một card chưa rõ kích thước đọc được từ trình điều khiển của nó. Phép dò này chỉ chạy khi không công cụ nào của nhà cung cấp đo được card, nên nó là nguồn cuối cùng."

msgid "No vendor tool reported the GPU's memory size; record the size in a hardware profile so budgets can be computed for this machine."
msgstr "Không công cụ nào của nhà cung cấp báo dung lượng bộ nhớ của GPU; hãy ghi dung lượng đó vào một hồ sơ phần cứng để tính được mức phân bổ cho máy này."

msgid "llama.cpp installed"
msgstr "llama.cpp đã được cài"

msgid "build %(build)s at %(path)s, backends: %(backends)s"
msgstr "bản dựng %(build)s tại %(path)s, backend: %(backends)s"

msgctxt "llama.cpp build"
msgid "unknown"
msgstr "không rõ"

msgid "llama.cpp not found"
msgstr "không tìm thấy llama.cpp"

msgid "no llama-server binary was found"
msgstr "không tìm thấy tệp thực thi llama-server"

msgid "Run `llamafit install llama.cpp`, which picks the right build for this machine, checks it against its published checksum, and never touches an installation LlamaFit did not create."
msgstr "Hãy chạy `llamafit install llama.cpp`: nó chọn bản dựng đúng cho máy này, đối chiếu với tổng kiểm tra đã công bố, và không bao giờ đụng vào một bản cài mà LlamaFit không tạo ra."

msgid "Memory size unknown"
msgstr "Không rõ dung lượng bộ nhớ"

msgid "LlamaFit could not read this machine's memory totals, so it cannot work out what will fit."
msgstr "LlamaFit không đọc được tổng bộ nhớ của máy này, nên không tính được cái gì vừa."

msgid "%(gpu)s: no %(backend)s backend in llama.cpp"
msgstr "%(gpu)s: llama.cpp không có backend %(backend)s"

msgid "llama.cpp was built with: %(backends)s"
msgstr "llama.cpp được dựng với: %(backends)s"

msgctxt "backends"
msgid "unknown"
msgstr "không rõ"

msgid "Install a llama.cpp build with the %(backend)s or Vulkan backend to use %(gpu)s."
msgstr "Hãy cài một bản dựng llama.cpp có backend %(backend)s hoặc Vulkan để dùng %(gpu)s."

msgid "%(gpu)s: VRAM size unknown"
msgstr "%(gpu)s: không rõ dung lượng VRAM"

msgid "the vendor tool that reports memory was not available"
msgstr "không có công cụ của nhà cung cấp để báo bộ nhớ"

msgid "%(gpus)s: planned around, not planned on"
msgstr "%(gpus)s: được lập kế hoạch né đi, chứ không phải lập kế hoạch trên nó"

msgid "with no reading of how much of the card is free, every budget and every speed on this machine was computed as if there were no card: they are CPU-only figures, and the real machine will be faster."
msgstr "vì không đọc được card còn trống bao nhiêu, mọi mức phân bổ và mọi tốc độ trên máy này đều được tính như thể không có card: chúng là những con số chỉ dùng CPU, và cỗ máy thật sẽ nhanh hơn."

msgid "Install the Vulkan tools so the size can be read from the driver, or record it in a hardware profile (`llamafit hardware path` says where those go) and pass --profile."
msgstr "Hãy cài bộ công cụ Vulkan để đọc được dung lượng từ trình điều khiển, hoặc ghi nó vào một hồ sơ phần cứng (`llamafit hardware path` cho biết hồ sơ nằm ở đâu) rồi truyền --profile."

msgid "No GPU detected"
msgstr "Không phát hiện GPU"

msgid "models will run on the CPU only"
msgstr "các mô hình sẽ chỉ chạy trên CPU"

msgid "If a GPU is present, check that its driver tools are installed."
msgstr "Nếu máy có GPU, hãy kiểm tra xem công cụ trình điều khiển của nó đã được cài chưa."

msgid "RAM bandwidth assumed"
msgstr "Băng thông RAM là giả định"

msgid "using %(gbps)s GB/s as a default"
msgstr "đang dùng %(gbps)s GB/s làm mặc định"

msgid "Install numpy (`pip install llamafit[fast]`) so LlamaFit can measure the RAM bandwidth."
msgstr "Hãy cài numpy (`pip install llamafit[fast]`) để LlamaFit đo được băng thông RAM."

msgid "Probe %(probe)s failed"
msgstr "Phép dò %(probe)s thất bại"

msgctxt "probe error"
msgid "unknown error"
msgstr "lỗi không rõ"

msgid "llama-server running at %(url)s"
msgstr "llama-server đang chạy tại %(url)s"

msgid "model %(model)s, context %(context)s"
msgstr "mô hình %(model)s, ngữ cảnh %(context)s"

msgctxt "model name"
msgid "unknown"
msgstr "không rõ"

msgid "Low disk space on %(path)s"
msgstr "Sắp hết dung lượng đĩa trên %(path)s"

msgid "%(size)s free"
msgstr "còn trống %(size)s"

msgid "Most useful models need 5 to 120 GB; free space or change the downloads directory."
msgstr "Phần lớn mô hình hữu dụng cần từ 5 đến 120 GB; hãy giải phóng dung lượng hoặc đổi thư mục tải về."

msgid "%(model)s has no %(quant)s quantisation"
msgstr "%(model)s không có bản lượng tử hóa %(quant)s"

msgid "It publishes: %(names)s"
msgstr "Nó công bố: %(names)s"

msgid "licensed %(spdx)s, which this request does not allow"
msgstr "có giấy phép %(spdx)s, thứ mà yêu cầu này không cho phép"

msgid "System memory bandwidth was not measured; %(gbps).0f GB/s assumed for %(arch)s."
msgstr "Băng thông bộ nhớ hệ thống chưa được đo; giả định %(gbps).0f GB/s cho %(arch)s."

msgid "%(gpu)s bandwidth is unknown; the %(backend)s fallback of %(gbps).0f GB/s stands in."
msgstr "Không rõ băng thông của %(gpu)s; dùng tạm giá trị dự phòng %(gbps).0f GB/s của %(backend)s."

msgid "No graphics card compute figure: prompt processing is estimated on the CPU."
msgstr "Không có số tính toán của card đồ họa: việc xử lý prompt được ước tính trên CPU."

msgid "%(gb).2f GB of routed experts is read from system memory per token at %(eff).2f of its %(raw).0f GB/s, because each token selects a different handful of experts and the read is a scatter of small blocks rather than a stream."
msgstr "Mỗi token đọc %(gb).2f GB chuyên gia được định tuyến từ bộ nhớ hệ thống ở %(eff).2f mức %(raw).0f GB/s của nó, vì mỗi token chọn một nhúm chuyên gia khác nhau nên đây là đọc rải rác nhiều khối nhỏ chứ không phải đọc một dòng liền."

msgid "%(gb).2f GB of contiguous weights is read from system memory per token at %(eff).2f of its %(raw).0f GB/s."
msgstr "Mỗi token đọc %(gb).2f GB trọng số liền mạch từ bộ nhớ hệ thống ở %(eff).2f mức %(raw).0f GB/s của nó."

msgid "No active parameter count was supplied; it was inferred from the weight bytes."
msgstr "Không có số tham số hoạt động nào được cung cấp; nó được suy ra từ số byte trọng số."

msgid "%(pct).0f percent of the layers sit in system memory, so that share of the prompt arithmetic is charged to the CPU at %(tflops).2f TFLOP/s rather than to the card. Both rates come from one small dense model on one machine."
msgstr "%(pct).0f phần trăm số lớp nằm trong bộ nhớ hệ thống, nên chừng ấy phần phép tính của prompt được tính cho CPU ở %(tflops).2f TFLOP/s chứ không phải cho card. Cả hai mức đều lấy từ một mô hình dày đặc nhỏ trên một máy."

msgid "%(gb).1f GB of the expert set is streamed across the link once per micro-batch at %(gbps).1f GB/s. That rate was fitted on the one model whose expert set does not fit in system memory, so part of its read comes off the disk; an expert set that stays in the page cache streams about three times faster, and for one of those this term is that much too slow."
msgstr "Mỗi lô nhỏ một lần, %(gb).1f GB của tập chuyên gia được truyền qua đường liên kết ở %(gbps).1f GB/s. Mức đó được khớp trên mô hình duy nhất có tập chuyên gia không vừa bộ nhớ hệ thống, nên một phần việc đọc lấy từ đĩa; một tập chuyên gia nằm gọn trong bộ nhớ đệm trang sẽ truyền nhanh hơn chừng ba lần, và với một mô hình như thế thì số hạng này chậm hơn thực tế đúng chừng ấy."

msgid "%(gb).1f GB of the expert set is read out of system memory once per micro-batch at %(gbps).1f GB/s, because there is no card to stream it to."
msgstr "Mỗi lô nhỏ một lần, %(gb).1f GB của tập chuyên gia được đọc ra từ bộ nhớ hệ thống ở %(gbps).1f GB/s, vì không có card nào để truyền tới."

msgid "No placement of this model on this machine could run it."
msgstr "Không cách bố trí nào của mô hình này trên máy này chạy được nó."

msgid "Generation is a benchmark of this configuration, not a prediction."
msgstr "Tốc độ sinh là một phép đo của chính cấu hình này, không phải dự đoán."

msgid "Generation is the formula corrected by %(factor).2f, from a benchmark of %(profile)s on this machine taken on %(date)s."
msgstr "Tốc độ sinh là công thức đã hiệu chỉnh theo hệ số %(factor).2f, từ một phép đo %(profile)s trên máy này lấy ngày %(date)s."

msgid "Prompt processing is a benchmark of this configuration."
msgstr "Việc xử lý prompt là một phép đo của chính cấu hình này."

msgid "Prompt processing is the formula corrected by %(factor).2f from a benchmark."
msgstr "Việc xử lý prompt là công thức đã hiệu chỉnh theo hệ số %(factor).2f từ một phép đo."

msgid "That benchmark's command line does not record how many layers went to the card, so the correction assumes it ran at this placement."
msgstr "Dòng lệnh của phép đo đó không ghi lại có bao nhiêu lớp lên card, nên phép hiệu chỉnh giả định nó đã chạy với cách bố trí này."

msgid "This figure assumes nothing pages: a placement this tight often does, silently."
msgstr "Con số này giả định không có gì bị đẩy bộ nhớ: một cách bố trí sát như thế này thì thường có, mà lại lặng lẽ."

