msgstr "%(counted)s, theo %(sort)s, hiện %(filter)s."

msgid "Nothing was ranked. Every candidate is listed below with the reason; widen the request or free some memory."
msgstr "Không có gì được xếp hạng. Mọi ứng viên đều được liệt kê bên dưới kèm lý do; hãy nới rộng yêu cầu hoặc giải phóng bớt bộ nhớ."

msgid "Recommended"
msgstr "Khuyến nghị"

msgid "--min-tps 0: nobody is waiting on these tokens, so nothing was excluded for generating more slowly than a person reads."
msgstr "--min-tps 0: không ai phải chờ các token này, nên không có gì bị loại vì sinh chậm hơn tốc độ đọc của một người."

msgid "--min-tps %(tps)s: this board wanted at least that many tokens per second, and anything slower is excluded below rather than ranked here."
msgstr "--min-tps %(tps)s: bảng này đòi ít nhất bấy nhiêu token mỗi giây, nên thứ gì chậm hơn đều bị loại ở bên dưới chứ không được xếp hạng ở đây."

msgid "Showing the best %(shown)s of %(total)s that qualified; --limit sets how many, and the rest are neither worse-behaved nor hidden, only further down."
msgstr "Đang hiện %(shown)s bản tốt nhất trong %(total)s bản đạt yêu cầu; --limit quyết định bao nhiêu, và phần còn lại không tệ hơn cũng không bị giấu, chỉ là nằm thấp hơn."

msgid "%(gpus)s is on this machine and nothing could read how much of it is free, so every speed above is a CPU-only speed. `llamafit doctor` says how to fix that."
msgstr "%(gpus)s có trên máy này mà không gì đọc được nó còn trống bao nhiêu, nên mọi tốc độ ở trên đều là tốc độ chỉ dùng CPU. `llamafit doctor` cho biết cách sửa."

msgid "Speeds are for %(working)s tokens of context so every row compares like with like; the context column is the largest each one holds. Sized and scored for %(use_case)s at %(requested)s tokens."
msgstr "Tốc độ tính ở ngữ cảnh %(working)s token để mọi dòng so sánh ngang nhau; cột ngữ cảnh là mức lớn nhất mỗi dòng giữ được. Kích thước và điểm tính cho %(use_case)s ở %(requested)s token."

msgid "Speeds are for %(working)s tokens of context so every row compares like with like; the context column is the largest each one holds. Sized for %(planned)s tokens and scored for %(use_case)s against %(requested)s."
msgstr "Tốc độ tính ở ngữ cảnh %(working)s token để mọi dòng so sánh ngang nhau; cột ngữ cảnh là mức lớn nhất mỗi dòng giữ được. Kích thước tính cho %(planned)s token và điểm tính cho %(use_case)s so với %(requested)s."

msgid "Weights: %(weights)s."
msgstr "Trọng số: %(weights)s."

msgid "Computed with %(ram_free)s of %(ram_total)s system memory free, no card."
msgstr "Tính với %(ram_free)s trên %(ram_total)s bộ nhớ hệ thống còn trống, không có card."

msgid "Computed with %(ram_free)s of %(ram_total)s system memory free and %(vram_free)s of %(vram_total)s free on the %(gpu)s."
msgstr "Tính với %(ram_free)s trên %(ram_total)s bộ nhớ hệ thống còn trống và %(vram_free)s trên %(vram_total)s còn trống trên %(gpu)s."

msgid "Every speed above is derived from %(bandwidth)s of memory bandwidth."
msgstr "Mọi tốc độ ở trên đều suy ra từ băng thông bộ nhớ %(bandwidth)s."

msgid "That bandwidth was kept from an earlier run on this machine; `llamafit system --refresh-bandwidth` times it again."
msgstr "Băng thông đó được giữ lại từ một lần chạy trước trên máy này; `llamafit system --refresh-bandwidth` sẽ đo lại."

msgid "generates fewer than the %(floor)s tokens per second this request asks for; lower --min-tps or choose a smaller model or quantisation"
msgstr "sinh ít hơn %(floor)s token mỗi giây mà yêu cầu này đòi hỏi; hãy hạ --min-tps hoặc chọn mô hình hay bản lượng tử hóa nhỏ hơn"

msgid "generates fewer than the %(floor)s tokens per second a person reads at: a batch tool on this machine and not one to sit in front of; a smaller model or quantisation would keep up"
msgstr "sinh ít hơn %(floor)s token mỗi giây, tức tốc độ đọc của một người: trên máy này nó là công cụ chạy nền chứ không phải thứ để ngồi trước mà dùng; một mô hình hay bản lượng tử hóa nhỏ hơn sẽ theo kịp"

msgid "%(tps)s tok/s"
