msgstr "nvidia-smi không trả về GPU nào"

msgid "rocm-smi returned no cards"
msgstr "rocm-smi không trả về card nào"

msgid "system_profiler returned no displays"
msgstr "system_profiler không trả về màn hình nào"

msgid "WMI returned no video controllers"
msgstr "WMI không trả về bộ điều khiển video nào"

msgid "lspci found no display controllers"
msgstr "lspci không tìm thấy bộ điều khiển hiển thị nào"

