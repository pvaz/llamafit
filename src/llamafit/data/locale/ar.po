msgid "running as %(mode)s"
msgstr "التي تعمل بوضع %(mode)s"

msgid "at least %(tps)s tokens per second"
msgstr "%(tps)s رمز في الثانية على الأقل"

msgid "no more than %(size)s to download"
msgstr "بما لا يتجاوز %(size)s للتنزيل"

