msgstr "يدعم LlamaFit إصدارات GGUF التالية: %(versions)s."

msgid "A memory budget built without these tensors would be too small, so none is built. If llama.cpp loads the file, LlamaFit's tensor-size table is missing the type."
msgstr "ميزانية ذاكرة تُبنى بدون هذه الموتّرات ستكون أصغر من اللازم، لذا لا تُبنى أي ميزانية. وإذا حمّل llama.cpp الملف، فإن جدول أحجام الموتّرات في LlamaFit تنقصه هذا النوع."

msgid "%(type)d (%(count)d tensor, first %(name)s)"
msgid_plural "%(type)d (%(count)d tensors, first %(name)s)"
msgstr[0] "%(type)d (%(count)d موتّر، أولها %(name)s)"
msgstr[1] "%(type)d (%(count)d موتّر، أولها %(name)s)"
msgstr[2] "%(type)d (%(count)d موتّران، أولها %(name)s)"
msgstr[3] "%(type)d (%(count)d موتّرات، أولها %(name)s)"
msgstr[4] "%(type)d (%(count)d موتّرًا، أولها %(name)s)"
msgstr[5] "%(type)d (%(count)d موتّر، أولها %(name)s)"

msgid "cannot size this GGUF file: %(count)d tensor uses a GGML type LlamaFit does not know: %(details)s"
msgid_plural "cannot size this GGUF file: %(count)d tensors use GGML types LlamaFit does not know: %(details)s"
msgstr[0] "تعذّر تحديد حجم ملف GGUF هذا: %(count)d موتّر يستخدم نوع GGML لا يعرفه LlamaFit: %(details)s"
msgstr[1] "تعذّر تحديد حجم ملف GGUF هذا: %(count)d موتّر يستخدم نوع GGML لا يعرفه LlamaFit: %(details)s"
msgstr[2] "تعذّر تحديد حجم ملف GGUF هذا: %(count)d موتّران يستخدمان أنواع GGML لا يعرفها LlamaFit: %(details)s"
msgstr[3] "تعذّر تحديد حجم ملف GGUF هذا: %(count)d موتّرات تستخدم أنواع GGML لا يعرفها LlamaFit: %(details)s"
msgstr[4] "تعذّر تحديد حجم ملف GGUF هذا: %(count)d موتّرًا يستخدم أنواع GGML لا يعرفها LlamaFit: %(details)s"
msgstr[5] "تعذّر تحديد حجم ملف GGUF هذا: %(count)d موتّر يستخدم أنواع GGML لا يعرفها LlamaFit: %(details)s"

msgid "%(count)d shard"
msgid_plural "%(count)d shards"
msgstr[0] "%(count)d جزء"
msgstr[1] "%(count)d جزء"
msgstr[2] "%(count)d جزءان"
msgstr[3] "%(count)d أجزاء"
msgstr[4] "%(count)d جزءًا"
msgstr[5] "%(count)d جزء"

msgid "these GGUF files are not one split model: they disagree about '%(key)s', declaring %(values)s"
msgstr "ملفات GGUF هذه ليست نموذجًا مقسّمًا واحدًا: تختلف حول '%(key)s'، إذ تعلن %(values)s"

msgid "Pass the shards of one model, not of several."
msgstr "مرّر أجزاء نموذج واحد، لا أجزاء عدة نماذج."

msgid "no GGUF header to read facts from"
msgstr "لا توجد ترويسة GGUF تُقرأ منها الحقائق"

msgid "Pass the model's file, or every shard of a split model."
msgstr "مرّر ملف النموذج، أو كل أجزاء النموذج المقسّم."

msgid "%(count)d GGUF file of the %(total)d given carries no '%(key)s' key, so its place in a split model cannot be established"
msgid_plural "%(count)d GGUF files of the %(total)d given carry no '%(key)s' key, so their place in a split model cannot be established"
msgstr[0] "%(count)d من ملفات GGUF الـ %(total)d المُعطاة لا يحمل المفتاح '%(key)s'، لذا لا يمكن تحديد موضعه في نموذج مقسّم"
msgstr[1] "%(count)d من ملفات GGUF الـ %(total)d المُعطاة لا يحمل المفتاح '%(key)s'، لذا لا يمكن تحديد موضعه في نموذج مقسّم"
msgstr[2] "%(count)d من ملفات GGUF الـ %(total)d المُعطاة لا يحملان المفتاح '%(key)s'، لذا لا يمكن تحديد موضعهما في نموذج مقسّم"
msgstr[3] "%(count)d من ملفات GGUF الـ %(total)d المُعطاة لا تحمل المفتاح '%(key)s'، لذا لا يمكن تحديد مواضعها في نموذج مقسّم"
msgstr[4] "%(count)d من ملفات GGUF الـ %(total)d المُعطاة لا تحمل المفتاح '%(key)s'، لذا لا يمكن تحديد مواضعها في نموذج مقسّم"
msgstr[5] "%(count)d من ملفات GGUF الـ %(total)d المُعطاة لا تحمل المفتاح '%(key)s'، لذا لا يمكن تحديد مواضعها في نموذج مقسّم"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "مرّر ملفًا واحدًا غير مقسّم بمفرده، أو كل أجزاء نموذج مقسّم واحد."

msgid "incomplete shard set: the model declares %(shards)s and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "مجموعة أجزاء ناقصة: يعلن النموذج %(shards)s ووصل %(arrived)d (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "مرّر كل أجزاء النموذج المقسّم."

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "الجزء الذي يحمل البيانات الوصفية للنموذج مفقود: وصل %(key)s %(numbers)s، وكان المتوقّع أن يكون أحدها 0"

msgid "Pass every shard of the split model, including the first."
msgstr "مرّر كل أجزاء النموذج المقسّم، بما فيها الأول."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "مجموعة أجزاء ناقصة: كان المتوقّع %(key)s من 0 إلى %(last)d، ووصل %(numbers)s"

msgid "Pass each shard of the split model exactly once."
msgstr "مرّر كل جزء من النموذج المقسّم مرة واحدة بالضبط."

msgid "incomplete shard set: the model declares %(tensors)s and its %(shards)s hold %(held)d between them"
msgstr "مجموعة أجزاء ناقصة: يعلن النموذج %(tensors)s وتحمل %(shards)s فيما بينها %(held)d"

msgid "%(count)d tensor"
msgid_plural "%(count)d tensors"
msgstr[0] "%(count)d موتّر"
msgstr[1] "%(count)d موتّر"
msgstr[2] "%(count)d موتّران"
msgstr[3] "%(count)d موتّرات"
msgstr[4] "%(count)d موتّرًا"
msgstr[5] "%(count)d موتّر"

msgid "Check your network connection and that the URL is reachable."
msgstr "تحقّق من اتصال الشبكة ومن إمكانية الوصول إلى العنوان."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "أرجع %(url)s الرمز HTTP %(status)d بدل 206 Partial Content؛ قد لا يدعم الخادم طلبات النطاقات."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "تأكّد من أن العنوان يشير إلى ملف GGUF قابل للتنزيل."

msgctxt "CPU model"
msgid "unknown"
msgstr "غير معروف"

msgid "nvidia-smi returned no GPUs"
msgstr "لم يُرجع nvidia-smi أي GPU"

msgid "rocm-smi returned no cards"
msgstr "لم يُرجع rocm-smi أي بطاقة"

msgid "system_profiler returned no displays"
msgstr "لم يُرجع system_profiler أي شاشة"

msgid "WMI returned no video controllers"
msgstr "لم يُرجع WMI أي متحكّم فيديو"

msgid "lspci found no display controllers"
msgstr "لم يجد lspci أي متحكّم عرض"

msgid "vulkaninfo reported no discrete device with a memory heap"
msgstr "لم يُبلّغ vulkaninfo عن أي جهاز منفصل بكومة ذاكرة"

msgid "no populated memory modules"
msgstr "لا توجد وحدات ذاكرة مركّبة"

msgid "no SPMemoryDataType"
msgstr "لا يوجد SPMemoryDataType"

msgid "%(program)s: timed out after %(seconds)s second"
msgid_plural "%(program)s: timed out after %(seconds)s seconds"
msgstr[0] "%(program)s: انتهت المهلة بعد %(seconds)s ثانية"
msgstr[1] "%(program)s: انتهت المهلة بعد %(seconds)s ثانية"
msgstr[2] "%(program)s: انتهت المهلة بعد %(seconds)s ثانيتين"
msgstr[3] "%(program)s: انتهت المهلة بعد %(seconds)s ثوانٍ"
msgstr[4] "%(program)s: انتهت المهلة بعد %(seconds)s ثانيةً"
msgstr[5] "%(program)s: انتهت المهلة بعد %(seconds)s ثانية"

msgid "empty command"
msgstr "أمر فارغ"

msgid "%(program)s: %(error)s"
msgstr "%(program)s: %(error)s"

msgid "%(program)s: not found"
msgstr "%(program)s: غير موجود"

msgid "exit code %(code)d: %(detail)s"
msgstr "رمز الخروج %(code)d: %(detail)s"

msgid "no hardware profile file at %(path)s"
msgstr "لا يوجد ملف تعريف عتاد في %(path)s"

msgid "Run `llamafit hardware list` to see the profiles LlamaFit has."
msgstr "نفّذ `llamafit hardware list` لعرض ملفات التعريف المتوفّرة في LlamaFit."

msgid "%(path)s is not a valid hardware profile: %(details)s"
msgstr "%(path)s ليس ملف تعريف عتاد صالحًا: %(details)s"

msgid "Run `llamafit hardware validate FILE` for the whole list."
msgstr "نفّذ `llamafit hardware validate FILE` للاطلاع على القائمة كاملة."

msgid "no hardware profile named %(name)s"
msgstr "لا يوجد ملف تعريف عتاد باسم %(name)s"

msgid "Profiles LlamaFit has: %(names)s"
msgstr "ملفات التعريف المتوفّرة في LlamaFit: %(names)s"

msgid "Run `llamafit hardware path` to see where your own profiles go."
msgstr "نفّذ `llamafit hardware path` لمعرفة أين توضع ملفاتك الخاصة."

msgid "this machine has no graphics card, so there is no VRAM to override"
msgstr "لا يملك هذا الجهاز بطاقة رسوميات، فلا توجد VRAM لتجاوزها"

msgid "Describe the whole machine in a hardware profile and pass --profile."
msgstr "صف الجهاز كاملًا في ملف تعريف عتاد ومرّر --profile."

msgid "this machine has one memory pool shared with the graphics card"
msgstr "يملك هذا الجهاز مجمّع ذاكرة واحدًا مشتركًا مع بطاقة الرسوميات"

msgid "Use --ram to resize the pool; --memory would change only half of it."
msgstr "استخدم --ram لتغيير حجم المجمّع؛ إذ لن يغيّر --memory سوى نصفه."

msgid "%(option)s needs a value above zero"
msgstr "يحتاج %(option)s إلى قيمة أكبر من صفر"

msgid "no build number in the version output: %(text)s"
msgstr "لا يوجد رقم بناء في مخرجات الإصدار: %(text)s"

msgid "llama.cpp not found: no llama-server on PATH, in LLAMA_CPP_PATH or in the usual directories"
msgstr "لم يُعثر على llama.cpp: لا يوجد llama-server في PATH ولا في LLAMA_CPP_PATH ولا في المجلدات المعتادة"

msgid "no ggml backend libraries found next to llama-server; the build may be static"
msgstr "لم يُعثر على مكتبات واجهات ggml الخلفية بجوار llama-server؛ قد يكون البناء ساكنًا"

msgid "%(path)s is a file, not a directory."
msgstr "%(path)s ملف، لا مجلد."

msgid "%(path)s cannot be read: %(error)s"
msgstr "تعذّرت قراءة %(path)s: %(error)s"

msgid "%(path)s has a marker file that cannot be read."
msgstr "يحتوي %(path)s على ملف علامة تتعذّر قراءته."

msgid "%(path)s already holds %(count)d file that LlamaFit did not install."
msgid_plural "%(path)s already holds %(count)d files that LlamaFit did not install."
msgstr[0] "يحتوي %(path)s بالفعل على %(count)d ملف لم يثبّته LlamaFit."
msgstr[1] "يحتوي %(path)s بالفعل على %(count)d ملف لم يثبّته LlamaFit."
msgstr[2] "يحتوي %(path)s بالفعل على %(count)d ملفين لم يثبّتهما LlamaFit."
msgstr[3] "يحتوي %(path)s بالفعل على %(count)d ملفات لم يثبّتها LlamaFit."
msgstr[4] "يحتوي %(path)s بالفعل على %(count)d ملفًا لم يثبّته LlamaFit."
msgstr[5] "يحتوي %(path)s بالفعل على %(count)d ملف لم يثبّته LlamaFit."

msgid "%(name)s has no published checksum, so it cannot be verified."
msgstr "ليس لـ %(name)s مجموع اختباري منشور، لذا لا يمكن التحقّق منه."

msgid "Pass --allow-unverified to install it anyway, knowing the archive is unchecked."
msgstr "مرّر --allow-unverified لتثبيته على أي حال، مع علمك بأن الأرشيف غير مفحوص."

msgid "could not download %(url)s: %(error)s"
msgstr "تعذّر تنزيل %(url)s: %(error)s"

msgid "the connection was closed"
msgstr "أُغلق الاتصال"

msgid "Run the command again; it continues from where it stopped."
msgstr "أعد تنفيذ الأمر؛ فهو يتابع من حيث توقّف."

msgid "the download of %(url)s stopped early: %(error)s"
msgstr "توقّف تنزيل %(url)s قبل الأوان: %(error)s"

msgid "%(got)s of %(want)s arrived"
msgstr "وصل %(got)s من %(want)s"

msgid "the disk holding %(path)s is full."
msgstr "القرص الذي يحوي %(path)s ممتلئ."

msgid "Free some space and run the command again; the download resumes."
msgstr "حرّر بعض المساحة وأعد تنفيذ الأمر؛ فيُستأنف التنزيل."

msgid "Check that the directory exists and is writable."
msgstr "تحقّق من وجود المجلد ومن إمكانية الكتابة فيه."

msgid "%(name)s did not match its published checksum and was discarded."
msgstr "لم يطابق %(name)s مجموعه الاختباري المنشور وجرى تجاهله."

msgid "Nothing was unpacked. Run the command again: the archive arrived damaged, which a second download usually fixes."
msgstr "لم يُفكّ شيء. أعد تنفيذ الأمر: وصل الأرشيف تالفًا، وعادةً ما يصلح ذلك تنزيلٌ ثانٍ."

msgid "%(archive)s contains %(name)s, which would be written outside the install directory."
msgstr "يحتوي %(archive)s على %(name)s، وهو ما سيُكتب خارج مجلد التثبيت."

msgid "Do not install this archive; report it to the llama.cpp project."
msgstr "لا تثبّت هذا الأرشيف؛ وأبلغ مشروع llama.cpp به."

msgid "%(name)s is not an archive LlamaFit knows how to unpack."
msgstr "%(name)s ليس أرشيفًا يعرف LlamaFit كيف يفكّه."

msgid "%(name)s could not be unpacked: %(error)s"
msgstr "تعذّر فكّ %(name)s: %(error)s"

msgid "Delete it and run the command again to download it afresh."
msgstr "احذفه وأعد تنفيذ الأمر لتنزيله من جديد."

msgid "the archive holds no %(name)s."
msgstr "لا يحتوي الأرشيف على %(name)s."

msgid "Report this; the release layout has changed."
msgstr "أبلغ عن ذلك؛ فقد تغيّر تخطيط الإصدار."

msgid "%(path)s was not installed by LlamaFit."
msgstr "لم يثبّت LlamaFit المسار %(path)s."

msgid "Pass --force to replace it, or --dir to install somewhere else. LlamaFit never overwrites an installation it did not create."
msgstr "مرّر --force لاستبداله، أو --dir للتثبيت في مكان آخر. لا يكتب LlamaFit أبدًا فوق تثبيت لم ينشئه."

msgid "%(path)s has %(free)s free; this install needs %(needed)s."
msgstr "في %(path)s %(free)s حرة؛ ويحتاج هذا التثبيت إلى %(needed)s."

msgid "Free some space, or pass --dir to install on another volume."
msgstr "حرّر بعض المساحة، أو مرّر --dir للتثبيت على وحدة تخزين أخرى."

msgid "the %(backend)s libraries are not in the installed directory."
msgstr "مكتبات %(backend)s ليست في مجلد التثبيت."

msgid "no ggml backend libraries were installed; the build may be a static one."
msgstr "لم تُثبَّت أي مكتبات واجهات ggml خلفية؛ قد يكون البناء ساكنًا."

msgid "Your PATH could not be read, so it will not be changed."
msgstr "تعذّرت قراءة PATH لديك، لذا لن يُغيَّر."

msgid "Add %(path)s to your user PATH (HKCU\\Environment)."
msgstr "أضف %(path)s إلى PATH الخاص بالمستخدم لديك (HKCU\\Environment)."

msgid "To undo: run `setx PATH \"%(previous)s\"`, or remove the entry in System > About > Advanced system settings > Environment Variables."
msgstr "للتراجع: نفّذ `setx PATH \"%(previous)s\"`، أو احذف المُدخلة من System > About > Advanced system settings > Environment Variables."

msgid "%(path)s is already on your PATH."
msgstr "%(path)s موجود بالفعل في PATH لديك."

msgid "Nothing to undo."
msgstr "لا شيء للتراجع عنه."

msgid "Append a PATH line for %(path)s to %(file)s."
msgstr "إضافة سطر PATH لـ %(path)s إلى %(file)s."

msgid "To undo: delete the two lines marked `%(mark)s` from %(file)s."
msgstr "للتراجع: احذف السطرين الموسومين بـ `%(mark)s` من %(file)s."

msgid "your PATH could not be changed: %(error)s"
msgstr "تعذّر تغيير PATH لديك: %(error)s"

msgid "To remove it later, delete %(path)s."
msgstr "لإزالته لاحقًا، احذف %(path)s."

msgid "the most recent %(count)d llama.cpp releases hold no build."
msgstr "أحدث %(count)d إصدار من llama.cpp لا تحتوي على أي بناء."

msgid "Name one with `llamafit install llama.cpp --tag ...`."
msgstr "سمِّ واحدًا بـ `llamafit install llama.cpp --tag ...`."

msgid "could not reach GitHub at %(url)s: %(error)s"
msgstr "تعذّر الوصول إلى GitHub على %(url)s: %(error)s"

msgid "GitHub refused the request for %(url)s: the rate limit is exhausted."
msgstr "رفض GitHub الطلب الخاص بـ %(url)s: استُنفد حد المعدّل."

msgid "Wait for the limit to reset, or set GITHUB_TOKEN to a personal access token with no scopes."
msgstr "انتظر إعادة ضبط الحد، أو اضبط GITHUB_TOKEN على رمز وصول شخصي بلا نطاقات."

msgid "GitHub has no release at %(url)s."
msgstr "ليس لدى GitHub أي إصدار على %(url)s."

msgid "Check the tag with `llamafit install llama.cpp --tag ...`."
msgstr "تحقّق من الوسم بـ `llamafit install llama.cpp --tag ...`."

msgid "GitHub returned %(status)d for %(url)s."
msgstr "أرجع GitHub الرمز %(status)d لـ %(url)s."

msgid "GitHub's answer for %(url)s was not JSON."
msgstr "لم تكن إجابة GitHub بخصوص %(url)s بصيغة JSON."

msgid "GitHub's answer did not describe a release."
msgstr "لم تصف إجابة GitHub أي إصدار."

msgid "no llama-server answering"
msgstr "لا يوجد llama-server يستجيب"

msgid "unexpected response: %(error)s"
msgstr "استجابة غير متوقّعة: %(error)s"

msgid "%(model)s holds %(native)s tokens, fewer than the %(minimum)s asked for."
msgstr "يستوعب %(model)s %(native)s رمزًا، وهو أقل من %(minimum)s المطلوبة."

msgid "No configuration of this model fits this machine."
msgstr "لا تتّسع أي تهيئة لهذا النموذج في هذا الجهاز."

msgid "Routed experts are held in system memory, and so are the always-on shared experts, which is what -ot ffn_.*_shexp=CPU does; attention and the KV cache stay on the card."
msgstr "يُحتفظ بالخبراء المُوجَّهين في ذاكرة النظام، وكذلك بالخبراء المشتركين الدائمين، وهذا ما يفعله -ot ffn_.*_shexp=CPU؛ ويبقى الانتباه وذاكرة KV على البطاقة."

msgid "Routed experts are held in system memory; attention, the KV cache and the shared experts stay on the card."
msgstr "يُحتفظ بالخبراء المُوجَّهين في ذاكرة النظام؛ ويبقى الانتباه وذاكرة KV والخبراء المشتركون على البطاقة."

msgid "%(layers)s layers are on the card and the rest run on the processor."
msgstr "%(layers)s طبقة على البطاقة والباقي يعمل على المعالج."

msgid "Nothing runs on a graphics card: every weight is in system memory."
msgstr "لا شيء يعمل على بطاقة رسوميات: كل وزن في ذاكرة النظام."

msgid "%(gpus)s is here, but nothing could read how much of it is free, so this plan was made as if it were not. The real machine will be faster than these figures."
msgstr "%(gpus)s موجود هنا، لكن لم يستطع شيء قراءة مقدار الحر منه، لذا وُضعت هذه الخطة كأنه غير موجود. وسيكون الجهاز الحقيقي أسرع من هذه الأرقام."

msgid "Sized for %(context)s tokens rather than the %(requested)s asked for."
msgstr "حُدّد الحجم لـ %(context)s رمز بدل %(requested)s المطلوبة."

msgid "The KV cache is quantised to %(type)s to reach this context."
msgstr "كُمّمت ذاكرة KV إلى %(type)s لبلوغ هذا السياق."

msgid "Vision is off: the projector did not fit, on the card or in system memory."
msgstr "الرؤية معطّلة: لم يتّسع المُسقِط، لا على البطاقة ولا في ذاكرة النظام."

msgid "The vision projector is in system memory (--no-mmproj-offload), which costs nothing measurable for text and makes images slower."
msgstr "مُسقِط الرؤية في ذاكرة النظام (--no-mmproj-offload)، وهو ما لا يكلّف شيئًا يُذكر للنص ويجعل الصور أبطأ."

msgid "%(threads)s threads, not the %(available)s this processor has: the efficiency cores are left out because generation measures slower with them, and what is left is the threads the performance cores provide."
msgstr "%(threads)s خيط، لا %(available)s التي يملكها هذا المعالج: تُترك أنوية الكفاءة خارجًا لأن التوليد يُقاس أبطأ معها، وما يتبقّى هو الخيوط التي توفّرها أنوية الأداء."

msgid "Tight: %(vram)s of the graphics card is free and this needs %(needed)s, so another program can push it over. The context tier table is how a launch script recovers."
msgstr "ضيّق: %(vram)s من بطاقة الرسوميات حرة وهذا يحتاج %(needed)s، فقد يدفعه برنامج آخر إلى الحافة. وجدول مستويات السياق هو ما يتعافى به سكربت التشغيل."

msgid "no %(capability)s capability, which %(use_case)s needs; ask for a different use case, or add it to the entry when the model really has it"
msgstr "لا قدرة %(capability)s، وهي ما تحتاجه %(use_case)s؛ اطلب حالة استخدام أخرى، أو أضفها إلى المُدخلة إن كان النموذج يملكها فعلًا"

msgid "no %(capability)s capability; drop it from the request to see this model"
msgstr "لا قدرة %(capability)s؛ احذفها من الطلب لترى هذا النموذج"

msgid "%(size)s to download, over the %(limit)s this request allows"
msgstr "%(size)s للتنزيل، فوق %(limit)s الذي يسمح به هذا الطلب"

msgid "unknown quantisation %(quant)s, so its cost in quality cannot be told"
msgstr "تكميم غير معروف %(quant)s، لذا لا يمكن معرفة كلفته في الجودة"

msgid "nowhere to put it: no placement fits this machine at any context"
msgstr "لا مكان لوضعه: لا يوجد توزيع يتّسع في هذا الجهاز عند أي سياق"

msgid "holds %(fit)s tokens at most, under the %(minimum)s asked for; lower the minimum context or free memory to see it ranked"
msgstr "يستوعب %(fit)s رمز على الأكثر، دون %(minimum)s المطلوبة؛ اخفض الحد الأدنى للسياق أو حرّر ذاكرة لتراه مرتّبًا"

msgid "generates %(tps)s tokens per second, below the %(floor)s this request asks for; lower --min-tps or choose a smaller model or quantisation"
msgstr "يولّد %(tps)s رمز في الثانية، دون %(floor)s التي يطلبها هذا الطلب؛ اخفض --min-tps أو اختر نموذجًا أو تكميمًا أصغر"

msgid "generates %(tps)s tokens per second, below the %(floor)s a person reads at: a batch tool on this machine and not one to sit in front of; a smaller model or quantisation would keep up"
msgstr "يولّد %(tps)s رمز في الثانية، دون %(floor)s التي يقرأ بها الإنسان: أداة دفعات على هذا الجهاز لا أداة تجلس أمامها؛ ونموذج أو تكميم أصغر سيواكب"

msgid "unknown use case %(use_case)s"
msgstr "حالة استخدام غير معروفة: %(use_case)s"

msgid "Known use cases: %(known)s."
msgstr "حالات الاستخدام المعروفة: %(known)s."

msgid "unknown score part %(part)s in the weights for %(use_case)s"
msgstr "جزء تقييم غير معروف %(part)s في أوزان %(use_case)s"

msgid "The parts are: %(parts)s."
msgstr "الأجزاء هي: %(parts)s."

msgid "the weights for %(use_case)s leave out %(part)s"
msgstr "تُغفل أوزان %(use_case)s الجزء %(part)s"

msgid "Overriding a use case means giving all four parts: %(parts)s."
msgstr "تجاوز حالة استخدام يعني إعطاء الأجزاء الأربعة كلها: %(parts)s."

msgid "the weight for %(part)s in %(use_case)s is below zero"
msgstr "وزن %(part)s في %(use_case)s أقل من صفر"

msgid "A weight says how much a part counts; it cannot count less than none."
msgstr "الوزن يقول كم يُحتسب الجزء؛ ولا يمكن أن يُحتسب أقل من لا شيء."

msgid "the weights for %(use_case)s add up to nothing"
msgstr "أوزان %(use_case)s مجموعها لا شيء"

msgid "At least one part has to count for something."
msgstr "يجب أن يُحتسب جزء واحد على الأقل بشيء."

msgid "unknown preference %(prefer)s"
msgstr "تفضيل غير معروف: %(prefer)s"

msgid "Preferences: %(known)s."
msgstr "التفضيلات: %(known)s."

msgid "Install or repair the NVIDIA driver; nvidia-smi ships with it and must be on PATH."
msgstr "ثبّت تعريف NVIDIA أو أصلحه؛ يأتي nvidia-smi معه ويجب أن يكون في PATH."

msgid "Install ROCm (Linux) to expose AMD VRAM figures; without it the GPU is listed by name only."
msgstr "ثبّت ROCm (على لينكس) لإظهار أرقام VRAM من AMD؛ بدونه تُدرج البطاقة بالاسم فقط."

msgid "PowerShell could not list video controllers; run from a normal user session."
msgstr "تعذّر على PowerShell سرد متحكّمات الفيديو؛ نفّذ الأمر من جلسة مستخدم عادية."

msgid "Install pciutils to list GPUs by name when no vendor tool is available."
msgstr "ثبّت pciutils لسرد بطاقات GPU بالاسم عند عدم توفّر أداة من المُصنّع."

msgid "DDR type and speed were not readable; on Linux run once with sudo (dmidecode) or accept the measured bandwidth instead."
msgstr "تعذّرت قراءة نوع DDR وسرعتها؛ على لينكس نفّذ الأمر مرة واحدة بـ sudo (dmidecode) أو اقبل عرض النطاق المقيس بدلًا من ذلك."

msgid "py-cpuinfo failed; the CPU model and instruction sets are unknown."
msgstr "فشل py-cpuinfo؛ طراز CPU ومجموعات تعليماته غير معروفة."

msgid "psutil could not count the CPU cores; thread choice falls back to one core. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "تعذّر على psutil عدّ أنوية CPU؛ يعود اختيار الخيوط إلى نواة واحدة. أعد تثبيت psutil بـ `pip install --force-reinstall psutil`."

msgid "psutil could not read the memory totals; budgets cannot be computed until this works. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "تعذّر على psutil قراءة إجماليات الذاكرة؛ لا يمكن حساب الميزانيات حتى يعمل هذا. أعد تثبيت psutil بـ `pip install --force-reinstall psutil`."

msgid "Could not read performance-core count from sysctl."
msgstr "تعذّرت قراءة عدد أنوية الأداء من sysctl."

msgid "llama-server exists but did not report a version; the binary may be broken."
msgstr "llama-server موجود لكنه لم يذكر إصدارًا؛ قد يكون الملف التنفيذي معطوبًا."

msgid "system_profiler failed; GPU information is unavailable."
msgstr "فشل system_profiler؛ معلومات GPU غير متاحة."

msgid "Install the Vulkan tools (vulkan-tools on Linux, the vendor's Vulkan runtime on Windows) so an unsized card's memory can be read from its driver. This probe runs only when no vendor tool sized the card, so it is the last source there is."
msgstr "ثبّت أدوات Vulkan (vulkan-tools على لينكس، وبيئة تشغيل Vulkan من المُصنّع على ويندوز) لتُقرأ ذاكرة البطاقة غير المحدّدة الحجم من تعريفها. لا يجري هذا الفحص إلا حين لا تحدّد أي أداة من المُصنّع حجم البطاقة، فهو المصدر الأخير."

msgid "No vendor tool reported the GPU's memory size; record the size in a hardware profile so budgets can be computed for this machine."
msgstr "لم تُبلّغ أي أداة من المُصنّع عن حجم ذاكرة GPU؛ سجّل الحجم في ملف تعريف عتاد لتُحسب الميزانيات لهذا الجهاز."

msgid "llama.cpp installed"
msgstr "llama.cpp مثبّت"

msgid "build %(build)s at %(path)s, backends: %(backends)s"
msgstr "البناء %(build)s في %(path)s، الواجهات الخلفية: %(backends)s"

msgctxt "llama.cpp build"
msgid "unknown"
msgstr "غير معروف"

msgid "llama.cpp not found"
msgstr "لم يُعثر على llama.cpp"

msgid "no llama-server binary was found"
msgstr "لم يُعثر على ملف llama-server التنفيذي"

msgid "Run `llamafit install llama.cpp`, which picks the right build for this machine, checks it against its published checksum, and never touches an installation LlamaFit did not create."
msgstr "نفّذ `llamafit install llama.cpp`، فهو يختار البناء المناسب لهذا الجهاز، ويتحقّق منه مقابل مجموعه الاختباري المنشور، ولا يمسّ أبدًا تثبيتًا لم ينشئه LlamaFit."

msgid "Memory size unknown"
msgstr "حجم الذاكرة غير معروف"

msgid "LlamaFit could not read this machine's memory totals, so it cannot work out what will fit."
msgstr "تعذّر على LlamaFit قراءة إجماليات ذاكرة هذا الجهاز، لذا لا يستطيع تحديد ما الذي سيتّسع فيها."

msgid "%(gpu)s: no %(backend)s backend in llama.cpp"
msgstr "%(gpu)s: لا توجد واجهة خلفية %(backend)s في llama.cpp"

msgid "llama.cpp was built with: %(backends)s"
msgstr "بُني llama.cpp بـ: %(backends)s"

msgctxt "backends"
msgid "unknown"
msgstr "غير معروفة"

msgid "Install a llama.cpp build with the %(backend)s or Vulkan backend to use %(gpu)s."
msgstr "ثبّت بناءً من llama.cpp يتضمّن واجهة %(backend)s أو Vulkan الخلفية لاستخدام %(gpu)s."

msgid "%(gpu)s: VRAM size unknown"
msgstr "%(gpu)s: حجم VRAM غير معروف"

msgid "the vendor tool that reports memory was not available"
msgstr "أداة المُصنّع التي تُبلّغ عن الذاكرة لم تكن متاحة"

msgid "%(gpus)s: planned around, not planned on"
msgstr "%(gpus)s: خُطّط حوله، لا عليه"

msgid "with no reading of how much of the card is free, every budget and every speed on this machine was computed as if there were no card: they are CPU-only figures, and the real machine will be faster."
msgstr "بدون قراءة لمقدار الحر من البطاقة، حُسبت كل ميزانية وكل سرعة على هذا الجهاز كأن لا بطاقة: فهي أرقام CPU وحده، وسيكون الجهاز الحقيقي أسرع."

msgid "Install the Vulkan tools so the size can be read from the driver, or record it in a hardware profile (`llamafit hardware path` says where those go) and pass --profile."
msgstr "ثبّت أدوات Vulkan ليُقرأ الحجم من التعريف، أو سجّله في ملف تعريف عتاد (يذكر `llamafit hardware path` أين توضع) ومرّر --profile."

msgid "No GPU detected"
msgstr "لم تُكتشف أي GPU"

msgid "models will run on the CPU only"
msgstr "ستعمل النماذج على CPU فقط"

msgid "If a GPU is present, check that its driver tools are installed."
msgstr "إن كانت هناك GPU، فتحقّق من تثبيت أدوات تعريفها."

msgid "RAM bandwidth assumed"
msgstr "عرض نطاق RAM مفترض"

msgid "using %(gbps)s GB/s as a default"
msgstr "يُستخدم %(gbps)s GB/s كقيمة افتراضية"

msgid "Install numpy (`pip install llamafit[fast]`) so LlamaFit can measure the RAM bandwidth."
msgstr "ثبّت numpy (`pip install llamafit[fast]`) ليتمكّن LlamaFit من قياس عرض نطاق RAM."

msgid "Probe %(probe)s failed"
msgstr "فشل الفحص %(probe)s"

msgctxt "probe error"
msgid "unknown error"
msgstr "خطأ غير معروف"

msgid "llama-server running at %(url)s"
msgstr "llama-server يعمل على %(url)s"

msgid "model %(model)s, context %(context)s"
msgstr "النموذج %(model)s، السياق %(context)s"

msgctxt "model name"
msgid "unknown"
msgstr "غير معروف"

msgid "Low disk space on %(path)s"
msgstr "مساحة القرص منخفضة في %(path)s"

msgid "%(size)s free"
msgstr "%(size)s حرة"

msgid "Most useful models need 5 to 120 GB; free space or change the downloads directory."
msgstr "تحتاج أغلب النماذج المفيدة من 5 إلى 120 GB؛ حرّر مساحة أو غيّر مجلد التنزيلات."

msgid "%(model)s has no %(quant)s quantisation"
msgstr "ليس لـ %(model)s تكميم %(quant)s"

msgid "It publishes: %(names)s"
msgstr "ينشر: %(names)s"

msgid "licensed %(spdx)s, which this request does not allow"
msgstr "مرخّص بـ %(spdx)s، وهو ما لا يسمح به هذا الطلب"

msgid "System memory bandwidth was not measured; %(gbps).0f GB/s assumed for %(arch)s."
msgstr "لم يُقس عرض نطاق ذاكرة النظام؛ افتُرض %(gbps).0f GB/s لـ %(arch)s."

msgid "%(gpu)s bandwidth is unknown; the %(backend)s fallback of %(gbps).0f GB/s stands in."
msgstr "عرض نطاق %(gpu)s غير معروف؛ ويحل محلّه احتياطي %(backend)s البالغ %(gbps).0f GB/s."

msgid "No graphics card compute figure: prompt processing is estimated on the CPU."
msgstr "لا يوجد رقم حساب لبطاقة الرسوميات: تُقدَّر معالجة الموجّه على CPU."

msgid "%(gb).2f GB of routed experts is read from system memory per token at %(eff).2f of its %(raw).0f GB/s, because each token selects a different handful of experts and the read is a scatter of small blocks rather than a stream."
msgstr "تُقرأ %(gb).2f GB من الخبراء المُوجَّهين من ذاكرة النظام لكل رمز بنسبة %(eff).2f من %(raw).0f GB/s الخاصة بها، لأن كل رمز يختار حفنة مختلفة من الخبراء والقراءة تشتّت لكتل صغيرة لا تدفّق."

msgid "%(gb).2f GB of contiguous weights is read from system memory per token at %(eff).2f of its %(raw).0f GB/s."
msgstr "تُقرأ %(gb).2f GB من الأوزان المتّصلة من ذاكرة النظام لكل رمز بنسبة %(eff).2f من %(raw).0f GB/s الخاصة بها."

msgid "No active parameter count was supplied; it was inferred from the weight bytes."
msgstr "لم يُقدَّم عدد المعاملات النشطة؛ فاستُنتج من بايتات الأوزان."

msgid "%(pct).0f percent of the layers sit in system memory, so that share of the prompt arithmetic is charged to the CPU at %(tflops).2f TFLOP/s rather than to the card. Both rates come from one small dense model on one machine."
msgstr "%(pct).0f بالمئة من الطبقات في ذاكرة النظام، لذا تُحمَّل تلك الحصة من حساب الموجّه على CPU بمعدل %(tflops).2f TFLOP/s بدل البطاقة. والمعدّلان مأخوذان من نموذج كثيف صغير واحد على جهاز واحد."

msgid "%(gb).1f GB of the expert set is streamed across the link once per micro-batch at %(gbps).1f GB/s. That rate was fitted on the one model whose expert set does not fit in system memory, so part of its read comes off the disk; an expert set that stays in the page cache streams about three times faster, and for one of those this term is that much too slow."
msgstr "تُتدفَّق %(gb).1f GB من مجموعة الخبراء عبر الوصلة مرة لكل دفعة صغرى بسرعة %(gbps).1f GB/s. وقد وُفّق هذا المعدل على النموذج الوحيد الذي لا تتّسع مجموعة خبرائه في ذاكرة النظام، فيأتي جزء من قراءته من القرص؛ ومجموعة خبراء تبقى في مخبأ الصفحات تتدفّق أسرع بنحو ثلاث مرات، وعندها يكون هذا الحد أبطأ بالقدر نفسه."

msgid "%(gb).1f GB of the expert set is read out of system memory once per micro-batch at %(gbps).1f GB/s, because there is no card to stream it to."
msgstr "تُقرأ %(gb).1f GB من مجموعة الخبراء من ذاكرة النظام مرة لكل دفعة صغرى بسرعة %(gbps).1f GB/s، إذ لا توجد بطاقة تُتدفَّق إليها."

msgid "No placement of this model on this machine could run it."
msgstr "لا يوجد توزيع لهذا النموذج على هذا الجهاز يستطيع تشغيله."

msgid "Generation is a benchmark of this configuration, not a prediction."
msgstr "التوليد اختبار مرجعي لهذه التهيئة، لا تنبّؤ."

msgid "Generation is the formula corrected by %(factor).2f, from a benchmark of %(profile)s on this machine taken on %(date)s."
msgstr "التوليد هو الصيغة مصحّحة بمعامل %(factor).2f، من اختبار مرجعي لـ %(profile)s على هذا الجهاز أُخذ في %(date)s."

msgid "Prompt processing is a benchmark of this configuration."
msgstr "معالجة الموجّه اختبار مرجعي لهذه التهيئة."

msgid "Prompt processing is the formula corrected by %(factor).2f from a benchmark."
msgstr "معالجة الموجّه هي الصيغة مصحّحة بمعامل %(factor).2f من اختبار مرجعي."

msgid "That benchmark's command line does not record how many layers went to the card, so the correction assumes it ran at this placement."
msgstr "لا يسجّل سطر أوامر ذلك الاختبار المرجعي عدد الطبقات التي ذهبت إلى البطاقة، لذا يفترض التصحيح أنه جرى بهذا التوزيع."

msgid "This figure assumes nothing pages: a placement this tight often does, silently."
msgstr "يفترض هذا الرقم ألا يحدث ترحيل: وتوزيع بهذا الضيق كثيرًا ما يُرحّل، بصمت."

