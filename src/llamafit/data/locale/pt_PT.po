msgid "Skip the RAM bandwidth measurement."
msgstr ""

msgid "Command: %(command)s"
msgstr "Comando: %(command)s"

msgid "truncated GGUF header: wanted %(wanted)d bytes at offset %(offset)d, got %(got)d"
msgstr "cabeçalho GGUF truncado: esperava %(wanted)d bytes na posição %(offset)d, recebeu %(got)d"

msgid "The file may still be downloading, or the URL may not be a GGUF file."
msgstr "O ficheiro pode ainda estar a ser transferido, ou o URL pode não ser um ficheiro GGUF."

msgid "unknown GGUF value type %(type)d at offset %(offset)d"
msgstr "tipo de valor GGUF desconhecido %(type)d na posição %(offset)d"

msgid "This file may use a newer GGUF metadata type than LlamaFit supports."
msgstr "Este ficheiro pode usar um tipo de metadados GGUF mais recente do que o LlamaFit suporta."

msgid "not a GGUF file: bad magic %(magic)s at offset 0"
msgstr "não é um ficheiro GGUF: assinatura inválida %(magic)s na posição 0"

msgid "Check that this file is actually a .gguf model."
msgstr "Verifique que este ficheiro é mesmo um modelo .gguf."

msgid "unsupported GGUF version %(version)d at offset 4"
msgstr "versão GGUF não suportada %(version)d na posição 4"

msgid "LlamaFit supports GGUF versions %(versions)s."
msgstr "O LlamaFit suporta as versões GGUF %(versions)s."

msgid "these GGUF files are not one split model: they disagree about '%(key)s', declaring %(values)s"
msgstr "estes ficheiros GGUF não são um só modelo dividido: discordam sobre '%(key)s', declarando %(values)s"

msgid "Pass the shards of one model, not of several."
msgstr "Indique os fragmentos de um só modelo, não de vários."

msgid "no GGUF header to read facts from"
msgstr "não há nenhum cabeçalho GGUF de onde ler os factos"

msgid "Pass the model's file, or every shard of a split model."
msgstr "Indique o ficheiro do modelo, ou todos os fragmentos de um modelo dividido."

msgid "%(count)d of %(total)d GGUF files carry no '%(key)s' key, so their place in a split model cannot be established"
msgstr "%(count)d de %(total)d ficheiros GGUF não têm a chave '%(key)s', por isso não é possível determinar o lugar deles num modelo dividido"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "Indique um único ficheiro não dividido sozinho, ou todos os fragmentos de um só modelo dividido."

msgid "incomplete shard set: the model declares %(declared)d shards and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "conjunto de fragmentos incompleto: o modelo declara %(declared)d fragmentos e chegaram %(arrived)d (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "Indique todos os fragmentos do modelo dividido."

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "falta o fragmento que tem os metadados do modelo: recebeu %(key)s %(numbers)s, esperava que um deles fosse 0"

msgid "Pass every shard of the split model, including the first."
msgstr "Indique todos os fragmentos do modelo dividido, incluindo o primeiro."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "conjunto de fragmentos incompleto: esperava %(key)s de 0 a %(last)d, recebeu %(numbers)s"

msgid "Pass each shard of the split model exactly once."
msgstr "Indique cada fragmento do modelo dividido exatamente uma vez."

msgid "incomplete shard set: the model declares %(declared)d tensors and its %(shards)d shards hold %(held)d between them"
msgstr "conjunto de fragmentos incompleto: o modelo declara %(declared)d tensores e os seus %(shards)d fragmentos têm %(held)d ao todo"

msgid "could not read %(path)s: %(error)s"
msgstr "não foi possível ler %(path)s: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "Verifique que o ficheiro existe e é legível."

msgid "could not fetch %(url)s: %(error)s"
msgstr "não foi possível obter %(url)s: %(error)s"

msgid "Check your network connection and that the URL is reachable."
msgstr "Verifique a sua ligação de rede e que o URL está acessível."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s devolveu HTTP %(status)d em vez de 206 Partial Content; o servidor pode não suportar pedidos por intervalo."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Confirme que o URL aponta para um ficheiro GGUF que possa ser transferido."

