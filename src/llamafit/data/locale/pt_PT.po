msgid ""
msgstr ""
"Project-Id-Version: llamafit 0.1.0a1\n"
"Report-Msgid-Bugs-To: https://github.com/pvaz/llamafit/issues\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: pt_PT\n"
"Language-Team: Portuguese (Portugal)\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "O Hugging Face devolveu %(status)d ao listar os ficheiros de %(repo)s."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Não foi possível ler a lista de ficheiros de %(repo)s no Hugging Face."

msgid "Check your network connection and try again."
msgstr "Verifique a sua ligação de rede e tente novamente."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "A resposta do Hugging Face para %(repo)s não incluía uma lista de ficheiros."

msgid "Check that the repository id is correct and public."
msgstr "Verifique que o identificador do repositório está correto e é público."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "o catálogo tem %(count)d problema"
msgstr[1] "o catálogo tem %(count)d problemas"

msgid "Run `llamafit catalog validate` for details."
msgstr "Execute `llamafit catalog validate` para ver os detalhes."

msgid "could not write %(path)s: %(error)s"
msgstr "não foi possível escrever %(path)s: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "Verifique que a pasta é gravável e tem espaço."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "%(path)s tem %(count)d problema e não pode ser atualizado"
msgstr[1] "%(path)s tem %(count)d problemas e não pode ser atualizado"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "Execute `llamafit catalog validate` e corrija primeiro o ficheiro."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "%(path)s não pôde ser lido por completo, por isso atualizar apenas %(model)s deitaria fora factos que ele guarda para modelos que esta execução não toca: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "Execute `llamafit catalog refresh` sem --model para reconstruir o ficheiro todo."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "Encontre, dimensione, instale e verifique LLMs de pesos abertos para o llama.cpp na sua própria máquina."

msgid "Print machine-readable JSON instead of tables."
msgstr "Escreve JSON legível por máquinas em vez de tabelas."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "Escreve os detalhes em llamafit.log na pasta de registos e mostra os rastreios."

msgid "Disable colours."
msgstr "Desativa as cores."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "Fala esta língua, por exemplo pt_PT. Uma língua que o LlamaFit não tem passa a inglês, e ele diz quais é que tem."

msgid "Print the version and exit."
msgstr "Escreve a versão e sai."

msgid "Unexpected error: %(error)s"
msgstr "Erro inesperado: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "Execute novamente com --verbose para ver o rastreio completo."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "Mantém o catálogo: valida os seus ficheiros, atualiza os campos voláteis."

msgid "Keep only this use case."
msgstr "Mantém apenas este caso de uso."

msgid "Keep only models with this capability (repeatable)."
msgstr "Mantém apenas os modelos com esta capacidade (repetível)."

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Mantém apenas estes identificadores de licença (repetível)."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "Valida apenas este ficheiro, em vez do catálogo incluído e das personalizações."

msgid "Did you mean: %(ids)s?"
msgstr "Queria dizer: %(ids)s?"

msgid "Run `llamafit list` to see every model id."
msgstr "Execute `llamafit list` para ver todos os identificadores de modelo."

msgid "no model named %(id)s in the catalog"
msgstr "não há nenhum modelo chamado %(id)s no catálogo"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "Encontrado %(count)d problema no catálogo; execute `llamafit catalog validate` para ver os detalhes."
msgstr[1] "Encontrados %(count)d problemas no catálogo; execute `llamafit catalog validate` para ver os detalhes."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "Nenhum modelo corresponde. Experimente um --use-case, --capability, --license, --vendor ou --search mais abrangente."

msgid "invalid --use-case %(value)s"
msgstr "--use-case inválido: %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "Casos de uso válidos: %(values)s"

msgid "invalid --capability value: %(values)s"
msgid_plural "invalid --capability values: %(values)s"
msgstr[0] "valor inválido em --capability: %(values)s"
msgstr[1] "valores inválidos em --capability: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "Capacidades válidas: %(values)s"

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"Lista o catálogo de modelos, restringido pelos filtros indicados.\n"
"\n"
"A tabela mostra no máximo três capacidades por modelo, mais um marcador +N para as restantes, e está ordenada pela coluna Qualidade que mostra; info ou --json têm todas as capacidades."

msgid "Keep only this vendor, case-insensitive."
msgstr "Mantém apenas este fabricante, sem distinguir maiúsculas de minúsculas."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "Procura parcial no identificador, nome, fabricante ou família, sem distinguir maiúsculas de minúsculas."

msgid "Show at most this many."
msgstr "Mostra no máximo este número."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "Atalho para llamafit list --search TEXTO."

msgid "Text to match against id, name, vendor or family."
msgstr "Texto a procurar no identificador, nome, fabricante ou família."

msgid "Show one model's facts, sources and every quant it publishes."
msgstr "Mostra os factos de um modelo, as suas fontes e todas as quantizações que publica."

msgid "A catalog model id."
msgstr "Um identificador de modelo do catálogo."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "Valida os ficheiros YAML do catálogo contra o esquema, escrevendo uma linha por problema."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "%(count)d ficheiro verificado, nenhum problema encontrado."
msgstr[1] "%(count)d ficheiros verificados, nenhum problema encontrado."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "Atualiza os nomes de ficheiros, tamanhos, somas de verificação e factos GGUF do catálogo a partir do Hugging Face."

msgid "Refresh only this model id."
msgstr "Atualiza apenas este identificador de modelo."

msgid "Compute the refresh but write nothing."
msgstr "Calcula a atualização mas não escreve nada."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "Termina com 1 se alguma coisa fosse mudar; não altera nada, para uma tarefa agendada de CI."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: aviso: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "aviso: %(warning)s (%(count)d modelo: %(models)s)"
msgstr[1] "aviso: %(warning)s (%(count)d modelos: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: erro: %(error)s"

msgid "Hint: %(hint)s"
msgstr "Sugestão: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "a atualização precisa de acesso de rede ao Hugging Face; verifique a sua ligação e que o identificador do repositório está correto."

msgid "No changes."
msgstr "Sem alterações."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "Escreve a entrada de catálogo em bruto de um modelo, em JSON por omissão ou em YAML com --yaml."

msgid "Print YAML instead of JSON."
msgstr "Escreve YAML em vez de JSON."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "Explica o que foi detetado, o que falhou e o que daria acesso a mais."

