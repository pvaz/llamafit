msgstr "%(file)s necessita autorització (HTTP %(status)d)."

msgid "This repository is gated. Accept its terms on Hugging Face and set HF_TOKEN to a token that can read it."
msgstr "Aquest dipòsit té l'accés restringit. Accepteu-ne els termes a Hugging Face i definiu HF_TOKEN amb un testimoni que el pugui llegir."

msgid "%(file)s is not at %(url)s any more (HTTP 404)."
msgstr "%(file)s ja no és a %(url)s (HTTP 404)."

msgid "Run `llamafit catalog refresh` to pick up the repository's current files."
msgstr "Executeu `llamafit catalog refresh` per a recollir els fitxers actuals del dipòsit."

