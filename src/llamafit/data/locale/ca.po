msgstr "Pot ser que el fitxer encara s'estigui baixant, o que l'URL no sigui un fitxer GGUF."

msgid "unknown GGUF value type %(type)d at offset %(offset)d"
msgstr "tipus de valor GGUF desconegut %(type)d a la posició %(offset)d"

