msgid_plural "%(count)d tensors"
msgstr[0] ""
msgstr[1] ""

msgid "could not read %(path)s: %(error)s"
msgstr "no s'ha pogut llegir %(path)s: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "Comproveu que el fitxer existeixi i es pugui llegir."

msgid "could not fetch %(url)s: %(error)s"
msgstr "no s'ha pogut obtenir %(url)s: %(error)s"

msgid "Check your network connection and that the URL is reachable."
msgstr "Comproveu la connexió de xarxa i que l'URL sigui accessible."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s ha retornat HTTP %(status)d en lloc de 206 Partial Content; pot ser que el servidor no admeti peticions per interval."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Confirmeu que l'URL apunta a un fitxer GGUF que es pugui baixar."

