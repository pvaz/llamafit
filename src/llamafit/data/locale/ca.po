msgid "The file may still be downloading, or the URL may not be a GGUF file."
msgstr "Pot ser que el fitxer encara s'estigui baixant, o que l'URL no sigui un fitxer GGUF."

msgid "unknown GGUF value type %(type)d at offset %(offset)d"
msgstr "tipus de valor GGUF desconegut %(type)d a la posició %(offset)d"

msgid "This file may use a newer GGUF metadata type than LlamaFit supports."
msgstr "Aquest fitxer pot fer servir un tipus de metadades GGUF més recent dels que admet LlamaFit."

msgid "not a GGUF file: bad magic %(magic)s at offset 0"
msgstr "no és un fitxer GGUF: signatura no vàlida %(magic)s a la posició 0"

msgid "Check that this file is actually a .gguf model."
msgstr "Comproveu que aquest fitxer sigui realment un model .gguf."

msgid "unsupported GGUF version %(version)d at offset 4"
msgstr "versió de GGUF no admesa %(version)d a la posició 4"

msgid "LlamaFit supports GGUF versions %(versions)s."
msgstr "LlamaFit admet les versions de GGUF %(versions)s."

msgid "%(count)d shard"
msgid_plural "%(count)d shards"
msgstr[0] "%(count)d fragment"
msgstr[1] "%(count)d fragments"

msgid "these GGUF files are not one split model: they disagree about '%(key)s', declaring %(values)s"
msgstr "aquests fitxers GGUF no són un sol model dividit: no coincideixen en '%(key)s' i declaren %(values)s"

msgid "Pass the shards of one model, not of several."
msgstr "Indiqueu els fragments d'un sol model, no de diversos."

msgid "no GGUF header to read facts from"
msgstr "no hi ha cap capçalera GGUF d'on llegir les dades"

msgid "Pass the model's file, or every shard of a split model."
msgstr "Indiqueu el fitxer del model, o tots els fragments d'un model dividit."

msgid "%(count)d GGUF file of the %(total)d given carries no '%(key)s' key, so its place in a split model cannot be established"
msgid_plural "%(count)d GGUF files of the %(total)d given carry no '%(key)s' key, so their place in a split model cannot be established"
msgstr[0] "%(count)d fitxer GGUF dels %(total)d indicats no porta cap clau '%(key)s', de manera que no se'n pot establir el lloc en un model dividit"
msgstr[1] "%(count)d fitxers GGUF dels %(total)d indicats no porten cap clau '%(key)s', de manera que no se'n pot establir el lloc en un model dividit"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "Indiqueu un únic fitxer sense dividir tot sol, o tots els fragments d'un mateix model dividit."

msgid "incomplete shard set: the model declares %(shards)s and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "conjunt de fragments incomplet: el model declara %(shards)s i n'han arribat %(arrived)d (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "Indiqueu tots els fragments del model dividit."

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "falta el fragment que conté les metadades del model: s'han obtingut %(key)s %(numbers)s i s'esperava que un fos 0"

msgid "Pass every shard of the split model, including the first."
msgstr "Indiqueu tots els fragments del model dividit, inclòs el primer."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "conjunt de fragments incomplet: s'esperava %(key)s de 0 a %(last)d i s'ha obtingut %(numbers)s"

msgid "Pass each shard of the split model exactly once."
msgstr "Indiqueu cada fragment del model dividit exactament una vegada."

msgid "incomplete shard set: the model declares %(tensors)s and its %(shards)s hold %(held)d between them"
msgstr "conjunt de fragments incomplet: el model declara %(tensors)s i els seus %(shards)s en contenen %(held)d entre tots"

msgid "%(count)d tensor"
msgid_plural "%(count)d tensors"
msgstr[0] "%(count)d tensor"
msgstr[1] "%(count)d tensors"

msgid "could not read %(path)s: %(error)s"
msgstr "no s'ha pogut llegir %(path)s: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "Comproveu que el fitxer existeixi i es pugui llegir."

msgid "could not fetch %(url)s: %(error)s"
msgstr "no s'ha pogut obtenir %(url)s: %(error)s"

msgid "Check your network connection and that the URL is reachable."
msgstr "Comproveu la connexió de xarxa i que l'URL sigui accessible."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s ha retornat HTTP %(status)d en lloc de 206 Partial Content; pot ser que el servidor no admeti peticions per interval."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Confirmeu que l'URL apunta a un fitxer GGUF que es pugui baixar."

