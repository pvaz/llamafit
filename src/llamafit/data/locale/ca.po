msgstr "rocm-smi no ha retornat cap targeta"

msgid "system_profiler returned no displays"
msgstr "system_profiler no ha retornat cap pantalla"

msgid "WMI returned no video controllers"
msgstr "WMI no ha retornat cap controlador de vídeo"

