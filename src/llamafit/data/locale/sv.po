msgstr "%(value)s MiB"

msgid "written"
msgstr "skriven"

msgid "brought up to date"
msgstr "uppdaterad"

msgid "already up to date"
msgstr "redan aktuell"

msgid "kept: you edited it"
msgstr "behållen: du har redigerat den"

msgid "overwritten: your edits are gone"
msgstr "överskriven: dina ändringar är borta"

msgid "The preset could not be started: %(error)s"
msgstr "Förinställningen gick inte att starta: %(error)s"

msgid "Started, but %(url)s has not answered yet. A large model can spend minutes reading its weights; try the health endpoint again in a moment, or run `llamafit launch %(model)s --stop`."
msgstr "Startad, men %(url)s har inte svarat ännu. En stor modell kan lägga minuter på att läsa sina vikter; prova health-endpointen igen om en stund, eller kör `llamafit launch %(model)s --stop`."

msgid "%(model)s was already serving on %(url)s."
msgstr "%(model)s betjänade redan på %(url)s."

msgid "%(model)s is serving on %(url)s."
msgstr "%(model)s betjänar på %(url)s."

msgid "Stop it with `llamafit launch %(model)s --stop`."
msgstr "Stoppa den med `llamafit launch %(model)s --stop`."

msgid "Endpoints"
msgstr "Endpoints"

msgctxt "column heading"
msgid "What"
msgstr "Vad"

msgctxt "column heading"
msgid "Where"
msgstr "Var"

