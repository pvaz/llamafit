msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "Hugging Face svarade %(status)d när fillistan för %(repo)s hämtades."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Det gick inte att läsa fillistan för %(repo)s från Hugging Face."

msgid "Check your network connection and try again."
msgstr "Kontrollera din nätverksanslutning och försök igen."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "Svaret från Hugging Face för %(repo)s innehöll ingen fillista."

msgid "Check that the repository id is correct and public."
msgstr "Kontrollera att repositoriets id är rätt och att repositoriet är offentligt."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "katalogen har %(count)d problem"
msgstr[1] "katalogen har %(count)d problem"

msgid "Run `llamafit catalog validate` for details."
msgstr "Kör `llamafit catalog validate` för detaljerna."

msgid "could not write %(path)s: %(error)s"
msgstr "det gick inte att skriva %(path)s: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "Kontrollera att katalogen går att skriva till och har plats kvar."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "%(path)s har %(count)d problem och kan inte uppdateras"
msgstr[1] "%(path)s har %(count)d problem och kan inte uppdateras"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "Kör `llamafit catalog validate` och rätta filen först."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "%(path)s gick inte att läsa i sin helhet, så att uppdatera bara %(model)s skulle kasta bort fakta som filen håller reda på för modeller som den här körningen inte rör: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "Kör `llamafit catalog refresh` utan --model för att bygga om hela filen."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "Hitta, dimensionera, installera och verifiera LLM:er med öppna vikter för llama.cpp på din egen dator."

msgid "Print machine-readable JSON instead of tables."
msgstr "Skriv ut maskinläsbar JSON i stället för tabeller."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "Skriv detaljerna till llamafit.log i loggkatalogen och visa stackspårningar."

msgid "Disable colours."
msgstr "Stäng av färgerna."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "Tala det här språket, till exempel pt_PT. Ett språk som LlamaFit inte har faller tillbaka på engelska, och då sägs vilka språk som finns."

msgid "Print the version and exit."
msgstr "Skriv ut versionen och avsluta."

msgid "Unexpected error: %(error)s"
msgstr "Oväntat fel: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "Kör igen med --verbose för hela stackspårningen."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "Underhåll katalogen: validera dess filer, uppdatera de föränderliga fälten."

msgid "Keep only this use case."
msgstr "Behåll bara det här användningsfallet."

msgid "Keep only models with this capability (repeatable)."
msgstr "Behåll bara modeller med den här förmågan (kan upprepas)."

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Behåll bara de här licensbeteckningarna (kan upprepas)."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "Validera bara den här filen i stället för den medföljande katalogen och de egna anpassningarna."

msgid "Did you mean: %(ids)s?"
msgstr "Menade du: %(ids)s?"

msgid "Run `llamafit list` to see every model id."
msgstr "Kör `llamafit list` för att se alla modell-id."

msgid "no model named %(id)s in the catalog"
msgstr "ingen modell med namnet %(id)s i katalogen"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "%(count)d problem hittades i katalogen; kör `llamafit catalog validate` för detaljerna."
msgstr[1] "%(count)d problem hittades i katalogen; kör `llamafit catalog validate` för detaljerna."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "Ingen modell matchade. Prova ett bredare --use-case, --capability, --license, --vendor eller --search."

msgid "invalid --use-case %(value)s"
msgstr "ogiltigt --use-case: %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "Giltiga användningsfall: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "Giltiga förmågor: %(values)s"

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"Lista modellkatalogen, avgränsad av de filter som anges.\n"
"\n"
"Tabellen visar högst tre förmågor per modell, plus en markering +N för de övriga, och är sorterad efter den kolumn Kvalitet som visas; info eller --json har alla förmågor."

msgid "Keep only this vendor, case-insensitive."
msgstr "Behåll bara den här leverantören, utan att skilja på stora och små bokstäver."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "Matchning mot en del av id, namn, leverantör eller familj, utan att skilja på stora och små bokstäver."

msgid "Show at most this many."
msgstr "Visa högst så här många."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "Kortform för llamafit list --search TEXT."

msgid "Text to match against id, name, vendor or family."
msgstr "Text att matcha mot id, namn, leverantör eller familj."

msgid "A catalog model id."
msgstr "Ett modell-id ur katalogen."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "Validera katalogens YAML-filer mot schemat och skriv ut en rad per problem."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "%(count)d fil kontrollerad, inga problem hittades."
msgstr[1] "%(count)d filer kontrollerade, inga problem hittades."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "Uppdatera katalogens filnamn, storlekar, kontrollsummor och GGUF-fakta från Hugging Face."

msgid "Refresh only this model id."
msgstr "Uppdatera bara det här modell-id:t."

msgid "Compute the refresh but write nothing."
msgstr "Beräkna uppdateringen men skriv ingenting."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "Avsluta med 1 om något skulle ändras; ändrar ingenting, för ett schemalagt CI-jobb."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: varning: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "varning: %(warning)s (%(count)d modell: %(models)s)"
msgstr[1] "varning: %(warning)s (%(count)d modeller: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: fel: %(error)s"

msgid "Hint: %(hint)s"
msgstr "Tips: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "uppdateringen behöver nätverksåtkomst till Hugging Face; kontrollera din anslutning och att repositoriets id är rätt."

msgid "No changes."
msgstr "Inga ändringar."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "Skriv ut en modells råa katalogpost, som JSON i normalfallet eller som YAML med --yaml."

msgid "Print YAML instead of JSON."
msgstr "Skriv ut YAML i stället för JSON."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "Förklara vad som hittades, vad som misslyckades och vad som skulle ge mer."

