msgid "llama.cpp not found: no llama-server on PATH, in LLAMA_CPP_PATH or in the usual directories"
msgstr "llama.cpp hittades inte: ingen llama-server i PATH, i LLAMA_CPP_PATH eller i de vanliga katalogerna"

msgid "no ggml backend libraries found next to llama-server; the build may be static"
msgstr "inga ggml-backendbibliotek hittades bredvid llama-server; bygget kan vara statiskt"

msgid "no llama-server answering"
msgstr "ingen llama-server svarar"

msgid "unexpected response: %(error)s"
msgstr "oväntat svar: %(error)s"

msgid "Install or repair the NVIDIA driver; nvidia-smi ships with it and must be on PATH."
msgstr "Installera eller reparera NVIDIA-drivrutinen; nvidia-smi följer med den och måste finnas i PATH."

msgid "Install ROCm (Linux) to expose AMD VRAM figures; without it the GPU is listed by name only."
msgstr "Installera ROCm (Linux) för att få fram AMD:s VRAM-siffror; utan ROCm listas GPU:n bara med namn."

msgid "PowerShell could not list video controllers; run from a normal user session."
msgstr "PowerShell kunde inte lista grafikstyrkorten; kör från en vanlig användarsession."

msgid "Install pciutils to list GPUs by name when no vendor tool is available."
msgstr "Installera pciutils för att lista GPU:er med namn när inget verktyg från tillverkaren finns."

msgid "DDR type and speed were not readable; on Linux run once with sudo (dmidecode) or accept the measured bandwidth instead."
msgstr "DDR-typ och hastighet gick inte att läsa; kör en gång med sudo på Linux (dmidecode) eller nöj dig med den uppmätta bandbredden i stället."

msgid "py-cpuinfo failed; the CPU model and instruction sets are unknown."
msgstr "py-cpuinfo misslyckades; CPU-modellen och instruktionsuppsättningarna är okända."

msgid "psutil could not count the CPU cores; thread choice falls back to one core. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil kunde inte räkna CPU-kärnorna; valet av trådar faller tillbaka på en kärna. Installera om psutil med `pip install --force-reinstall psutil`."

msgid "psutil could not read the memory totals; budgets cannot be computed until this works. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil kunde inte läsa minnestotalerna; så länge det inte fungerar går det inte att räkna ut några budgetar. Installera om psutil med `pip install --force-reinstall psutil`."

msgid "Could not read performance-core count from sysctl."
msgstr "Antalet prestandakärnor gick inte att läsa ur sysctl."

msgid "llama-server exists but did not report a version; the binary may be broken."
msgstr "llama-server finns men uppgav ingen version; programfilen kan vara trasig."

msgid "system_profiler failed; GPU information is unavailable."
msgstr "system_profiler misslyckades; det finns inga uppgifter om GPU:n."

msgid "No vendor tool reported the GPU's memory size; record the size in a hardware profile so budgets can be computed for this machine."
msgstr "Inget verktyg från tillverkaren uppgav GPU:ns minnesstorlek; skriv in storleken i en maskinvaruprofil så att budgetar kan räknas ut för den här datorn."

msgid "llama.cpp installed"
msgstr "llama.cpp installerat"

msgid "build %(build)s at %(path)s, backends: %(backends)s"
msgstr "bygge %(build)s i %(path)s, backends: %(backends)s"

msgctxt "llama.cpp build"
msgid "unknown"
msgstr "okänt"

msgid "llama.cpp not found"
msgstr "llama.cpp hittades inte"

msgid "no llama-server binary was found"
msgstr "ingen llama-server-programfil hittades"

msgid "Memory size unknown"
msgstr "Minnesstorleken är okänd"

msgid "LlamaFit could not read this machine's memory totals, so it cannot work out what will fit."
msgstr "LlamaFit kunde inte läsa den här datorns minnestotaler och kan därför inte räkna ut vad som får plats."

msgid "%(gpu)s: no %(backend)s backend in llama.cpp"
msgstr "%(gpu)s: ingen %(backend)s-backend i llama.cpp"

msgid "llama.cpp was built with: %(backends)s"
msgstr "llama.cpp byggdes med: %(backends)s"

msgctxt "backends"
msgid "unknown"
msgstr "okända"

msgid "Install a llama.cpp build with the %(backend)s or Vulkan backend to use %(gpu)s."
msgstr "Installera ett bygge av llama.cpp med backend %(backend)s eller Vulkan för att kunna använda %(gpu)s."

msgid "%(gpu)s: VRAM size unknown"
msgstr "%(gpu)s: VRAM-storleken är okänd"

msgid "the vendor tool that reports memory was not available"
msgstr "verktyget från tillverkaren som uppger minnet fanns inte att tillgå"

msgid "No GPU detected"
msgstr "Ingen GPU hittades"

msgid "models will run on the CPU only"
msgstr "modeller kommer bara att köras på CPU:n"

msgid "If a GPU is present, check that its driver tools are installed."
msgstr "Om det finns en GPU, kontrollera att dess drivrutinsverktyg är installerade."

msgid "RAM bandwidth assumed"
msgstr "RAM-bandbredden är antagen"

msgid "using %(gbps)s GB/s as a default"
msgstr "%(gbps)s GB/s används som standardvärde"

msgid "Install numpy (`pip install llamafit[fast]`) so LlamaFit can measure the RAM bandwidth."
msgstr "Installera numpy (`pip install llamafit[fast]`) så att LlamaFit kan mäta RAM-bandbredden."

msgid "Probe %(probe)s failed"
msgstr "Testet %(probe)s misslyckades"

msgctxt "probe error"
msgid "unknown error"
msgstr "okänt fel"

msgid "llama-server running at %(url)s"
msgstr "llama-server kör på %(url)s"

msgid "model %(model)s, context %(context)s"
msgstr "modell %(model)s, kontext %(context)s"

msgctxt "model name"
msgid "unknown"
msgstr "okänd"

msgid "Low disk space on %(path)s"
msgstr "Lite diskutrymme på %(path)s"

msgid "%(size)s free"
msgstr "%(size)s ledigt"

msgid "Most useful models need 5 to 120 GB; free space or change the downloads directory."
msgstr "De flesta användbara modeller behöver 5 till 120 GB; frigör utrymme eller byt katalog för hämtningar."

# The thousands separator below is a no-break space (U+00A0), not an ordinary space
# and not an empty translation. Swedish groups digits with a space, and the entry is
# read literally, so the space is the answer. Do not "tidy" it away.
msgctxt "thousands separator"
msgid ","
msgstr " "

msgctxt "decimal separator"
msgid "."
msgstr ","

# B is not the English word for a thousand million; it is how these models are named.
# The file is Qwen3-27B and the identifier in this row already says 27B, so a localised
# abbreviation would make one row disagree with itself. Change it only if your readers
# genuinely would not recognise B, and say in a comment here why.
msgctxt "parameter count"
msgid "B"
msgstr "B"

msgctxt "size"
msgid "unknown"
msgstr "okänd"
