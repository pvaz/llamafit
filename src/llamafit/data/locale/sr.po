msgstr "У %(path)s, где је слободно %(free)s; остало би %(after)s."

msgid "The catalog holds no checksum for %(files)s."
msgid_plural "The catalog holds no checksums for %(files)s."
msgstr[0] "Каталог нема контролну суму за %(files)s."
msgstr[1] "Каталог нема контролне суме за %(files)s."
msgstr[2] "Каталог нема контролне суме за %(files)s."

msgid "Download a model's weights, resuming anything an earlier run left and checking every file against the catalog's checksum."
msgstr "Преузима тежине модела, наставља оно што је раније покретање оставило и проверава сваку датотеку према контролној суми из каталога."

msgid "%(model)s %(quant)s is already here; nothing to do."
msgstr "%(model)s %(quant)s је већ овде; нема шта да се ради."

msgid "Start the download?"
msgstr "Започети преузимање?"

msgid "Stopped. What arrived is kept; run `llamafit install model %(model)s` again to carry on from there."
msgstr "Заустављено. Оно што је стигло се чува; покрените `llamafit install model %(model)s` поново да се настави одатле."

msgid "%(count)d file, %(size)s, checked against the catalog."
msgid_plural "%(count)d files, %(size)s, checked against the catalog."
msgstr[0] "%(count)d датотека, %(size)s, проверено према каталогу."
msgstr[1] "%(count)d датотеке, %(size)s, проверено према каталогу."
msgstr[2] "%(count)d датотека, %(size)s, проверено према каталогу."

msgid "In %(path)s. Run `llamafit plan %(model)s` for the command line that runs it."
msgstr "У %(path)s. Покрените `llamafit plan %(model)s` за командну линију која га покреће."

msgid "Show what has been downloaded, newest first."
msgstr "Приказује шта је преузето, најновије прво."

msgid "Nothing has been downloaded yet."
msgstr "Још ништа није преузето."

