msgid "no %(capability)s"
msgstr "без %(capability)s"

msgid "no %(capability)s capability; drop it from the request, or ask for a use case that does not need it"
msgstr "нема могућност %(capability)s; изоставите је из захтева или затражите случај употребе коме није потребна"

msgctxt "exclusion tag"
msgid "no estimate"
msgstr "без процене"

msgctxt "exclusion tag"
msgid "no room"
msgstr "нема места"

msgctxt "exclusion tag"
msgid "no facts"
msgstr "без података"

msgctxt "exclusion tag"
msgid "not ranked"
msgstr "нерангирано"

msgctxt "board cell with no figure"
msgid "–"
msgstr "–"

msgid "%(term)s is not a filter; the terms are %(terms)s, and anything else is text to look for."
msgstr "%(term)s није филтер; појмови су %(terms)s, а све остало је текст за тражење."

msgid "fit>= takes one of %(values)s"
msgstr "fit>= прима једну од %(values)s"

msgid "runs= takes one of %(values)s"
msgstr "runs= прима једну од %(values)s"

msgid "%(term)s needs a number"
msgstr "%(term)s треба број"

msgid "%(term)s needs a size such as 8G, 7.5GiB or 512M"
msgstr "%(term)s треба величину као 8G, 7.5GiB или 512M"

msgctxt "exclusion tag"
msgid "short context"
msgstr "кратак контекст"

msgid "holds fewer than the %(minimum)s tokens asked for; lower the minimum context or free memory to see it ranked"
msgstr "држи мање од %(minimum)s тражених токена; смањите минимални контекст или ослободите меморију да буде рангиран"

msgctxt "exclusion tag"
msgid "too big"
msgstr "превелик"

msgid "larger to download than the %(limit)s this request allows"
msgstr "већи за преузимање од %(limit)s колико овај захтев дозвољава"

msgctxt "exclusion tag"
msgid "too slow"
msgstr "преспор"

msgctxt "exclusion tag"
msgid "unknown quant"
msgstr "непозната квант."

msgid "a quantisation whose cost in quality is not known, so it cannot be scored"
msgstr "квантизација чија цена у квалитету није позната, па не може да се оцени"

msgctxt "exclusion tag"
msgid "unsupported"
msgstr "неподржано"

msgid "About these figures"
msgstr "О овим бројкама"

msgid "Close"
msgstr "Затвори"

msgid "%(shown)s of %(total)s in the catalog"
msgstr "%(shown)s од %(total)s у каталогу"
