msgid "profile must be a name, not a path: %(value)s"
msgstr "профил мора да буде назив, а не путања: %(value)s"

msgid "Ask GET /api/v1/profiles for the names this machine has."
msgstr "Затражите GET /api/v1/profiles за називе које ова машина има."

msgid "unknown query parameter: %(names)s"
msgstr "непознат параметар упита: %(names)s"

