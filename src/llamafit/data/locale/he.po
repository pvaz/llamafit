msgid_plural "%(count)d files, %(total)s in all, %(needed)s still to fetch."
msgstr[0] "%(count)d קובץ, %(total)s בסך הכול, %(needed)s עוד להבאה."
msgstr[1] "%(count)d קבצים, %(total)s בסך הכול, %(needed)s עוד להבאה."
