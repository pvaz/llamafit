msgid_plural "%(shown)d of %(total)d candidates shown."
msgstr[0] "מוצג %(shown)d מתוך %(total)d מועמד."
msgstr[1] "מוצגים %(shown)d מתוך %(total)d מועמדים."
msgstr[2] "מוצגים %(shown)d מתוך %(total)d מועמדים."

