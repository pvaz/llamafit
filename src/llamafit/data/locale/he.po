msgstr "system_profiler לא החזיר מסכים"

msgid "WMI returned no video controllers"
msgstr "WMI לא החזיר בקרי וידאו"

msgid "lspci found no display controllers"
msgstr "lspci לא מצא בקרי תצוגה"

