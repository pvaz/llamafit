msgid "kept: you edited it"
msgstr "נשמר: ערכת אותו"

msgid "overwritten: your edits are gone"
msgstr "נדרס: העריכות שלך נעלמו"

msgid "The preset could not be started: %(error)s"
msgstr "לא ניתן היה להפעיל את ההגדרה המוכנה: %(error)s"

msgid "Started, but %(url)s has not answered yet. A large model can spend minutes reading its weights; try the health endpoint again in a moment, or run `llamafit launch %(model)s --stop`."
msgstr "הופעל, אך %(url)s עדיין לא ענה. מודל גדול יכול לבלות דקות בקריאת המשקולות שלו; נסה שוב את נקודת הקצה health בעוד רגע, או הרץ `llamafit launch %(model)s --stop`."

msgid "%(model)s was already serving on %(url)s."
msgstr "%(model)s כבר שירת בכתובת %(url)s."

msgid "%(model)s is serving on %(url)s."
msgstr "%(model)s משרת בכתובת %(url)s."

msgid "Stop it with `llamafit launch %(model)s --stop`."
msgstr "עצור אותו באמצעות `llamafit launch %(model)s --stop`."

msgid "Endpoints"
msgstr "נקודות קצה"

msgctxt "column heading"
msgid "What"
msgstr "מה"

msgctxt "column heading"
msgid "Where"
msgstr "איפה"

msgid "Web interface"
msgstr "ממשק ווב"

msgid "Chat completions"
msgstr "השלמות צ'אט"

msgid "Models"
msgstr "מודלים"

msgid "Health"
msgstr "בריאות"

msgid "Ask for the model by the alias %(alias)s."
msgstr "בקש את המודל בשם החלופי %(alias)s."

msgctxt "finding level"
msgid "OK"
msgstr "תקין"

msgctxt "finding level"
msgid "WARN"
msgstr "אזהרה"

msgctxt "finding level"
msgid "ERROR"
msgstr "שגיאה"

# The four bandwidth labels say how the figure was arrived at, so they are written as
# past passives agreeing with רוחב הפס, which is masculine.
msgctxt "bandwidth source"
msgid "measured"
msgstr "נמדד"

msgctxt "bandwidth source"
msgid "estimated"
msgstr "הוערך"

msgctxt "bandwidth source"
msgid "assumed"
msgstr "הונח"

msgctxt "bandwidth source"
msgid "unknown"
msgstr "לא ידוע"

# Each row that says "unknown" names its own noun, and Hebrew follows that noun's
# gender: רוחב הפס, הדגם, ההקשר and הגודל are masculine, ערכת ההוראות and הבנייה
