msgstr[1] "کیٹلاگ کے پاس %(files)s کے checksum نہیں۔"

msgid "%(model)s %(quant)s is already here; nothing to do."
msgstr "%(model)s %(quant)s پہلے ہی یہاں ہے؛ کچھ کرنے کو نہیں۔"

msgid "Stopped. What arrived is kept; run `llamafit install model %(model)s` again to carry on from there."
msgstr "رک گیا۔ جو پہنچا وہ محفوظ ہے؛ وہیں سے جاری رکھنے کے لیے `llamafit install model %(model)s` دوبارہ چلائیں۔"

msgid "%(count)d file, %(size)s, checked against the catalog."
msgid_plural "%(count)d files, %(size)s, checked against the catalog."
msgstr[0] "%(count)d فائل، %(size)s، کیٹلاگ کے مقابل جانچی گئی۔"
msgstr[1] "%(count)d فائلیں، %(size)s، کیٹلاگ کے مقابل جانچی گئیں۔"

msgid "In %(path)s. Run `llamafit plan %(model)s` for the command line that runs it."
msgstr "%(path)s میں۔ اسے چلانے والی کمانڈ لائن کے لیے `llamafit plan %(model)s` چلائیں۔"

msgid "Downloads"
msgstr "ڈاؤن لوڈز"

msgid "When"
msgstr "کب"

msgid "Model"
msgstr "ماڈل"

msgid "Quant"
msgstr "Quant"

msgid "Outcome"
msgstr "نتیجہ"

msgid "finished"
msgstr "مکمل"

msgid "stopped"
msgstr "رکا"

msgid "Bind to this address instead of 127.0.0.1. Anything but loopback puts the dashboard on your network, where there is no password and no login; it prints what that exposes before it starts."
msgstr "127.0.0.1 کے بجائے اس پتے سے جڑتا ہے۔ loopback کے سوا کچھ بھی ڈیش بورڈ کو آپ کے نیٹ ورک پر رکھ دیتا ہے، جہاں نہ کوئی پاس ورڈ ہے نہ لاگ اِن؛ شروع ہونے سے پہلے وہ بتاتا ہے کہ اس سے کیا کھلتا ہے۔"

msgid "Listen on this port."
msgstr "اسی پورٹ پر سنتا ہے۔"

msgid ""
"Open the dashboard in a browser: the board, the machine and the plans.\n"
"\n"
"It serves the same numbers `--json` prints, from the same code, on this machine only. Nothing is fetched from the internet to draw the page."
msgstr ""
"براؤزر میں ڈیش بورڈ کھولتا ہے: بورڈ، مشین اور پلان۔\n"
"\n"
"یہ وہی اعداد پیش کرتا ہے جو --json چھاپتا ہے، اسی کوڈ سے، صرف اسی مشین پر۔ صفحہ بنانے کے لیے انٹرنیٹ سے کچھ نہیں لایا جاتا۔"

msgid "Open the page in your browser."
msgstr "صفحہ آپ کے براؤزر میں کھولتا ہے۔"

msgid "Drop --profile, --memory, --ram and --cpu-cores, then open the Simulate panel on the page: it substitutes a machine for as long as you want it, and marks every answer it produces."
msgstr "--profile، --memory، --ram اور --cpu-cores ہٹا دیں، پھر صفحے پر Simulate پینل کھولیں: یہ جب تک آپ چاہیں مشین بدل دیتا ہے، اور اپنا پیدا کردہ ہر جواب نشان زد کرتا ہے۔"

msgid "LlamaFit is at %(url)s. Press Ctrl+C to stop it."
msgstr "LlamaFit، %(url)s پر ہے۔ اسے روکنے کے لیے Ctrl+C دبائیں۔"

msgid "Show what this machine has: CPU, memory, GPUs, disks and llama.cpp."
msgstr "دکھاتا ہے کہ اس مشین میں کیا ہے: CPU، میموری، GPU، ڈسک اور llama.cpp۔"

msgid "Skip the RAM bandwidth measurement."
msgstr "RAM بینڈوتھ کی پیمائش چھوڑ دیتا ہے۔"

msgid "Measure RAM bandwidth again instead of reading back the figure kept for this machine, and keep the new one."
msgstr "اس مشین کے لیے محفوظ عدد پڑھنے کے بجائے RAM بینڈوتھ دوبارہ ماپتا ہے، اور نئی رکھ لیتا ہے۔"

msgid "%(url)s answered a range request with the whole file."
msgstr "%(url)s نے range کی درخواست کا جواب پوری فائل سے دیا۔"

msgid "%(url)s is rate-limiting this download (HTTP %(status)d)."
msgstr "%(url)s اس ڈاؤن لوڈ کی رفتار محدود کر رہا ہے (HTTP %(status)d)۔"

msgid "Check your network connection and run the command again to resume."
msgstr "اپنا نیٹ ورک کنکشن جانچیں اور جاری رکھنے کے لیے کمانڈ دوبارہ چلائیں۔"

msgid "%(file)s needs authorisation (HTTP %(status)d)."
msgstr "%(file)s کے لیے اجازت درکار ہے (HTTP %(status)d)۔"

msgid "This repository is gated. Accept its terms on Hugging Face and set HF_TOKEN to a token that can read it."
msgstr "یہ ریپوزٹری محدود ہے۔ Hugging Face پر اس کی شرائط قبول کریں اور HF_TOKEN کو ایسا ٹوکن مقرر کریں جو اسے پڑھ سکے۔"

msgid "%(file)s is not at %(url)s any more (HTTP 404)."
msgstr "%(file)s اب %(url)s پر نہیں ہے (HTTP 404)۔"

msgid "Run `llamafit catalog refresh` to pick up the repository's current files."
msgstr "ریپوزٹری کی موجودہ فائلیں لینے کے لیے `llamafit catalog refresh` چلائیں۔"

msgid "%(url)s returned HTTP %(status)d."
msgstr "%(url)s نے HTTP %(status)d واپس کیا۔"

msgid "Confirm the URL points at a downloadable file."
msgstr "تصدیق کریں کہ URL کسی ڈاؤن لوڈ کے قابل فائل کی طرف اشارہ کرتا ہے۔"

msgid "%(url)s did not say how big %(file)s is."
msgstr "%(url)s نے نہیں بتایا کہ %(file)s کتنی بڑی ہے۔"

msgid "%(file)s is %(actual)s on the server but the catalog says %(expected)s; the repository has been re-uploaded since the catalog was refreshed."
msgstr "سرور پر %(file)s کا حجم %(actual)s ہے مگر کیٹلاگ %(expected)s کہتا ہے؛ کیٹلاگ تازہ ہونے کے بعد ریپوزٹری دوبارہ اپ لوڈ ہوئی ہے۔"

msgid "Run `llamafit catalog refresh` and try again."
msgstr "`llamafit catalog refresh` چلائیں اور دوبارہ کوشش کریں۔"

msgid "%(file)s: the server sent %(actual)d bytes of a %(expected)d byte range."
msgstr "%(file)s: سرور نے %(expected)d بائٹ کے range میں سے %(actual)d بائٹ بھیجے۔"

msgid "Run the command again; the parts that did arrive are kept."
msgstr "کمانڈ دوبارہ چلائیں؛ جو حصے پہنچ گئے وہ محفوظ ہیں۔"

msgid "Stopped."
msgstr "رک گیا۔"

msgid "%(file)s: the server asked for fewer connections; using %(count)d."
msgstr "%(file)s: سرور نے کم کنکشن مانگے؛ %(count)d استعمال ہو رہے ہیں۔"

msgid "%(file)s: this server will not serve byte ranges; fetching it in one stream."
msgstr "%(file)s: یہ سرور بائٹ range نہیں دیتا؛ اسے ایک ہی stream میں لایا جا رہا ہے۔"

msgid "%(file)s does not match its checksum; fetching it again."
msgstr "%(file)s اپنے checksum سے نہیں ملتی؛ اسے دوبارہ لایا جا رہا ہے۔"

msgid "Check that the download directory is writable."
msgstr "جانچ لیں کہ ڈاؤن لوڈ ڈائریکٹری میں لکھا جا سکتا ہے۔"

msgid "%(needed)s is needed for this model but %(path)s has only %(free)s free, %(short)s short of what is wanted with %(headroom)s left spare."
msgstr "اس ماڈل کے لیے %(needed)s درکار ہے مگر %(path)s میں صرف %(free)s خالی ہے، یعنی %(headroom)s فالتو چھوڑ کر جو چاہیے اس سے %(short)s کم۔"

msgid "Free some space, or choose another directory with --dir, or a smaller quantisation with --quant."
msgstr "کچھ جگہ خالی کریں، یا --dir سے کوئی اور ڈائریکٹری چنیں، یا --quant سے چھوٹی quantisation۔"

msgid "could not measure the free space on %(path)s: %(error)s"
msgstr "%(path)s پر خالی جگہ ناپی نہیں جا سکی: %(error)s"

msgid "Check that the download directory's volume is available."
msgstr "جانچ لیں کہ ڈاؤن لوڈ ڈائریکٹری کا ڈرائیو دستیاب ہے۔"

msgid "%(model)s has no downloadable source in the catalog."
msgstr "کیٹلاگ میں %(model)s کا کوئی ڈاؤن لوڈ کے قابل ماخذ نہیں۔"

msgid "Only Hugging Face sources can be installed; this entry has none."
msgstr "صرف Hugging Face کے ماخذ انسٹال کیے جا سکتے ہیں؛ اس اندراج میں کوئی نہیں۔"

msgid "the catalog has no file list for %(model)s %(quant)s."
msgstr "کیٹلاگ کے پاس %(model)s %(quant)s کی کوئی فائل فہرست نہیں۔"

msgid "Run `llamafit catalog refresh` to fill in the file names."
msgstr "فائلوں کے نام بھرنے کے لیے `llamafit catalog refresh` چلائیں۔"

msgid "%(model)s publishes no quantisations."
msgstr "%(model)s کوئی quantisation شائع نہیں کرتا۔"

msgid "%(model)s does not publish a %(quant)s quantisation."
msgstr "%(model)s، %(quant)s quantisation شائع نہیں کرتا۔"

msgid "It publishes: %(quants)s"
msgstr "یہ شائع کرتا ہے: %(quants)s"

msgid "the catalog does not record how big %(quant)s is."
msgstr "کیٹلاگ درج نہیں کرتا کہ %(quant)s کتنی بڑی ہے۔"

msgid "Run `llamafit catalog refresh` to fill in the sizes."
msgstr "سائز بھرنے کے لیے `llamafit catalog refresh` چلائیں۔"

msgid "the catalog holds no checksum for %(files)s."
msgid_plural "the catalog holds no checksums for %(files)s."
msgstr[0] "کیٹلاگ کے پاس %(files)s کا کوئی checksum نہیں۔"
msgstr[1] "کیٹلاگ کے پاس %(files)s کے checksum نہیں۔"

msgid "Run `llamafit catalog refresh` to fetch them, or pass --allow-unverified to download anyway and check the files yourself."
msgstr "انہیں لانے کے لیے `llamafit catalog refresh` چلائیں، یا پھر بھی ڈاؤن لوڈ کرنے اور فائلیں خود جانچنے کے لیے --allow-unverified دیں۔"

msgid "%(done)s of %(total)s"
msgstr "%(total)s میں سے %(done)s"

msgid "%(rate)s/s"
msgstr "%(rate)s/s"

msgid "Fetching %(file)s (%(size)s)"
msgstr "%(file)s لایا جا رہا ہے (%(size)s)"

msgid "Checking %(file)s against its checksum"
msgstr "%(file)s کو اس کے checksum کے مقابل جانچا جا رہا ہے"

msgid "Done: %(file)s"
msgstr "مکمل: %(file)s"

msgid "could not create %(path)s: %(error)s"
msgstr "%(path)s نہیں بنایا جا سکا: %(error)s"

msgid "Check that the download directory is writable and has room."
msgstr "جانچ لیں کہ ڈاؤن لوڈ ڈائریکٹری میں لکھا جا سکتا ہے اور اس میں جگہ ہے۔"

msgid "could not move %(source)s into place: %(error)s"
msgstr "%(source)s کو اس کی جگہ منتقل نہیں کیا جا سکا: %(error)s"

msgid "could not record progress in %(path)s: %(error)s"
msgstr "%(path)s میں پیش رفت درج نہیں کی جا سکی: %(error)s"

msgid "could not fetch %(url)s: %(error)s"
msgstr "%(url)s حاصل نہیں کیا جا سکا: %(error)s"

msgid "Stopped before the checksum was finished."
msgstr "checksum مکمل ہونے سے پہلے رک گیا۔"

msgid "could not read %(path)s: %(error)s"
msgstr "%(path)s نہیں پڑھا جا سکا: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "جانچ لیں کہ فائل موجود ہے اور پڑھی جا سکتی ہے۔"

msgid "%(file)s is %(actual)d bytes, but the catalog says %(expected)d"
msgstr "%(file)s کا حجم %(actual)d بائٹ ہے، مگر کیٹلاگ %(expected)d کہتا ہے"

msgid "The transfer was cut short. Run the command again to fetch it properly."
msgstr "منتقلی بیچ میں کٹ گئی۔ اسے ٹھیک سے لانے کے لیے کمانڈ دوبارہ چلائیں۔"

msgid "%(file)s does not match the checksum the catalog holds."
msgstr "%(file)s کیٹلاگ کے پاس موجود checksum سے نہیں ملتی۔"

msgid "Expected %(expected)s but the file hashes to %(actual)s. The bad copy has been deleted; run the command again to fetch it."
msgstr "%(expected)s متوقع تھا مگر فائل کا hash %(actual)s ہے۔ خراب نقل حذف کر دی گئی؛ اسے لانے کے لیے کمانڈ دوبارہ چلائیں۔"

msgid "Command: %(command)s"
msgstr "کمانڈ: %(command)s"

msgid "truncated GGUF header: wanted %(wanted)d byte at offset %(offset)d, got %(got)d"
msgid_plural "truncated GGUF header: wanted %(wanted)d bytes at offset %(offset)d, got %(got)d"
msgstr[0] "ادھورا GGUF header: offset %(offset)d پر %(wanted)d بائٹ درکار تھا، ملے %(got)d"
msgstr[1] "ادھورا GGUF header: offset %(offset)d پر %(wanted)d بائٹ درکار تھے، ملے %(got)d"

msgid "The file may still be downloading, or the URL may not be a GGUF file."
msgstr "فائل شاید ابھی ڈاؤن لوڈ ہو رہی ہو، یا URL کسی GGUF فائل کا نہ ہو۔"

msgid "unknown GGUF value type %(type)d at offset %(offset)d"
msgstr "offset %(offset)d پر نامعلوم GGUF قدر کی قسم %(type)d"

msgid "This file may use a newer GGUF metadata type than LlamaFit supports."
msgstr "یہ فائل شاید GGUF میٹا ڈیٹا کی ایسی قسم استعمال کرتی ہے جو LlamaFit کی حمایت سے نئی ہے۔"

msgid "not a GGUF file: bad magic %(magic)s at offset 0"
msgstr "یہ GGUF فائل نہیں: offset 0 پر غلط magic %(magic)s"

msgid "Check that this file is actually a .gguf model."
msgstr "جانچ لیں کہ یہ فائل واقعی ایک .gguf ماڈل ہے۔"

msgid "unsupported GGUF version %(version)d at offset 4"
msgstr "offset 4 پر غیر معاون GGUF ورژن %(version)d"

msgid "LlamaFit supports GGUF versions %(versions)s."
msgstr "LlamaFit، GGUF کے %(versions)s ورژن کی حمایت کرتا ہے۔"

msgid "A memory budget built without these tensors would be too small, so none is built. If llama.cpp loads the file, LlamaFit's tensor-size table is missing the type."
msgstr "اِن tensor کے بغیر بنایا گیا میموری کا بجٹ بہت چھوٹا ہوگا، اس لیے کوئی بجٹ نہیں بنایا جاتا۔ اگر llama.cpp فائل لوڈ کر لیتا ہے تو LlamaFit کے tensor سائز کے جدول میں یہ قسم موجود نہیں۔"

msgid "%(type)d (%(count)d tensor, first %(name)s)"
msgid_plural "%(type)d (%(count)d tensors, first %(name)s)"
msgstr[0] "%(type)d (%(count)d tensor، پہلا %(name)s)"
msgstr[1] "%(type)d (%(count)d tensor، پہلا %(name)s)"

msgid "cannot size this GGUF file: %(count)d tensor uses a GGML type LlamaFit does not know: %(details)s"
msgid_plural "cannot size this GGUF file: %(count)d tensors use GGML types LlamaFit does not know: %(details)s"
msgstr[0] "اس GGUF فائل کا حجم نہیں نکالا جا سکتا: %(count)d tensor ایسی GGML قسم استعمال کرتا ہے جو LlamaFit نہیں جانتا: %(details)s"
msgstr[1] "اس GGUF فائل کا حجم نہیں نکالا جا سکتا: %(count)d tensor ایسی GGML اقسام استعمال کرتے ہیں جو LlamaFit نہیں جانتا: %(details)s"

msgid "%(count)d shard"
msgid_plural "%(count)d shards"
msgstr[0] "%(count)d shard"
msgstr[1] "%(count)d shard"

msgid "these GGUF files are not one split model: they disagree about '%(key)s', declaring %(values)s"
msgstr "یہ GGUF فائلیں ایک ہی split ماڈل کی نہیں: '%(key)s' کے بارے میں ان میں اختلاف ہے، یہ %(values)s بتاتی ہیں"

msgid "Pass the shards of one model, not of several."
msgstr "ایک ہی ماڈل کے shard دیں، کئی ماڈلوں کے نہیں۔"

msgid "no GGUF header to read facts from"
msgstr "حقائق پڑھنے کے لیے کوئی GGUF header نہیں"

msgid "Pass the model's file, or every shard of a split model."
msgstr "ماڈل کی فائل دیں، یا کسی split ماڈل کا ہر shard دیں۔"

msgid "%(count)d GGUF file of the %(total)d given carries no '%(key)s' key, so its place in a split model cannot be established"
msgid_plural "%(count)d GGUF files of the %(total)d given carry no '%(key)s' key, so their place in a split model cannot be established"
msgstr[0] "دی گئی %(total)d GGUF فائلوں میں سے %(count)d میں '%(key)s' key نہیں، اس لیے split ماڈل میں اس کی جگہ طے نہیں کی جا سکتی"
msgstr[1] "دی گئی %(total)d GGUF فائلوں میں سے %(count)d میں '%(key)s' key نہیں، اس لیے split ماڈل میں ان کی جگہ طے نہیں کی جا سکتی"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "یا تو ایک اکیلی بغیر split فائل دیں، یا ایک ہی split ماڈل کا ہر shard دیں۔"

msgid "incomplete shard set: the model declares %(shards)s and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "نامکمل shard مجموعہ: ماڈل %(shards)s بتاتا ہے اور %(arrived)d پہنچے (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "split ماڈل کا ہر shard دیں۔"

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "ماڈل کا میٹا ڈیٹا رکھنے والا shard غائب ہے: %(key)s %(numbers)s ملے، ان میں سے کسی ایک کا 0 ہونا متوقع تھا"

msgid "Pass every shard of the split model, including the first."
msgstr "split ماڈل کا ہر shard دیں، پہلا بھی۔"

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "نامکمل shard مجموعہ: %(key)s 0 سے %(last)d تک متوقع تھے، ملے %(numbers)s"

msgid "Pass each shard of the split model exactly once."
msgstr "split ماڈل کا ہر shard بالکل ایک بار دیں۔"

msgid "incomplete shard set: the model declares %(tensors)s and its %(shards)s hold %(held)d between them"
msgstr "نامکمل shard مجموعہ: ماڈل %(tensors)s بتاتا ہے اور اس کے %(shards)s مل کر %(held)d رکھتے ہیں"

msgid "%(count)d tensor"
msgid_plural "%(count)d tensors"
msgstr[0] "%(count)d tensor"
msgstr[1] "%(count)d tensor"

msgid "Check your network connection and that the URL is reachable."
msgstr "اپنا نیٹ ورک کنکشن جانچیں اور یہ بھی کہ URL تک پہنچا جا سکتا ہے۔"

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s نے 206 Partial Content کے بجائے HTTP %(status)d واپس کیا؛ ممکن ہے سرور range درخواستوں کی حمایت نہ کرتا ہو۔"

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "تصدیق کریں کہ URL کسی ڈاؤن لوڈ کے قابل GGUF فائل کی طرف اشارہ کرتا ہے۔"

msgctxt "CPU model"
msgid "unknown"
msgstr "نامعلوم"

msgid "nvidia-smi returned no GPUs"
msgstr "nvidia-smi نے کوئی GPU واپس نہیں کیا"

msgid "rocm-smi returned no cards"
msgstr "rocm-smi نے کوئی کارڈ واپس نہیں کیا"

msgid "system_profiler returned no displays"
msgstr "system_profiler نے کوئی ڈسپلے واپس نہیں کیا"

msgid "WMI returned no video controllers"
msgstr "WMI نے کوئی ویڈیو کنٹرولر واپس نہیں کیا"

msgid "lspci found no display controllers"
msgstr "lspci کو کوئی ڈسپلے کنٹرولر نہیں ملا"

msgid "vulkaninfo reported no discrete device with a memory heap"
msgstr "vulkaninfo نے میموری heap والا کوئی الگ آلہ نہیں بتایا"

msgid "no populated memory modules"
msgstr "کوئی بھرا ہوا میموری ماڈیول نہیں"

msgid "no SPMemoryDataType"
msgstr "کوئی SPMemoryDataType نہیں"

msgid "%(program)s: timed out after %(seconds)s second"
msgid_plural "%(program)s: timed out after %(seconds)s seconds"
msgstr[0] "%(program)s: %(seconds)s سیکنڈ بعد وقت ختم"
msgstr[1] "%(program)s: %(seconds)s سیکنڈ بعد وقت ختم"

msgid "empty command"
msgstr "خالی کمانڈ"

msgid "%(program)s: %(error)s"
msgstr "%(program)s: %(error)s"

msgid "%(program)s: not found"
msgstr "%(program)s: نہیں ملا"

msgid "exit code %(code)d: %(detail)s"
msgstr "exit code %(code)d: %(detail)s"

msgid "no hardware profile file at %(path)s"
msgstr "%(path)s پر کوئی hardware profile فائل نہیں"

msgid "Run `llamafit hardware list` to see the profiles LlamaFit has."
msgstr "LlamaFit کے پاس موجود پروفائل دیکھنے کے لیے `llamafit hardware list` چلائیں۔"

msgid "%(path)s is not a valid hardware profile: %(details)s"
msgstr "%(path)s کوئی درست hardware profile نہیں: %(details)s"

msgid "Run `llamafit hardware validate FILE` for the whole list."
msgstr "پوری فہرست کے لیے `llamafit hardware validate FILE` چلائیں۔"

msgid "no hardware profile named %(name)s"
msgstr "%(name)s نام کا کوئی hardware profile نہیں"

msgid "Profiles LlamaFit has: %(names)s"
msgstr "LlamaFit کے پاس موجود پروفائل: %(names)s"

msgid "Run `llamafit hardware path` to see where your own profiles go."
msgstr "یہ دیکھنے کے لیے کہ آپ کے اپنے پروفائل کہاں جاتے ہیں، `llamafit hardware path` چلائیں۔"

msgid "this machine has no graphics card, so there is no VRAM to override"
msgstr "اس مشین میں کوئی گرافکس کارڈ نہیں، اس لیے بدلنے کو کوئی VRAM نہیں"

msgid "Describe the whole machine in a hardware profile and pass --profile."
msgstr "پوری مشین کو کسی hardware profile میں بیان کریں اور --profile دیں۔"

msgid "this machine has one memory pool shared with the graphics card"
msgstr "اس مشین کا ایک ہی میموری پول ہے جو گرافکس کارڈ کے ساتھ مشترک ہے"

msgid "Use --ram to resize the pool; --memory would change only half of it."
msgstr "پول کا حجم بدلنے کے لیے --ram استعمال کریں؛ --memory اس کا صرف آدھا حصہ بدلے گا۔"

msgid "%(option)s needs a value above zero"
msgstr "%(option)s کو صفر سے بڑی قدر چاہیے"

msgid "no build number in the version output: %(text)s"
msgstr "ورژن کے آؤٹ پٹ میں کوئی build نمبر نہیں: %(text)s"

msgid "llama.cpp not found: no llama-server on PATH, in LLAMA_CPP_PATH or in the usual directories"
msgstr "llama.cpp نہیں ملا: نہ PATH پر، نہ LLAMA_CPP_PATH میں، نہ عام ڈائریکٹریوں میں کوئی llama-server ہے"

msgid "no ggml backend libraries found next to llama-server; the build may be static"
msgstr "llama-server کے ساتھ کوئی ggml backend لائبریری نہیں ملی؛ ممکن ہے build static ہو"

msgid "%(path)s is a file, not a directory."
msgstr "%(path)s ایک فائل ہے، ڈائریکٹری نہیں۔"

msgid "%(path)s cannot be read: %(error)s"
msgstr "%(path)s پڑھی نہیں جا سکتی: %(error)s"

msgid "%(path)s has a marker file that cannot be read."
msgstr "%(path)s میں ایک marker فائل ہے جو پڑھی نہیں جا سکتی۔"

msgid "%(path)s already holds %(count)d file that LlamaFit did not install."
msgid_plural "%(path)s already holds %(count)d files that LlamaFit did not install."
msgstr[0] "%(path)s میں پہلے سے %(count)d فائل ہے جو LlamaFit نے انسٹال نہیں کی۔"
msgstr[1] "%(path)s میں پہلے سے %(count)d فائلیں ہیں جو LlamaFit نے انسٹال نہیں کیں۔"

msgid "%(name)s has no published checksum, so it cannot be verified."
msgstr "%(name)s کا کوئی شائع شدہ checksum نہیں، اس لیے اس کی تصدیق نہیں ہو سکتی۔"

msgid "Pass --allow-unverified to install it anyway, knowing the archive is unchecked."
msgstr "اسے پھر بھی انسٹال کرنے کے لیے --allow-unverified دیں، یہ جانتے ہوئے کہ آرکائیو جانچا نہیں گیا۔"

msgid "could not download %(url)s: %(error)s"
msgstr "%(url)s ڈاؤن لوڈ نہیں کیا جا سکا: %(error)s"

msgid "the connection was closed"
msgstr "کنکشن بند ہو گیا"

msgid "Run the command again; it continues from where it stopped."
msgstr "کمانڈ دوبارہ چلائیں؛ یہ وہیں سے جاری رہتی ہے جہاں رکی تھی۔"

msgid "the download of %(url)s stopped early: %(error)s"
msgstr "%(url)s کا ڈاؤن لوڈ وقت سے پہلے رک گیا: %(error)s"

msgid "%(got)s of %(want)s arrived"
msgstr "%(want)s میں سے %(got)s پہنچا"

msgid "the disk holding %(path)s is full."
msgstr "%(path)s رکھنے والی ڈسک بھری ہوئی ہے۔"

msgid "Free some space and run the command again; the download resumes."
msgstr "کچھ جگہ خالی کریں اور کمانڈ دوبارہ چلائیں؛ ڈاؤن لوڈ جاری ہو جائے گا۔"

msgid "Check that the directory exists and is writable."
msgstr "جانچ لیں کہ ڈائریکٹری موجود ہے اور اس میں لکھا جا سکتا ہے۔"

msgid "%(name)s did not match its published checksum and was discarded."
msgstr "%(name)s اپنے شائع شدہ checksum سے نہیں ملی اور ضائع کر دی گئی۔"

msgid "Nothing was unpacked. Run the command again: the archive arrived damaged, which a second download usually fixes."
msgstr "کچھ نہیں کھولا گیا۔ کمانڈ دوبارہ چلائیں: آرکائیو خراب پہنچا، اور دوسرا ڈاؤن لوڈ عموماً یہ ٹھیک کر دیتا ہے۔"

msgid "%(archive)s contains %(name)s, which would be written outside the install directory."
msgstr "%(archive)s میں %(name)s ہے، جو انسٹال ڈائریکٹری سے باہر لکھا جاتا۔"

msgid "Do not install this archive; report it to the llama.cpp project."
msgstr "یہ آرکائیو انسٹال نہ کریں؛ اس کی اطلاع llama.cpp پروجیکٹ کو دیں۔"

msgid "%(name)s is not an archive LlamaFit knows how to unpack."
msgstr "%(name)s ایسا آرکائیو نہیں جسے کھولنا LlamaFit جانتا ہو۔"

msgid "%(name)s could not be unpacked: %(error)s"
msgstr "%(name)s کھولا نہیں جا سکا: %(error)s"

msgid "Delete it and run the command again to download it afresh."
msgstr "اسے حذف کریں اور نئے سرے سے ڈاؤن لوڈ کرنے کے لیے کمانڈ دوبارہ چلائیں۔"

msgid "the archive holds no %(name)s."
msgstr "آرکائیو میں کوئی %(name)s نہیں۔"

msgid "Report this; the release layout has changed."
msgstr "اس کی اطلاع دیں؛ ریلیز کی ساخت بدل گئی ہے۔"

msgid "%(path)s was not installed by LlamaFit."
msgstr "%(path)s کو LlamaFit نے انسٹال نہیں کیا تھا۔"

msgid "Pass --force to replace it, or --dir to install somewhere else. LlamaFit never overwrites an installation it did not create."
msgstr "اسے بدلنے کے لیے --force دیں، یا کہیں اور انسٹال کرنے کے لیے --dir۔ LlamaFit ایسی تنصیب پر کبھی نہیں لکھتا جو اس نے خود نہ بنائی ہو۔"

msgid "%(path)s has %(free)s free; this install needs %(needed)s."
msgstr "%(path)s میں %(free)s خالی ہے؛ اس تنصیب کو %(needed)s درکار ہے۔"

msgid "Free some space, or pass --dir to install on another volume."
msgstr "کچھ جگہ خالی کریں، یا کسی اور ڈرائیو پر انسٹال کرنے کے لیے --dir دیں۔"

msgid "the %(backend)s libraries are not in the installed directory."
msgstr "%(backend)s کی لائبریریاں انسٹال شدہ ڈائریکٹری میں نہیں ہیں۔"

msgid "no ggml backend libraries were installed; the build may be a static one."
msgstr "کوئی ggml backend لائبریری انسٹال نہیں ہوئی؛ ممکن ہے build static ہو۔"

msgid "Your PATH could not be read, so it will not be changed."
msgstr "آپ کا PATH پڑھا نہیں جا سکا، اس لیے اسے بدلا نہیں جائے گا۔"

msgid "Add %(path)s to your user PATH (HKCU\\Environment)."
msgstr "%(path)s کو اپنے صارف کے PATH میں شامل کریں (HKCU\\Environment)۔"

msgid "To undo: run `setx PATH \"%(previous)s\"`, or remove the entry in System > About > Advanced system settings > Environment Variables."
msgstr "واپس لینے کے لیے: `setx PATH \"%(previous)s\"` چلائیں، یا System > About > Advanced system settings > Environment Variables میں سے یہ اندراج ہٹا دیں۔"

msgid "%(path)s is already on your PATH."
msgstr "%(path)s پہلے ہی آپ کے PATH میں ہے۔"

msgid "Nothing to undo."
msgstr "واپس لینے کو کچھ نہیں۔"

msgid "Append a PATH line for %(path)s to %(file)s."
msgstr "%(path)s کے لیے ایک PATH سطر %(file)s میں شامل کریں۔"

msgid "To undo: delete the two lines marked `%(mark)s` from %(file)s."
msgstr "واپس لینے کے لیے: %(file)s میں سے `%(mark)s` سے نشان زد دونوں سطریں حذف کریں۔"

msgid "your PATH could not be changed: %(error)s"
msgstr "آپ کا PATH بدلا نہیں جا سکا: %(error)s"

msgid "To remove it later, delete %(path)s."
msgstr "بعد میں ہٹانے کے لیے %(path)s حذف کر دیں۔"

msgid "the most recent %(count)d llama.cpp releases hold no build."
msgstr "llama.cpp کی تازہ ترین %(count)d ریلیزوں میں کوئی build نہیں۔"

msgid "Name one with `llamafit install llama.cpp --tag ...`."
msgstr "`llamafit install llama.cpp --tag ...` سے کسی ایک کا نام دیں۔"

msgid "could not reach GitHub at %(url)s: %(error)s"
msgstr "%(url)s پر GitHub تک نہیں پہنچا جا سکا: %(error)s"

msgid "GitHub refused the request for %(url)s: the rate limit is exhausted."
msgstr "GitHub نے %(url)s کی درخواست رد کر دی: rate limit ختم ہو چکی ہے۔"

msgid "Wait for the limit to reset, or set GITHUB_TOKEN to a personal access token with no scopes."
msgstr "حد کے دوبارہ مقرر ہونے کا انتظار کریں، یا GITHUB_TOKEN کو بغیر کسی scope والا ذاتی رسائی ٹوکن مقرر کریں۔"

msgid "GitHub has no release at %(url)s."
msgstr "GitHub پر %(url)s کوئی ریلیز نہیں۔"

msgid "Check the tag with `llamafit install llama.cpp --tag ...`."
msgstr "ٹیگ کو `llamafit install llama.cpp --tag ...` سے جانچیں۔"

msgid "GitHub returned %(status)d for %(url)s."
msgstr "GitHub نے %(url)s کے لیے %(status)d واپس کیا۔"

msgid "GitHub's answer for %(url)s was not JSON."
msgstr "%(url)s کے لیے GitHub کا جواب JSON نہیں تھا۔"

msgid "GitHub's answer did not describe a release."
msgstr "GitHub کے جواب میں کسی ریلیز کی تفصیل نہیں تھی۔"

msgid "no llama-server answering"
msgstr "کوئی llama-server جواب نہیں دے رہا"

msgid "unexpected response: %(error)s"
msgstr "غیر متوقع جواب: %(error)s"

msgid "%(model)s holds %(native)s tokens, fewer than the %(minimum)s asked for."
msgstr "%(model)s، %(native)s ٹوکن سنبھالتا ہے، جو مانگے گئے %(minimum)s سے کم ہیں۔"

msgid "No configuration of this model fits this machine."
msgstr "اس ماڈل کی کوئی کنفیگریشن اس مشین میں نہیں سماتی۔"

msgid "Routed experts are held in system memory, and so are the always-on shared experts, which is what -ot ffn_.*_shexp=CPU does; attention and the KV cache stay on the card."
msgstr "routed expert سسٹم میموری میں رکھے جاتے ہیں، اور ہمیشہ فعال مشترکہ expert بھی، یہی -ot ffn_.*_shexp=CPU کرتا ہے؛ attention اور KV کیش کارڈ پر رہتے ہیں۔"

msgid "Routed experts are held in system memory; attention, the KV cache and the shared experts stay on the card."
msgstr "routed expert سسٹم میموری میں رکھے جاتے ہیں؛ attention، KV کیش اور مشترکہ expert کارڈ پر رہتے ہیں۔"

msgid "%(layers)s layers are on the card and the rest run on the processor."
msgstr "%(layers)s پرتیں کارڈ پر ہیں اور باقی پروسیسر پر چلتی ہیں۔"

msgid "Nothing runs on a graphics card: every weight is in system memory."
msgstr "کچھ بھی گرافکس کارڈ پر نہیں چلتا: ہر وزن سسٹم میموری میں ہے۔"

msgid "%(gpus)s is here, but nothing could read how much of it is free, so this plan was made as if it were not. The real machine will be faster than these figures."
msgstr "%(gpus)s یہاں موجود ہے، مگر کوئی چیز نہ پڑھ سکی کہ اس کا کتنا حصہ خالی ہے، اس لیے یہ پلان ایسے بنایا گیا جیسے وہ ہے ہی نہیں۔ اصل مشین ان اعداد سے تیز ہوگی۔"

msgid "Sized for %(context)s tokens rather than the %(requested)s asked for."
msgstr "مانگے گئے %(requested)s کے بجائے %(context)s ٹوکن کے لیے حجم نکالا گیا۔"

msgid "The KV cache is quantised to %(type)s to reach this context."
msgstr "اس context تک پہنچنے کے لیے KV کیش کو %(type)s پر quantise کیا گیا ہے۔"

msgid "Vision is off: the projector did not fit, on the card or in system memory."
msgstr "بصارت بند ہے: projector نہ کارڈ پر سمایا نہ سسٹم میموری میں۔"

msgid "The vision projector is in system memory (--no-mmproj-offload), which costs nothing measurable for text and makes images slower."
msgstr "vision projector سسٹم میموری میں ہے (--no-mmproj-offload)، جس کی متن کے لیے کوئی قابلِ پیمائش قیمت نہیں اور تصویریں سست ہو جاتی ہیں۔"

msgid "%(threads)s threads, not the %(available)s this processor has: the efficiency cores are left out because generation measures slower with them, and what is left is the threads the performance cores provide."
msgstr "%(threads)s تھریڈ، نہ کہ %(available)s جو اس پروسیسر کے پاس ہیں: efficiency کور چھوڑ دیے گئے کیونکہ ان کے ساتھ جنریشن سست ماپی جاتی ہے، اور جو بچتے ہیں وہ پرفارمنس کور کے دیے ہوئے تھریڈ ہیں۔"

msgid "Tight: %(vram)s of the graphics card is free and this needs %(needed)s, so another program can push it over. The context tier table is how a launch script recovers."
msgstr "تنگ: گرافکس کارڈ کا %(vram)s خالی ہے اور اسے %(needed)s چاہیے، اس لیے کوئی دوسرا پروگرام اسے حد سے آگے دھکیل سکتا ہے۔ context کے درجوں کا جدول ہی وہ طریقہ ہے جس سے launch سکرپٹ سنبھلتا ہے۔"

msgid "no %(capability)s capability, which %(use_case)s needs; ask for a different use case, or add it to the entry when the model really has it"
msgstr "%(capability)s کی صلاحیت نہیں، جو %(use_case)s کو درکار ہے؛ کوئی اور استعمال کی قسم مانگیں، یا اگر ماڈل میں واقعی ہے تو اسے اندراج میں شامل کریں"

msgid "no %(capability)s capability; drop it from the request to see this model"
msgstr "%(capability)s کی صلاحیت نہیں؛ اس ماڈل کو دیکھنے کے لیے اسے درخواست سے نکال دیں"

msgid "%(size)s to download, over the %(limit)s this request allows"
msgstr "ڈاؤن لوڈ میں %(size)s، جو اس درخواست کی اجازت دی گئی %(limit)s سے زیادہ ہے"

msgid "unknown quantisation %(quant)s, so its cost in quality cannot be told"
msgstr "نامعلوم quantisation %(quant)s، اس لیے اس کی معیار میں قیمت نہیں بتائی جا سکتی"

msgid "nowhere to put it: no placement fits this machine at any context"
msgstr "اسے رکھنے کو کوئی جگہ نہیں: کوئی بندوبست کسی بھی context پر اس مشین میں نہیں سماتا"

msgid "holds %(fit)s tokens at most, under the %(minimum)s asked for; lower the minimum context or free memory to see it ranked"
msgstr "زیادہ سے زیادہ %(fit)s ٹوکن سنبھالتا ہے، جو مانگے گئے %(minimum)s سے کم ہیں؛ کم از کم context گھٹائیں یا میموری خالی کریں تاکہ یہ درجہ بندی میں نظر آئے"

msgid "generates %(tps)s tokens per second, below the %(floor)s this request asks for; lower --min-tps or choose a smaller model or quantisation"
msgstr "%(tps)s ٹوکن فی سیکنڈ بناتا ہے، جو اس درخواست کے مانگے ہوئے %(floor)s سے کم ہیں؛ --min-tps کم کریں یا چھوٹا ماڈل یا quantisation چنیں"

msgid "generates %(tps)s tokens per second, below the %(floor)s a person reads at: a batch tool on this machine and not one to sit in front of; a smaller model or quantisation would keep up"
msgstr "%(tps)s ٹوکن فی سیکنڈ بناتا ہے، جو انسان کے پڑھنے کی %(floor)s سے کم ہیں: اس مشین پر یہ batch کا اوزار ہے، سامنے بیٹھنے کا نہیں؛ چھوٹا ماڈل یا quantisation ساتھ چل پاتا"

msgid "unknown use case %(use_case)s"
msgstr "نامعلوم استعمال کی قسم %(use_case)s"

msgid "Known use cases: %(known)s."
msgstr "معلوم استعمال کی اقسام: %(known)s۔"

msgid "unknown score part %(part)s in the weights for %(use_case)s"
msgstr "%(use_case)s کے وزنوں میں نامعلوم سکور جزو %(part)s"

msgid "The parts are: %(parts)s."
msgstr "اجزا یہ ہیں: %(parts)s۔"

msgid "the weights for %(use_case)s leave out %(part)s"
msgstr "%(use_case)s کے وزن %(part)s کو چھوڑ دیتے ہیں"

msgid "Overriding a use case means giving all four parts: %(parts)s."
msgstr "کسی استعمال کی قسم بدلنے کا مطلب ہے چاروں اجزا دینا: %(parts)s۔"

msgid "the weight for %(part)s in %(use_case)s is below zero"
msgstr "%(use_case)s میں %(part)s کا وزن صفر سے کم ہے"

msgid "A weight says how much a part counts; it cannot count less than none."
msgstr "وزن بتاتا ہے کہ کوئی جزو کتنا گنا جاتا ہے؛ وہ کچھ نہ ہونے سے بھی کم نہیں گنا جا سکتا۔"

msgid "the weights for %(use_case)s add up to nothing"
msgstr "%(use_case)s کے وزنوں کا مجموعہ صفر ہے"

msgid "At least one part has to count for something."
msgstr "کم از کم ایک جزو کا کچھ نہ کچھ گنا جانا ضروری ہے۔"

msgid "unknown preference %(prefer)s"
msgstr "نامعلوم ترجیح %(prefer)s"

msgid "Preferences: %(known)s."
msgstr "ترجیحات: %(known)s۔"

msgid "Install or repair the NVIDIA driver; nvidia-smi ships with it and must be on PATH."
msgstr "NVIDIA ڈرائیور انسٹال کریں یا درست کریں؛ nvidia-smi اسی کے ساتھ آتا ہے اور اس کا PATH پر ہونا ضروری ہے۔"

msgid "Install ROCm (Linux) to expose AMD VRAM figures; without it the GPU is listed by name only."
msgstr "AMD کی VRAM کے اعداد دیکھنے کے لیے ROCm (Linux) انسٹال کریں؛ اس کے بغیر GPU صرف نام سے درج ہوتا ہے۔"

msgid "PowerShell could not list video controllers; run from a normal user session."
msgstr "PowerShell ویڈیو کنٹرولرز کی فہرست نہیں دے سکا؛ اسے کسی عام صارف سیشن سے چلائیں۔"

msgid "Install pciutils to list GPUs by name when no vendor tool is available."
msgstr "جب کوئی وینڈر ٹول دستیاب نہ ہو تو GPU نام سے درج کرنے کے لیے pciutils انسٹال کریں۔"

msgid "DDR type and speed were not readable; on Linux run once with sudo (dmidecode) or accept the measured bandwidth instead."
msgstr "DDR کی قسم اور رفتار پڑھی نہیں جا سکی؛ Linux پر ایک بار sudo کے ساتھ چلائیں (dmidecode) یا اس کے بجائے ماپی گئی بینڈوتھ قبول کریں۔"

msgid "py-cpuinfo failed; the CPU model and instruction sets are unknown."
msgstr "py-cpuinfo ناکام رہا؛ CPU کا ماڈل اور instruction set نامعلوم ہیں۔"

msgid "psutil could not count the CPU cores; thread choice falls back to one core. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil، CPU کور گن نہیں سکا؛ تھریڈ کا انتخاب ایک ہی کور پر لوٹ آتا ہے۔ psutil کو `pip install --force-reinstall psutil` سے دوبارہ انسٹال کریں۔"

msgid "psutil could not read the memory totals; budgets cannot be computed until this works. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil میموری کے کل اعداد نہیں پڑھ سکا؛ جب تک یہ کام نہیں کرتا، بجٹ کا حساب نہیں لگایا جا سکتا۔ psutil کو `pip install --force-reinstall psutil` سے دوبارہ انسٹال کریں۔"

msgid "Could not read performance-core count from sysctl."
msgstr "sysctl سے پرفارمنس کور کی تعداد نہیں پڑھی جا سکی۔"

msgid "llama-server exists but did not report a version; the binary may be broken."
msgstr "llama-server موجود تو ہے مگر اس نے کوئی ورژن نہیں بتایا؛ ممکن ہے binary خراب ہو۔"

msgid "system_profiler failed; GPU information is unavailable."
msgstr "system_profiler ناکام رہا؛ GPU کی معلومات دستیاب نہیں۔"

msgid "Install the Vulkan tools (vulkan-tools on Linux, the vendor's Vulkan runtime on Windows) so an unsized card's memory can be read from its driver. This probe runs only when no vendor tool sized the card, so it is the last source there is."
msgstr "Vulkan ٹول انسٹال کریں (Linux پر vulkan-tools، Windows پر وینڈر کا Vulkan runtime) تاکہ جس کارڈ کا حجم معلوم نہ ہو اس کی میموری ڈرائیور سے پڑھی جا سکے۔ یہ جانچ صرف تب چلتی ہے جب کسی وینڈر ٹول نے کارڈ کا حجم نہ نکالا ہو، اس لیے یہی آخری ماخذ ہے۔"

msgid "No vendor tool reported the GPU's memory size; record the size in a hardware profile so budgets can be computed for this machine."
msgstr "کسی وینڈر ٹول نے GPU کی میموری کا حجم نہیں بتایا؛ یہ حجم کسی hardware profile میں درج کریں تاکہ اس مشین کے لیے بجٹ کا حساب لگایا جا سکے۔"

msgid "llama.cpp installed"
msgstr "llama.cpp انسٹال ہے"

msgid "build %(build)s at %(path)s, backends: %(backends)s"
msgstr "%(path)s پر build %(build)s، backends: %(backends)s"

msgctxt "llama.cpp build"
msgid "unknown"
msgstr "نامعلوم"

msgid "llama.cpp not found"
msgstr "llama.cpp نہیں ملا"

msgid "no llama-server binary was found"
msgstr "کوئی llama-server binary نہیں ملی"

msgid "Run `llamafit install llama.cpp`, which picks the right build for this machine, checks it against its published checksum, and never touches an installation LlamaFit did not create."
msgstr "`llamafit install llama.cpp` چلائیں، جو اس مشین کے لیے درست build چنتا ہے، اسے اس کے شائع شدہ checksum کے مقابل جانچتا ہے، اور ایسی تنصیب کو کبھی نہیں چھوتا جو LlamaFit نے نہ بنائی ہو۔"

msgid "Memory size unknown"
msgstr "میموری کا حجم نامعلوم"

msgid "LlamaFit could not read this machine's memory totals, so it cannot work out what will fit."
msgstr "LlamaFit اس مشین کی کل میموری نہیں پڑھ سکا، اس لیے وہ طے نہیں کر سکتا کہ اس میں کیا سما جائے گا۔"

msgid "%(gpu)s: no %(backend)s backend in llama.cpp"
msgstr "%(gpu)s: llama.cpp میں کوئی %(backend)s backend نہیں"

msgid "llama.cpp was built with: %(backends)s"
msgstr "llama.cpp اِن کے ساتھ بنایا گیا: %(backends)s"

msgctxt "backends"
msgid "unknown"
msgstr "نامعلوم"

msgid "Install a llama.cpp build with the %(backend)s or Vulkan backend to use %(gpu)s."
msgstr "%(gpu)s استعمال کرنے کے لیے %(backend)s یا Vulkan backend والا llama.cpp build انسٹال کریں۔"

msgid "%(gpu)s: VRAM size unknown"
msgstr "%(gpu)s: VRAM کا حجم نامعلوم"

msgid "the vendor tool that reports memory was not available"
msgstr "میموری بتانے والا وینڈر ٹول دستیاب نہیں تھا"

msgid "%(gpus)s: planned around, not planned on"
msgstr "%(gpus)s: اس کے گرد پلان بنا، اس پر نہیں"

msgid "with no reading of how much of the card is free, every budget and every speed on this machine was computed as if there were no card: they are CPU-only figures, and the real machine will be faster."
msgstr "کارڈ کا کتنا حصہ خالی ہے یہ پڑھے بغیر، اس مشین کا ہر بجٹ اور ہر رفتار ایسے نکالی گئی جیسے کوئی کارڈ ہی نہ ہو: یہ صرف CPU کے اعداد ہیں، اور اصل مشین تیز ہوگی۔"

msgid "Install the Vulkan tools so the size can be read from the driver, or record it in a hardware profile (`llamafit hardware path` says where those go) and pass --profile."
msgstr "Vulkan ٹول انسٹال کریں تاکہ حجم ڈرائیور سے پڑھا جا سکے، یا اسے کسی hardware profile میں درج کریں (`llamafit hardware path` بتاتا ہے کہ وہ کہاں جاتے ہیں) اور --profile دیں۔"

msgid "No GPU detected"
msgstr "کوئی GPU نہیں ملا"

msgid "models will run on the CPU only"
msgstr "ماڈل صرف CPU پر چلیں گے"

msgid "If a GPU is present, check that its driver tools are installed."
msgstr "اگر GPU موجود ہے تو جانچ لیں کہ اس کے ڈرائیور ٹول انسٹال ہیں۔"

msgid "RAM bandwidth assumed"
msgstr "RAM بینڈوتھ فرض کر لی گئی"

msgid "using %(gbps)s GB/s as a default"
msgstr "طے شدہ کے طور پر %(gbps)s GB/s استعمال ہو رہی ہے"

msgid "Install numpy (`pip install llamafit[fast]`) so LlamaFit can measure the RAM bandwidth."
msgstr "numpy انسٹال کریں (`pip install llamafit[fast]`) تاکہ LlamaFit، RAM بینڈوتھ ماپ سکے۔"

msgid "Probe %(probe)s failed"
msgstr "جانچ %(probe)s ناکام رہی"

msgctxt "probe error"
msgid "unknown error"
msgstr "نامعلوم خرابی"

msgid "llama-server running at %(url)s"
msgstr "%(url)s پر llama-server چل رہا ہے"

msgid "model %(model)s, context %(context)s"
msgstr "ماڈل %(model)s، context %(context)s"

msgctxt "model name"
msgid "unknown"
msgstr "نامعلوم"

msgid "Low disk space on %(path)s"
msgstr "%(path)s پر ڈسک میں جگہ کم"

msgid "%(size)s free"
msgstr "%(size)s خالی"

msgid "Most useful models need 5 to 120 GB; free space or change the downloads directory."
msgstr "زیادہ تر کام کے ماڈلوں کو 5 سے 120 GB درکار ہوتے ہیں؛ جگہ خالی کریں یا ڈاؤن لوڈ ڈائریکٹری بدلیں۔"

msgid "%(model)s has no %(quant)s quantisation"
msgstr "%(model)s کے پاس %(quant)s quantisation نہیں"

msgid "It publishes: %(names)s"
msgstr "یہ شائع کرتا ہے: %(names)s"

msgid "licensed %(spdx)s, which this request does not allow"
msgstr "%(spdx)s کے تحت لائسنس یافتہ، جس کی یہ درخواست اجازت نہیں دیتی"

msgid "System memory bandwidth was not measured; %(gbps)s GB/s assumed for %(arch)s."
msgstr "سسٹم میموری کی بینڈوتھ نہیں ماپی گئی؛ %(arch)s کے لیے %(gbps)s GB/s فرض کر لی گئی۔"

msgid "%(gpu)s bandwidth is unknown; the %(backend)s fallback of %(gbps)s GB/s stands in."
msgstr "%(gpu)s کی بینڈوتھ نامعلوم ہے؛ %(backend)s کا %(gbps)s GB/s کا متبادل اس کی جگہ لے رہا ہے۔"

msgid "No graphics card compute figure: prompt processing is estimated on the CPU."
msgstr "گرافکس کارڈ کے compute کا کوئی عدد نہیں: prompt کی پروسیسنگ کا تخمینہ CPU پر لگایا گیا ہے۔"

msgid "%(gb)s GB of routed experts is read from system memory per token at %(eff)s of its %(raw)s GB/s, because each token selects a different handful of experts and the read is a scatter of small blocks rather than a stream."
msgstr "ہر ٹوکن پر routed expert کے %(gb)s GB سسٹم میموری سے اس کی %(raw)s GB/s کے %(eff)s پر پڑھے جاتے ہیں، کیونکہ ہر ٹوکن مختلف چند expert چنتا ہے اور یہ پڑھنا چھوٹے بلاکوں کا بکھراؤ ہے، کوئی stream نہیں۔"

msgid "%(gb)s GB of contiguous weights is read from system memory per token at %(eff)s of its %(raw)s GB/s."
msgstr "ہر ٹوکن پر متصل وزن کے %(gb)s GB سسٹم میموری سے اس کی %(raw)s GB/s کے %(eff)s پر پڑھے جاتے ہیں۔"

msgid "No active parameter count was supplied; it was inferred from the weight bytes."
msgstr "فعال پیرامیٹروں کی تعداد نہیں دی گئی؛ اسے وزن کے بائٹ سے اخذ کیا گیا۔"

msgid "%(pct)s percent of the layers sit in system memory, so that share of the prompt arithmetic is charged to the CPU at %(tflops)s TFLOP/s rather than to the card. Both rates come from one small dense model on one machine."
msgstr "%(pct)s فیصد پرتیں سسٹم میموری میں ہیں، اس لیے prompt کے حساب کا اتنا حصہ کارڈ کے بجائے CPU کے کھاتے میں %(tflops)s TFLOP/s پر ڈالا جاتا ہے۔ دونوں شرحیں ایک ہی مشین پر ایک ہی چھوٹے کثیف ماڈل سے آتی ہیں۔"

msgid "%(gb)s GB of the expert set is streamed across the link once per micro-batch at %(gbps)s GB/s. That rate was fitted on the one model whose expert set does not fit in system memory, so part of its read comes off the disk; an expert set that stays in the page cache streams about three times faster, and for one of those this term is that much too slow."
msgstr "expert کے مجموعے کے %(gb)s GB ہر مائیکرو بیچ میں ایک بار link کے پار %(gbps)s GB/s پر stream ہوتے ہیں۔ یہ شرح اُس واحد ماڈل پر fit کی گئی تھی جس کا expert مجموعہ سسٹم میموری میں نہیں سماتا، اس لیے اس کی کچھ پڑھائی ڈسک سے آتی ہے؛ جو expert مجموعہ page cache میں رہ جائے وہ تقریباً تین گنا تیز stream ہوتا ہے، اور ایسے کسی ماڈل کے لیے یہ جزو اتنا ہی زیادہ سست ہے۔"

msgid "%(gb)s GB of the expert set is read out of system memory once per micro-batch at %(gbps)s GB/s, because there is no card to stream it to."
msgstr "expert کے مجموعے کے %(gb)s GB ہر مائیکرو بیچ میں ایک بار سسٹم میموری سے %(gbps)s GB/s پر پڑھے جاتے ہیں، کیونکہ انہیں stream کرنے کو کوئی کارڈ نہیں۔"

msgid "No placement of this model on this machine could run it."
msgstr "اس مشین پر اس ماڈل کا کوئی بندوبست اسے چلا نہیں سکا۔"

msgid "Generation is a benchmark of this configuration, not a prediction."
msgstr "جنریشن اس کنفیگریشن کا بینچ مارک ہے، پیشگوئی نہیں۔"

msgid "Generation is the formula corrected by %(factor)s, from a benchmark of %(profile)s on this machine taken on %(date)s."
msgstr "جنریشن وہی فارمولا ہے جو %(factor)s سے درست کیا گیا، اس مشین پر %(date)s کو لیے گئے %(profile)s کے بینچ مارک سے۔"

msgid "Prompt processing is a benchmark of this configuration."
msgstr "prompt کی پروسیسنگ اس کنفیگریشن کا بینچ مارک ہے۔"

msgid "Prompt processing is the formula corrected by %(factor)s from a benchmark."
msgstr "prompt کی پروسیسنگ وہی فارمولا ہے جو ایک بینچ مارک سے %(factor)s پر درست کیا گیا۔"

msgid "That benchmark's command line does not record how many layers went to the card, so the correction assumes it ran at this placement."
msgstr "اُس بینچ مارک کی کمانڈ لائن درج نہیں کرتی کہ کتنی پرتیں کارڈ پر گئیں، اس لیے تصحیح یہ فرض کرتی ہے کہ وہ اسی بندوبست پر چلا تھا۔"

msgid "This figure assumes nothing pages: a placement this tight often does, silently."
msgstr "یہ عدد فرض کرتا ہے کہ کہیں paging نہیں ہو رہی: اتنا تنگ بندوبست اکثر خاموشی سے paging کرتا ہے۔"

