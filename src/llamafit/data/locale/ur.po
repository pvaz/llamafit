# اور اسے کسی دوسرے قاری نے نہیں پڑھا۔ docs/translations.md ہر زبان کے لیے جو معیار مقرر کرتا
# ہے، اس کے مطابق یہ کافی نہیں: براہِ کرم اسے سطر بہ سطر پڑھیں اور pull request میں درست کریں۔
#
msgid ""
msgstr ""
"Project-Id-Version: llamafit 0.1.0a1\n"
"Report-Msgid-Bugs-To: https://github.com/pvaz/llamafit/issues\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ur\n"
"Language-Team: Urdu\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# Urdu counts one apart from everything else, zero included, so the rule has the same
# shape as English's: CLDR puts ur in the group whose singular is exactly n = 1.
#
# Urdu is written right to left, and this file is stored in logical order, which is what
# gettext and the terminal both expect. It is still going to be read inside tables that
# are laid out left to right, and nothing in a catalog can change that: see the note in
# the translator's report that came with this file.
#
# Names that are not language stay in Latin: LlamaFit, llama.cpp, Hugging Face, GGUF,
# JSON, YAML, CUDA, Vulkan, Metal, flags, paths and tool names, plus the jargon an Urdu
# developer only ever writes in English: backend, quant, shard, offset, header, key,
# schema, build, binary, traceback, checksum, tensor, expert, context. Every one of those
# is a left-to-right island in a right-to-left sentence, so keep them where they are
# rather than moving them next to punctuation.

msgid "nothing measured touches this term, so there is no equation it appears in"
msgstr "ماپی گئی کوئی چیز اس جزو کو نہیں چھوتی، اس لیے کوئی ایسی مساوات نہیں جس میں یہ آتا ہو"

msgid "%(measurements)d distinct configurations for %(parameters)d free parameters; fewer points than parameters gives numbers that look precise and are arbitrary"
msgstr "%(parameters)d آزاد پیرامیٹروں کے لیے %(measurements)d الگ الگ کنفیگریشنیں؛ پیرامیٹروں سے کم نقطے ایسے اعداد دیتے ہیں جو درست لگتے ہیں مگر من مانے ہوتے ہیں"

msgid "the %(measurements)d configurations do not vary independently enough to separate %(parameters)d parameters"
msgstr "یہ %(measurements)d کنفیگریشنیں اتنی آزادانہ طور پر نہیں بدلتیں کہ %(parameters)d پیرامیٹر الگ کیے جا سکیں"

msgid "the fit put it at %(value)s, which its own definition does not allow; the measurements disagree with each other under section 10.1's model"
msgstr "fit نے اسے %(value)s پر رکھا، جس کی اجازت اس کی اپنی تعریف نہیں دیتی؛ سیکشن 10.1 کے ماڈل کے تحت پیمائشیں آپس میں متضاد ہیں"

msgid "it came out at %(value)s, but another parameter of the same fit was impossible, and least squares chose them against each other"
msgstr "یہ %(value)s نکلا، مگر اسی fit کا ایک اور پیرامیٹر ناممکن تھا، اور least squares نے انہیں ایک دوسرے کے خلاف چنا"

msgid "the estimator has no such term: section 10.1 removed the per-layer overhead, which for a 28-layer model exceeded the whole measured token"
msgstr "تخمین کار کے پاس ایسا کوئی جزو نہیں: سیکشن 10.1 نے فی پرت کا اضافی بوجھ ہٹا دیا تھا، جو 28 پرتوں والے ماڈل میں پورے ماپے گئے ٹوکن سے بڑھ جاتا تھا"

msgid "generation (llama-bench)"
msgstr "جنریشن (llama-bench)"

msgid "prompt (llama-bench)"
msgstr "prompt (llama-bench)"

msgid "generation, first request"
msgstr "جنریشن، پہلی درخواست"

msgid "generation, 1K prompt"
msgstr "جنریشن، 1K prompt"

msgid "prompt, 1K request"
msgstr "prompt، 1K درخواست"

msgid "peak VRAM"
msgstr "VRAM کی چوٹی"

msgid "no graphics card"
msgstr "کوئی گرافکس کارڈ نہیں"

msgid "%(os)s %(version)s, %(cpu)s, %(ram)s, %(gpu)s%(driver)s"
msgstr "%(os)s %(version)s، %(cpu)s، %(ram)s، %(gpu)s%(driver)s"

msgid "%(flag)s was asked for as %(wanted)s but the run reports %(actual)s"
msgstr "%(flag)s کو %(wanted)s کے طور پر مانگا گیا مگر رن %(actual)s بتاتا ہے"

msgid "The card was full and generation came in below three fifths of the estimate: the driver was paging to system memory, which does not fail and does not appear in the log."
msgstr "کارڈ بھرا ہوا تھا اور جنریشن تخمینے کے تین پنجم سے نیچے رہی: ڈرائیور سسٹم میموری میں paging کر رہا تھا، جو ناکام نہیں ہوتا اور لاگ میں نظر بھی نہیں آتا۔"

msgid "Peak VRAM stayed clear of the card's total, so there was nothing for the driver to page."
msgstr "VRAM کی چوٹی کارڈ کے کل حجم سے دور رہی، اس لیے ڈرائیور کے پاس paging کرنے کو کچھ تھا ہی نہیں۔"

msgid "The card was full, which a good plan is meant to be, and the speed was close enough to the estimate that nothing was paging."
msgstr "کارڈ بھرا ہوا تھا، جو ایک اچھے پلان سے توقع بھی یہی ہے، اور رفتار تخمینے کے اتنی قریب تھی کہ کہیں paging نہیں ہو رہی تھی۔"

msgid "No VRAM reading was taken during the run, so this configuration has not been cleared of paging; it has only not been checked."
msgstr "رن کے دوران VRAM کی کوئی پیمائش نہیں لی گئی، اس لیے یہ کنفیگریشن paging سے بری نہیں ہوئی؛ اسے صرف جانچا ہی نہیں گیا۔"

msgid "The card's total memory is unknown, so a reading of what was in use says nothing about how close to full it was."
msgstr "کارڈ کی کل میموری نامعلوم ہے، اس لیے جو استعمال میں تھا اس کی پیمائش یہ نہیں بتاتی کہ وہ بھرنے کے کتنا قریب تھا۔"

msgid "There was no estimate to compare the measured speed against, so the second half of the signature could not be tested."
msgstr "ماپی گئی رفتار کا موازنہ کرنے کے لیے کوئی تخمینہ موجود نہیں تھا، اس لیے دستخط کا دوسرا نصف جانچا نہیں جا سکا۔"

msgid "llama-bench did not produce JSON"
msgstr "llama-bench نے JSON پیدا نہیں کیا"

msgid "llama-bench JSON is not a list of results"
msgstr "llama-bench کا JSON نتائج کی فہرست نہیں ہے"

msgid "llama-bench JSON held no readable results"
msgstr "llama-bench کے JSON میں کوئی پڑھنے کے قابل نتیجہ نہیں تھا"

msgid "no llama-bench result rows found"
msgstr "llama-bench کے نتائج کی کوئی سطر نہیں ملی"

msgid "could not open %(path)s for the server log"
msgstr "سرور لاگ کے لیے %(path)s نہیں کھولا جا سکا"

msgid "could not start llama-server"
msgstr "llama-server شروع نہیں کیا جا سکا"

msgid "no output"
msgstr "کوئی آؤٹ پٹ نہیں"

msgid "llama-bench exited with code %(code)d: %(detail)s"
msgstr "llama-bench، exit code %(code)d کے ساتھ ختم ہوا: %(detail)s"

msgid "llama-bench output could not be read: %(error)s"
msgstr "llama-bench کا آؤٹ پٹ نہیں پڑھا جا سکا: %(error)s"

msgid "llama-server did not become healthy"
msgstr "llama-server درست حالت میں نہیں آیا"

msgid "Its whole output is in the log file `bench` named; the end says why."
msgstr "اس کا سارا آؤٹ پٹ اُس لاگ فائل میں ہے جس کا نام `bench` نے بتایا؛ اس کا آخر وجہ بتاتا ہے۔"

msgid "%(path)s was written by a newer LlamaFit (benchmark format %(found)d, this build reads %(known)d)"
msgstr "%(path)s کسی نئے LlamaFit نے لکھا تھا (بینچ مارک فارمیٹ %(found)d، یہ build %(known)d پڑھتا ہے)"

msgid "Upgrade LlamaFit, or move the file aside to start a new one."
msgstr "LlamaFit کو اپ گریڈ کریں، یا فائل ایک طرف ہٹا کر نئی شروع کریں۔"

msgid "a benchmark cannot be recorded against a simulated machine"
msgstr "کسی نقلی مشین کے مقابل بینچ مارک درج نہیں کیا جا سکتا"

msgid "Run `llamafit bench` on the machine itself, without --profile."
msgstr "`llamafit bench` کو مشین پر ہی چلائیں، --profile کے بغیر۔"

msgid "the run did not use the settings it was given: %(problems)s"
msgstr "رن نے وہ ترتیبات استعمال نہیں کیں جو اسے دی گئی تھیں: %(problems)s"

msgid "Nothing was stored. A result filed under flags it was not taken with would be believed later by everything that reads it."
msgstr "کچھ محفوظ نہیں کیا گیا۔ جو نتیجہ ایسے flags کے تحت درج ہو جن کے ساتھ وہ لیا ہی نہیں گیا، اسے بعد میں ہر پڑھنے والا سچ مان لے گا۔"

msgid "a conservative default; nobody has measured this card's backend overhead"
msgstr "ایک محتاط طے شدہ قدر؛ اس کارڈ کے backend کا اضافی بوجھ کسی نے نہیں ماپا"

msgid "measured on this card with driver %(driver)s and llama.cpp %(build)s; one machine"
msgstr "اسی کارڈ پر ڈرائیور %(driver)s اور llama.cpp %(build)s کے ساتھ ماپا گیا؛ ایک مشین"

msgid "A hybrid placement has to say how many layers are on the graphics card."
msgstr "ہائبرڈ بندوبست کو بتانا ہوتا ہے کہ گرافکس کارڈ پر کتنی پرتیں ہیں۔"

msgid "Pass gpu_layers, which is what -ngl would be."
msgstr "gpu_layers دیں، جو -ngl کی قدر ہے۔"

msgid "LlamaFit has not read %(model)s's %(quant)s file, so it cannot size it."
msgstr "LlamaFit نے %(model)s کی %(quant)s فائل نہیں پڑھی، اس لیے وہ اس کا حجم نہیں نکال سکتا۔"

msgid "Run `llamafit catalog refresh` to read the file's header."
msgstr "فائل کا header پڑھنے کے لیے `llamafit catalog refresh` چلائیں۔"

msgid "the server process before any model buffer"
msgstr "کسی بھی ماڈل بفر سے پہلے سرور کا عمل"

msgid "fitted to one machine's measurements; the least certain line here"
msgstr "ایک ہی مشین کی پیمائشوں پر fit کیا گیا؛ یہاں سب سے کم یقینی سطر"

msgid "room for one logit per vocabulary entry per token of the batch"
msgstr "بیچ کے ہر ٹوکن کے لیے، لغت کے ہر اندراج پر ایک logit کی جگہ"

msgid "LlamaFit cannot size a %(kv_type)s key-value cache."
msgstr "LlamaFit، %(kv_type)s قسم کے key-value کیش کا حجم نہیں نکال سکتا۔"

msgid "Use one of: %(types)s."
msgstr "ان میں سے کوئی ایک استعمال کریں: %(types)s۔"

msgid "This model's file does not say how large its key-value cache is per token."
msgstr "اس ماڈل کی فائل نہیں بتاتی کہ فی ٹوکن اس کا key-value کیش کتنا بڑا ہے۔"

msgid "Refresh the catalog so the file's header is read again."
msgstr "کیٹلاگ تازہ کریں تاکہ فائل کا header دوبارہ پڑھا جائے۔"

msgid "the attention-layer count was assumed, not counted"
msgstr "attention پرتوں کی تعداد فرض کی گئی، گنی نہیں گئی"

msgid "%(arch)s allocates more cache than its header describes; see the line below"
msgstr "%(arch)s اپنے header میں بیان کیے گئے سے زیادہ کیش مختص کرتا ہے؛ نیچے کی سطر دیکھیں"

msgid "what %(arch)s allocates beyond its header, measured rather than derived"
msgstr "%(arch)s اپنے header سے زائد جو مختص کرتا ہے، ماپا گیا نہ کہ اخذ کیا گیا"

msgid "from the architecture's state dimensions; it does not grow with context"
msgstr "آرکیٹیکچر کی state کے ابعاد سے؛ یہ context کے ساتھ نہیں بڑھتا"

msgid "the projector file itself"
msgstr "projector فائل خود"

msgid "the projector's own compute space, measured at 248 MiB"
msgstr "projector کی اپنی حساب کی جگہ، 248 MiB ماپی گئی"

msgid "attention projections, feed-forward weights and norms"
msgstr "attention projections، feed-forward وزن اور norms"

msgid "always-on experts, which run for every token"
msgstr "ہمیشہ فعال expert، جو ہر ٹوکن کے لیے چلتے ہیں"

msgid "routed experts, read across the bus once per micro-batch"
msgstr "routed expert، جو ہر مائیکرو بیچ میں ایک بار bus کے پار پڑھے جاتے ہیں"

msgid "this model ties its output projection to its embedding table"
msgstr "یہ ماڈل اپنی output projection کو اپنی embedding ٹیبل سے باندھتا ہے"

msgid "llama.cpp keeps the embedding table in memory even at full offload"
msgstr "llama.cpp، پوری offload کی صورت میں بھی embedding ٹیبل میموری میں رکھتا ہے"

msgid "streamed from disk as it is needed, not held in memory"
msgstr "ضرورت کے مطابق ڈسک سے stream کیا جاتا ہے، میموری میں نہیں رکھا جاتا"

msgid "held in memory, since streaming from disk was turned off"
msgstr "میموری میں رکھا گیا، کیونکہ ڈسک سے streaming بند تھی"

msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "%(repo)s کی فائلوں کی فہرست لیتے ہوئے Hugging Face نے %(status)d واپس کیا۔"

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Hugging Face سے %(repo)s کی فائل فہرست نہیں پڑھی جا سکی۔"

msgid "Check your network connection and try again."
msgstr "اپنا نیٹ ورک کنکشن جانچیں اور دوبارہ کوشش کریں۔"

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "%(repo)s کے لیے Hugging Face کے جواب میں فائل فہرست شامل نہیں تھی۔"

msgid "Check that the repository id is correct and public."
msgstr "جانچ لیں کہ ریپوزٹری id درست اور عوامی ہے۔"

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "کیٹلاگ میں %(count)d مسئلہ ہے"
msgstr[1] "کیٹلاگ میں %(count)d مسائل ہیں"

msgid "Run `llamafit catalog validate` for details."
msgstr "تفصیل کے لیے `llamafit catalog validate` چلائیں۔"

msgid "could not write %(path)s: %(error)s"
msgstr "%(path)s نہیں لکھا جا سکا: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "جانچ لیں کہ ڈائریکٹری میں لکھا جا سکتا ہے اور اس میں جگہ ہے۔"

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "%(path)s میں %(count)d مسئلہ ہے، اس لیے اسے تازہ نہیں کیا جا سکتا"
msgstr[1] "%(path)s میں %(count)d مسائل ہیں، اس لیے اسے تازہ نہیں کیا جا سکتا"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "پہلے `llamafit catalog validate` چلائیں اور فائل درست کریں۔"

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "%(path)s پورا نہیں پڑھا جا سکا، اس لیے صرف %(model)s کو تازہ کرنے سے اُن ماڈلوں کے بارے میں محفوظ حقائق مٹ جائیں گے جنہیں یہ عمل چھوتا ہی نہیں: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "پوری فائل دوبارہ بنانے کے لیے `llamafit catalog refresh` کو --model کے بغیر چلائیں۔"

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "اپنی مشین پر llama.cpp کے لیے open-weight LLM تلاش کریں، ان کا حجم جانچیں، انسٹال کریں اور تصدیق کریں۔"

msgid "With no command, llamafit opens the terminal dashboard; in a pipe, or with --json, it prints what `llamafit recommend` would."
msgstr "بغیر کسی کمانڈ کے، llamafit ٹرمینل کا ڈیش بورڈ کھولتا ہے؛ pipe میں، یا --json کے ساتھ، وہ وہی چھاپتا ہے جو `llamafit recommend` چھاپتا۔"

msgid "Print machine-readable JSON instead of tables."
msgstr "جدولوں کے بجائے مشین کے پڑھنے کے قابل JSON چھاپتا ہے۔"

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "لاگ ڈائریکٹری کی llamafit.log میں تفصیل لکھتا ہے اور traceback دکھاتا ہے۔"

msgid "Disable colours."
msgstr "رنگ بند کرتا ہے۔"

msgid "Answer for the machine this hardware profile describes instead of this one. Nothing about this machine is probed, and every answer is marked as simulated. `llamafit hardware list` names the profiles you have."
msgstr "اس مشین کے بجائے اُس مشین کے لیے جواب دیتا ہے جسے یہ hardware profile بیان کرتا ہے۔ اس مشین کی کوئی جانچ نہیں ہوتی، اور ہر جواب نقلی کے طور پر نشان زد ہوتا ہے۔ `llamafit hardware list` بتاتا ہے کہ آپ کے پاس کون سے پروفائل ہیں۔"

msgid "Pretend the graphics card has this much memory, for example 24G. Everything else stays as scanned, and every answer is marked as simulated."
msgstr "فرض کرتا ہے کہ گرافکس کارڈ کے پاس اتنی میموری ہے، مثلاً 24G۔ باقی سب کچھ ویسا ہی رہتا ہے جیسا سکین ہوا، اور ہر جواب نقلی کے طور پر نشان زد ہوتا ہے۔"

msgid "Pretend the machine has this much system memory, for example 128GiB. Every answer is marked as simulated."
msgstr "فرض کرتا ہے کہ مشین کے پاس اتنی سسٹم میموری ہے، مثلاً 128GiB۔ ہر جواب نقلی کے طور پر نشان زد ہوتا ہے۔"

msgid "Pretend the processor has this many physical cores. Every answer is marked as simulated."
msgstr "فرض کرتا ہے کہ پروسیسر کے پاس اتنے طبعی کور ہیں۔ ہر جواب نقلی کے طور پر نشان زد ہوتا ہے۔"

msgid "Plan, report and score no context longer than this. It caps the model's own length; it does not describe a machine."
msgstr "اس سے لمبے context کا نہ پلان بناتا ہے، نہ رپورٹ، نہ سکور۔ یہ ماڈل کی اپنی لمبائی کی حد باندھتا ہے؛ یہ کسی مشین کو بیان نہیں کرتا۔"

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "اس زبان میں بولتا ہے، مثلاً pt_PT۔ جو زبان LlamaFit کے پاس نہیں، اس کے بجائے وہ انگریزی پر لوٹ آتا ہے اور بتاتا ہے کہ اس کے پاس کون سی زبانیں ہیں۔"

msgid "Print the version and exit."
msgstr "ورژن چھاپ کر باہر نکل جاتا ہے۔"

msgid "the output's encoding"
msgstr "آؤٹ پٹ کی encoding"

msgid "%(count)d character could not be written in %(encoding)s and is shown as ?."
msgid_plural "%(count)d characters could not be written in %(encoding)s and are shown as ?."
msgstr[0] "%(count)d حرف %(encoding)s میں نہیں لکھا جا سکا اور وہ ? کے طور پر دکھایا گیا ہے۔"
msgstr[1] "%(count)d حروف %(encoding)s میں نہیں لکھے جا سکے اور وہ ? کے طور پر دکھائے گئے ہیں۔"

msgid "Set PYTHONUTF8=1 in the environment and run again: Python then writes UTF-8, which carries every language."
msgstr "ماحول میں PYTHONUTF8=1 مقرر کریں اور دوبارہ چلائیں: پھر Python، UTF-8 لکھتی ہے، جو ہر زبان سنبھالتی ہے۔"

msgid "%(option)s is an option of llamafit itself, so it goes before the command: `llamafit %(option)s %(rest)s`."
msgstr "%(option)s خود llamafit کا ایک آپشن ہے، اس لیے یہ کمانڈ سے پہلے آتا ہے: `llamafit %(option)s %(rest)s`۔"

msgid "Unexpected error: %(error)s"
msgstr "غیر متوقع خرابی: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "پورا traceback دیکھنے کے لیے --verbose کے ساتھ دوبارہ چلائیں۔"

msgid "A catalog model id."
msgstr "کیٹلاگ کا ایک ماڈل id۔"

msgid "Benchmark this quantisation instead of the planned one."
msgstr "منصوبے والی کے بجائے اسی quantisation کا بینچ مارک لیتا ہے۔"

msgid "Size for this many tokens."
msgstr "اتنے ٹوکن کے لیے حجم نکالتا ہے۔"

msgid "Set the micro-batch by hand; the budget is rebuilt around it."
msgstr "مائیکرو بیچ خود مقرر کرتا ہے؛ بجٹ اسی کے گرد دوبارہ بنایا جاتا ہے۔"

msgid ""
"Measure a model on this machine and show the measurement beside the estimate.\n"
"\n"
"Runs llama-bench and a real server at the planned flags, stores the result with the conditions it was taken under, and flags a configuration the driver was paging. With --calibrate, fits the estimator's constants to this machine from every stored result and says by name which ones the measurements do not determine."
msgstr ""
"اس مشین پر ایک ماڈل ماپتا ہے اور پیمائش کو تخمینے کے ساتھ دکھاتا ہے۔\n"
"\n"
"منصوبے والے flags پر llama-bench اور ایک اصل سرور چلاتا ہے، نتیجہ اُن حالات کے ساتھ محفوظ کرتا ہے جن میں وہ لیا گیا، اور ایسی کنفیگریشن کی نشان دہی کرتا ہے جس میں ڈرائیور paging کر رہا تھا۔ --calibrate کے ساتھ، ہر محفوظ نتیجے سے تخمین کار کے ثوابت اس مشین پر fit کرتا ہے اور نام لے کر بتاتا ہے کہ کن کا تعین پیمائشیں نہیں کرتیں۔"

msgid "Measure prompt processing at every micro-batch of the ladder, not only the planned one. Section 10.2 has two free parameters and one micro-batch is one equation, so without this the prompt half of a calibration cannot be fitted at all."
msgstr "سیڑھی کے ہر مائیکرو بیچ پر prompt کی پروسیسنگ ماپتا ہے، صرف منصوبے والے پر نہیں۔ سیکشن 10.2 کے دو آزاد پیرامیٹر ہیں اور ایک مائیکرو بیچ ایک مساوات ہے، اس لیے اس کے بغیر کیلیبریشن کا prompt والا نصف fit ہو ہی نہیں سکتا۔"

msgid "Run llama-bench only. Faster, and it gives up the paging check, the buffer sizes and the tool-call test, all of which need a real server."
msgstr "صرف llama-bench چلاتا ہے۔ تیز تر، مگر یہ paging کی جانچ، بفر کے سائز اور tool-call کی جانچ چھوڑ دیتا ہے، جن سب کے لیے ایک اصل سرور درکار ہے۔"

msgid "Print the result without writing it to the database."
msgstr "نتیجہ چھاپتا ہے مگر اسے ڈیٹابیس میں نہیں لکھتا۔"

msgid "Print the commands that would run, and run nothing."
msgstr "وہ کمانڈیں چھاپتا ہے جو چلتیں، اور چلاتا کچھ نہیں۔"

msgid "Fit the estimator's constants to this machine from every result."
msgstr "ہر نتیجے سے تخمین کار کے ثوابت اس مشین پر fit کرتا ہے۔"

msgid "List what is already stored and stop."
msgstr "جو پہلے سے محفوظ ہے اس کی فہرست دے کر رک جاتا ہے۔"

msgid "`llamafit bench` needs a model to measure"
msgstr "`llamafit bench` کو ماپنے کے لیے ایک ماڈل چاہیے"

msgid "Try `llamafit bench <model>`, `--calibrate` on its own, or `--show`."
msgstr "`llamafit bench <model>`، اکیلا `--calibrate`، یا `--show` آزما کر دیکھیں۔"

msgid "llama.cpp was not found, so there is nothing to benchmark with"
msgstr "llama.cpp نہیں ملا، اس لیے بینچ مارک کرنے کو کچھ نہیں"

msgid "Run `llamafit doctor` to see where it was looked for."
msgstr "یہ دیکھنے کے لیے کہ اسے کہاں تلاش کیا گیا، `llamafit doctor` چلائیں۔"

msgid "%(path)s has llama-server but no llama-bench"
msgstr "%(path)s میں llama-server تو ہے مگر llama-bench نہیں"

msgid "Some release archives leave it out; a full build has it beside the server."
msgstr "کچھ ریلیز آرکائیو اسے شامل نہیں کرتے؛ مکمل build میں وہ سرور کے ساتھ ہوتا ہے۔"

msgid "this host is simulated, and a simulated machine cannot be measured"
msgstr "یہ مشین نقلی ہے، اور نقلی مشین ماپی نہیں جا سکتی"

msgid "Run `llamafit bench` on the machine itself."
msgstr "`llamafit bench` کو مشین پر ہی چلائیں۔"

msgid "the model file is not on this machine: %(path)s"
msgstr "ماڈل کی فائل اس مشین پر نہیں ہے: %(path)s"

msgid "Download it first; `llamafit plan` shows the path the command line uses."
msgstr "پہلے اسے ڈاؤن لوڈ کریں؛ `llamafit plan` وہ راستہ دکھاتا ہے جو کمانڈ لائن استعمال کرتی ہے۔"

msgid "Would run:"
msgstr "یہ چلتا:"

msgid "Nothing has been measured on this machine yet."
msgstr "اس مشین پر ابھی تک کچھ نہیں ماپا گیا۔"

msgid "Stored measurements"
msgstr "محفوظ پیمائشیں"

msgid "model"
msgstr "ماڈل"

msgid "kind"
msgstr "قسم"

msgid "gen tok/s"
msgstr "جنریشن tok/s"

msgid "prompt tok/s"
msgstr "prompt tok/s"

msgid "taken"
msgstr "لیا گیا"

msgid "flags"
msgstr "flags"

msgid "Nothing was written to the database, so no estimate will be relabelled."
msgstr "ڈیٹابیس میں کچھ نہیں لکھا گیا، اس لیے کسی تخمینے کا لیبل نہیں بدلے گا۔"

msgid "Estimated against measured"
msgstr "تخمینی بمقابلہ ماپا گیا"

msgid "figure"
msgstr "عدد"

msgid "context"
msgstr "context"

msgid "micro-batch"
msgstr "مائیکرو بیچ"

msgid "estimated"
msgstr "تخمینی"

msgid "measured"
msgstr "ماپا گیا"

msgid "ratio"
msgstr "تناسب"

msgid "The plan sizes this configuration for %(context)s tokens and estimates %(tps)s generated tokens per second there. Nothing above ran at that context, so that figure is reported and not compared."
msgstr "پلان اس کنفیگریشن کا حجم %(context)s ٹوکن کے لیے نکالتا ہے اور وہاں %(tps)s ٹوکن فی سیکنڈ جنریشن کا تخمینہ لگاتا ہے۔ اوپر کچھ بھی اُس context پر نہیں چلا، اس لیے یہ عدد بتایا گیا ہے، موازنہ نہیں کیا گیا۔"

msgid "%(count)d figure is outside the 0.8 to 1.25 band an uncalibrated formula is expected to land in."
msgid_plural "%(count)d figures are outside the 0.8 to 1.25 band an uncalibrated formula is expected to land in."
msgstr[0] "%(count)d عدد اُس 0.8 سے 1.25 کی حد سے باہر ہے جس میں بغیر کیلیبریشن والے فارمولے کے گرنے کی توقع کی جاتی ہے۔"
msgstr[1] "%(count)d اعداد اُس 0.8 سے 1.25 کی حد سے باہر ہیں جس میں بغیر کیلیبریشن والے فارمولے کے گرنے کی توقع کی جاتی ہے۔"

msgid "This configuration was paging."
msgstr "یہ کنفیگریشن paging کر رہی تھی۔"

msgid "This configuration was not paging."
msgstr "یہ کنفیگریشن paging نہیں کر رہی تھی۔"

msgid "Paging could not be checked."
msgstr "paging جانچی نہیں جا سکی۔"

msgid "Peak VRAM was %(percent)s percent of the card, and generation was %(speed)s percent of the estimate."
msgstr "VRAM کی چوٹی کارڈ کا %(percent)s فیصد رہی، اور جنریشن تخمینے کا %(speed)s فیصد رہی۔"

msgid "Peak VRAM was %(percent)s percent of the card. Generation was not compared with the estimate."
msgstr "VRAM کی چوٹی کارڈ کا %(percent)s فیصد رہی۔ جنریشن کا تخمینے سے موازنہ نہیں کیا گیا۔"

msgid "The largest context on the ladder that would not page is %(tokens)s."
msgstr "سیڑھی پر سب سے بڑا context جو paging نہ کرے، %(tokens)s ہے۔"

msgid "Calibration"
msgstr "کیلیبریشن"

msgid "constant"
msgstr "ثابت"

msgid "value"
msgstr "قدر"

msgid "from"
msgstr "سے"

msgid "%(base)s + %(slope)s per 1K"
msgstr "%(base)s + %(slope)s فی 1K"

msgid "%(count)d measured context"
msgid_plural "%(count)d measured contexts"
msgstr[0] "%(count)d ماپا گیا context"
msgstr[1] "%(count)d ماپے گئے context"

msgid "Nothing was fitted. Every line below says what its constant was missing; a calibration made from less than that would look precise and be arbitrary."
msgstr "کچھ بھی fit نہیں کیا گیا۔ نیچے کی ہر سطر بتاتی ہے کہ اس کے ثابت میں کیا کمی تھی؛ اس سے کم پر بنی کیلیبریشن درست لگے گی مگر من مانی ہوگی۔"

msgid "%(name)s was not fitted: %(reason)s"
msgstr "%(name)s کو fit نہیں کیا گیا: %(reason)s"

msgid "%(count)d measured configuration"
msgid_plural "%(count)d measured configurations"
msgstr[0] "%(count)d ماپی گئی کنفیگریشن"
msgstr[1] "%(count)d ماپی گئی کنفیگریشنیں"

msgid "What the model is for. It sets the score weights, the speed target and the context a candidate is measured against."
msgstr "ماڈل کس کام کے لیے ہے۔ یہ سکور کے وزن، رفتار کا ہدف اور وہ context مقرر کرتا ہے جس کے مقابل امیدوار کو ماپا جاتا ہے۔"

msgid "Capability the model must have; a model without it is excluded "
msgstr "وہ صلاحیت جو ماڈل میں ہونا ضروری ہے؛ جس ماڈل میں نہ ہو وہ خارج کر دیا جاتا ہے"

msgid "Keep only these licence identifiers (repeatable)."
msgstr "صرف یہی لائسنس شناخت کار رکھتا ہے (دہرایا جا سکتا ہے)۔"

msgid "balanced, quality or speed: moves a tenth of the weight between quality and speed. It leans the board; it does not replace the weights."
msgstr "balanced، quality یا speed: وزن کا دسواں حصہ معیار اور رفتار کے درمیان منتقل کرتا ہے۔ یہ بورڈ کو جھکاتا ہے؛ وزن بدلتا نہیں۔"

msgid "Exclude anything larger to download, for example 40G or 7.5GiB."
msgstr "ڈاؤن لوڈ میں اس سے بڑی ہر چیز خارج کر دیتا ہے، مثلاً 40G یا 7.5GiB۔"

msgid "The worst verdict to list: comfortable, fits or tight."
msgstr "فہرست میں سب سے برا فیصلہ: comfortable، fits یا tight۔"

msgid "Exclude candidates generating fewer tokens per second than this, in place of the speed a person reads at. Pass 0 when nobody is waiting on the tokens."
msgstr "اس سے کم ٹوکن فی سیکنڈ بنانے والے امیدواروں کو خارج کرتا ہے، انسان کی پڑھنے کی رفتار کی جگہ۔ جب ٹوکن کا کوئی منتظر نہ ہو تو 0 دیں۔"

msgid "Order the rows drawn: score, speed, quality, context, size, prompt, card, ram, fit, model or quant, largest or best first unless :asc says otherwise. The # column keeps the ranking."
msgstr "کھینچی گئی سطروں کی ترتیب: score، speed، quality، context، size، prompt، card، ram، fit، model یا quant، سب سے بڑا یا بہترین پہلے، جب تک :asc اس کے خلاف نہ کہے۔ # کالم درجہ بندی برقرار رکھتا ہے۔"

msgid "Draw only rows whose id, name or quantisation contains this text."
msgstr "صرف وہی سطریں کھینچتا ہے جن کے id، نام یا quantisation میں یہ متن ہو۔"

msgid "Draw only rows whose file is already on this machine."
msgstr "صرف وہی سطریں کھینچتا ہے جن کی فائل پہلے ہی اس مشین پر ہے۔"

msgid "Draw only rows that run this way: gpu, moe-offload, hybrid or cpu."
msgstr "صرف وہی سطریں کھینچتا ہے جو اس طرح چلتی ہیں: gpu، moe-offload، hybrid یا cpu۔"

msgid "Draw only rows at or above this verdict: comfortable, fits or tight. The ranking is unchanged and a hidden row is still counted."
msgstr "صرف وہی سطریں کھینچتا ہے جو اس فیصلے پر یا اس سے اوپر ہوں: comfortable، fits یا tight۔ درجہ بندی نہیں بدلتی اور چھپی ہوئی سطر بھی گنی جاتی ہے۔"

msgid "Draw exactly these columns, comma-separated, in this order, named as --json names them: rank, model, quant, size, have, score, quality, gen, prompt, confidence, mode, vram, ram, verdict, context."
msgstr "بالکل یہی کالم کھینچتا ہے، کاما سے الگ، اسی ترتیب میں، اُن ناموں سے جو --json دیتا ہے: rank, model, quant, size, have, score, quality, gen, prompt, confidence, mode, vram, ram, verdict, context."

msgid "Draw every column whatever the terminal's width; a cell that does not fit folds."
msgstr "ٹرمینل کی چوڑائی سے قطع نظر ہر کالم کھینچتا ہے؛ جو خانہ نہ سمائے وہ لپیٹ دیا جاتا ہے۔"

msgid "Leave the candidates that were not ranked off the table. The reasons are still printed under it."
msgstr "جن امیدواروں کی درجہ بندی نہیں ہوئی، انہیں جدول سے باہر رکھتا ہے۔ وجوہات پھر بھی اس کے نیچے چھپتی ہیں۔"

msgid "invalid --min-fit %(value)s"
msgstr "غیر درست --min-fit %(value)s"

msgid "Valid values: %(values)s"
msgstr "درست قدریں: %(values)s"

msgid "invalid --prefer %(value)s"
msgstr "غیر درست --prefer %(value)s"

msgid "invalid --runs %(value)s"
msgstr "غیر درست --runs %(value)s"

msgid "invalid --sort %(value)s"
msgstr "غیر درست --sort %(value)s"

msgid "invalid --columns %(value)s"
msgstr "غیر درست --columns %(value)s"

msgid ""
"Rank the catalog for what you want to do on this machine.\n"
"\n"
"Every candidate is planned, sized and estimated here, so the first run scans the machine. Speeds compare candidates at 8K tokens of context; --explain expands a row into the scores, the weights, the budget and the speed breakdown that produced it."
msgstr ""
"اس مشین پر آپ جو کرنا چاہتے ہیں، اس کے لیے کیٹلاگ کی درجہ بندی کرتا ہے۔\n"
"\n"
"ہر امیدوار کا یہیں پلان بنتا ہے، حجم نکلتا ہے اور تخمینہ لگتا ہے، اس لیے پہلا رن مشین کو سکین کرتا ہے۔ رفتاریں امیدواروں کا موازنہ 8K ٹوکن context پر کرتی ہیں؛ --explain کسی سطر کو اُن سکوروں، وزنوں، بجٹ اور رفتار کی تفصیل میں کھول دیتا ہے جنہوں نے اسے پیدا کیا۔"

msgid "Exclude candidates that cannot hold at least this many tokens."
msgstr "اُن امیدواروں کو خارج کرتا ہے جو کم از کم اتنے ٹوکن نہیں سنبھال سکتے۔"

msgid "Show at most this many rows."
msgstr "زیادہ سے زیادہ اتنی سطریں دکھاتا ہے۔"

msgid "Show every quantisation instead of the best one per model."
msgstr "ہر ماڈل کی بہترین کے بجائے ہر quantisation دکھاتا ہے۔"

msgid "Expand every row shown into the scores, weights, budget and speed breakdown behind it. Combine with --limit 1 for one model."
msgstr "دکھائی گئی ہر سطر کو اس کے پیچھے موجود سکور، وزن، بجٹ اور رفتار کی تفصیل میں کھولتا ہے۔ ایک ہی ماڈل کے لیے --limit 1 کے ساتھ ملا کر استعمال کریں۔"

msgid "Plan without a vision projector, freeing its memory."
msgstr "vision projector کے بغیر پلان بناتا ہے، اس کی میموری خالی کر دیتا ہے۔"

msgid ""
"Rank every model by how well it uses this machine, whatever it is for.\n"
"\n"
"No use case, no weights and no score: this is the memory question on its own. Models are sized for 32K tokens of context, and the context column is the largest each one holds in the mode shown."
msgstr ""
"ہر ماڈل کی درجہ بندی اس بنیاد پر کرتا ہے کہ وہ اس مشین کو کتنا اچھا استعمال کرتا ہے، چاہے وہ کسی بھی کام کے لیے ہو۔\n"
"\n"
"نہ استعمال کی قسم، نہ وزن، نہ سکور: یہ صرف میموری کا سوال ہے۔ ماڈلوں کا حجم 32K ٹوکن context کے لیے نکالا جاتا ہے، اور context کا کالم وہ سب سے بڑا ہے جو ہر ایک دکھائے گئے موڈ میں سنبھالتا ہے۔"

msgid "Only the configurations that use the machine well: at least half its memory held in weights, and no pool past four fifths."
msgstr "صرف وہی کنفیگریشنیں جو مشین کو اچھی طرح استعمال کرتی ہیں: کم از کم آدھی میموری وزن میں، اور کوئی پول چار پنجم سے آگے نہیں۔"

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "کیٹلاگ کی دیکھ بھال کرتا ہے: اس کی فائلیں جانچتا ہے، بدلتے رہنے والے خانے تازہ کرتا ہے۔"

msgid "Keep only this use case."
msgstr "صرف یہی استعمال کی قسم رکھتا ہے۔"

msgid "Keep only models with this capability (repeatable)."
msgstr "صرف اس صلاحیت والے ماڈل رکھتا ہے (دہرایا جا سکتا ہے)۔"

msgid "Show only this quantisation, matched case-insensitively, in both tables."
msgstr "دونوں جدولوں میں صرف یہی quantisation دکھاتا ہے، بڑے چھوٹے حروف کا فرق کیے بغیر ملاتے ہوئے۔"

msgid "Size every quantisation for this many tokens instead of the usual 32,768."
msgstr "ہر quantisation کا حجم عام 32,768 کے بجائے اتنے ٹوکن کے لیے نکالتا ہے۔"

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "ساتھ آنے والے کیٹلاگ اور آپ کی اپنی تبدیلیوں کے بجائے صرف یہی فائل جانچتا ہے۔"

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "کوئی ماڈل مطابقت نہیں رکھتا۔ --use-case, --capability, --license, --vendor یا --search کو زیادہ وسیع کر کے دیکھیں۔"

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"دیے گئے فلٹروں سے چھان کر ماڈل کیٹلاگ کی فہرست دیتا ہے۔\n"
"\n"
"جدول ہر ماڈل کی زیادہ سے زیادہ تین صلاحیتیں دکھاتا ہے، اور باقی کے لیے ایک +N نشان، اور وہ دکھائے گئے معیار کے کالم کے مطابق ترتیب دیا گیا ہے؛ ہر صلاحیت info یا --json میں موجود ہے۔"

msgid "Keep only this vendor, case-insensitive."
msgstr "صرف یہی وینڈر رکھتا ہے، بڑے چھوٹے حروف کا فرق کیے بغیر۔"

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "id، نام، وینڈر یا خاندان میں ذیلی سٹرنگ کی مطابقت، بڑے چھوٹے حروف کا فرق کیے بغیر۔"

msgid "Show at most this many."
msgstr "زیادہ سے زیادہ اتنے ہی دکھاتا ہے۔"

msgid "Shorthand for llamafit list --search TEXT."
msgstr "llamafit list --search TEXT کی مختصر شکل۔"

msgid "Text to match against id, name, vendor or family."
msgstr "وہ متن جسے id، نام، وینڈر یا خاندان سے ملانا ہے۔"

msgid ""
"Show one model: its facts, the quants it publishes, and what each would cost on this machine.\n"
"\n"
"The last table is sized against this machine, so the first run scans it. One line per quantisation; plan opens one of those rows into the memory budget, the context ladder and the command line."
msgstr ""
"ایک ماڈل دکھاتا ہے: اس کے حقائق، جو quant وہ شائع کرتا ہے، اور اس مشین پر ہر ایک کی قیمت کیا ہوگی۔\n"
"\n"
"آخری جدول کا حجم اسی مشین کے مقابل نکالا جاتا ہے، اس لیے پہلا رن اسے سکین کرتا ہے۔ ہر quantisation کے لیے ایک سطر؛ plan ان میں سے کسی سطر کو میموری کے بجٹ، context کی سیڑھی اور کمانڈ لائن میں کھول دیتا ہے۔"

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "کیٹلاگ کی YAML فائلیں schema کے مقابل جانچتا ہے اور ہر مسئلے کے لیے ایک سطر چھاپتا ہے۔"

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "%(count)d فائل جانچی گئی، کوئی مسئلہ نہیں ملا۔"
msgstr[1] "%(count)d فائلیں جانچی گئیں، کوئی مسئلہ نہیں ملا۔"

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "کیٹلاگ کے لیے فائلوں کے نام، سائز، checksum اور GGUF حقائق Hugging Face سے تازہ کرتا ہے۔"

msgid "Refresh only this model id."
msgstr "صرف یہی ماڈل id تازہ کرتا ہے۔"

msgid "Compute the refresh but write nothing."
msgstr "تازہ کاری کا حساب لگاتا ہے مگر کچھ لکھتا نہیں۔"

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "اگر کچھ بھی بدلنے والا ہو تو 1 کے ساتھ باہر نکلتا ہے؛ بدلتا کچھ نہیں، طے شدہ CI job کے لیے۔"

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: انتباہ: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "انتباہ: %(warning)s (%(count)d ماڈل: %(models)s)"
msgstr[1] "انتباہ: %(warning)s (%(count)d ماڈل: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: خرابی: %(error)s"

msgid "Hint: %(hint)s"
msgstr "اشارہ: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "refresh کے لیے Hugging Face تک نیٹ ورک رسائی درکار ہے؛ اپنا کنکشن جانچیں اور یہ بھی کہ ریپوزٹری id درست ہے۔"

msgid "No changes."
msgstr "کوئی تبدیلی نہیں۔"

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "ایک ماڈل کا خام کیٹلاگ اندراج چھاپتا ہے، طے شدہ طور پر JSON میں یا --yaml کے ساتھ YAML میں۔"

msgid "Print YAML instead of JSON."
msgstr "JSON کے بجائے YAML چھاپتا ہے۔"

msgid "Did you mean: %(ids)s?"
msgstr "کیا آپ کی مراد تھی: %(ids)s؟"

msgid "Run `llamafit list` to see every model id."
msgstr "ہر ماڈل id دیکھنے کے لیے `llamafit list` چلائیں۔"

msgid "no model named %(id)s in the catalog"
msgstr "کیٹلاگ میں %(id)s نام کا کوئی ماڈل نہیں"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "کیٹلاگ میں %(count)d مسئلہ ملا؛ تفصیل کے لیے `llamafit catalog validate` چلائیں۔"
msgstr[1] "کیٹلاگ میں %(count)d مسائل ملے؛ تفصیل کے لیے `llamafit catalog validate` چلائیں۔"

msgid "invalid --use-case %(value)s"
msgstr "غیر درست --use-case %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "درست استعمال کی اقسام: %(values)s"

msgid "invalid %(option)s value: %(values)s"
msgid_plural "invalid %(option)s values: %(values)s"
msgstr[0] "%(option)s کی غیر درست قدر: %(values)s"
msgstr[1] "%(option)s کی غیر درست قدریں: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "درست صلاحیتیں: %(values)s"

msgid "%(option)s is not a size: %(value)s"
msgstr "%(option)s کوئی سائز نہیں: %(value)s"

msgid "Sizes look like 8G, 7.5GiB or 512M; a bare number is bytes."
msgstr "سائز اس طرح لکھے جاتے ہیں: 8G، 7.5GiB یا 512M؛ خالی عدد بائٹ ہوتا ہے۔"

msgid "%(ceiling)s %(max)s is below %(floor)s %(min)s"
msgstr "%(ceiling)s %(max)s، %(floor)s %(min)s سے کم ہے"

msgid "Raise %(ceiling)s, or lower %(floor)s."
msgstr "%(ceiling)s بڑھائیں، یا %(floor)s کم کریں۔"

msgid "`llamafit %(command)s` reports on the machine LlamaFit is running on"
msgstr "`llamafit %(command)s` اُسی مشین کی رپورٹ دیتا ہے جس پر LlamaFit چل رہا ہے"

msgid "Drop --profile, --memory, --ram and --cpu-cores. To see the machine a profile describes, run `llamafit hardware show NAME --as-host`."
msgstr "--profile، --memory، --ram اور --cpu-cores ہٹا دیں۔ کوئی پروفائل جس مشین کو بیان کرتا ہے اسے دیکھنے کے لیے `llamafit hardware show NAME --as-host` چلائیں۔"

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "بتاتا ہے کہ کیا شناخت ہوا، کیا ناکام رہا، اور کس چیز سے مزید کچھ کھلے گا۔"

msgid "Hardware profiles: describe a machine in a file and score models against it."
msgstr "Hardware profiles: کسی مشین کو ایک فائل میں بیان کریں اور ماڈلوں کو اس کے مقابل سکور کریں۔"

msgid "Validate only this file instead of every bundled and user profile."
msgstr "ساتھ آنے والے اور صارف کے ہر پروفائل کے بجائے صرف یہی فائل جانچتا ہے۔"

msgid "A profile name, or a path to a profile file."
msgstr "کوئی پروفائل نام، یا کسی پروفائل فائل کا راستہ۔"

msgid "%(count)d hardware profile problem found; run `llamafit hardware validate` for details."
msgid_plural "%(count)d hardware profile problems found; run `llamafit hardware validate` for details."
msgstr[0] "hardware profile میں %(count)d مسئلہ ملا؛ تفصیل کے لیے `llamafit hardware validate` چلائیں۔"
msgstr[1] "hardware profile میں %(count)d مسائل ملے؛ تفصیل کے لیے `llamafit hardware validate` چلائیں۔"

msgid "List the hardware profiles LlamaFit has: the bundled ones and your own."
msgstr "LlamaFit کے پاس موجود hardware profiles کی فہرست دیتا ہے: ساتھ آنے والے اور آپ کے اپنے۔"

msgid "No hardware profiles. Run `llamafit hardware path` to see where yours would go."
msgstr "کوئی hardware profile نہیں۔ یہ دیکھنے کے لیے کہ آپ کے پروفائل کہاں جائیں گے، `llamafit hardware path` چلائیں۔"

msgid ""
"Show one profile; with --as-host, the machine it stands in for.\n"
"\n"
"A host built from a profile is marked as simulated, in the table and in the JSON, so a what-if is never mistaken for a scan of this machine."
msgstr ""
"ایک پروفائل دکھاتا ہے؛ --as-host کے ساتھ، وہ مشین جس کی یہ جگہ لیتا ہے۔\n"
"\n"
"کسی پروفائل سے بنی مشین جدول میں اور JSON میں نقلی کے طور پر نشان زد ہوتی ہے، تاکہ کوئی فرضی صورت اس مشین کے سکین سے کبھی خلط نہ ہو۔"

msgid "Show the host this profile substitutes, as `llamafit system` would."
msgstr "وہ مشین دکھاتا ہے جس کی جگہ یہ پروفائل لیتا ہے، جیسے `llamafit system` دکھاتا۔"

msgid "Check hardware profile files against the schema, printing one line per problem."
msgstr "hardware profile فائلیں schema کے مقابل جانچتا ہے اور ہر مسئلے کے لیے ایک سطر چھاپتا ہے۔"

msgid "Print the directory your own hardware profiles go in."
msgstr "وہ ڈائریکٹری چھاپتا ہے جس میں آپ کے اپنے hardware profile جاتے ہیں۔"

msgid "It does not exist yet; create it and put a %(suffix)s file in it."
msgstr "یہ ابھی موجود نہیں؛ اسے بنائیں اور اس میں ایک %(suffix)s فائل رکھیں۔"

msgid "Install what it takes to run a model: llama.cpp itself, and the weights."
msgstr "ماڈل چلانے کے لیے جو درکار ہے وہ انسٹال کرتا ہے: خود llama.cpp، اور وزن۔"

msgid "Fetch this quantisation instead of the first the catalog publishes."
msgstr "کیٹلاگ جو پہلی شائع کرتا ہے اس کے بجائے یہی quantisation لاتا ہے۔"

msgid "Put the files here instead of under the configured downloads directory."
msgstr "طے شدہ ڈاؤن لوڈ ڈائریکٹری کے بجائے فائلیں یہاں رکھتا ہے۔"

msgid "Use at most this much bandwidth, for example 5M. Shared across every worker, so the figure is the figure whatever --workers says."
msgstr "زیادہ سے زیادہ اتنی بینڈوتھ استعمال کرتا ہے، مثلاً 5M۔ یہ ہر worker میں بٹتی ہے، اس لیے --workers جو بھی کہے، عدد وہی رہتا ہے۔"

msgid "How many requests to keep in flight. More is not always faster, and a home connection is shared with whoever else is using it."
msgstr "کتنی درخواستیں بیک وقت چلتی رہیں۔ زیادہ ہمیشہ تیز نہیں ہوتا، اور گھر کا کنکشن ہر اُس شخص میں بٹا ہوتا ہے جو اسے استعمال کر رہا ہو۔"

msgid "Do not ask before starting."
msgstr "شروع کرنے سے پہلے نہیں پوچھتا۔"

msgid "Show what would be fetched and stop before fetching it."
msgstr "دکھاتا ہے کہ کیا لایا جاتا اور لانے سے پہلے رک جاتا ہے۔"

msgid "Fetch only the weights, not the vision projector or the draft model."
msgstr "صرف وزن لاتا ہے، vision projector یا draft ماڈل نہیں۔"

msgid "Re-read files that are already here and check them against the catalog."
msgstr "جو فائلیں پہلے سے یہاں ہیں انہیں دوبارہ پڑھ کر کیٹلاگ کے مقابل جانچتا ہے۔"

msgid "Fetch files the catalog holds no checksum for. Nothing will be able to tell you whether they arrived intact."
msgstr "وہ فائلیں لاتا ہے جن کا کیٹلاگ کے پاس کوئی checksum نہیں۔ کوئی چیز آپ کو نہیں بتا سکے گی کہ وہ سالم پہنچیں یا نہیں۔"

msgid "Show at most this many entries."
msgstr "زیادہ سے زیادہ اتنے اندراج دکھاتا ہے۔"

msgid "Download a model's weights, resuming anything an earlier run left and checking every file against the catalog's checksum."
msgstr "کسی ماڈل کے وزن ڈاؤن لوڈ کرتا ہے، پچھلے رن کا چھوڑا ہوا کام جاری رکھتا ہے اور ہر فائل کو کیٹلاگ کے checksum کے مقابل جانچتا ہے۔"

msgid "Start the download?"
msgstr "ڈاؤن لوڈ شروع کریں؟"

msgid "Show what has been downloaded, newest first."
msgstr "جو ڈاؤن لوڈ ہو چکا ہے وہ دکھاتا ہے، نیا پہلے۔"

msgid "Nothing has been downloaded yet."
msgstr "ابھی تک کچھ ڈاؤن لوڈ نہیں ہوا۔"

msgid "Install this backend instead of the one chosen for your GPU: cuda, vulkan, hip, sycl, metal or cpu."
msgstr "آپ کے GPU کے لیے چنے گئے کے بجائے یہی backend انسٹال کرتا ہے: cuda، vulkan، hip، sycl، metal یا cpu۔"

msgid "Install here instead of ~/.llamafit/llama.cpp."
msgstr "~/.llamafit/llama.cpp کے بجائے یہاں انسٹال کرتا ہے۔"

msgid "Install this release tag, for example b6100, not the latest."
msgstr "تازہ ترین کے بجائے یہی ریلیز ٹیگ انسٹال کرتا ہے، مثلاً b6100۔"

msgid "invalid --backend %(value)s"
msgstr "غیر درست --backend %(value)s"

msgid "Valid backends: %(values)s"
msgstr "درست backends: %(values)s"

msgid "release %(tag)s publishes no %(backend)s build for %(os)s %(arch)s."
msgstr "ریلیز %(tag)s، %(os)s %(arch)s کے لیے کوئی %(backend)s build شائع نہیں کرتی۔"

msgid "Leave --backend out and LlamaFit will choose a published one."
msgstr "--backend نہ دیں تو LlamaFit خود کوئی شائع شدہ چن لے گا۔"

msgid "release %(tag)s publishes nothing for %(os)s %(arch)s."
msgstr "ریلیز %(tag)s، %(os)s %(arch)s کے لیے کچھ شائع نہیں کرتی۔"

msgid "Build llama.cpp from source; see the project's own instructions."
msgstr "llama.cpp کو source سے بنائیں؛ پروجیکٹ کی اپنی ہدایات دیکھیں۔"

msgid "Downloading"
msgstr "ڈاؤن لوڈ ہو رہا ہے"

msgid "Change your PATH?"
msgstr "آپ کا PATH بدلیں؟"

msgid "PATH left alone."
msgstr "PATH ویسا ہی چھوڑ دیا گیا۔"

msgid "PATH changed. Open a new terminal for it to take effect."
msgstr "PATH بدل دیا گیا۔ اثر دکھانے کے لیے نیا ٹرمینل کھولیں۔"

msgid ""
"Download a published llama.cpp build and install it into ~/.llamafit/llama.cpp.\n"
"\n"
"The plan is printed before anything is written. The archive's checksum is verified before it is unpacked, an interrupted download continues where it stopped, and a directory LlamaFit did not create is never overwritten."
msgstr ""
"llama.cpp کا شائع شدہ build ڈاؤن لوڈ کر کے ~/.llamafit/llama.cpp میں انسٹال کرتا ہے۔\n"
"\n"
"کچھ لکھنے سے پہلے پلان چھاپا جاتا ہے۔ آرکائیو کھولنے سے پہلے اس کا checksum جانچا جاتا ہے، ٹوٹا ہوا ڈاؤن لوڈ وہیں سے جاری رہتا ہے جہاں رکا تھا، اور جو ڈائریکٹری LlamaFit نے نہیں بنائی اس پر کبھی نہیں لکھا جاتا۔"

msgid "Offer to add the bin directory to your PATH, showing the undo first."
msgstr "bin ڈائریکٹری کو آپ کے PATH میں شامل کرنے کی پیشکش کرتا ہے، پہلے واپسی کا طریقہ دکھا کر۔"

msgid "Install over a directory LlamaFit did not create. Ask yourself twice."
msgstr "ایسی ڈائریکٹری پر انسٹال کرتا ہے جو LlamaFit نے نہیں بنائی۔ دو بار سوچ لیں۔"

msgid "Install an archive that publishes no checksum. Nothing can be checked."
msgstr "ایسا آرکائیو انسٹال کرتا ہے جو کوئی checksum شائع نہیں کرتا۔ کچھ بھی جانچا نہیں جا سکتا۔"

msgid "Print the plan and write nothing."
msgstr "پلان چھاپتا ہے اور کچھ نہیں لکھتا۔"

msgid "Do not ask; assume yes."
msgstr "نہیں پوچھتا؛ ہاں فرض کر لیتا ہے۔"

msgid "Install this?"
msgstr "یہ انسٹال کریں؟"

msgid "Nothing was written."
msgstr "کچھ نہیں لکھا گیا۔"

msgid "Plan this quantisation instead of the one that scores best on this machine."
msgstr "اس مشین پر سب سے اچھا سکور پانے والی کے بجائے اسی quantisation کا پلان بناتا ہے۔"

msgid "Size for this many tokens. When it does not fit, the plan sizes down and shows what the context you asked for would have cost."
msgstr "اتنے ٹوکن کے لیے حجم نکالتا ہے۔ جب یہ نہ سمائے تو پلان حجم کم کر دیتا ہے اور دکھاتا ہے کہ آپ کا مانگا ہوا context کیا قیمت لیتا۔"

msgid "Set the micro-batch by hand. The whole budget is rebuilt around it, since it moves the compute buffer and with it the verdict."
msgstr "مائیکرو بیچ خود مقرر کرتا ہے۔ پورا بجٹ اسی کے گرد دوبارہ بنتا ہے، کیونکہ یہ compute بفر کو ہلاتا ہے اور اس کے ساتھ فیصلہ بھی۔"

msgid "A generation speed to answer against: whether this reaches it, and what context would."
msgstr "ایک جنریشن رفتار جس کے مقابل جواب دیا جائے: آیا یہ اس تک پہنچتی ہے، اور کون سا context پہنچتا۔"

msgid "%(model)s publishes no quantisations"
msgstr "%(model)s کوئی quantisation شائع نہیں کرتا"

msgid "Run `llamafit catalog refresh --model %(model)s`."
msgstr "`llamafit catalog refresh --model %(model)s` چلائیں۔"

msgid ""
"Place one model on this machine and print the command line that runs it.\n"
"\n"
"Shows the memory budget component by component, the context ladder a launch script chooses from, where a token's time goes, and any run the catalog records for comparison."
msgstr ""
"ایک ماڈل اس مشین پر رکھتا ہے اور وہ کمانڈ لائن چھاپتا ہے جو اسے چلاتی ہے۔\n"
"\n"
"میموری کا بجٹ جزو بہ جزو دکھاتا ہے، وہ context کی سیڑھی جس میں سے launch سکرپٹ چنتا ہے، ٹوکن کا وقت کہاں جاتا ہے، اور موازنے کے لیے کیٹلاگ میں درج کوئی بھی رن۔"

msgid "Leave the vision projector out, freeing its memory for context."
msgstr "vision projector کو چھوڑ دیتا ہے، اس کی میموری context کے لیے خالی کر دیتا ہے۔"

msgid "Write the files here instead of in LlamaFit's own presets directory."
msgstr "LlamaFit کی اپنی preset ڈائریکٹری کے بجائے فائلیں یہاں لکھتا ہے۔"

msgid "Bind this port instead of llama.cpp's default 8080."
msgstr "llama.cpp کے طے شدہ 8080 کے بجائے اسی پورٹ سے جڑتا ہے۔"

msgid "Size for this many tokens. It becomes the top of the ladder the script chooses from; the script never goes above it."
msgstr "اتنے ٹوکن کے لیے حجم نکالتا ہے۔ یہ اُس سیڑھی کی چوٹی بن جاتا ہے جس میں سے سکرپٹ چنتا ہے؛ سکرپٹ کبھی اس سے اوپر نہیں جاتا۔"

msgid "%(model)s does not fit this machine in any configuration"
msgstr "%(model)s کسی بھی کنفیگریشن میں اس مشین میں نہیں سماتا"

msgid "Run `llamafit plan %(model)s` to see what it would need."
msgstr "یہ دیکھنے کے لیے کہ اسے کیا درکار ہوتا، `llamafit plan %(model)s` چلائیں۔"

msgid ""
"Write launch scripts for one model: a script that picks its context from free card memory at start time, a router section, and a README.\n"
"\n"
"A file you have edited is never overwritten without --force."
msgstr ""
"ایک ماڈل کے لیے launch سکرپٹ لکھتا ہے: ایک سکرپٹ جو شروع ہوتے وقت کارڈ کی خالی میموری سے اپنا context چنتا ہے، ایک router حصہ، اور ایک README۔\n"
"\n"
"جو فائل آپ نے خود بدلی ہو، اس پر --force کے بغیر کبھی نہیں لکھا جاتا۔"

msgid "Overwrite files you have edited. It says which ones it discarded."
msgstr "جو فائلیں آپ نے بدلی ہوں ان پر لکھ دیتا ہے۔ یہ بتاتا ہے کہ اس نے کون سی ضائع کیں۔"

msgid "Run a model's preset, wait for the server to answer, and print its endpoints. --stop stops the server LlamaFit started."
msgstr "کسی ماڈل کا preset چلاتا ہے، سرور کے جواب کا انتظار کرتا ہے، اور اس کے endpoint چھاپتا ہے۔ --stop وہ سرور بند کرتا ہے جو LlamaFit نے شروع کیا تھا۔"

msgid "Stop the server LlamaFit started for this model."
msgstr "اس ماڈل کے لیے LlamaFit کا شروع کیا ہوا سرور بند کرتا ہے۔"

msgid "Seconds to wait for /health before reporting that it has not answered."
msgstr "/health کا کتنے سیکنڈ انتظار کیا جائے، اس سے پہلے کہ بتایا جائے کہ اس نے جواب نہیں دیا۔"

msgid "the preset could not be written"
msgstr "preset نہیں لکھا جا سکا"

msgid "Wrote a preset first: %(path)s"
msgstr "پہلے ایک preset لکھا گیا: %(path)s"

msgid "Nothing to stop: LlamaFit has no record of starting %(model)s."
msgstr "بند کرنے کو کچھ نہیں: LlamaFit کے پاس %(model)s شروع کرنے کا کوئی ریکارڈ نہیں۔"

msgid "Stopped %(model)s, which was serving on %(url)s."
msgstr "%(model)s بند کر دیا گیا، جو %(url)s پر خدمت دے رہا تھا۔"

msgid "Preset for %(name)s (%(quant)s) in %(dir)s"
msgstr "%(dir)s میں %(name)s (%(quant)s) کے لیے preset"

msgid "The server will answer on %(url)s."
msgstr "سرور %(url)s پر جواب دے گا۔"

msgid "Your edits were kept. Nothing above was written to those files; run the command again with --force to replace them."
msgstr "آپ کی تبدیلیاں محفوظ رہیں۔ اوپر کی کوئی چیز اُن فائلوں میں نہیں لکھی گئی؛ انہیں بدلنے کے لیے کمانڈ دوبارہ --force کے ساتھ چلائیں۔"

msgid "At start time the script reads how much card memory is free, keeps %(reserve)s MiB back, and takes the largest context that still fits."
msgstr "شروع ہوتے وقت سکرپٹ پڑھتا ہے کہ کارڈ کی کتنی میموری خالی ہے، %(reserve)s MiB بچا کر رکھتا ہے، اور سب سے بڑا context لیتا ہے جو پھر بھی سما جائے۔"

msgid "This machine has nothing the script can ask for free card memory, so it will start at %(context)s tokens; the script's header says why."
msgstr "اس مشین پر ایسا کچھ نہیں جس سے سکرپٹ کارڈ کی خالی میموری پوچھ سکے، اس لیے وہ %(context)s ٹوکن سے شروع ہوگا؛ سکرپٹ کا header وجہ بتاتا ہے۔"

