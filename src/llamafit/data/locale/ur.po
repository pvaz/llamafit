msgid ""
msgstr ""
"Project-Id-Version: llamafit 0.1.0a1\n"
"Report-Msgid-Bugs-To: https://github.com/pvaz/llamafit/issues\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ur\n"
"Language-Team: Urdu\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

# Urdu counts one apart from everything else, zero included, so the rule has the same
# shape as English's: CLDR puts ur in the group whose singular is exactly n = 1.
#
# Urdu is written right to left, and this file is stored in logical order, which is what
# gettext and the terminal both expect. It is still going to be read inside tables that
# are laid out left to right, and nothing in a catalog can change that: see the note in
# the translator's report that came with this file.
#
# Names that are not language stay in Latin: LlamaFit, llama.cpp, Hugging Face, GGUF,
# JSON, YAML, CUDA, Vulkan, Metal, flags, paths and tool names, plus the jargon an Urdu
# developer only ever writes in English: backend, quant, shard, offset, header, key,
# schema, build, binary, traceback, checksum, tensor, expert, context. Every one of those
# is a left-to-right island in a right-to-left sentence, so keep them where they are
# rather than moving them next to punctuation.

msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "%(repo)s کی فائلوں کی فہرست لیتے ہوئے Hugging Face نے %(status)d واپس کیا۔"

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Hugging Face سے %(repo)s کی فائل فہرست نہیں پڑھی جا سکی۔"

msgid "Check your network connection and try again."
msgstr "اپنا نیٹ ورک کنکشن جانچیں اور دوبارہ کوشش کریں۔"

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "%(repo)s کے لیے Hugging Face کے جواب میں فائل فہرست شامل نہیں تھی۔"

msgid "Check that the repository id is correct and public."
msgstr "جانچ لیں کہ ریپوزٹری id درست اور عوامی ہے۔"

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "کیٹلاگ میں %(count)d مسئلہ ہے"
msgstr[1] "کیٹلاگ میں %(count)d مسائل ہیں"

msgid "Run `llamafit catalog validate` for details."
msgstr "تفصیل کے لیے `llamafit catalog validate` چلائیں۔"

msgid "could not write %(path)s: %(error)s"
msgstr "%(path)s نہیں لکھا جا سکا: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "جانچ لیں کہ ڈائریکٹری میں لکھا جا سکتا ہے اور اس میں جگہ ہے۔"

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "%(path)s میں %(count)d مسئلہ ہے، اس لیے اسے تازہ نہیں کیا جا سکتا"
msgstr[1] "%(path)s میں %(count)d مسائل ہیں، اس لیے اسے تازہ نہیں کیا جا سکتا"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "پہلے `llamafit catalog validate` چلائیں اور فائل درست کریں۔"

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "%(path)s پورا نہیں پڑھا جا سکا، اس لیے صرف %(model)s کو تازہ کرنے سے اُن ماڈلوں کے بارے میں محفوظ حقائق مٹ جائیں گے جنہیں یہ عمل چھوتا ہی نہیں: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "پوری فائل دوبارہ بنانے کے لیے `llamafit catalog refresh` کو --model کے بغیر چلائیں۔"

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "اپنی مشین پر llama.cpp کے لیے open-weight LLM تلاش کریں، ان کا حجم جانچیں، انسٹال کریں اور تصدیق کریں۔"

msgid "Print machine-readable JSON instead of tables."
msgstr "جدولوں کے بجائے مشین کے پڑھنے کے قابل JSON چھاپتا ہے۔"

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "لاگ ڈائریکٹری کی llamafit.log میں تفصیل لکھتا ہے اور traceback دکھاتا ہے۔"

msgid "Disable colours."
msgstr "رنگ بند کرتا ہے۔"

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "اس زبان میں بولتا ہے، مثلاً pt_PT۔ جو زبان LlamaFit کے پاس نہیں، اس کے بجائے وہ انگریزی پر لوٹ آتا ہے اور بتاتا ہے کہ اس کے پاس کون سی زبانیں ہیں۔"

msgid "Print the version and exit."
msgstr "ورژن چھاپ کر باہر نکل جاتا ہے۔"

msgid "Unexpected error: %(error)s"
msgstr "غیر متوقع خرابی: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "پورا traceback دیکھنے کے لیے --verbose کے ساتھ دوبارہ چلائیں۔"

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "کیٹلاگ کی دیکھ بھال کرتا ہے: اس کی فائلیں جانچتا ہے، بدلتے رہنے والے خانے تازہ کرتا ہے۔"

msgid "Keep only this use case."
msgstr "صرف یہی استعمال کی قسم رکھتا ہے۔"

msgid "Keep only models with this capability (repeatable)."
msgstr "صرف اس صلاحیت والے ماڈل رکھتا ہے (دہرایا جا سکتا ہے)۔"

msgid "Keep only these licence identifiers (repeatable)."
msgstr "صرف یہی لائسنس شناخت کار رکھتا ہے (دہرایا جا سکتا ہے)۔"

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "ساتھ آنے والے کیٹلاگ اور آپ کی اپنی تبدیلیوں کے بجائے صرف یہی فائل جانچتا ہے۔"

msgid "Did you mean: %(ids)s?"
msgstr "کیا آپ کی مراد تھی: %(ids)s؟"

msgid "Run `llamafit list` to see every model id."
msgstr "ہر ماڈل id دیکھنے کے لیے `llamafit list` چلائیں۔"

msgid "no model named %(id)s in the catalog"
msgstr "کیٹلاگ میں %(id)s نام کا کوئی ماڈل نہیں"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "کیٹلاگ میں %(count)d مسئلہ ملا؛ تفصیل کے لیے `llamafit catalog validate` چلائیں۔"
msgstr[1] "کیٹلاگ میں %(count)d مسائل ملے؛ تفصیل کے لیے `llamafit catalog validate` چلائیں۔"

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "کوئی ماڈل مطابقت نہیں رکھتا۔ --use-case, --capability, --license, --vendor یا --search کو زیادہ وسیع کر کے دیکھیں۔"

msgid "invalid --use-case %(value)s"
msgstr "غیر درست --use-case %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "درست استعمال کی اقسام: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "درست صلاحیتیں: %(values)s"

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"دیے گئے فلٹروں سے چھان کر ماڈل کیٹلاگ کی فہرست دیتا ہے۔\n"
"\n"
"جدول ہر ماڈل کی زیادہ سے زیادہ تین صلاحیتیں دکھاتا ہے، اور باقی کے لیے ایک +N نشان، اور وہ دکھائے گئے معیار کے کالم کے مطابق ترتیب دیا گیا ہے؛ ہر صلاحیت info یا --json میں موجود ہے۔"

msgid "Keep only this vendor, case-insensitive."
msgstr "صرف یہی وینڈر رکھتا ہے، بڑے چھوٹے حروف کا فرق کیے بغیر۔"

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "id، نام، وینڈر یا خاندان میں ذیلی سٹرنگ کی مطابقت، بڑے چھوٹے حروف کا فرق کیے بغیر۔"

msgid "Show at most this many."
msgstr "زیادہ سے زیادہ اتنے ہی دکھاتا ہے۔"

msgid "Shorthand for llamafit list --search TEXT."
msgstr "llamafit list --search TEXT کی مختصر شکل۔"

msgid "Text to match against id, name, vendor or family."
msgstr "وہ متن جسے id، نام، وینڈر یا خاندان سے ملانا ہے۔"

msgid "Show one model's facts, sources and every quant it publishes."
msgstr "ایک ماڈل کے حقائق، اس کے ماخذ اور اس کے شائع کردہ ہر quant دکھاتا ہے۔"

msgid "A catalog model id."
msgstr "کیٹلاگ کا ایک ماڈل id۔"

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "کیٹلاگ کی YAML فائلیں schema کے مقابل جانچتا ہے اور ہر مسئلے کے لیے ایک سطر چھاپتا ہے۔"

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "%(count)d فائل جانچی گئی، کوئی مسئلہ نہیں ملا۔"
msgstr[1] "%(count)d فائلیں جانچی گئیں، کوئی مسئلہ نہیں ملا۔"

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "کیٹلاگ کے لیے فائلوں کے نام، سائز، checksum اور GGUF حقائق Hugging Face سے تازہ کرتا ہے۔"

msgid "Refresh only this model id."
msgstr "صرف یہی ماڈل id تازہ کرتا ہے۔"

msgid "Compute the refresh but write nothing."
msgstr "تازہ کاری کا حساب لگاتا ہے مگر کچھ لکھتا نہیں۔"

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "اگر کچھ بھی بدلنے والا ہو تو 1 کے ساتھ باہر نکلتا ہے؛ بدلتا کچھ نہیں، طے شدہ CI job کے لیے۔"

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: انتباہ: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "انتباہ: %(warning)s (%(count)d ماڈل: %(models)s)"
msgstr[1] "انتباہ: %(warning)s (%(count)d ماڈل: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: خرابی: %(error)s"

msgid "Hint: %(hint)s"
msgstr "اشارہ: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "refresh کے لیے Hugging Face تک نیٹ ورک رسائی درکار ہے؛ اپنا کنکشن جانچیں اور یہ بھی کہ ریپوزٹری id درست ہے۔"

msgid "No changes."
msgstr "کوئی تبدیلی نہیں۔"

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "ایک ماڈل کا خام کیٹلاگ اندراج چھاپتا ہے، طے شدہ طور پر JSON میں یا --yaml کے ساتھ YAML میں۔"

msgid "Print YAML instead of JSON."
msgstr "JSON کے بجائے YAML چھاپتا ہے۔"

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "بتاتا ہے کہ کیا شناخت ہوا، کیا ناکام رہا، اور کس چیز سے مزید کچھ کھلے گا۔"

