# Romanian translation of LlamaFit.
# This file is distributed under the same licence as LlamaFit.
#
# NOT YET REVIEWED BY A NATIVE SPEAKER. It was written against the template and the
# European Portuguese catalog, and it has had no second reader. By the standard
# docs/translations.md sets for every language, that is not enough: please read it line
# by line and correct it in a pull request.
#
# Romanian has three plural forms, not two: the singular for 1, a "few" form for 0 and
# for 2 to 19 by the last two digits, and a third form from 20 upwards that inserts "de"
# before the noun ("2 probleme" but "21 de probleme"). Every msgstr[2] below that shows a
# number carries that "de"; the ones that show no number repeat the second form, which is
# correct rather than lazy.
#
msgid ""
msgstr ""
"Project-Id-Version: llamafit 0.1.0a1\n"
"Report-Msgid-Bugs-To: https://github.com/pvaz/llamafit/issues\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: ro\n"
"Language-Team: Romanian\n"
"Plural-Forms: nplurals=3; plural=(n==1 ? 0 : (n==0 || (n%100 > 0 && n%100 < 20)) ? 1 : 2);\n"

msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "Hugging Face a returnat %(status)d la listarea fișierelor pentru %(repo)s."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Nu s-a putut citi lista de fișiere pentru %(repo)s de la Hugging Face."

msgid "Check your network connection and try again."
msgstr "Verificați conexiunea la rețea și încercați din nou."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "Răspunsul Hugging Face pentru %(repo)s nu conținea o listă de fișiere."

msgid "Check that the repository id is correct and public."
msgstr "Verificați dacă identificatorul depozitului este corect și public."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "catalogul are %(count)d problemă"
msgstr[1] "catalogul are %(count)d probleme"
msgstr[2] "catalogul are %(count)d de probleme"

msgid "Run `llamafit catalog validate` for details."
msgstr "Rulați `llamafit catalog validate` pentru detalii."

msgid "could not write %(path)s: %(error)s"
msgstr "nu s-a putut scrie %(path)s: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "Verificați dacă directorul permite scrierea și are spațiu."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "%(path)s are %(count)d problemă și nu poate fi actualizat"
msgstr[1] "%(path)s are %(count)d probleme și nu poate fi actualizat"
msgstr[2] "%(path)s are %(count)d de probleme și nu poate fi actualizat"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "Rulați `llamafit catalog validate` și corectați mai întâi fișierul."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "%(path)s nu a putut fi citit în întregime, așa că actualizarea doar a %(model)s ar pierde caracteristicile pe care le păstrează pentru modelele neatinse de această execuție: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "Rulați `llamafit catalog refresh` fără --model pentru a reconstrui întregul fișier."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "Găsiți, dimensionați, instalați și verificați modele LLM cu greutăți deschise pentru llama.cpp pe propriul calculator."

msgid "Print machine-readable JSON instead of tables."
msgstr "Afișează JSON citibil de mașini în loc de tabele."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "Scrie detaliile în llamafit.log, în directorul de jurnale, și afișează urmele de execuție."

msgid "Disable colours."
msgstr "Dezactivează culorile."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "Vorbește această limbă, de exemplu pt_PT. O limbă pe care LlamaFit nu o are revine la engleză, iar el spune pe care le are."

msgid "Print the version and exit."
msgstr "Afișează versiunea și iese."

msgid "Unexpected error: %(error)s"
msgstr "Eroare neașteptată: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "Rulați din nou cu --verbose pentru urma completă de execuție."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "Întreține catalogul: validează fișierele lui, actualizează câmpurile volatile."

msgid "Keep only this use case."
msgstr "Păstrează doar acest caz de utilizare."

msgid "Keep only models with this capability (repeatable)."
msgstr "Păstrează doar modelele cu această capabilitate (repetabil)."

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Păstrează doar acești identificatori de licență (repetabil)."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "Validează doar acest fișier, în loc de catalogul inclus și personalizările."

msgid "Did you mean: %(ids)s?"
msgstr "Ați vrut să spuneți: %(ids)s?"

msgid "Run `llamafit list` to see every model id."
msgstr "Rulați `llamafit list` pentru a vedea toți identificatorii de model."

msgid "no model named %(id)s in the catalog"
msgstr "niciun model numit %(id)s în catalog"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "S-a găsit %(count)d problemă în catalog; rulați `llamafit catalog validate` pentru detalii."
msgstr[1] "S-au găsit %(count)d probleme în catalog; rulați `llamafit catalog validate` pentru detalii."
msgstr[2] "S-au găsit %(count)d de probleme în catalog; rulați `llamafit catalog validate` pentru detalii."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "Niciun model nu corespunde. Încercați un --use-case, --capability, --license, --vendor sau --search mai larg."

msgid "invalid --use-case %(value)s"
msgstr "--use-case nevalid: %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "Cazuri de utilizare valide: %(values)s"

msgid "invalid --capability value: %(values)s"
msgid_plural "invalid --capability values: %(values)s"
msgstr[0] "valoare nevalidă pentru --capability: %(values)s"
msgstr[1] "valori nevalide pentru --capability: %(values)s"
msgstr[2] "valori nevalide pentru --capability: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "Capabilități valide: %(values)s"

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"Listează catalogul de modele, restrâns de filtrele date.\n"
"\n"
"Tabelul arată cel mult trei capabilități pentru fiecare model, plus un marcaj +N pentru restul, și este sortat după coloana Calitate afișată; info sau --json au toate capabilitățile."

msgid "Keep only this vendor, case-insensitive."
msgstr "Păstrează doar acest producător, fără a distinge majusculele de minuscule."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "Potrivire parțială pe identificator, nume, producător sau familie, fără a distinge majusculele de minuscule."

msgid "Show at most this many."
msgstr "Afișează cel mult atâtea."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "Prescurtare pentru llamafit list --search TEXT."

msgid "Text to match against id, name, vendor or family."
msgstr "Text de căutat în identificator, nume, producător sau familie."

msgid "Show one model's facts, sources and every quant it publishes."
msgstr "Afișează caracteristicile unui model, sursele lui și fiecare cuantizare pe care o publică."

msgid "A catalog model id."
msgstr "Un identificator de model din catalog."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "Validează fișierele YAML ale catalogului față de schemă, scriind câte o linie pentru fiecare problemă."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "%(count)d fișier verificat, nicio problemă găsită."
msgstr[1] "%(count)d fișiere verificate, nicio problemă găsită."
msgstr[2] "%(count)d de fișiere verificate, nicio problemă găsită."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "Actualizează de la Hugging Face numele fișierelor, dimensiunile, sumele de control și caracteristicile GGUF ale catalogului."

msgid "Refresh only this model id."
msgstr "Actualizează doar acest identificator de model."

msgid "Compute the refresh but write nothing."
msgstr "Calculează actualizarea, dar nu scrie nimic."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "Iese cu 1 dacă s-ar schimba ceva; nu modifică nimic, pentru o sarcină CI programată."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: avertisment: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "avertisment: %(warning)s (%(count)d model: %(models)s)"
msgstr[1] "avertisment: %(warning)s (%(count)d modele: %(models)s)"
msgstr[2] "avertisment: %(warning)s (%(count)d de modele: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: eroare: %(error)s"

msgid "Hint: %(hint)s"
msgstr "Sugestie: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "actualizarea are nevoie de acces la rețea către Hugging Face; verificați conexiunea și dacă identificatorul depozitului este corect."

msgid "No changes."
msgstr "Nicio schimbare."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "Afișează intrarea brută din catalog a unui model, în JSON implicit sau în YAML cu --yaml."

msgid "Print YAML instead of JSON."
msgstr "Afișează YAML în loc de JSON."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "Explică ce s-a detectat, ce a eșuat și ce ar debloca mai mult."

