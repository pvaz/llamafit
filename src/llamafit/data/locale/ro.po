msgid "Show what this machine has: CPU, memory, GPUs, disks and llama.cpp."
msgstr "Arată ce are acest calculator: CPU, memorie, GPU-uri, discuri și llama.cpp."

msgid "Skip the RAM bandwidth measurement."
msgstr "Sare peste măsurarea lățimii de bandă a memoriei RAM."

msgid "Command: %(command)s"
msgstr "Comandă: %(command)s"

msgid "truncated GGUF header: wanted %(wanted)d bytes at offset %(offset)d, got %(got)d"
msgstr "antet GGUF trunchiat: se așteptau %(wanted)d octeți la poziția %(offset)d, s-au primit %(got)d"

msgid "The file may still be downloading, or the URL may not be a GGUF file."
msgstr "Fișierul poate fi încă în curs de descărcare sau URL-ul poate să nu fie un fișier GGUF."

msgid "unknown GGUF value type %(type)d at offset %(offset)d"
msgstr "tip de valoare GGUF necunoscut %(type)d la poziția %(offset)d"

msgid "This file may use a newer GGUF metadata type than LlamaFit supports."
msgstr "Acest fișier poate folosi un tip de metadate GGUF mai nou decât cele acceptate de LlamaFit."

msgid "not a GGUF file: bad magic %(magic)s at offset 0"
msgstr "nu este un fișier GGUF: semnătură nevalidă %(magic)s la poziția 0"

msgid "Check that this file is actually a .gguf model."
msgstr "Verificați dacă acest fișier este într-adevăr un model .gguf."

msgid "unsupported GGUF version %(version)d at offset 4"
msgstr "versiune GGUF neacceptată %(version)d la poziția 4"

msgid "LlamaFit supports GGUF versions %(versions)s."
msgstr "LlamaFit acceptă versiunile GGUF %(versions)s."

msgid "these GGUF files are not one split model: they disagree about '%(key)s', declaring %(values)s"
msgstr "aceste fișiere GGUF nu formează un singur model împărțit: nu sunt de acord asupra '%(key)s' și declară %(values)s"

msgid "Pass the shards of one model, not of several."
msgstr "Dați fragmentele unui singur model, nu ale mai multora."

msgid "no GGUF header to read facts from"
msgstr "niciun antet GGUF din care să se citească caracteristicile"

msgid "Pass the model's file, or every shard of a split model."
msgstr "Dați fișierul modelului sau fiecare fragment al unui model împărțit."

msgid "%(count)d of %(total)d GGUF files carry no '%(key)s' key, so their place in a split model cannot be established"
msgstr "%(count)d din %(total)d fișiere GGUF nu au cheia '%(key)s', așa că locul lor într-un model împărțit nu poate fi stabilit"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "Dați un singur fișier neîmpărțit de unul singur sau fiecare fragment al unui singur model împărțit."

msgid "incomplete shard set: the model declares %(declared)d shards and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "set de fragmente incomplet: modelul declară %(declared)d fragmente și au sosit %(arrived)d (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "Dați fiecare fragment al modelului împărțit."

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "lipsește fragmentul care conține metadatele modelului: s-au primit %(key)s %(numbers)s, unul dintre ele trebuia să fie 0"

msgid "Pass every shard of the split model, including the first."
msgstr "Dați fiecare fragment al modelului împărțit, inclusiv primul."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "set de fragmente incomplet: se așteptau %(key)s de la 0 la %(last)d, s-au primit %(numbers)s"

msgid "Pass each shard of the split model exactly once."
msgstr "Dați fiecare fragment al modelului împărțit exact o dată."

msgid "incomplete shard set: the model declares %(declared)d tensors and its %(shards)d shards hold %(held)d between them"
