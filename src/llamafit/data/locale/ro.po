msgstr "llama-server rulează la %(url)s"

msgid "model %(model)s, context %(context)s"
msgstr "model %(model)s, context %(context)s"

msgctxt "model name"
msgid "unknown"
msgstr "necunoscut"

msgid "Low disk space on %(path)s"
msgstr "Spațiu redus pe disc la %(path)s"

msgid "%(size)s free"
msgstr "%(size)s liberi"

msgid "Most useful models need 5 to 120 GB; free space or change the downloads directory."
msgstr "Majoritatea modelelor utile au nevoie de 5 până la 120 GB; eliberați spațiu sau schimbați directorul de descărcări."

