msgstr[1] "%(count)d fișiere GGUF din cele %(total)d date nu poartă cheia '%(key)s', așa că locul lor într-un model împărțit nu poate fi stabilit"
msgstr[2] "%(count)d de fișiere GGUF din cele %(total)d date nu poartă cheia '%(key)s', așa că locul lor într-un model împărțit nu poate fi stabilit"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "Dați un singur fișier neîmpărțit de unul singur sau fiecare fragment al unui singur model împărțit."

msgid "incomplete shard set: the model declares %(shards)s and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "set de fragmente incomplet: modelul declară %(shards)s și au ajuns %(arrived)d (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "Dați fiecare fragment al modelului împărțit."

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "lipsește fragmentul care conține metadatele modelului: s-au primit %(key)s %(numbers)s, unul dintre ele trebuia să fie 0"

msgid "Pass every shard of the split model, including the first."
msgstr "Dați fiecare fragment al modelului împărțit, inclusiv primul."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "set de fragmente incomplet: se așteptau %(key)s de la 0 la %(last)d, s-au primit %(numbers)s"

msgid "Pass each shard of the split model exactly once."
msgstr "Dați fiecare fragment al modelului împărțit exact o dată."

msgid "incomplete shard set: the model declares %(tensors)s and its %(shards)s hold %(held)d between them"
msgstr "set de fragmente incomplet: modelul declară %(tensors)s, iar cele %(shards)s ale lui conțin %(held)d în total"

msgid "%(count)d tensor"
msgid_plural "%(count)d tensors"
msgstr[0] "%(count)d tensor"
msgstr[1] "%(count)d tensori"
msgstr[2] "%(count)d de tensori"

msgid "could not read %(path)s: %(error)s"
msgstr "nu s-a putut citi %(path)s: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "Verificați dacă fișierul există și poate fi citit."

msgid "could not fetch %(url)s: %(error)s"
msgstr "nu s-a putut obține %(url)s: %(error)s"

msgid "Check your network connection and that the URL is reachable."
msgstr "Verificați conexiunea la rețea și dacă URL-ul este accesibil."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s a returnat HTTP %(status)d în loc de 206 Partial Content; serverul poate să nu accepte cereri pe intervale."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Confirmați că URL-ul indică un fișier GGUF care poate fi descărcat."

