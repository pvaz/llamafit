msgid "Memory size unknown"
msgstr "Dimensiune de memorie necunoscută"

msgid "LlamaFit could not read this machine's memory totals, so it cannot work out what will fit."
msgstr "LlamaFit nu a putut citi totalurile de memorie ale acestui calculator, așa că nu poate calcula ce încape."

msgid "%(gpu)s: no %(backend)s backend in llama.cpp"
msgstr "%(gpu)s: niciun backend %(backend)s în llama.cpp"

