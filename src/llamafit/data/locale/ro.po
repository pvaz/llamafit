msgstr "Instalați o compilare de llama.cpp cu backendul %(backend)s sau Vulkan pentru a folosi %(gpu)s."

msgid "%(gpu)s: VRAM size unknown"
msgstr "%(gpu)s: dimensiunea VRAM necunoscută"

