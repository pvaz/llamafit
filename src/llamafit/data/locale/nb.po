msgid "Check that the file exists and is readable."
msgstr "Kontroller at filen finnes og kan leses."

msgid "could not fetch %(url)s: %(error)s"
msgstr "klarte ikke å hente %(url)s: %(error)s"

msgid "Check your network connection and that the URL is reachable."
msgstr "Kontroller nettverksforbindelsen og at adressen er tilgjengelig."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s svarte HTTP %(status)d i stedet for 206 Partial Content; serveren støtter kanskje ikke range-forespørsler."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Bekreft at adressen peker på en GGUF-fil som kan lastes ned."

