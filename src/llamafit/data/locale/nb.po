msgid "llama.cpp not found: no llama-server on PATH, in LLAMA_CPP_PATH or in the usual directories"
msgstr "llama.cpp ble ikke funnet: ingen llama-server i PATH, i LLAMA_CPP_PATH eller i de vanlige katalogene"

msgid "no ggml backend libraries found next to llama-server; the build may be static"
msgstr "fant ingen ggml-backend-biblioteker ved siden av llama-server; bygget kan være statisk"

msgid "no llama-server answering"
msgstr "ingen llama-server svarer"

msgid "unexpected response: %(error)s"
msgstr "uventet svar: %(error)s"

msgid "Install or repair the NVIDIA driver; nvidia-smi ships with it and must be on PATH."
msgstr "Installer eller reparer NVIDIA-driveren; nvidia-smi følger med den og må ligge i PATH."

msgid "Install ROCm (Linux) to expose AMD VRAM figures; without it the GPU is listed by name only."
msgstr "Installer ROCm (Linux) for å få fram AMDs VRAM-tall; uten ROCm listes GPU-en bare med navn."

msgid "PowerShell could not list video controllers; run from a normal user session."
msgstr "PowerShell klarte ikke å liste skjermkontrollerne; kjør fra en vanlig brukerøkt."

msgid "Install pciutils to list GPUs by name when no vendor tool is available."
msgstr "Installer pciutils for å liste GPU-er med navn når det ikke finnes noe verktøy fra leverandøren."

msgid "DDR type and speed were not readable; on Linux run once with sudo (dmidecode) or accept the measured bandwidth instead."
msgstr "DDR-type og hastighet var ikke til å lese; kjør én gang med sudo på Linux (dmidecode), eller nøy deg med den målte båndbredden i stedet."

msgid "py-cpuinfo failed; the CPU model and instruction sets are unknown."
msgstr "py-cpuinfo mislyktes; CPU-modellen og instruksjonssettene er ukjente."

msgid "psutil could not count the CPU cores; thread choice falls back to one core. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil klarte ikke å telle CPU-kjernene; valget av tråder faller tilbake til én kjerne. Installer psutil på nytt med `pip install --force-reinstall psutil`."

msgid "psutil could not read the memory totals; budgets cannot be computed until this works. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil klarte ikke å lese de samlede minnetallene; så lenge det ikke virker, kan ingen budsjetter regnes ut. Installer psutil på nytt med `pip install --force-reinstall psutil`."

msgid "Could not read performance-core count from sysctl."
msgstr "Antall ytelseskjerner var ikke til å lese ut av sysctl."

msgid "llama-server exists but did not report a version; the binary may be broken."
msgstr "llama-server finnes, men oppga ingen versjon; programfilen kan være ødelagt."

msgid "system_profiler failed; GPU information is unavailable."
msgstr "system_profiler mislyktes; det finnes ingen opplysninger om GPU-en."

msgid "No vendor tool reported the GPU's memory size; record the size in a hardware profile so budgets can be computed for this machine."
msgstr "Ingen verktøy fra leverandøren oppga minnestørrelsen til GPU-en; skriv inn størrelsen i en maskinvareprofil, så budsjetter kan regnes ut for denne maskinen."

msgid "llama.cpp installed"
msgstr "llama.cpp installert"

msgid "build %(build)s at %(path)s, backends: %(backends)s"
msgstr "bygg %(build)s i %(path)s, backends: %(backends)s"

