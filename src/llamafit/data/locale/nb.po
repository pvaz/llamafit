msgid "This repository is gated. Accept its terms on Hugging Face and set HF_TOKEN to a token that can read it."
msgstr "Dette repositoriet er lukket. Godta vilkårene på Hugging Face og sett HF_TOKEN til et token som får lese det."

msgid "%(file)s is not at %(url)s any more (HTTP 404)."
msgstr "%(file)s ligger ikke på %(url)s lenger (HTTP 404)."

msgid "Run `llamafit catalog refresh` to pick up the repository's current files."
msgstr "Kjør `llamafit catalog refresh` for å hente repositoriets nåværende filer."

msgid "%(url)s returned HTTP %(status)d."
msgstr "%(url)s svarte HTTP %(status)d."

msgid "Confirm the URL points at a downloadable file."
msgstr "Bekreft at adressen peker på en fil som kan lastes ned."

msgid "%(url)s did not say how big %(file)s is."
msgstr "%(url)s sa ikke hvor stor %(file)s er."

msgid "%(file)s is %(actual)s on the server but the catalog says %(expected)s; the repository has been re-uploaded since the catalog was refreshed."
msgstr "%(file)s er %(actual)s på serveren, men katalogen sier %(expected)s; repositoriet er lastet opp på nytt siden katalogen ble oppdatert."

msgid "Run `llamafit catalog refresh` and try again."
msgstr "Kjør `llamafit catalog refresh` og prøv igjen."

msgid "%(file)s: the server sent %(actual)d bytes of a %(expected)d byte range."
msgstr "%(file)s: serveren sendte %(actual)d byte av et område på %(expected)d byte."

msgid "Run the command again; the parts that did arrive are kept."
msgstr "Kjør kommandoen på nytt; delene som kom fram beholdes."

msgid "Stopped."
msgstr "Stoppet."

msgid "%(file)s: the server asked for fewer connections; using %(count)d."
msgstr "%(file)s: serveren ba om færre forbindelser; bruker %(count)d."

msgid "%(file)s: this server will not serve byte ranges; fetching it in one stream."
msgstr "%(file)s: denne serveren leverer ikke byteområder; henter den i én strøm."

msgid "%(file)s does not match its checksum; fetching it again."
msgstr "%(file)s stemmer ikke med kontrollsummen sin; henter den på nytt."

msgid "Check that the download directory is writable."
msgstr "Kontroller at det går an å skrive til nedlastingskatalogen."

msgid "%(needed)s is needed for this model but %(path)s has only %(free)s free, %(short)s short of what is wanted with %(headroom)s left spare."
msgstr "%(needed)s trengs til denne modellen, men %(path)s har bare %(free)s ledig, %(short)s for lite mot det ønskede med %(headroom)s til overs."

msgid "Free some space, or choose another directory with --dir, or a smaller quantisation with --quant."
msgstr "Frigjør litt plass, eller velg en annen katalog med --dir, eller en mindre kvantisering med --quant."

msgid "could not measure the free space on %(path)s: %(error)s"
msgstr "klarte ikke å måle den ledige plassen på %(path)s: %(error)s"

msgid "Check that the download directory's volume is available."
msgstr "Kontroller at volumet med nedlastingskatalogen er tilgjengelig."

msgid "%(model)s has no downloadable source in the catalog."
msgstr "%(model)s har ingen nedlastbar kilde i katalogen."

msgid "Only Hugging Face sources can be installed; this entry has none."
msgstr "Bare kilder fra Hugging Face kan installeres; denne oppføringen har ingen."

msgid "the catalog has no file list for %(model)s %(quant)s."
msgstr "katalogen har ingen filliste for %(model)s %(quant)s."

msgid "Run `llamafit catalog refresh` to fill in the file names."
msgstr "Kjør `llamafit catalog refresh` for å fylle inn filnavnene."

msgid "%(model)s publishes no quantisations."
msgstr "%(model)s publiserer ingen kvantiseringer."

msgid "%(model)s does not publish a %(quant)s quantisation."
msgstr "%(model)s publiserer ingen %(quant)s-kvantisering."

msgid "It publishes: %(quants)s"
msgstr "Den publiserer: %(quants)s"

msgid "the catalog does not record how big %(quant)s is."
msgstr "katalogen noterer ikke hvor stor %(quant)s er."

msgid "Run `llamafit catalog refresh` to fill in the sizes."
msgstr "Kjør `llamafit catalog refresh` for å fylle inn størrelsene."

msgid "the catalog holds no checksum for %(files)s."
msgid_plural "the catalog holds no checksums for %(files)s."
msgstr[0] "katalogen har ingen kontrollsum for %(files)s."
msgstr[1] "katalogen har ingen kontrollsummer for %(files)s."

msgid "Run `llamafit catalog refresh` to fetch them, or pass --allow-unverified to download anyway and check the files yourself."
msgstr "Kjør `llamafit catalog refresh` for å hente dem, eller oppgi --allow-unverified for å laste ned likevel og kontrollere filene selv."

msgid "%(done)s of %(total)s"
msgstr "%(done)s av %(total)s"

msgid "%(rate)s/s"
msgstr "%(rate)s/s"

msgid "Fetching %(file)s (%(size)s)"
msgstr "Henter %(file)s (%(size)s)"

msgid "Checking %(file)s against its checksum"
msgstr "Kontrollerer %(file)s mot kontrollsummen sin"

msgid "Done: %(file)s"
msgstr "Ferdig: %(file)s"

msgid "could not create %(path)s: %(error)s"
msgstr "klarte ikke å opprette %(path)s: %(error)s"

msgid "Check that the download directory is writable and has room."
msgstr "Kontroller at det går an å skrive til nedlastingskatalogen, og at det er plass."

msgid "could not move %(source)s into place: %(error)s"
msgstr "klarte ikke å flytte %(source)s på plass: %(error)s"

msgid "could not record progress in %(path)s: %(error)s"
msgstr "klarte ikke å notere framdriften i %(path)s: %(error)s"

msgid "could not fetch %(url)s: %(error)s"
msgstr "klarte ikke å hente %(url)s: %(error)s"

msgid "Stopped before the checksum was finished."
msgstr "Stoppet før kontrollsummen var ferdig."

msgid "could not read %(path)s: %(error)s"
msgstr "klarte ikke å lese %(path)s: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "Kontroller at filen finnes og kan leses."

msgid "%(file)s is %(actual)d bytes, but the catalog says %(expected)d"
msgstr "%(file)s er %(actual)d byte, men katalogen sier %(expected)d"

msgid "The transfer was cut short. Run the command again to fetch it properly."
msgstr "Overføringen ble avbrutt. Kjør kommandoen på nytt for å hente den ordentlig."

msgid "%(file)s does not match the checksum the catalog holds."
msgstr "%(file)s stemmer ikke med kontrollsummen katalogen har."

msgid "Expected %(expected)s but the file hashes to %(actual)s. The bad copy has been deleted; run the command again to fetch it."
msgstr "Ventet %(expected)s, men filen hasher til %(actual)s. Den dårlige kopien er slettet; kjør kommandoen på nytt for å hente den."

msgid "Command: %(command)s"
msgstr "Kommando: %(command)s"

msgid "truncated GGUF header: wanted %(wanted)d byte at offset %(offset)d, got %(got)d"
msgid_plural "truncated GGUF header: wanted %(wanted)d bytes at offset %(offset)d, got %(got)d"
msgstr[0] "avkortet GGUF-header: ville ha %(wanted)d byte på posisjon %(offset)d, fikk %(got)d"
msgstr[1] "avkortet GGUF-header: ville ha %(wanted)d byte på posisjon %(offset)d, fikk %(got)d"

msgid "The file may still be downloading, or the URL may not be a GGUF file."
msgstr "Filen lastes kanskje fortsatt ned, eller adressen peker ikke på en GGUF-fil."

msgid "unknown GGUF value type %(type)d at offset %(offset)d"
msgstr "ukjent GGUF-verditype %(type)d på posisjon %(offset)d"

msgid "This file may use a newer GGUF metadata type than LlamaFit supports."
msgstr "Denne filen bruker kanskje en nyere GGUF-metadatatype enn den LlamaFit støtter."

msgid "not a GGUF file: bad magic %(magic)s at offset 0"
msgstr "ikke en GGUF-fil: feil signatur %(magic)s på posisjon 0"

msgid "Check that this file is actually a .gguf model."
msgstr "Kontroller at denne filen virkelig er en .gguf-modell."

msgid "unsupported GGUF version %(version)d at offset 4"
msgstr "GGUF-versjon %(version)d støttes ikke, på posisjon 4"

msgid "LlamaFit supports GGUF versions %(versions)s."
msgstr "LlamaFit støtter GGUF-versjonene %(versions)s."

msgid "A memory budget built without these tensors would be too small, so none is built. If llama.cpp loads the file, LlamaFit's tensor-size table is missing the type."
msgstr "Et minnebudsjett bygget uten disse tensorene ville blitt for lite, så det bygges ingen. Hvis llama.cpp laster filen, mangler typen i LlamaFits tabell over tensorstørrelser."

msgid "%(type)d (%(count)d tensor, first %(name)s)"
msgid_plural "%(type)d (%(count)d tensors, first %(name)s)"
msgstr[0] "%(type)d (%(count)d tensor, første %(name)s)"
msgstr[1] "%(type)d (%(count)d tensorer, første %(name)s)"

msgid "cannot size this GGUF file: %(count)d tensor uses a GGML type LlamaFit does not know: %(details)s"
msgid_plural "cannot size this GGUF file: %(count)d tensors use GGML types LlamaFit does not know: %(details)s"
msgstr[0] "kan ikke dimensjonere denne GGUF-filen: %(count)d tensor bruker en GGML-type LlamaFit ikke kjenner: %(details)s"
msgstr[1] "kan ikke dimensjonere denne GGUF-filen: %(count)d tensorer bruker GGML-typer LlamaFit ikke kjenner: %(details)s"

msgid "%(count)d shard"
msgid_plural "%(count)d shards"
msgstr[0] "%(count)d shard"
msgstr[1] "%(count)d shards"

msgid "these GGUF files are not one split model: they disagree about '%(key)s', declaring %(values)s"
msgstr "disse GGUF-filene er ikke én oppdelt modell: de er uenige om '%(key)s' og oppgir %(values)s"

# "Shard" is the word Norwegian developers use for a piece of a split model; the
# literal "skår" would read as a piece of broken glass.
msgid "Pass the shards of one model, not of several."
msgstr "Oppgi shards fra én modell, ikke fra flere."

msgid "no GGUF header to read facts from"
msgstr "ingen GGUF-header å lese fakta fra"

msgid "Pass the model's file, or every shard of a split model."
msgstr "Oppgi filen til modellen, eller hver shard i en oppdelt modell."

msgid "%(count)d GGUF file of the %(total)d given carries no '%(key)s' key, so its place in a split model cannot be established"
msgid_plural "%(count)d GGUF files of the %(total)d given carry no '%(key)s' key, so their place in a split model cannot be established"
msgstr[0] "%(count)d GGUF-fil av de %(total)d oppgitte bærer ingen '%(key)s'-nøkkel, så plassen dens i en oppdelt modell kan ikke fastslås"
msgstr[1] "%(count)d GGUF-filer av de %(total)d oppgitte bærer ingen '%(key)s'-nøkkel, så plassen deres i en oppdelt modell kan ikke fastslås"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "Oppgi enten én udelt fil alene, eller hver shard i én oppdelt modell."

msgid "incomplete shard set: the model declares %(shards)s and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "ufullstendig sett med shards: modellen oppgir %(shards)s og %(arrived)d kom fram (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "Oppgi hver shard i den oppdelte modellen."

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "den sharden som bærer modellens metadata mangler: fikk %(key)s %(numbers)s, ventet at én av dem skulle være 0"

msgid "Pass every shard of the split model, including the first."
msgstr "Oppgi hver shard i den oppdelte modellen, også den første."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "ufullstendig sett med shards: ventet %(key)s 0 til %(last)d, fikk %(numbers)s"

msgid "Pass each shard of the split model exactly once."
msgstr "Oppgi hver shard i den oppdelte modellen nøyaktig én gang."

msgid "incomplete shard set: the model declares %(tensors)s and its %(shards)s hold %(held)d between them"
msgstr "ufullstendig sett med shards: modellen oppgir %(tensors)s og dens %(shards)s rommer %(held)d til sammen"

msgid "%(count)d tensor"
msgid_plural "%(count)d tensors"
msgstr[0] "%(count)d tensor"
msgstr[1] "%(count)d tensorer"

msgid "Check your network connection and that the URL is reachable."
msgstr "Kontroller nettverksforbindelsen og at adressen er tilgjengelig."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s svarte HTTP %(status)d i stedet for 206 Partial Content; serveren støtter kanskje ikke range-forespørsler."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Bekreft at adressen peker på en GGUF-fil som kan lastes ned."

msgctxt "CPU model"
msgid "unknown"
msgstr "ukjent"

msgid "nvidia-smi returned no GPUs"
msgstr "nvidia-smi ga ingen GPU-er"

msgid "rocm-smi returned no cards"
msgstr "rocm-smi ga ingen kort"

msgid "system_profiler returned no displays"
msgstr "system_profiler ga ingen skjermer"

msgid "WMI returned no video controllers"
msgstr "WMI ga ingen skjermkontrollere"

msgid "lspci found no display controllers"
msgstr "lspci fant ingen skjermkontrollere"

msgid "vulkaninfo reported no discrete device with a memory heap"
msgstr "vulkaninfo meldte ingen diskret enhet med en minneheap"

msgid "no populated memory modules"
msgstr "ingen minnemoduler i bruk"

msgid "no SPMemoryDataType"
msgstr "ingen SPMemoryDataType"

msgid "%(program)s: timed out after %(seconds)s second"
msgid_plural "%(program)s: timed out after %(seconds)s seconds"
msgstr[0] "%(program)s: tidsavbrudd etter %(seconds)s sekund"
msgstr[1] "%(program)s: tidsavbrudd etter %(seconds)s sekunder"

msgid "empty command"
msgstr "tom kommando"

msgid "%(program)s: %(error)s"
msgstr "%(program)s: %(error)s"

msgid "%(program)s: not found"
msgstr "%(program)s: ikke funnet"

msgid "exit code %(code)d: %(detail)s"
msgstr "sluttkode %(code)d: %(detail)s"

msgid "no hardware profile file at %(path)s"
msgstr "ingen maskinvareprofilfil på %(path)s"

msgid "Run `llamafit hardware list` to see the profiles LlamaFit has."
msgstr "Kjør `llamafit hardware list` for å se profilene LlamaFit har."

msgid "%(path)s is not a valid hardware profile: %(details)s"
msgstr "%(path)s er ikke en gyldig maskinvareprofil: %(details)s"

msgid "Run `llamafit hardware validate FILE` for the whole list."
msgstr "Kjør `llamafit hardware validate FIL` for hele listen."

msgid "no hardware profile named %(name)s"
msgstr "ingen maskinvareprofil med navnet %(name)s"

msgid "Profiles LlamaFit has: %(names)s"
msgstr "Profiler LlamaFit har: %(names)s"

msgid "Run `llamafit hardware path` to see where your own profiles go."
msgstr "Kjør `llamafit hardware path` for å se hvor dine egne profiler skal ligge."

msgid "this machine has no graphics card, so there is no VRAM to override"
msgstr "denne maskinen har intet grafikkort, så det finnes ingen VRAM å overstyre"

msgid "Describe the whole machine in a hardware profile and pass --profile."
msgstr "Beskriv hele maskinen i en maskinvareprofil og oppgi --profile."

msgid "this machine has one memory pool shared with the graphics card"
msgstr "denne maskinen har én minnepool som deles med grafikkortet"

msgid "Use --ram to resize the pool; --memory would change only half of it."
msgstr "Bruk --ram for å endre størrelsen på poolen; --memory ville bare endret halvparten av den."

msgid "%(option)s needs a value above zero"
msgstr "%(option)s trenger en verdi over null"

msgid "no build number in the version output: %(text)s"
msgstr "ingen byggnummer i versjonsutskriften: %(text)s"

msgid "llama.cpp not found: no llama-server on PATH, in LLAMA_CPP_PATH or in the usual directories"
msgstr "llama.cpp ble ikke funnet: ingen llama-server i PATH, i LLAMA_CPP_PATH eller i de vanlige katalogene"

msgid "no ggml backend libraries found next to llama-server; the build may be static"
msgstr "fant ingen ggml-backend-biblioteker ved siden av llama-server; bygget kan være statisk"

msgid "%(path)s is a file, not a directory."
msgstr "%(path)s er en fil, ikke en katalog."

msgid "%(path)s cannot be read: %(error)s"
msgstr "%(path)s kan ikke leses: %(error)s"

msgid "%(path)s has a marker file that cannot be read."
msgstr "%(path)s har en markørfil som ikke kan leses."

msgid "%(path)s already holds %(count)d file that LlamaFit did not install."
msgid_plural "%(path)s already holds %(count)d files that LlamaFit did not install."
msgstr[0] "%(path)s inneholder allerede %(count)d fil som LlamaFit ikke har installert."
msgstr[1] "%(path)s inneholder allerede %(count)d filer som LlamaFit ikke har installert."

msgid "%(name)s has no published checksum, so it cannot be verified."
msgstr "%(name)s har ingen publisert kontrollsum og kan derfor ikke verifiseres."

msgid "Pass --allow-unverified to install it anyway, knowing the archive is unchecked."
msgstr "Oppgi --allow-unverified for å installere det likevel, vel vitende om at arkivet er ukontrollert."

msgid "could not download %(url)s: %(error)s"
msgstr "klarte ikke å laste ned %(url)s: %(error)s"

msgid "the connection was closed"
msgstr "forbindelsen ble lukket"

msgid "Run the command again; it continues from where it stopped."
msgstr "Kjør kommandoen på nytt; den fortsetter der den stoppet."

msgid "the download of %(url)s stopped early: %(error)s"
msgstr "nedlastingen av %(url)s stoppet for tidlig: %(error)s"

msgid "%(got)s of %(want)s arrived"
msgstr "%(got)s av %(want)s kom fram"

msgid "the disk holding %(path)s is full."
msgstr "disken som rommer %(path)s er full."

msgid "Free some space and run the command again; the download resumes."
msgstr "Frigjør litt plass og kjør kommandoen på nytt; nedlastingen gjenopptas."

msgid "Check that the directory exists and is writable."
msgstr "Kontroller at katalogen finnes og kan skrives til."

msgid "%(name)s did not match its published checksum and was discarded."
msgstr "%(name)s stemte ikke med den publiserte kontrollsummen sin og ble forkastet."

msgid "Nothing was unpacked. Run the command again: the archive arrived damaged, which a second download usually fixes."
msgstr "Ingenting ble pakket ut. Kjør kommandoen på nytt: arkivet kom skadet fram, noe en ny nedlasting som regel retter."

msgid "%(archive)s contains %(name)s, which would be written outside the install directory."
msgstr "%(archive)s inneholder %(name)s, som ville blitt skrevet utenfor installasjonskatalogen."

msgid "Do not install this archive; report it to the llama.cpp project."
msgstr "Ikke installer dette arkivet; meld det til llama.cpp-prosjektet."

msgid "%(name)s is not an archive LlamaFit knows how to unpack."
msgstr "%(name)s er ikke et arkiv LlamaFit vet hvordan skal pakkes ut."

msgid "%(name)s could not be unpacked: %(error)s"
msgstr "%(name)s kunne ikke pakkes ut: %(error)s"

msgid "Delete it and run the command again to download it afresh."
msgstr "Slett det og kjør kommandoen på nytt for å laste det ned på nytt."

msgid "the archive holds no %(name)s."
msgstr "arkivet inneholder ingen %(name)s."

msgid "Report this; the release layout has changed."
msgstr "Meld fra om dette; oppbygningen av utgivelsen er endret."

msgid "%(path)s was not installed by LlamaFit."
msgstr "%(path)s ble ikke installert av LlamaFit."

msgid "Pass --force to replace it, or --dir to install somewhere else. LlamaFit never overwrites an installation it did not create."
msgstr "Oppgi --force for å erstatte den, eller --dir for å installere et annet sted. LlamaFit overskriver aldri en installasjon den ikke har opprettet selv."

msgid "%(path)s has %(free)s free; this install needs %(needed)s."
msgstr "%(path)s har %(free)s ledig; denne installasjonen trenger %(needed)s."

msgid "Free some space, or pass --dir to install on another volume."
msgstr "Frigjør litt plass, eller oppgi --dir for å installere på et annet volum."

msgid "the %(backend)s libraries are not in the installed directory."
msgstr "%(backend)s-bibliotekene ligger ikke i den installerte katalogen."

msgid "no ggml backend libraries were installed; the build may be a static one."
msgstr "det ble ikke installert noen ggml-backend-biblioteker; bygget kan være statisk."

msgid "Your PATH could not be read, so it will not be changed."
msgstr "PATH-en din kunne ikke leses, så den blir ikke endret."

msgid "Add %(path)s to your user PATH (HKCU\\Environment)."
msgstr "Legg %(path)s til i bruker-PATH-en din (HKCU\\Environment)."

msgid "To undo: run `setx PATH \"%(previous)s\"`, or remove the entry in System > About > Advanced system settings > Environment Variables."
msgstr "Slik angrer du: kjør `setx PATH \"%(previous)s\"`, eller fjern oppføringen i System > Om > Avanserte systeminnstillinger > Miljøvariabler."

msgid "%(path)s is already on your PATH."
msgstr "%(path)s står allerede i PATH-en din."

msgid "Nothing to undo."
msgstr "Ingenting å angre."

msgid "Append a PATH line for %(path)s to %(file)s."
msgstr "Legg en PATH-linje for %(path)s til i %(file)s."

msgid "To undo: delete the two lines marked `%(mark)s` from %(file)s."
msgstr "Slik angrer du: slett de to linjene merket `%(mark)s` fra %(file)s."

msgid "your PATH could not be changed: %(error)s"
msgstr "PATH-en din kunne ikke endres: %(error)s"

msgid "To remove it later, delete %(path)s."
msgstr "For å fjerne den senere: slett %(path)s."

msgid "the most recent %(count)d llama.cpp releases hold no build."
msgstr "de %(count)d nyeste llama.cpp-utgivelsene inneholder ingen bygg."

msgid "Name one with `llamafit install llama.cpp --tag ...`."
msgstr "Nevn en med `llamafit install llama.cpp --tag ...`."

msgid "could not reach GitHub at %(url)s: %(error)s"
msgstr "klarte ikke å nå GitHub på %(url)s: %(error)s"

msgid "GitHub refused the request for %(url)s: the rate limit is exhausted."
msgstr "GitHub avviste forespørselen om %(url)s: fartsgrensen er brukt opp."

msgid "Wait for the limit to reset, or set GITHUB_TOKEN to a personal access token with no scopes."
msgstr "Vent til grensen nullstilles, eller sett GITHUB_TOKEN til et personlig tilgangstoken uten scopes."

msgid "GitHub has no release at %(url)s."
msgstr "GitHub har ingen utgivelse på %(url)s."

msgid "Check the tag with `llamafit install llama.cpp --tag ...`."
msgstr "Kontroller taggen med `llamafit install llama.cpp --tag ...`."

msgid "GitHub returned %(status)d for %(url)s."
msgstr "GitHub svarte %(status)d for %(url)s."

msgid "GitHub's answer for %(url)s was not JSON."
msgstr "Svaret fra GitHub for %(url)s var ikke JSON."

msgid "GitHub's answer did not describe a release."
msgstr "Svaret fra GitHub beskrev ingen utgivelse."

msgid "no llama-server answering"
msgstr "ingen llama-server svarer"

msgid "unexpected response: %(error)s"
msgstr "uventet svar: %(error)s"

msgid "%(model)s holds %(native)s tokens, fewer than the %(minimum)s asked for."
msgstr "%(model)s rommer %(native)s tokens, færre enn de %(minimum)s det ble bedt om."

msgid "No configuration of this model fits this machine."
msgstr "Ingen konfigurasjon av denne modellen får plass på denne maskinen."

msgid "Routed experts are held in system memory, and so are the always-on shared experts, which is what -ot ffn_.*_shexp=CPU does; attention and the KV cache stay on the card."
msgstr "De rutede ekspertene holdes i systemminnet, og det gjør de alltid aktive delte ekspertene også, som er det -ot ffn_.*_shexp=CPU gjør; attention og KV-cachen blir på kortet."

msgid "Routed experts are held in system memory; attention, the KV cache and the shared experts stay on the card."
msgstr "De rutede ekspertene holdes i systemminnet; attention, KV-cachen og de delte ekspertene blir på kortet."

msgid "%(layers)s layers are on the card and the rest run on the processor."
msgstr "%(layers)s lag ligger på kortet, og resten kjører på prosessoren."

msgid "Nothing runs on a graphics card: every weight is in system memory."
msgstr "Ingenting kjører på et grafikkort: hver vekt ligger i systemminnet."

msgid "%(gpus)s is here, but nothing could read how much of it is free, so this plan was made as if it were not. The real machine will be faster than these figures."
msgstr "%(gpus)s sitter her, men ingenting kunne lese hvor mye av det som er ledig, så denne planen ble laget som om det ikke fantes. Den virkelige maskinen blir raskere enn disse tallene."

msgid "Sized for %(context)s tokens rather than the %(requested)s asked for."
msgstr "Dimensjonert for %(context)s tokens i stedet for de %(requested)s det ble bedt om."

msgid "The KV cache is quantised to %(type)s to reach this context."
msgstr "KV-cachen er kvantisert til %(type)s for å nå denne konteksten."

msgid "Vision is off: the projector did not fit, on the card or in system memory."
msgstr "Bilde er slått av: projektoren fikk ikke plass, verken på kortet eller i systemminnet."

msgid "The vision projector is in system memory (--no-mmproj-offload), which costs nothing measurable for text and makes images slower."
msgstr "Bildeprojektoren ligger i systemminnet (--no-mmproj-offload), noe som ikke koster noe målbart for tekst og gjør bilder tregere."

msgid "%(threads)s threads, not the %(available)s this processor has: the efficiency cores are left out because generation measures slower with them, and what is left is the threads the performance cores provide."
msgstr "%(threads)s tråder, ikke de %(available)s denne prosessoren har: effektivitetskjernene utelates fordi genereringen måler tregere med dem, og det som er igjen er trådene ytelseskjernene gir."

msgid "Tight: %(vram)s of the graphics card is free and this needs %(needed)s, so another program can push it over. The context tier table is how a launch script recovers."
msgstr "Trangt: %(vram)s av grafikkortet er ledig, og dette trenger %(needed)s, så et annet program kan skyve det over kanten. Tabellen med konteksttrinn er slik et startskript henter seg inn igjen."

msgid "no %(capability)s capability, which %(use_case)s needs; ask for a different use case, or add it to the entry when the model really has it"
msgstr "ingen %(capability)s-egenskap, som %(use_case)s krever; be om et annet bruksområde, eller legg den til i oppføringen når modellen virkelig har den"

msgid "no %(capability)s capability; drop it from the request to see this model"
msgstr "ingen %(capability)s-egenskap; ta den ut av forespørselen for å se denne modellen"

msgid "%(size)s to download, over the %(limit)s this request allows"
msgstr "%(size)s å laste ned, over de %(limit)s denne forespørselen tillater"

msgid "unknown quantisation %(quant)s, so its cost in quality cannot be told"
msgstr "ukjent kvantisering %(quant)s, så kostnaden dens i kvalitet kan ikke oppgis"

msgid "nowhere to put it: no placement fits this machine at any context"
msgstr "ingen steder å legge den: ingen plassering får plass på denne maskinen ved noen kontekst"

msgid "holds %(fit)s tokens at most, under the %(minimum)s asked for; lower the minimum context or free memory to see it ranked"
msgstr "rommer høyst %(fit)s tokens, under de %(minimum)s det ble bedt om; senk minste kontekst eller frigjør minne for å se den rangert"

msgid "generates %(tps)s tokens per second, below the %(floor)s this request asks for; lower --min-tps or choose a smaller model or quantisation"
msgstr "genererer %(tps)s tokens per sekund, under de %(floor)s denne forespørselen ber om; senk --min-tps eller velg en mindre modell eller kvantisering"

msgid "generates %(tps)s tokens per second, below the %(floor)s a person reads at: a batch tool on this machine and not one to sit in front of; a smaller model or quantisation would keep up"
msgstr "genererer %(tps)s tokens per sekund, under de %(floor)s et menneske leser i: et batchverktøy på denne maskinen og ikke et å sitte foran; en mindre modell eller kvantisering ville holdt følge"

msgid "unknown use case %(use_case)s"
msgstr "ukjent bruksområde %(use_case)s"

msgid "Known use cases: %(known)s."
msgstr "Kjente bruksområder: %(known)s."

msgid "unknown score part %(part)s in the weights for %(use_case)s"
msgstr "ukjent poengdel %(part)s i vektene for %(use_case)s"

msgid "The parts are: %(parts)s."
msgstr "Delene er: %(parts)s."

msgid "the weights for %(use_case)s leave out %(part)s"
msgstr "vektene for %(use_case)s utelater %(part)s"

msgid "Overriding a use case means giving all four parts: %(parts)s."
msgstr "Å overstyre et bruksområde betyr å oppgi alle fire delene: %(parts)s."

msgid "the weight for %(part)s in %(use_case)s is below zero"
msgstr "vekten for %(part)s i %(use_case)s er under null"

msgid "A weight says how much a part counts; it cannot count less than none."
msgstr "En vekt sier hvor mye en del teller; den kan ikke telle mindre enn ingenting."

msgid "the weights for %(use_case)s add up to nothing"
msgstr "vektene for %(use_case)s summerer til ingenting"

msgid "At least one part has to count for something."
msgstr "Minst én del må telle for noe."

msgid "unknown preference %(prefer)s"
msgstr "ukjent preferanse %(prefer)s"

msgid "Preferences: %(known)s."
msgstr "Preferanser: %(known)s."

msgid "Install or repair the NVIDIA driver; nvidia-smi ships with it and must be on PATH."
msgstr "Installer eller reparer NVIDIA-driveren; nvidia-smi følger med den og må ligge i PATH."

msgid "Install ROCm (Linux) to expose AMD VRAM figures; without it the GPU is listed by name only."
msgstr "Installer ROCm (Linux) for å få fram AMDs VRAM-tall; uten ROCm listes GPU-en bare med navn."

msgid "PowerShell could not list video controllers; run from a normal user session."
msgstr "PowerShell klarte ikke å liste skjermkontrollerne; kjør fra en vanlig brukerøkt."

msgid "Install pciutils to list GPUs by name when no vendor tool is available."
msgstr "Installer pciutils for å liste GPU-er med navn når det ikke finnes noe verktøy fra leverandøren."

msgid "DDR type and speed were not readable; on Linux run once with sudo (dmidecode) or accept the measured bandwidth instead."
msgstr "DDR-type og hastighet var ikke til å lese; kjør én gang med sudo på Linux (dmidecode), eller nøy deg med den målte båndbredden i stedet."

msgid "py-cpuinfo failed; the CPU model and instruction sets are unknown."
msgstr "py-cpuinfo mislyktes; CPU-modellen og instruksjonssettene er ukjente."

msgid "psutil could not count the CPU cores; thread choice falls back to one core. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil klarte ikke å telle CPU-kjernene; valget av tråder faller tilbake til én kjerne. Installer psutil på nytt med `pip install --force-reinstall psutil`."

msgid "psutil could not read the memory totals; budgets cannot be computed until this works. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil klarte ikke å lese de samlede minnetallene; så lenge det ikke virker, kan ingen budsjetter regnes ut. Installer psutil på nytt med `pip install --force-reinstall psutil`."

msgid "Could not read performance-core count from sysctl."
msgstr "Antall ytelseskjerner var ikke til å lese ut av sysctl."

msgid "llama-server exists but did not report a version; the binary may be broken."
msgstr "llama-server finnes, men oppga ingen versjon; programfilen kan være ødelagt."

msgid "system_profiler failed; GPU information is unavailable."
msgstr "system_profiler mislyktes; det finnes ingen opplysninger om GPU-en."

msgid "Install the Vulkan tools (vulkan-tools on Linux, the vendor's Vulkan runtime on Windows) so an unsized card's memory can be read from its driver. This probe runs only when no vendor tool sized the card, so it is the last source there is."
msgstr "Installer Vulkan-verktøyene (vulkan-tools på Linux, leverandørens Vulkan-kjøretid på Windows), slik at minnet på et umålt kort kan leses fra driveren. Denne testen kjører bare når ingen verktøy fra leverandøren har målt kortet, så den er den siste kilden som finnes."

msgid "No vendor tool reported the GPU's memory size; record the size in a hardware profile so budgets can be computed for this machine."
msgstr "Ingen verktøy fra leverandøren oppga minnestørrelsen til GPU-en; skriv inn størrelsen i en maskinvareprofil, så budsjetter kan regnes ut for denne maskinen."

msgid "llama.cpp installed"
msgstr "llama.cpp installert"

msgid "build %(build)s at %(path)s, backends: %(backends)s"
msgstr "bygg %(build)s i %(path)s, backends: %(backends)s"

msgctxt "llama.cpp build"
msgid "unknown"
msgstr "ukjent"

msgid "llama.cpp not found"
msgstr "llama.cpp ble ikke funnet"

msgid "no llama-server binary was found"
msgstr "ingen llama-server-programfil ble funnet"

msgid "Run `llamafit install llama.cpp`, which picks the right build for this machine, checks it against its published checksum, and never touches an installation LlamaFit did not create."
msgstr "Kjør `llamafit install llama.cpp`, som velger riktig bygg for denne maskinen, kontrollerer det mot den publiserte kontrollsummen sin, og aldri rører en installasjon LlamaFit ikke har opprettet selv."

msgid "Memory size unknown"
msgstr "Minnestørrelsen er ukjent"

msgid "LlamaFit could not read this machine's memory totals, so it cannot work out what will fit."
msgstr "LlamaFit klarte ikke å lese de samlede minnetallene for denne maskinen, og kan derfor ikke regne ut hva som får plass."

msgid "%(gpu)s: no %(backend)s backend in llama.cpp"
msgstr "%(gpu)s: ingen %(backend)s-backend i llama.cpp"

msgid "llama.cpp was built with: %(backends)s"
msgstr "llama.cpp ble bygget med: %(backends)s"

msgctxt "backends"
msgid "unknown"
msgstr "ukjente"

msgid "Install a llama.cpp build with the %(backend)s or Vulkan backend to use %(gpu)s."
msgstr "Installer et bygg av llama.cpp med backend %(backend)s eller Vulkan for å bruke %(gpu)s."

msgid "%(gpu)s: VRAM size unknown"
msgstr "%(gpu)s: VRAM-størrelsen er ukjent"

msgid "the vendor tool that reports memory was not available"
msgstr "verktøyet fra leverandøren som oppgir minnet var ikke tilgjengelig"

msgid "%(gpus)s: planned around, not planned on"
msgstr "%(gpus)s: planlagt rundt, ikke planlagt på"

msgid "with no reading of how much of the card is free, every budget and every speed on this machine was computed as if there were no card: they are CPU-only figures, and the real machine will be faster."
msgstr "uten en avlesning av hvor mye av kortet som er ledig, ble hvert budsjett og hver hastighet på denne maskinen regnet ut som om det ikke fantes noe kort: det er tall for bare CPU, og den virkelige maskinen blir raskere."

msgid "Install the Vulkan tools so the size can be read from the driver, or record it in a hardware profile (`llamafit hardware path` says where those go) and pass --profile."
msgstr "Installer Vulkan-verktøyene slik at størrelsen kan leses fra driveren, eller noter den i en maskinvareprofil (`llamafit hardware path` sier hvor de skal ligge) og oppgi --profile."

msgid "No GPU detected"
msgstr "Ingen GPU funnet"

msgid "models will run on the CPU only"
msgstr "modeller vil bare kjøre på CPU-en"

msgid "If a GPU is present, check that its driver tools are installed."
msgstr "Hvis det finnes en GPU, kontroller at driververktøyene for den er installert."

msgid "RAM bandwidth assumed"
msgstr "RAM-båndbredden er antatt"

msgid "using %(gbps)s GB/s as a default"
msgstr "%(gbps)s GB/s brukes som standardverdi"

msgid "Install numpy (`pip install llamafit[fast]`) so LlamaFit can measure the RAM bandwidth."
msgstr "Installer numpy (`pip install llamafit[fast]`) slik at LlamaFit kan måle RAM-båndbredden."

msgid "Probe %(probe)s failed"
msgstr "Testen %(probe)s mislyktes"

msgctxt "probe error"
msgid "unknown error"
msgstr "ukjent feil"

msgid "llama-server running at %(url)s"
msgstr "llama-server kjører på %(url)s"

msgid "model %(model)s, context %(context)s"
msgstr "modell %(model)s, kontekst %(context)s"

msgctxt "model name"
msgid "unknown"
msgstr "ukjent"

msgid "Low disk space on %(path)s"
msgstr "Lite diskplass på %(path)s"

msgid "%(size)s free"
msgstr "%(size)s ledig"

msgid "Most useful models need 5 to 120 GB; free space or change the downloads directory."
msgstr "De fleste nyttige modeller trenger 5 til 120 GB; frigjør plass eller bytt katalog for nedlastinger."

msgid "%(model)s has no %(quant)s quantisation"
msgstr "%(model)s har ingen %(quant)s-kvantisering"

msgid "It publishes: %(names)s"
msgstr "Den publiserer: %(names)s"

msgid "licensed %(spdx)s, which this request does not allow"
msgstr "lisensiert %(spdx)s, som denne forespørselen ikke tillater"

msgid "System memory bandwidth was not measured; %(gbps)s GB/s assumed for %(arch)s."
msgstr "Båndbredden til systemminnet ble ikke målt; %(gbps)s GB/s antatt for %(arch)s."

msgid "%(gpu)s bandwidth is unknown; the %(backend)s fallback of %(gbps)s GB/s stands in."
msgstr "Båndbredden til %(gpu)s er ukjent; reserveverdien for %(backend)s på %(gbps)s GB/s står i stedet."

msgid "No graphics card compute figure: prompt processing is estimated on the CPU."
msgstr "Ingen tall for regnekraften til grafikkortet: promptbehandlingen estimeres på CPU-en."

msgid "%(gb)s GB of routed experts is read from system memory per token at %(eff)s of its %(raw)s GB/s, because each token selects a different handful of experts and the read is a scatter of small blocks rather than a stream."
msgstr "%(gb)s GB rutede eksperter leses fra systemminnet per token ved %(eff)s av dets %(raw)s GB/s, fordi hvert token velger en ny håndfull eksperter og lesingen er en spredning av små blokker i stedet for en strøm."

msgid "%(gb)s GB of contiguous weights is read from system memory per token at %(eff)s of its %(raw)s GB/s."
msgstr "%(gb)s GB sammenhengende vekter leses fra systemminnet per token ved %(eff)s av dets %(raw)s GB/s."

msgid "No active parameter count was supplied; it was inferred from the weight bytes."
msgstr "Det ble ikke oppgitt noe antall aktive parametere; det ble utledet av bytene i vektene."

msgid "%(pct)s percent of the layers sit in system memory, so that share of the prompt arithmetic is charged to the CPU at %(tflops)s TFLOP/s rather than to the card. Both rates come from one small dense model on one machine."
msgstr "%(pct)s prosent av lagene ligger i systemminnet, så den andelen av promptregningen føres på CPU-en ved %(tflops)s TFLOP/s i stedet for på kortet. Begge ratene kommer fra én liten tett modell på én maskin."

msgid "%(gb)s GB of the expert set is streamed across the link once per micro-batch at %(gbps)s GB/s. That rate was fitted on the one model whose expert set does not fit in system memory, so part of its read comes off the disk; an expert set that stays in the page cache streams about three times faster, and for one of those this term is that much too slow."
msgstr "%(gb)s GB av ekspertsettet strømmes over forbindelsen én gang per mikrobatch ved %(gbps)s GB/s. Den raten ble tilpasset på den ene modellen der ekspertsettet ikke får plass i systemminnet, så en del av lesingen kommer fra disken; et ekspertsett som blir værende i sidecachen strømmer omtrent tre ganger raskere, og for et slikt er dette leddet nøyaktig så mye for tregt."

msgid "%(gb)s GB of the expert set is read out of system memory once per micro-batch at %(gbps)s GB/s, because there is no card to stream it to."
msgstr "%(gb)s GB av ekspertsettet leses ut av systemminnet én gang per mikrobatch ved %(gbps)s GB/s, fordi det ikke finnes noe kort å strømme det til."

msgid "No placement of this model on this machine could run it."
msgstr "Ingen plassering av denne modellen på denne maskinen kunne kjøre den."

msgid "Generation is a benchmark of this configuration, not a prediction."
msgstr "Genereringen er en måling av denne konfigurasjonen, ikke en spådom."

msgid "Generation is the formula corrected by %(factor)s, from a benchmark of %(profile)s on this machine taken on %(date)s."
msgstr "Genereringen er formelen korrigert med %(factor)s, fra en måling av %(profile)s på denne maskinen tatt %(date)s."

msgid "Prompt processing is a benchmark of this configuration."
msgstr "Promptbehandlingen er en måling av denne konfigurasjonen."

msgid "Prompt processing is the formula corrected by %(factor)s from a benchmark."
msgstr "Promptbehandlingen er formelen korrigert med %(factor)s fra en måling."

msgid "That benchmark's command line does not record how many layers went to the card, so the correction assumes it ran at this placement."
msgstr "Kommandolinjen til den målingen noterer ikke hvor mange lag som gikk til kortet, så korreksjonen går ut fra at den kjørte ved denne plasseringen."

msgid "This figure assumes nothing pages: a placement this tight often does, silently."
msgstr "Dette tallet går ut fra at ingenting veksler: en plassering så trang som denne gjør ofte det, i stillhet."

