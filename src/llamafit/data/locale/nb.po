msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "Hugging Face svarte %(status)d da fillisten for %(repo)s ble hentet."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Klarte ikke å lese fillisten for %(repo)s fra Hugging Face."

msgid "Check your network connection and try again."
msgstr "Kontroller nettverksforbindelsen og prøv igjen."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "Svaret fra Hugging Face for %(repo)s inneholdt ingen filliste."

msgid "Check that the repository id is correct and public."
msgstr "Kontroller at repositoriets ID er riktig, og at repositoriet er offentlig."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "katalogen har %(count)d problem"
msgstr[1] "katalogen har %(count)d problemer"

msgid "Run `llamafit catalog validate` for details."
msgstr "Kjør `llamafit catalog validate` for detaljene."

msgid "could not write %(path)s: %(error)s"
msgstr "klarte ikke å skrive %(path)s: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "Kontroller at katalogen er skrivbar og har plass igjen."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "%(path)s har %(count)d problem og kan ikke oppdateres"
msgstr[1] "%(path)s har %(count)d problemer og kan ikke oppdateres"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "Kjør `llamafit catalog validate` og rett filen først."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "%(path)s kunne ikke leses i sin helhet, så å oppdatere bare %(model)s ville forkaste opplysninger filen har om modeller denne kjøringen ikke rører: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "Kjør `llamafit catalog refresh` uten --model for å bygge opp hele filen på nytt."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "Finn, dimensjoner, installer og verifiser LLM-er med åpne vekter for llama.cpp på din egen maskin."

msgid "Print machine-readable JSON instead of tables."
msgstr "Skriver ut maskinlesbar JSON i stedet for tabeller."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "Skriver detaljene til llamafit.log i loggkatalogen og viser sporingene."

msgid "Disable colours."
msgstr "Slår av fargene."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "Snakker dette språket, for eksempel pt_PT. Et språk LlamaFit ikke har, faller tilbake til engelsk, og da sies det hvilke språk som finnes."

msgid "Print the version and exit."
msgstr "Skriver ut versjonen og avslutter."

msgid "Unexpected error: %(error)s"
msgstr "Uventet feil: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "Kjør på nytt med --verbose for hele sporingen."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "Vedlikeholder katalogen: validerer filene, oppdaterer de foranderlige feltene."

msgid "Keep only this use case."
msgstr "Beholder bare dette bruksområdet."

msgid "Keep only models with this capability (repeatable)."
msgstr "Beholder bare modeller med denne egenskapen (kan gjentas)."

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Beholder bare disse lisensbetegnelsene (kan gjentas)."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "Validerer bare denne filen i stedet for den medfølgende katalogen og de egne tilpasningene."

msgid "Did you mean: %(ids)s?"
msgstr "Mente du: %(ids)s?"

msgid "Run `llamafit list` to see every model id."
msgstr "Kjør `llamafit list` for å se alle modell-ID-er."

msgid "no model named %(id)s in the catalog"
msgstr "ingen modell med navnet %(id)s i katalogen"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "Fant %(count)d problem i katalogen; kjør `llamafit catalog validate` for detaljene."
msgstr[1] "Fant %(count)d problemer i katalogen; kjør `llamafit catalog validate` for detaljene."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "Ingen modeller passet. Prøv et videre --use-case, --capability, --license, --vendor eller --search."

msgid "invalid --use-case %(value)s"
msgstr "ugyldig --use-case: %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "Gyldige bruksområder: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "Gyldige egenskaper: %(values)s"

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"Lister modellkatalogen, avgrenset av filtrene som er oppgitt.\n"
"\n"
"Tabellen viser høyst tre egenskaper per modell, pluss en markering +N for resten, og er sortert etter kolonnen Kvalitet som vises; info eller --json har alle egenskapene."

msgid "Keep only this vendor, case-insensitive."
msgstr "Beholder bare denne leverandøren, uten å skille mellom store og små bokstaver."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "Treff på en del av ID, navn, leverandør eller familie, uten å skille mellom store og små bokstaver."

msgid "Show at most this many."
msgstr "Viser høyst så mange."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "Kortform for llamafit list --search TEKST."

msgid "Text to match against id, name, vendor or family."
msgstr "Tekst som skal matches mot ID, navn, leverandør eller familie."

msgid "A catalog model id."
msgstr "En modell-ID fra katalogen."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "Validerer katalogens YAML-filer mot skjemaet og skriver ut én linje per problem."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "%(count)d fil kontrollert, ingen problemer funnet."
msgstr[1] "%(count)d filer kontrollert, ingen problemer funnet."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "Oppdaterer katalogens filnavn, størrelser, kontrollsummer og GGUF-fakta fra Hugging Face."

msgid "Refresh only this model id."
msgstr "Oppdaterer bare denne modell-ID-en."

msgid "Compute the refresh but write nothing."
msgstr "Regner ut oppdateringen, men skriver ingenting."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "Avslutter med 1 hvis noe ville endret seg; endrer ingenting, for en planlagt CI-jobb."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: advarsel: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "advarsel: %(warning)s (%(count)d modell: %(models)s)"
msgstr[1] "advarsel: %(warning)s (%(count)d modeller: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: feil: %(error)s"

msgid "Hint: %(hint)s"
msgstr "Tips: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "oppdateringen trenger nettverkstilgang til Hugging Face; kontroller forbindelsen din og at repositoriets ID er riktig."

msgid "No changes."
msgstr "Ingen endringer."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "Skriver ut den rå katalogoppføringen for én modell, som JSON til vanlig eller som YAML med --yaml."

msgid "Print YAML instead of JSON."
msgstr "Skriver ut YAML i stedet for JSON."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "Forklarer hva som ble funnet, hva som gikk galt og hva som ville gitt mer."

