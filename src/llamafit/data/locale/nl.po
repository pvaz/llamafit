msgstr "rocm-smi gaf geen kaarten terug"

msgid "system_profiler returned no displays"
msgstr "system_profiler gaf geen beeldschermen terug"

msgid "WMI returned no video controllers"
msgstr "WMI gaf geen videocontrollers terug"

msgid "lspci found no display controllers"
msgstr "lspci vond geen videocontrollers"

msgid "vulkaninfo reported no discrete device with a memory heap"
msgstr "vulkaninfo meldde geen discreet apparaat met een geheugenheap"

msgid "no populated memory modules"
msgstr "geen bezette geheugenmodules"

msgid "no SPMemoryDataType"
msgstr "geen SPMemoryDataType"

msgid "%(program)s: timed out after %(seconds)s second"
msgid_plural "%(program)s: timed out after %(seconds)s seconds"
msgstr[0] "%(program)s: tijd verstreken na %(seconds)s seconde"
msgstr[1] "%(program)s: tijd verstreken na %(seconds)s seconden"

msgid "empty command"
msgstr "lege opdracht"

msgid "%(program)s: %(error)s"
msgstr "%(program)s: %(error)s"

msgid "%(program)s: not found"
msgstr "%(program)s: niet gevonden"

msgid "exit code %(code)d: %(detail)s"
msgstr "afsluitcode %(code)d: %(detail)s"

msgid "no hardware profile file at %(path)s"
msgstr "geen hardwareprofielbestand op %(path)s"

msgid "Run `llamafit hardware list` to see the profiles LlamaFit has."
msgstr "Voer `llamafit hardware list` uit om de profielen te zien die LlamaFit heeft."

msgid "%(path)s is not a valid hardware profile: %(details)s"
msgstr "%(path)s is geen geldig hardwareprofiel: %(details)s"

msgid "Run `llamafit hardware validate FILE` for the whole list."
msgstr "Voer `llamafit hardware validate BESTAND` uit voor de hele lijst."

msgid "no hardware profile named %(name)s"
msgstr "geen hardwareprofiel met de naam %(name)s"

msgid "Profiles LlamaFit has: %(names)s"
msgstr "Profielen die LlamaFit heeft: %(names)s"

msgid "Run `llamafit hardware path` to see where your own profiles go."
msgstr "Voer `llamafit hardware path` uit om te zien waar uw eigen profielen komen te staan."

msgid "this machine has no graphics card, so there is no VRAM to override"
msgstr "deze machine heeft geen grafische kaart, dus er is geen VRAM om te overschrijven"

msgid "Describe the whole machine in a hardware profile and pass --profile."
msgstr "Beschrijf de hele machine in een hardwareprofiel en geef --profile op."

msgid "this machine has one memory pool shared with the graphics card"
msgstr "deze machine heeft één geheugenpool die met de grafische kaart wordt gedeeld"

msgid "Use --ram to resize the pool; --memory would change only half of it."
msgstr "Gebruik --ram om de pool te herschalen; --memory zou maar de helft ervan veranderen."

msgid "%(option)s needs a value above zero"
msgstr "%(option)s heeft een waarde boven nul nodig"

msgid "no build number in the version output: %(text)s"
msgstr "geen buildnummer in de versie-uitvoer: %(text)s"

msgid "llama.cpp not found: no llama-server on PATH, in LLAMA_CPP_PATH or in the usual directories"
msgstr "llama.cpp niet gevonden: geen llama-server in PATH, in LLAMA_CPP_PATH of in de gebruikelijke mappen"

msgid "no ggml backend libraries found next to llama-server; the build may be static"
msgstr "geen ggml-backendbibliotheken naast llama-server gevonden; de build is mogelijk statisch"

msgid "%(path)s is a file, not a directory."
msgstr "%(path)s is een bestand, geen map."

msgid "%(path)s cannot be read: %(error)s"
msgstr "%(path)s kan niet worden gelezen: %(error)s"

msgid "%(path)s has a marker file that cannot be read."
msgstr "%(path)s heeft een markeringsbestand dat niet kan worden gelezen."

msgid "%(path)s already holds %(count)d file that LlamaFit did not install."
msgid_plural "%(path)s already holds %(count)d files that LlamaFit did not install."
msgstr[0] "%(path)s bevat al %(count)d bestand dat LlamaFit niet heeft geïnstalleerd."
msgstr[1] "%(path)s bevat al %(count)d bestanden die LlamaFit niet heeft geïnstalleerd."

msgid "%(name)s has no published checksum, so it cannot be verified."
msgstr "%(name)s heeft geen gepubliceerde controlesom en kan dus niet worden geverifieerd."

msgid "Pass --allow-unverified to install it anyway, knowing the archive is unchecked."
msgstr "Geef --allow-unverified op om het toch te installeren, in de wetenschap dat het archief ongecontroleerd is."

msgid "could not download %(url)s: %(error)s"
msgstr "kon %(url)s niet downloaden: %(error)s"

msgid "the connection was closed"
msgstr "de verbinding is gesloten"

msgid "Run the command again; it continues from where it stopped."
msgstr "Voer de opdracht opnieuw uit; hij gaat verder waar hij is gestopt."

msgid "the download of %(url)s stopped early: %(error)s"
msgstr "de download van %(url)s is vroegtijdig gestopt: %(error)s"

msgid "%(got)s of %(want)s arrived"
msgstr "%(got)s van %(want)s aangekomen"

msgid "the disk holding %(path)s is full."
msgstr "de schijf waarop %(path)s staat is vol."

msgid "Free some space and run the command again; the download resumes."
msgstr "Maak wat ruimte vrij en voer de opdracht opnieuw uit; de download wordt hervat."

msgid "Check that the directory exists and is writable."
msgstr "Controleer of de map bestaat en beschrijfbaar is."

msgid "%(name)s did not match its published checksum and was discarded."
msgstr "%(name)s kwam niet overeen met zijn gepubliceerde controlesom en is weggegooid."

msgid "Nothing was unpacked. Run the command again: the archive arrived damaged, which a second download usually fixes."
msgstr "Er is niets uitgepakt. Voer de opdracht opnieuw uit: het archief kwam beschadigd aan, wat een tweede download meestal verhelpt."

msgid "%(archive)s contains %(name)s, which would be written outside the install directory."
msgstr "%(archive)s bevat %(name)s, dat buiten de installatiemap zou worden geschreven."

msgid "Do not install this archive; report it to the llama.cpp project."
msgstr "Installeer dit archief niet; meld het bij het llama.cpp-project."

msgid "%(name)s is not an archive LlamaFit knows how to unpack."
msgstr "%(name)s is geen archief dat LlamaFit weet uit te pakken."

msgid "%(name)s could not be unpacked: %(error)s"
msgstr "%(name)s kon niet worden uitgepakt: %(error)s"

msgid "Delete it and run the command again to download it afresh."
msgstr "Verwijder het en voer de opdracht opnieuw uit om het opnieuw te downloaden."

msgid "the archive holds no %(name)s."
msgstr "het archief bevat geen %(name)s."

msgid "Report this; the release layout has changed."
msgstr "Meld dit; de indeling van de release is veranderd."

msgid "%(path)s was not installed by LlamaFit."
msgstr "%(path)s is niet door LlamaFit geïnstalleerd."

msgid "Pass --force to replace it, or --dir to install somewhere else. LlamaFit never overwrites an installation it did not create."
msgstr "Geef --force op om het te vervangen, of --dir om ergens anders te installeren. LlamaFit overschrijft nooit een installatie die het niet zelf heeft aangemaakt."

msgid "%(path)s has %(free)s free; this install needs %(needed)s."
msgstr "%(path)s heeft %(free)s vrij; deze installatie heeft %(needed)s nodig."

msgid "Free some space, or pass --dir to install on another volume."
msgstr "Maak wat ruimte vrij, of geef --dir op om op een ander volume te installeren."

msgid "the %(backend)s libraries are not in the installed directory."
msgstr "de %(backend)s-bibliotheken staan niet in de geïnstalleerde map."

msgid "no ggml backend libraries were installed; the build may be a static one."
msgstr "er zijn geen ggml-backendbibliotheken geïnstalleerd; de build is mogelijk statisch."

msgid "Your PATH could not be read, so it will not be changed."
msgstr "Uw PATH kon niet worden gelezen en wordt dus niet gewijzigd."

msgid "Add %(path)s to your user PATH (HKCU\\Environment)."
msgstr "%(path)s toevoegen aan uw gebruikers-PATH (HKCU\\Environment)."

msgid "To undo: run `setx PATH \"%(previous)s\"`, or remove the entry in System > About > Advanced system settings > Environment Variables."
msgstr "Ongedaan maken: voer `setx PATH \"%(previous)s\"` uit, of verwijder de vermelding in Systeem > Info > Geavanceerde systeeminstellingen > Omgevingsvariabelen."

msgid "%(path)s is already on your PATH."
msgstr "%(path)s staat al in uw PATH."

msgid "Nothing to undo."
msgstr "Niets ongedaan te maken."

msgid "Append a PATH line for %(path)s to %(file)s."
msgstr "Een PATH-regel voor %(path)s aan %(file)s toevoegen."

msgid "To undo: delete the two lines marked `%(mark)s` from %(file)s."
msgstr "Ongedaan maken: verwijder de twee regels met de markering `%(mark)s` uit %(file)s."

msgid "your PATH could not be changed: %(error)s"
msgstr "uw PATH kon niet worden gewijzigd: %(error)s"

msgid "To remove it later, delete %(path)s."
msgstr "Om het later te verwijderen: wis %(path)s."

msgid "the most recent %(count)d llama.cpp releases hold no build."
msgstr "de %(count)d nieuwste llama.cpp-releases bevatten geen build."

msgid "Name one with `llamafit install llama.cpp --tag ...`."
msgstr "Noem er een met `llamafit install llama.cpp --tag ...`."

msgid "could not reach GitHub at %(url)s: %(error)s"
msgstr "kon GitHub niet bereiken op %(url)s: %(error)s"

msgid "GitHub refused the request for %(url)s: the rate limit is exhausted."
msgstr "GitHub weigerde het verzoek voor %(url)s: de snelheidslimiet is uitgeput."

msgid "Wait for the limit to reset, or set GITHUB_TOKEN to a personal access token with no scopes."
msgstr "Wacht tot de limiet wordt gereset, of zet GITHUB_TOKEN op een persoonlijk toegangstoken zonder scopes."

msgid "GitHub has no release at %(url)s."
msgstr "GitHub heeft geen release op %(url)s."

msgid "Check the tag with `llamafit install llama.cpp --tag ...`."
msgstr "Controleer de tag met `llamafit install llama.cpp --tag ...`."

msgid "GitHub returned %(status)d for %(url)s."
msgstr "GitHub gaf %(status)d terug voor %(url)s."

msgid "GitHub's answer for %(url)s was not JSON."
msgstr "Het antwoord van GitHub voor %(url)s was geen JSON."

msgid "GitHub's answer did not describe a release."
msgstr "Het antwoord van GitHub beschreef geen release."

msgid "no llama-server answering"
msgstr "geen llama-server die antwoordt"

msgid "unexpected response: %(error)s"
msgstr "onverwacht antwoord: %(error)s"

msgid "%(model)s holds %(native)s tokens, fewer than the %(minimum)s asked for."
msgstr "%(model)s bevat %(native)s tokens, minder dan de %(minimum)s die zijn gevraagd."

msgid "No configuration of this model fits this machine."
msgstr "Geen enkele configuratie van dit model past op deze machine."

msgid "Routed experts are held in system memory, and so are the always-on shared experts, which is what -ot ffn_.*_shexp=CPU does; attention and the KV cache stay on the card."
msgstr "De gerouteerde experts staan in het systeemgeheugen, en de altijd actieve gedeelde experts ook, wat is wat -ot ffn_.*_shexp=CPU doet; de attentie en de KV-cache blijven op de kaart."

msgid "Routed experts are held in system memory; attention, the KV cache and the shared experts stay on the card."
msgstr "De gerouteerde experts staan in het systeemgeheugen; de attentie, de KV-cache en de gedeelde experts blijven op de kaart."

msgid "%(layers)s layers are on the card and the rest run on the processor."
msgstr "%(layers)s lagen staan op de kaart en de rest draait op de processor."

msgid "Nothing runs on a graphics card: every weight is in system memory."
msgstr "Er draait niets op een grafische kaart: elk gewicht staat in het systeemgeheugen."

msgid "%(gpus)s is here, but nothing could read how much of it is free, so this plan was made as if it were not. The real machine will be faster than these figures."
msgstr "%(gpus)s zit hier, maar niets kon lezen hoeveel ervan vrij is, dus dit plan is gemaakt alsof die er niet was. De echte machine zal sneller zijn dan deze cijfers."

msgid "Sized for %(context)s tokens rather than the %(requested)s asked for."
msgstr "Gedimensioneerd voor %(context)s tokens in plaats van de gevraagde %(requested)s."

msgid "The KV cache is quantised to %(type)s to reach this context."
msgstr "De KV-cache is gekwantiseerd naar %(type)s om deze context te halen."

msgid "Vision is off: the projector did not fit, on the card or in system memory."
msgstr "Beeld staat uit: de projector paste niet, niet op de kaart en niet in het systeemgeheugen."

msgid "The vision projector is in system memory (--no-mmproj-offload), which costs nothing measurable for text and makes images slower."
msgstr "De beeldprojector staat in het systeemgeheugen (--no-mmproj-offload), wat voor tekst niets meetbaars kost en beelden trager maakt."

msgid "%(threads)s threads, not the %(available)s this processor has: the efficiency cores are left out because generation measures slower with them, and what is left is the threads the performance cores provide."
msgstr "%(threads)s threads, niet de %(available)s die deze processor heeft: de efficiëntiekernen worden weggelaten omdat de generatie er trager mee meet, en wat overblijft zijn de threads die de performancekernen leveren."

msgid "Tight: %(vram)s of the graphics card is free and this needs %(needed)s, so another program can push it over. The context tier table is how a launch script recovers."
msgstr "Krap: %(vram)s van de grafische kaart is vrij en dit heeft %(needed)s nodig, dus een ander programma kan het over de rand duwen. De tabel met contexttreden is hoe een startscript zich herstelt."

msgid "no %(capability)s capability, which %(use_case)s needs; ask for a different use case, or add it to the entry when the model really has it"
msgstr "geen mogelijkheid %(capability)s, die %(use_case)s nodig heeft; vraag een andere toepassing, of voeg de mogelijkheid aan de vermelding toe wanneer het model haar werkelijk heeft"

msgid "no %(capability)s capability; drop it from the request to see this model"
msgstr "geen mogelijkheid %(capability)s; laat die uit het verzoek weg om dit model te zien"

msgid "%(size)s to download, over the %(limit)s this request allows"
msgstr "%(size)s om te downloaden, meer dan de %(limit)s die dit verzoek toestaat"

msgid "unknown quantisation %(quant)s, so its cost in quality cannot be told"
msgstr "onbekende kwantisatie %(quant)s, dus de kosten ervan in kwaliteit zijn niet te zeggen"

msgid "nowhere to put it: no placement fits this machine at any context"
msgstr "nergens om het te plaatsen: geen enkele plaatsing past bij welke context dan ook op deze machine"

msgid "holds %(fit)s tokens at most, under the %(minimum)s asked for; lower the minimum context or free memory to see it ranked"
msgstr "bevat hoogstens %(fit)s tokens, onder de %(minimum)s die zijn gevraagd; verlaag de minimumcontext of maak geheugen vrij om het gerangschikt te zien"

msgid "generates %(tps)s tokens per second, below the %(floor)s this request asks for; lower --min-tps or choose a smaller model or quantisation"
msgstr "genereert %(tps)s tokens per seconde, onder de %(floor)s die dit verzoek vraagt; verlaag --min-tps of kies een kleiner model of een kleinere kwantisatie"

msgid "generates %(tps)s tokens per second, below the %(floor)s a person reads at: a batch tool on this machine and not one to sit in front of; a smaller model or quantisation would keep up"
msgstr "genereert %(tps)s tokens per seconde, onder de %(floor)s waarmee een mens leest: op deze machine een gereedschap voor batchwerk en niet om voor te gaan zitten; een kleiner model of een kleinere kwantisatie zou bijblijven"

msgid "unknown use case %(use_case)s"
msgstr "onbekende toepassing %(use_case)s"

msgid "Known use cases: %(known)s."
msgstr "Bekende toepassingen: %(known)s."

msgid "unknown score part %(part)s in the weights for %(use_case)s"
msgstr "onbekend scoredeel %(part)s in de gewichten voor %(use_case)s"

msgid "The parts are: %(parts)s."
msgstr "De delen zijn: %(parts)s."

msgid "the weights for %(use_case)s leave out %(part)s"
msgstr "de gewichten voor %(use_case)s laten %(part)s weg"

msgid "Overriding a use case means giving all four parts: %(parts)s."
msgstr "Een toepassing overschrijven betekent alle vier de delen geven: %(parts)s."

msgid "the weight for %(part)s in %(use_case)s is below zero"
msgstr "het gewicht voor %(part)s in %(use_case)s ligt onder nul"

msgid "A weight says how much a part counts; it cannot count less than none."
msgstr "Een gewicht zegt hoe zwaar een deel telt; het kan niet minder tellen dan niets."

msgid "the weights for %(use_case)s add up to nothing"
msgstr "de gewichten voor %(use_case)s tellen op tot niets"

msgid "At least one part has to count for something."
msgstr "Ten minste één deel moet ergens voor tellen."

msgid "unknown preference %(prefer)s"
msgstr "onbekende voorkeur %(prefer)s"

msgid "Preferences: %(known)s."
msgstr "Voorkeuren: %(known)s."

msgid "Install or repair the NVIDIA driver; nvidia-smi ships with it and must be on PATH."
msgstr "Installeer of herstel het NVIDIA-stuurprogramma; nvidia-smi wordt daarmee meegeleverd en moet in PATH staan."

msgid "Install ROCm (Linux) to expose AMD VRAM figures; without it the GPU is listed by name only."
msgstr "Installeer ROCm (Linux) om de VRAM-cijfers van AMD zichtbaar te maken; zonder ROCm wordt de GPU alleen op naam vermeld."

msgid "PowerShell could not list video controllers; run from a normal user session."
msgstr "PowerShell kon de videocontrollers niet opsommen; voer dit uit vanuit een gewone gebruikerssessie."

msgid "Install pciutils to list GPUs by name when no vendor tool is available."
msgstr "Installeer pciutils om GPU's op naam te tonen wanneer er geen hulpprogramma van de leverancier is."

msgid "DDR type and speed were not readable; on Linux run once with sudo (dmidecode) or accept the measured bandwidth instead."
msgstr "Het DDR-type en de snelheid waren niet te lezen; voer dit op Linux één keer met sudo uit (dmidecode) of neem in plaats daarvan genoegen met de gemeten bandbreedte."

msgid "py-cpuinfo failed; the CPU model and instruction sets are unknown."
msgstr "py-cpuinfo is mislukt; het CPU-model en de instructiesets zijn onbekend."

msgid "psutil could not count the CPU cores; thread choice falls back to one core. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil kon de CPU-kernen niet tellen; de keuze van threads valt terug op één kern. Installeer psutil opnieuw met `pip install --force-reinstall psutil`."

msgid "psutil could not read the memory totals; budgets cannot be computed until this works. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil kon de geheugentotalen niet lezen; zolang dit niet werkt, zijn er geen budgetten te berekenen. Installeer psutil opnieuw met `pip install --force-reinstall psutil`."

msgid "Could not read performance-core count from sysctl."
msgstr "Het aantal performancekernen was niet uit sysctl te lezen."

msgid "llama-server exists but did not report a version; the binary may be broken."
msgstr "llama-server bestaat maar meldde geen versie; het programma is mogelijk beschadigd."

msgid "system_profiler failed; GPU information is unavailable."
msgstr "system_profiler is mislukt; er is geen informatie over de GPU."

msgid "Install the Vulkan tools (vulkan-tools on Linux, the vendor's Vulkan runtime on Windows) so an unsized card's memory can be read from its driver. This probe runs only when no vendor tool sized the card, so it is the last source there is."
msgstr "Installeer de Vulkan-hulpprogramma's (vulkan-tools op Linux, de Vulkan-runtime van de leverancier op Windows) zodat het geheugen van een niet-gemeten kaart uit het stuurprogramma kan worden gelezen. Deze test draait alleen wanneer geen enkel hulpprogramma van de leverancier de kaart heeft gemeten, dus het is de laatste bron die er is."

msgid "No vendor tool reported the GPU's memory size; record the size in a hardware profile so budgets can be computed for this machine."
msgstr "Geen enkel hulpprogramma van de leverancier meldde de geheugengrootte van de GPU; leg de grootte vast in een hardwareprofiel, zodat er voor deze machine budgetten kunnen worden berekend."

msgid "llama.cpp installed"
msgstr "llama.cpp geïnstalleerd"

msgid "build %(build)s at %(path)s, backends: %(backends)s"
msgstr "build %(build)s in %(path)s, backends: %(backends)s"

msgctxt "llama.cpp build"
msgid "unknown"
msgstr "onbekend"

msgid "llama.cpp not found"
msgstr "llama.cpp niet gevonden"

msgid "no llama-server binary was found"
msgstr "er is geen llama-server-programma gevonden"

msgid "Run `llamafit install llama.cpp`, which picks the right build for this machine, checks it against its published checksum, and never touches an installation LlamaFit did not create."
msgstr "Voer `llamafit install llama.cpp` uit, dat de juiste build voor deze machine kiest, hem controleert tegen zijn gepubliceerde controlesom, en nooit een installatie aanraakt die LlamaFit niet zelf heeft aangemaakt."

msgid "Memory size unknown"
msgstr "Geheugengrootte onbekend"

msgid "LlamaFit could not read this machine's memory totals, so it cannot work out what will fit."
msgstr "LlamaFit kon de geheugentotalen van deze machine niet lezen en kan daarom niet uitrekenen wat erin past."

msgid "%(gpu)s: no %(backend)s backend in llama.cpp"
msgstr "%(gpu)s: geen %(backend)s-backend in llama.cpp"

msgid "llama.cpp was built with: %(backends)s"
msgstr "llama.cpp is gebouwd met: %(backends)s"

msgctxt "backends"
msgid "unknown"
msgstr "onbekend"

msgid "Install a llama.cpp build with the %(backend)s or Vulkan backend to use %(gpu)s."
msgstr "Installeer een build van llama.cpp met de backend %(backend)s of Vulkan om %(gpu)s te gebruiken."

msgid "%(gpu)s: VRAM size unknown"
msgstr "%(gpu)s: VRAM-grootte onbekend"

msgid "the vendor tool that reports memory was not available"
msgstr "het hulpprogramma van de leverancier dat het geheugen meldt was niet beschikbaar"

msgid "%(gpus)s: planned around, not planned on"
msgstr "%(gpus)s: omheen gepland, niet op gepland"

msgid "with no reading of how much of the card is free, every budget and every speed on this machine was computed as if there were no card: they are CPU-only figures, and the real machine will be faster."
msgstr "zonder een meting van hoeveel van de kaart vrij is, is elk budget en elke snelheid op deze machine berekend alsof er geen kaart was: het zijn cijfers voor alleen de CPU, en de echte machine zal sneller zijn."

msgid "Install the Vulkan tools so the size can be read from the driver, or record it in a hardware profile (`llamafit hardware path` says where those go) and pass --profile."
msgstr "Installeer de Vulkan-hulpprogramma's zodat de grootte uit het stuurprogramma kan worden gelezen, of leg haar vast in een hardwareprofiel (`llamafit hardware path` zegt waar die komen te staan) en geef --profile op."

msgid "No GPU detected"
msgstr "Geen GPU gevonden"

msgid "models will run on the CPU only"
msgstr "modellen draaien alleen op de CPU"

msgid "If a GPU is present, check that its driver tools are installed."
msgstr "Als er een GPU aanwezig is, controleer dan of de hulpprogramma's van het stuurprogramma zijn geïnstalleerd."

msgid "RAM bandwidth assumed"
msgstr "RAM-bandbreedte aangenomen"

msgid "using %(gbps)s GB/s as a default"
msgstr "%(gbps)s GB/s wordt als standaardwaarde gebruikt"

msgid "Install numpy (`pip install llamafit[fast]`) so LlamaFit can measure the RAM bandwidth."
msgstr "Installeer numpy (`pip install llamafit[fast]`) zodat LlamaFit de RAM-bandbreedte kan meten."

msgid "Probe %(probe)s failed"
msgstr "Test %(probe)s is mislukt"

msgctxt "probe error"
msgid "unknown error"
msgstr "onbekende fout"

msgid "llama-server running at %(url)s"
msgstr "llama-server draait op %(url)s"

msgid "model %(model)s, context %(context)s"
msgstr "model %(model)s, context %(context)s"

msgctxt "model name"
msgid "unknown"
msgstr "onbekend"

msgid "Low disk space on %(path)s"
msgstr "Weinig schijfruimte op %(path)s"

msgid "%(size)s free"
msgstr "%(size)s vrij"

msgid "Most useful models need 5 to 120 GB; free space or change the downloads directory."
msgstr "De meeste bruikbare modellen hebben 5 tot 120 GB nodig; maak ruimte vrij of kies een andere downloadmap."

msgid "%(model)s has no %(quant)s quantisation"
msgstr "%(model)s heeft geen kwantisatie %(quant)s"

msgid "It publishes: %(names)s"
msgstr "Het publiceert: %(names)s"

msgid "licensed %(spdx)s, which this request does not allow"
msgstr "gelicentieerd onder %(spdx)s, wat dit verzoek niet toestaat"

msgid "System memory bandwidth was not measured; %(gbps).0f GB/s assumed for %(arch)s."
msgstr "De bandbreedte van het systeemgeheugen is niet gemeten; %(gbps).0f GB/s aangenomen voor %(arch)s."

msgid "%(gpu)s bandwidth is unknown; the %(backend)s fallback of %(gbps).0f GB/s stands in."
msgstr "De bandbreedte van %(gpu)s is onbekend; de terugvalwaarde van %(gbps).0f GB/s voor %(backend)s staat ervoor in de plaats."

msgid "No graphics card compute figure: prompt processing is estimated on the CPU."
msgstr "Geen rekencijfer voor de grafische kaart: de promptverwerking wordt op de CPU geschat."

msgid "%(gb).2f GB of routed experts is read from system memory per token at %(eff).2f of its %(raw).0f GB/s, because each token selects a different handful of experts and the read is a scatter of small blocks rather than a stream."
msgstr "%(gb).2f GB aan gerouteerde experts wordt per token uit het systeemgeheugen gelezen op %(eff).2f van zijn %(raw).0f GB/s, omdat elk token een andere handvol experts kiest en de leesbewerking een verstrooiing van kleine blokken is in plaats van een stroom."

msgid "%(gb).2f GB of contiguous weights is read from system memory per token at %(eff).2f of its %(raw).0f GB/s."
msgstr "%(gb).2f GB aan aaneengesloten gewichten wordt per token uit het systeemgeheugen gelezen op %(eff).2f van zijn %(raw).0f GB/s."

msgid "No active parameter count was supplied; it was inferred from the weight bytes."
msgstr "Er is geen aantal actieve parameters opgegeven; het is afgeleid uit de bytes van de gewichten."

msgid "%(pct).0f percent of the layers sit in system memory, so that share of the prompt arithmetic is charged to the CPU at %(tflops).2f TFLOP/s rather than to the card. Both rates come from one small dense model on one machine."
msgstr "%(pct).0f procent van de lagen staat in het systeemgeheugen, dus dat deel van het promptrekenwerk wordt aan de CPU toegerekend op %(tflops).2f TFLOP/s in plaats van aan de kaart. Beide snelheden komen van één klein dicht model op één machine."

msgid "%(gb).1f GB of the expert set is streamed across the link once per micro-batch at %(gbps).1f GB/s. That rate was fitted on the one model whose expert set does not fit in system memory, so part of its read comes off the disk; an expert set that stays in the page cache streams about three times faster, and for one of those this term is that much too slow."
msgstr "%(gb).1f GB van de expertverzameling wordt één keer per microbatch over de verbinding gestreamd op %(gbps).1f GB/s. Die snelheid is gefit op het ene model waarvan de expertverzameling niet in het systeemgeheugen past, dus een deel van de leesbewerking komt van de schijf; een expertverzameling die in de paginacache blijft streamt ongeveer drie keer zo snel, en voor zo'n model is deze term net zoveel te traag."

msgid "%(gb).1f GB of the expert set is read out of system memory once per micro-batch at %(gbps).1f GB/s, because there is no card to stream it to."
msgstr "%(gb).1f GB van de expertverzameling wordt één keer per microbatch uit het systeemgeheugen gelezen op %(gbps).1f GB/s, omdat er geen kaart is om hem naartoe te streamen."

msgid "No placement of this model on this machine could run it."
msgstr "Geen enkele plaatsing van dit model op deze machine kon het draaien."

msgid "Generation is a benchmark of this configuration, not a prediction."
msgstr "De generatie is een benchmark van deze configuratie, geen voorspelling."

msgid "Generation is the formula corrected by %(factor).2f, from a benchmark of %(profile)s on this machine taken on %(date)s."
msgstr "De generatie is de formule, gecorrigeerd met %(factor).2f, uit een benchmark van %(profile)s op deze machine, genomen op %(date)s."

msgid "Prompt processing is a benchmark of this configuration."
msgstr "De promptverwerking is een benchmark van deze configuratie."

msgid "Prompt processing is the formula corrected by %(factor).2f from a benchmark."
msgstr "De promptverwerking is de formule, gecorrigeerd met %(factor).2f uit een benchmark."

msgid "That benchmark's command line does not record how many layers went to the card, so the correction assumes it ran at this placement."
msgstr "De opdrachtregel van die benchmark legt niet vast hoeveel lagen er naar de kaart zijn gegaan, dus de correctie neemt aan dat hij bij deze plaatsing draaide."

msgid "This figure assumes nothing pages: a placement this tight often does, silently."
msgstr "Dit cijfer neemt aan dat er niets uitwisselt: een plaatsing die zo krap is doet dat vaak wel, in stilte."

