msgstr "%(url)s beantwoordde een range-request met het hele bestand."

msgid "%(url)s is rate-limiting this download (HTTP %(status)d)."
msgstr "%(url)s beperkt de snelheid van deze download (HTTP %(status)d)."

msgid "Check your network connection and run the command again to resume."
msgstr "Controleer uw netwerkverbinding en voer de opdracht opnieuw uit om te hervatten."

msgid "%(file)s needs authorisation (HTTP %(status)d)."
msgstr "%(file)s vereist autorisatie (HTTP %(status)d)."

msgid "This repository is gated. Accept its terms on Hugging Face and set HF_TOKEN to a token that can read it."
msgstr "Deze repository is afgeschermd. Accepteer de voorwaarden op Hugging Face en zet HF_TOKEN op een token dat hem mag lezen."

msgid "%(file)s is not at %(url)s any more (HTTP 404)."
msgstr "%(file)s staat niet meer op %(url)s (HTTP 404)."

msgid "Run `llamafit catalog refresh` to pick up the repository's current files."
msgstr "Voer `llamafit catalog refresh` uit om de huidige bestanden van de repository op te halen."

msgid "%(url)s returned HTTP %(status)d."
msgstr "%(url)s gaf HTTP %(status)d terug."

msgid "Confirm the URL points at a downloadable file."
msgstr "Ga na of de URL naar een downloadbaar bestand wijst."

msgid "%(url)s did not say how big %(file)s is."
msgstr "%(url)s heeft niet gezegd hoe groot %(file)s is."

msgid "%(file)s is %(actual)s on the server but the catalog says %(expected)s; the repository has been re-uploaded since the catalog was refreshed."
msgstr "%(file)s is %(actual)s op de server maar de catalogus zegt %(expected)s; de repository is opnieuw geüpload sinds de catalogus is ververst."

msgid "Run `llamafit catalog refresh` and try again."
msgstr "Voer `llamafit catalog refresh` uit en probeer het opnieuw."

msgid "%(file)s: the server sent %(actual)d bytes of a %(expected)d byte range."
msgstr "%(file)s: de server stuurde %(actual)d bytes van een range van %(expected)d bytes."

msgid "Run the command again; the parts that did arrive are kept."
msgstr "Voer de opdracht opnieuw uit; de delen die wel zijn aangekomen blijven bewaard."

msgid "Stopped."
msgstr "Gestopt."

msgid "%(file)s: the server asked for fewer connections; using %(count)d."
msgstr "%(file)s: de server vroeg om minder verbindingen; er worden er %(count)d gebruikt."

msgid "%(file)s: this server will not serve byte ranges; fetching it in one stream."
msgstr "%(file)s: deze server serveert geen byte-ranges; het wordt in één stroom opgehaald."

msgid "%(file)s does not match its checksum; fetching it again."
msgstr "%(file)s komt niet overeen met zijn controlesom; het wordt opnieuw opgehaald."

msgid "Check that the download directory is writable."
msgstr "Controleer of de downloadmap beschrijfbaar is."

msgid "%(needed)s is needed for this model but %(path)s has only %(free)s free, %(short)s short of what is wanted with %(headroom)s left spare."
msgstr "Er is %(needed)s nodig voor dit model maar %(path)s heeft maar %(free)s vrij, %(short)s te weinig voor wat er wordt gewenst met %(headroom)s over."

msgid "Free some space, or choose another directory with --dir, or a smaller quantisation with --quant."
msgstr "Maak wat ruimte vrij, of kies een andere map met --dir, of een kleinere kwantisatie met --quant."

msgid "could not measure the free space on %(path)s: %(error)s"
msgstr "kon de vrije ruimte op %(path)s niet meten: %(error)s"

msgid "Check that the download directory's volume is available."
msgstr "Controleer of het volume van de downloadmap beschikbaar is."

msgid "%(model)s has no downloadable source in the catalog."
msgstr "%(model)s heeft geen downloadbare bron in de catalogus."

msgid "Only Hugging Face sources can be installed; this entry has none."
msgstr "Alleen bronnen van Hugging Face kunnen worden geïnstalleerd; deze vermelding heeft er geen."

msgid "the catalog has no file list for %(model)s %(quant)s."
msgstr "de catalogus heeft geen bestandslijst voor %(model)s %(quant)s."

msgid "Run `llamafit catalog refresh` to fill in the file names."
msgstr "Voer `llamafit catalog refresh` uit om de bestandsnamen in te vullen."

msgid "%(model)s publishes no quantisations."
msgstr "%(model)s publiceert geen kwantisaties."

msgid "%(model)s does not publish a %(quant)s quantisation."
msgstr "%(model)s publiceert geen kwantisatie %(quant)s."

msgid "It publishes: %(quants)s"
msgstr "Het publiceert: %(quants)s"

msgid "the catalog does not record how big %(quant)s is."
msgstr "de catalogus legt niet vast hoe groot %(quant)s is."

msgid "Run `llamafit catalog refresh` to fill in the sizes."
msgstr "Voer `llamafit catalog refresh` uit om de groottes in te vullen."

msgid "the catalog holds no checksum for %(files)s."
msgid_plural "the catalog holds no checksums for %(files)s."
msgstr[0] "de catalogus heeft geen controlesom voor %(files)s."
msgstr[1] "de catalogus heeft geen controlesommen voor %(files)s."

msgid "Run `llamafit catalog refresh` to fetch them, or pass --allow-unverified to download anyway and check the files yourself."
msgstr "Voer `llamafit catalog refresh` uit om ze op te halen, of geef --allow-unverified op om toch te downloaden en de bestanden zelf te controleren."

msgid "%(done)s of %(total)s"
msgstr "%(done)s van %(total)s"

msgid "%(rate)s/s"
msgstr "%(rate)s/s"

msgid "Fetching %(file)s (%(size)s)"
msgstr "%(file)s ophalen (%(size)s)"

msgid "Checking %(file)s against its checksum"
msgstr "%(file)s tegen zijn controlesom controleren"

msgid "Done: %(file)s"
msgstr "Klaar: %(file)s"

msgid "could not create %(path)s: %(error)s"
msgstr "kon %(path)s niet aanmaken: %(error)s"

msgid "Check that the download directory is writable and has room."
msgstr "Controleer of de downloadmap beschrijfbaar is en ruimte heeft."

msgid "could not move %(source)s into place: %(error)s"
msgstr "kon %(source)s niet op zijn plaats zetten: %(error)s"

msgid "could not record progress in %(path)s: %(error)s"
msgstr "kon de voortgang niet vastleggen in %(path)s: %(error)s"

msgid "could not fetch %(url)s: %(error)s"
msgstr "kon %(url)s niet ophalen: %(error)s"

msgid "Stopped before the checksum was finished."
msgstr "Gestopt voordat de controlesom klaar was."

msgid "could not read %(path)s: %(error)s"
msgstr "kon %(path)s niet lezen: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "Controleer of het bestand bestaat en leesbaar is."

msgid "%(file)s is %(actual)d bytes, but the catalog says %(expected)d"
msgstr "%(file)s is %(actual)d bytes, maar de catalogus zegt %(expected)d"

msgid "The transfer was cut short. Run the command again to fetch it properly."
msgstr "De overdracht is afgebroken. Voer de opdracht opnieuw uit om het bestand goed op te halen."

msgid "%(file)s does not match the checksum the catalog holds."
msgstr "%(file)s komt niet overeen met de controlesom die de catalogus heeft."

msgid "Expected %(expected)s but the file hashes to %(actual)s. The bad copy has been deleted; run the command again to fetch it."
msgstr "%(expected)s werd verwacht maar het bestand hasht naar %(actual)s. De slechte kopie is verwijderd; voer de opdracht opnieuw uit om hem op te halen."

msgid "Command: %(command)s"
msgstr "Opdracht: %(command)s"

msgid "truncated GGUF header: wanted %(wanted)d byte at offset %(offset)d, got %(got)d"
msgid_plural "truncated GGUF header: wanted %(wanted)d bytes at offset %(offset)d, got %(got)d"
msgstr[0] "afgekapte GGUF-header: %(wanted)d byte gewenst op positie %(offset)d, %(got)d gekregen"
msgstr[1] "afgekapte GGUF-header: %(wanted)d bytes gewenst op positie %(offset)d, %(got)d gekregen"

msgid "The file may still be downloading, or the URL may not be a GGUF file."
msgstr "Het bestand wordt misschien nog gedownload, of de URL wijst niet naar een GGUF-bestand."

msgid "unknown GGUF value type %(type)d at offset %(offset)d"
msgstr "onbekend GGUF-waardetype %(type)d op positie %(offset)d"

msgid "This file may use a newer GGUF metadata type than LlamaFit supports."
msgstr "Dit bestand gebruikt mogelijk een nieuwer GGUF-metadatatype dan LlamaFit ondersteunt."

msgid "not a GGUF file: bad magic %(magic)s at offset 0"
msgstr "geen GGUF-bestand: verkeerde magic %(magic)s op positie 0"

msgid "Check that this file is actually a .gguf model."
msgstr "Controleer of dit bestand werkelijk een .gguf-model is."

msgid "unsupported GGUF version %(version)d at offset 4"
msgstr "niet-ondersteunde GGUF-versie %(version)d op positie 4"

msgid "LlamaFit supports GGUF versions %(versions)s."
msgstr "LlamaFit ondersteunt de GGUF-versies %(versions)s."

msgid "A memory budget built without these tensors would be too small, so none is built. If llama.cpp loads the file, LlamaFit's tensor-size table is missing the type."
msgstr "Een geheugenbudget dat zonder deze tensoren is opgebouwd, zou te klein zijn, dus er wordt er geen opgebouwd. Als llama.cpp het bestand laadt, ontbreekt het type in de tensorgroottetabel van LlamaFit."

msgid "%(type)d (%(count)d tensor, first %(name)s)"
msgid_plural "%(type)d (%(count)d tensors, first %(name)s)"
msgstr[0] "%(type)d (%(count)d tensor, eerste %(name)s)"
msgstr[1] "%(type)d (%(count)d tensoren, eerste %(name)s)"

msgid "cannot size this GGUF file: %(count)d tensor uses a GGML type LlamaFit does not know: %(details)s"
msgid_plural "cannot size this GGUF file: %(count)d tensors use GGML types LlamaFit does not know: %(details)s"
msgstr[0] "kan dit GGUF-bestand niet dimensioneren: %(count)d tensor gebruikt een GGML-type dat LlamaFit niet kent: %(details)s"
msgstr[1] "kan dit GGUF-bestand niet dimensioneren: %(count)d tensoren gebruiken GGML-types die LlamaFit niet kent: %(details)s"

msgid "%(count)d shard"
msgid_plural "%(count)d shards"
msgstr[0] "%(count)d shard"
msgstr[1] "%(count)d shards"

msgid "these GGUF files are not one split model: they disagree about '%(key)s', declaring %(values)s"
msgstr "deze GGUF-bestanden zijn niet één opgesplitst model: ze zijn het oneens over '%(key)s' en geven %(values)s op"

# "Shard" is the word Dutch developers use for a piece of a split model; the literal
# "scherf" would read as a piece of broken crockery.
msgid "Pass the shards of one model, not of several."
msgstr "Geef de shards van één model op, niet die van meerdere."

msgid "no GGUF header to read facts from"
msgstr "geen GGUF-header om gegevens uit te lezen"

msgid "Pass the model's file, or every shard of a split model."
msgstr "Geef het bestand van het model op, of elke shard van een opgesplitst model."

msgid "%(count)d GGUF file of the %(total)d given carries no '%(key)s' key, so its place in a split model cannot be established"
msgid_plural "%(count)d GGUF files of the %(total)d given carry no '%(key)s' key, so their place in a split model cannot be established"
msgstr[0] "%(count)d GGUF-bestand van de %(total)d opgegeven bestanden draagt geen sleutel '%(key)s', dus zijn plaats in een opgesplitst model kan niet worden bepaald"
msgstr[1] "%(count)d GGUF-bestanden van de %(total)d opgegeven bestanden dragen geen sleutel '%(key)s', dus hun plaats in een opgesplitst model kan niet worden bepaald"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "Geef één niet-opgesplitst bestand alleen op, of elke shard van één opgesplitst model."

msgid "incomplete shard set: the model declares %(shards)s and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "onvolledige set shards: het model geeft %(shards)s op en er zijn er %(arrived)d aangekomen (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "Geef elke shard van het opgesplitste model op."

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "de shard met de metadata van het model ontbreekt: %(key)s %(numbers)s gekregen, terwijl een daarvan 0 moest zijn"

msgid "Pass every shard of the split model, including the first."
msgstr "Geef elke shard van het opgesplitste model op, ook de eerste."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "onvolledige set shards: %(key)s 0 tot %(last)d verwacht, %(numbers)s gekregen"

msgid "Pass each shard of the split model exactly once."
msgstr "Geef elke shard van het opgesplitste model precies één keer op."

msgid "incomplete shard set: the model declares %(tensors)s and its %(shards)s hold %(held)d between them"
msgstr "onvolledige set shards: het model geeft %(tensors)s op en zijn %(shards)s bevatten er samen %(held)d"

msgid "%(count)d tensor"
msgid_plural "%(count)d tensors"
msgstr[0] "%(count)d tensor"
msgstr[1] "%(count)d tensoren"

msgid "Check your network connection and that the URL is reachable."
msgstr "Controleer uw netwerkverbinding en of de URL bereikbaar is."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s gaf HTTP %(status)d terug in plaats van 206 Partial Content; de server ondersteunt mogelijk geen range-requests."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Ga na of de URL naar een downloadbaar GGUF-bestand wijst."

msgctxt "CPU model"
msgid "unknown"
msgstr "onbekend"

msgid "nvidia-smi returned no GPUs"
msgstr "nvidia-smi gaf geen GPU's terug"

