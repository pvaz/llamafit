msgstr "nvidia-smi non ha restituito alcuna GPU"

msgid "rocm-smi returned no cards"
msgstr "rocm-smi non ha restituito alcuna scheda"

msgid "system_profiler returned no displays"
msgstr "system_profiler non ha restituito alcuno schermo"

