msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "Hugging Face ha restituito %(status)d durante l'elenco dei file di %(repo)s."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Non è stato possibile leggere l'elenco dei file di %(repo)s da Hugging Face."

msgid "Check your network connection and try again."
msgstr "Verificare la connessione di rete e riprovare."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "La risposta di Hugging Face per %(repo)s non conteneva un elenco di file."

msgid "Check that the repository id is correct and public."
msgstr "Verificare che l'id del repository sia corretto e pubblico."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "il catalogo ha %(count)d problema"
msgstr[1] "il catalogo ha %(count)d problemi"

msgid "Run `llamafit catalog validate` for details."
msgstr "Eseguire `llamafit catalog validate` per i dettagli."

msgid "could not write %(path)s: %(error)s"
msgstr "non è stato possibile scrivere %(path)s: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "Verificare che la cartella sia scrivibile e abbia spazio."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "%(path)s ha %(count)d problema e non può essere aggiornato"
msgstr[1] "%(path)s ha %(count)d problemi e non può essere aggiornato"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "Eseguire `llamafit catalog validate` e correggere prima il file."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "%(path)s non è stato letto per intero, quindi aggiornare solo %(model)s farebbe perdere le caratteristiche che registra per i modelli che questa esecuzione non tocca: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "Eseguire `llamafit catalog refresh` senza --model per ricostruire l'intero file."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "Trova, dimensiona, installa e verifica LLM a pesi aperti per llama.cpp sulla propria macchina."

msgid "Print machine-readable JSON instead of tables."
msgstr "Stampa JSON leggibile da una macchina invece delle tabelle."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "Scrive i dettagli in llamafit.log, nella cartella dei log, e mostra i traceback."

msgid "Disable colours."
msgstr "Disattiva i colori."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "Parla questa lingua, per esempio pt_PT. Una lingua che LlamaFit non ha ricade sull'inglese, e lui dice quali ha."

msgid "Print the version and exit."
msgstr "Stampa la versione ed esce."

msgid "Unexpected error: %(error)s"
msgstr "Errore imprevisto: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "Eseguire di nuovo con --verbose per il traceback completo."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "Gestisce il catalogo: valida i suoi file, aggiorna i campi volatili."

msgid "Keep only this use case."
msgstr "Tiene solo questo caso d'uso."

msgid "Keep only models with this capability (repeatable)."
msgstr "Tiene solo i modelli con questa capacità (ripetibile)."

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Tiene solo questi identificatori di licenza (ripetibile)."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "Valida solo questo file, invece del catalogo incluso e delle personalizzazioni."

msgid "Did you mean: %(ids)s?"
msgstr "Forse intendevi: %(ids)s?"

msgid "Run `llamafit list` to see every model id."
msgstr "Eseguire `llamafit list` per vedere tutti gli id dei modelli."

msgid "no model named %(id)s in the catalog"
msgstr "nessun modello di nome %(id)s nel catalogo"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "Trovato %(count)d problema nel catalogo; eseguire `llamafit catalog validate` per i dettagli."
msgstr[1] "Trovati %(count)d problemi nel catalogo; eseguire `llamafit catalog validate` per i dettagli."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "Nessun modello corrisponde. Provare un --use-case, --capability, --license, --vendor o --search più ampio."

msgid "invalid --use-case %(value)s"
msgstr "--use-case non valido: %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "Casi d'uso validi: %(values)s"

msgid "invalid --capability value: %(values)s"
msgid_plural "invalid --capability values: %(values)s"
msgstr[0] "valore non valido per --capability: %(values)s"
msgstr[1] "valori non validi per --capability: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "Capacità valide: %(values)s"

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"Elenca il catalogo dei modelli, ristretto dai filtri indicati.\n"
"\n"
"La tabella mostra al massimo tre capacità per modello, più un indicatore +N per le altre, ed è ordinata secondo la colonna Qualità mostrata; info o --json hanno tutte le capacità."

msgid "Keep only this vendor, case-insensitive."
msgstr "Tiene solo questo produttore, senza distinguere maiuscole e minuscole."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "Corrispondenza parziale su id, nome, produttore o famiglia, senza distinguere maiuscole e minuscole."

msgid "Show at most this many."
msgstr "Mostra al massimo questo numero."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "Abbreviazione di llamafit list --search TESTO."

msgid "Text to match against id, name, vendor or family."
msgstr "Testo da cercare in id, nome, produttore o famiglia."

msgid "Show one model's facts, sources and every quant it publishes."
msgstr "Mostra le caratteristiche di un modello, le sue fonti e ogni quantizzazione che pubblica."

msgid "A catalog model id."
msgstr "Un id di modello del catalogo."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "Valida i file YAML del catalogo rispetto allo schema, scrivendo una riga per problema."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "%(count)d file controllato, nessun problema trovato."
msgstr[1] "%(count)d file controllati, nessun problema trovato."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "Aggiorna da Hugging Face i nomi dei file, le dimensioni, i checksum e le caratteristiche GGUF del catalogo."

msgid "Refresh only this model id."
msgstr "Aggiorna solo questo id di modello."

msgid "Compute the refresh but write nothing."
msgstr "Calcola l'aggiornamento senza scrivere nulla."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "Esce con 1 se qualcosa cambierebbe; non modifica nulla, per un job di CI pianificato."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: avviso: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "avviso: %(warning)s (%(count)d modello: %(models)s)"
msgstr[1] "avviso: %(warning)s (%(count)d modelli: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: errore: %(error)s"

msgid "Hint: %(hint)s"
msgstr "Suggerimento: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "l'aggiornamento richiede l'accesso di rete a Hugging Face; verificare la connessione e che l'id del repository sia corretto."

msgid "No changes."
msgstr "Nessuna modifica."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "Stampa la voce di catalogo grezza di un modello, in JSON per impostazione predefinita o in YAML con --yaml."

msgid "Print YAML instead of JSON."
msgstr "Stampa YAML invece di JSON."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "Spiega che cosa è stato rilevato, che cosa non è riuscito e che cosa sbloccherebbe altro."

