msgid "%(model)s is no longer in the catalog this board was built from."
msgstr "%(model)s non è più nel catalogo da cui è stata costruita questa classifica."

msgid "Planned with the vision projector; press v to leave it out."
msgstr "Pianificato con il proiettore di visione; premere v per lasciarlo fuori."

msgid "Planned without the vision projector; press v to put it back."
msgstr "Pianificato senza il proiettore di visione; premere v per rimetterlo."

msgid "The ladder has no rung above %(context)s."
msgstr "La scala non ha alcun gradino sopra %(context)s."

msgid "The ladder has no rung below %(context)s."
msgstr "La scala non ha alcun gradino sotto %(context)s."

msgid "There is no command line to copy yet."
msgstr "Non c'è ancora una riga di comando da copiare."

msgid "The command line is on the clipboard."
msgstr "La riga di comando è negli appunti."

msgid "Everything on every screen answers about the machine chosen here. While it is not this one, the band at the top says SIMULATED."
msgstr "Tutto, su ogni schermata, risponde riguardo alla macchina scelta qui. Finché non è questa, la fascia in alto dice SIMULATO."

msgid "Answer for this machine instead:"
msgstr "Rispondere invece per questa macchina:"

msgid "Pretend the graphics card has this much memory (blank to leave it):"
msgstr "Fingere che la scheda grafica abbia questa memoria (vuoto per lasciare com'è):"

msgid "Pretend the machine has this much system memory (blank to leave it):"
msgstr "Fingere che la macchina abbia questa memoria di sistema (vuoto per lasciare com'è):"

msgid "Pretend the processor has this many cores (blank to leave it):"
msgstr "Fingere che il processore abbia questo numero di core (vuoto per lasciare com'è):"

msgid "Back to this machine"
msgstr "Torna a questa macchina"

msgctxt "hardware profile"
msgid "this machine"
msgstr "questa macchina"

msgid "The core count is a whole number, for example 8."
msgstr "Il numero di core è un numero intero, per esempio 8."

# Punctuation, not prose: the separator between the pieces of the dashboard's
# header line, with its spaces. The same middle dot serves here as in English.
msgctxt "dashboard header separator"
msgid " · "
msgstr " · "

msgctxt "dashboard header"
msgid "no GPU detected"
msgstr "nessuna GPU rilevata"

msgid "%(name)s, VRAM unknown"
msgstr "%(name)s, VRAM sconosciuta"

msgid "%(name)s, %(free)s free of %(total)s"
msgstr "%(name)s, %(free)s liberi su %(total)s"

msgid "%(available)s free of %(total)s RAM"
msgstr "%(available)s liberi su %(total)s di RAM"

msgid "%(model)s, %(count)d core"
msgid_plural "%(model)s, %(count)d cores"
msgstr[0] "%(model)s, %(count)d core"
msgstr[1] "%(model)s, %(count)d core"

msgctxt "dashboard header"
msgid "llama.cpp not installed"
msgstr "llama.cpp non installato"

msgctxt "dashboard header"
msgid "llama.cpp installed"
msgstr "llama.cpp installato"

msgid "llama.cpp b%(build)d"
msgstr "llama.cpp b%(build)d"

msgctxt "dashboard header"
msgid "scanning this machine…"
msgstr "analisi di questa macchina…"

msgid "These speeds were not all arrived at the same way; the How column says which each row is."
msgstr "Queste velocità non sono state ottenute tutte allo stesso modo; la colonna Come dice che cos'è ciascuna riga."

msgctxt "thousands separator"
msgid ","
msgstr "."

msgctxt "decimal separator"
msgid "."
msgstr ","

# B is not the English word for a thousand million; it is how these models are named.
# The file is Qwen3-27B and the identifier in this row already says 27B, so a localised
# abbreviation would make one row disagree with itself. Change it only if your readers
# genuinely would not recognise B, and say in a comment here why.
msgctxt "parameter count"
msgid "B"
msgstr "B"

msgctxt "size"
msgid "unknown"
msgstr "sconosciuta"

msgid "profile must be a name, not a path: %(value)s"
msgstr "il profilo deve essere un nome, non un percorso: %(value)s"

msgid "Ask GET /api/v1/profiles for the names this machine has."
msgstr "Chiedere a GET /api/v1/profiles i nomi che questa macchina ha."

msgid "unknown query parameter: %(names)s"
msgstr "parametro di query sconosciuto: %(names)s"

msgid "This endpoint takes: %(names)s"
msgstr "Questo endpoint accetta: %(names)s"

msgid "invalid prefer %(value)s"
msgstr "prefer non valido: %(value)s"

msgid "invalid sort %(value)s"
msgstr "sort non valido: %(value)s"

msgid "%(host)s:%(port)d is not this machine only. Anyone who can reach this computer on that port can read everything the dashboard shows -- your hardware, your disks, your file paths and the models you have downloaded. There is no password, because LlamaFit is meant for the person sitting at the keyboard. Press Ctrl+C now if you did not mean this."
msgstr "%(host)s:%(port)d non è solo questa macchina. Chiunque possa raggiungere questo computer su quella porta può leggere tutto ciò che la dashboard mostra -- il proprio hardware, i propri dischi, i propri percorsi di file e i modelli scaricati. Non c'è password, perché LlamaFit è pensato per la persona seduta alla tastiera. Premere Ctrl+C ora se non era questa l'intenzione."

msgid "the web dashboard needs FastAPI and uvicorn, which are not installed"
msgstr "la dashboard web richiede FastAPI e uvicorn, che non sono installati"

msgid "Install them with: pip install \"llamafit[web]\""
msgstr "Installarli con: pip install \"llamafit[web]\""

msgid "%(host)s is not a loopback address, and the dashboard has no authentication"
msgstr "%(host)s non è un indirizzo di loopback, e la dashboard non ha autenticazione"

msgid "Leave --host alone to serve this machine only, or pass it to mean it."
msgstr "Lasciare stare --host per servire solo questa macchina, oppure passarlo intenzionalmente."

