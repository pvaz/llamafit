msgid "The transfer was cut short. Run the command again to fetch it properly."
msgstr "Az átvitel megszakadt. Futtassa újra a parancsot, hogy rendesen letöltődjön."

msgid "%(file)s does not match the checksum the catalog holds."
msgstr "A(z) %(file)s nem egyezik a katalógusban tárolt ellenőrzőösszeggel."

msgid "Expected %(expected)s but the file hashes to %(actual)s. The bad copy has been deleted; run the command again to fetch it."
msgstr "A várt érték %(expected)s volt, de a fájl %(actual)s értéket ad. A hibás példány törölve; futtassa újra a parancsot a letöltéséhez."

msgid "Command: %(command)s"
msgstr "Parancs: %(command)s"

msgid "truncated GGUF header: wanted %(wanted)d byte at offset %(offset)d, got %(got)d"
msgid_plural "truncated GGUF header: wanted %(wanted)d bytes at offset %(offset)d, got %(got)d"
msgstr[0] "csonka GGUF fejléc: %(wanted)d bájt kellett volna a(z) %(offset)d eltolásnál, %(got)d érkezett"
msgstr[1] "csonka GGUF fejléc: %(wanted)d bájt kellett volna a(z) %(offset)d eltolásnál, %(got)d érkezett"

msgid "The file may still be downloading, or the URL may not be a GGUF file."
msgstr "Lehet, hogy a fájl még töltődik le, vagy hogy az URL nem GGUF fájlra mutat."

msgid "unknown GGUF value type %(type)d at offset %(offset)d"
msgstr "ismeretlen GGUF értéktípus: %(type)d a(z) %(offset)d eltolásnál"

msgid "This file may use a newer GGUF metadata type than LlamaFit supports."
msgstr "Lehet, hogy ez a fájl újabb GGUF metaadattípust használ, mint amit a LlamaFit támogat."

msgid "not a GGUF file: bad magic %(magic)s at offset 0"
msgstr "nem GGUF fájl: hibás azonosító %(magic)s a 0 eltolásnál"

msgid "Check that this file is actually a .gguf model."
msgstr "Ellenőrizze, hogy ez a fájl valóban .gguf modell."

msgid "unsupported GGUF version %(version)d at offset 4"
msgstr "nem támogatott GGUF verzió: %(version)d a 4 eltolásnál"

msgid "LlamaFit supports GGUF versions %(versions)s."
msgstr "A LlamaFit a következő GGUF verziókat támogatja: %(versions)s."

msgid "A memory budget built without these tensors would be too small, so none is built. If llama.cpp loads the file, LlamaFit's tensor-size table is missing the type."
msgstr "Az ezek nélkül a tenzorok nélkül felépített memóriakeret túl kicsi lenne, ezért egy sem épül fel. Ha a llama.cpp betölti a fájlt, akkor a LlamaFit tenzorméret-táblájából hiányzik a típus."

msgid "%(type)d (%(count)d tensor, first %(name)s)"
msgid_plural "%(type)d (%(count)d tensors, first %(name)s)"
msgstr[0] "%(type)d (%(count)d tenzor, az első: %(name)s)"
msgstr[1] "%(type)d (%(count)d tenzor, az első: %(name)s)"

msgid "cannot size this GGUF file: %(count)d tensor uses a GGML type LlamaFit does not know: %(details)s"
msgid_plural "cannot size this GGUF file: %(count)d tensors use GGML types LlamaFit does not know: %(details)s"
msgstr[0] "ez a GGUF fájl nem méretezhető: %(count)d tenzor olyan GGML típust használ, amelyet a LlamaFit nem ismer: %(details)s"
msgstr[1] "ez a GGUF fájl nem méretezhető: %(count)d tenzor olyan GGML típusokat használ, amelyeket a LlamaFit nem ismer: %(details)s"

msgid "%(count)d shard"
msgid_plural "%(count)d shards"
msgstr[0] "%(count)d rész"
msgstr[1] "%(count)d rész"

msgid "these GGUF files are not one split model: they disagree about '%(key)s', declaring %(values)s"
msgstr "ezek a GGUF fájlok nem egyetlen felosztott modellt alkotnak: nem értenek egyet a(z) '%(key)s' kulcsról, ezt jelentik: %(values)s"

msgid "Pass the shards of one model, not of several."
msgstr "Egyetlen modell részeit adja meg, ne többét."

msgid "no GGUF header to read facts from"
msgstr "nincs GGUF fejléc, amelyből adatokat lehetne olvasni"

msgid "Pass the model's file, or every shard of a split model."
msgstr "Adja meg a modell fájlját, vagy egy felosztott modell összes részét."

msgid "%(count)d GGUF file of the %(total)d given carries no '%(key)s' key, so its place in a split model cannot be established"
msgid_plural "%(count)d GGUF files of the %(total)d given carry no '%(key)s' key, so their place in a split model cannot be established"
msgstr[0] "a megadott %(total)d GGUF fájl közül %(count)d nem hordoz '%(key)s' kulcsot, ezért nem állapítható meg a helye egy felosztott modellben"
msgstr[1] "a megadott %(total)d GGUF fájl közül %(count)d nem hordoz '%(key)s' kulcsot, ezért nem állapítható meg a helyük egy felosztott modellben"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "Adjon meg egyetlen, fel nem osztott fájlt önmagában, vagy egyetlen felosztott modell összes részét."

msgid "incomplete shard set: the model declares %(shards)s and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "hiányos részhalmaz: a modell %(shards)s részt jelent be, és %(arrived)d érkezett (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "Adja meg a felosztott modell összes részét."

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "hiányzik a modell metaadatait hordozó rész: %(key)s %(numbers)s érkezett, pedig az egyiknek 0-nak kellene lennie"

msgid "Pass every shard of the split model, including the first."
msgstr "Adja meg a felosztott modell összes részét, az elsőt is beleértve."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "hiányos részhalmaz: %(key)s 0-tól %(last)d-ig kellett volna, %(numbers)s érkezett"

msgid "Pass each shard of the split model exactly once."
msgstr "A felosztott modell minden részét pontosan egyszer adja meg."

msgid "incomplete shard set: the model declares %(tensors)s and its %(shards)s hold %(held)d between them"
msgstr "hiányos részhalmaz: a modell %(tensors)s tenzort jelent be, a(z) %(shards)s része pedig együttesen %(held)d darabot tart"

msgid "%(count)d tensor"
msgid_plural "%(count)d tensors"
msgstr[0] "%(count)d tenzor"
msgstr[1] "%(count)d tenzor"

msgid "Check your network connection and that the URL is reachable."
msgstr "Ellenőrizze a hálózati kapcsolatot, és hogy az URL elérhető."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "A(z) %(url)s a 206 Partial Content helyett HTTP %(status)d választ adott; lehet, hogy a kiszolgáló nem támogatja a tartománykéréseket."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Győződjön meg róla, hogy az URL letölthető GGUF fájlra mutat."

msgctxt "CPU model"
msgid "unknown"
msgstr "ismeretlen"

msgid "nvidia-smi returned no GPUs"
msgstr "az nvidia-smi egyetlen GPU-t sem adott vissza"

msgid "rocm-smi returned no cards"
msgstr "a rocm-smi egyetlen kártyát sem adott vissza"

msgid "system_profiler returned no displays"
msgstr "a system_profiler egyetlen kijelzőt sem adott vissza"

msgid "WMI returned no video controllers"
msgstr "a WMI egyetlen videovezérlőt sem adott vissza"

msgid "lspci found no display controllers"
msgstr "az lspci egyetlen megjelenítővezérlőt sem talált"

msgid "vulkaninfo reported no discrete device with a memory heap"
msgstr "a vulkaninfo nem jelentett memóriahalommal rendelkező különálló eszközt"

msgid "no populated memory modules"
msgstr "nincs behelyezett memóriamodul"

msgid "no SPMemoryDataType"
msgstr "nincs SPMemoryDataType"

msgid "%(program)s: timed out after %(seconds)s second"
msgid_plural "%(program)s: timed out after %(seconds)s seconds"
msgstr[0] "%(program)s: időtúllépés %(seconds)s másodperc után"
msgstr[1] "%(program)s: időtúllépés %(seconds)s másodperc után"

msgid "empty command"
msgstr "üres parancs"

msgid "%(program)s: %(error)s"
msgstr "%(program)s: %(error)s"

msgid "%(program)s: not found"
msgstr "%(program)s: nem található"

msgid "exit code %(code)d: %(detail)s"
msgstr "kilépési kód %(code)d: %(detail)s"

msgid "no hardware profile file at %(path)s"
msgstr "nincs hardverprofil-fájl itt: %(path)s"

msgid "Run `llamafit hardware list` to see the profiles LlamaFit has."
msgstr "Futtassa a `llamafit hardware list` parancsot, hogy lássa a LlamaFit profiljait."

msgid "%(path)s is not a valid hardware profile: %(details)s"
msgstr "a(z) %(path)s nem érvényes hardverprofil: %(details)s"

msgid "Run `llamafit hardware validate FILE` for the whole list."
msgstr "A teljes listáért futtassa a `llamafit hardware validate FILE` parancsot."

msgid "no hardware profile named %(name)s"
msgstr "nincs %(name)s nevű hardverprofil"

msgid "Profiles LlamaFit has: %(names)s"
msgstr "A LlamaFit profiljai: %(names)s"

msgid "Run `llamafit hardware path` to see where your own profiles go."
msgstr "Futtassa a `llamafit hardware path` parancsot, hogy lássa, hová kerülnek a saját profiljai."

msgid "this machine has no graphics card, so there is no VRAM to override"
msgstr "ebben a gépben nincs videokártya, így nincs felülbírálandó VRAM"

msgid "Describe the whole machine in a hardware profile and pass --profile."
msgstr "Írja le az egész gépet egy hardverprofilban, és adja meg a --profile kapcsolót."

msgid "this machine has one memory pool shared with the graphics card"
msgstr "ebben a gépben egyetlen memóriakészlet van, amelyen a videokártya is osztozik"

msgid "Use --ram to resize the pool; --memory would change only half of it."
msgstr "A --ram kapcsolóval méretezze át a készletet; a --memory csak a felét változtatná meg."

msgid "%(option)s needs a value above zero"
msgstr "a(z) %(option)s nullánál nagyobb értéket vár"

msgid "no build number in the version output: %(text)s"
msgstr "nincs buildszám a verzió kimenetében: %(text)s"

msgid "llama.cpp not found: no llama-server on PATH, in LLAMA_CPP_PATH or in the usual directories"
msgstr "a llama.cpp nem található: nincs llama-server a PATH-ban, a LLAMA_CPP_PATH alatt vagy a szokásos könyvtárakban"

msgid "no ggml backend libraries found next to llama-server; the build may be static"
msgstr "nem található ggml háttérkönyvtár a llama-server mellett; lehet, hogy a build statikus"

msgid "%(path)s is a file, not a directory."
msgstr "A(z) %(path)s fájl, nem könyvtár."

msgid "%(path)s cannot be read: %(error)s"
msgstr "A(z) %(path)s nem olvasható: %(error)s"

msgid "%(path)s has a marker file that cannot be read."
msgstr "A(z) %(path)s helyen olyan jelölőfájl van, amely nem olvasható."

msgid "%(path)s already holds %(count)d file that LlamaFit did not install."
msgid_plural "%(path)s already holds %(count)d files that LlamaFit did not install."
msgstr[0] "A(z) %(path)s már %(count)d olyan fájlt tartalmaz, amelyet nem a LlamaFit telepített."
msgstr[1] "A(z) %(path)s már %(count)d olyan fájlt tartalmaz, amelyeket nem a LlamaFit telepített."

msgid "%(name)s has no published checksum, so it cannot be verified."
msgstr "A(z) %(name)s elemhez nincs közzétett ellenőrzőösszeg, ezért nem ellenőrizhető."

msgid "Pass --allow-unverified to install it anyway, knowing the archive is unchecked."
msgstr "Adja meg a --allow-unverified kapcsolót, hogy mégis telepítse, tudva, hogy az archívum ellenőrizetlen."

msgid "could not download %(url)s: %(error)s"
msgstr "nem sikerült letölteni a(z) %(url)s címet: %(error)s"

msgid "the connection was closed"
msgstr "a kapcsolat lezárult"

msgid "Run the command again; it continues from where it stopped."
msgstr "Futtassa újra a parancsot; onnan folytatódik, ahol abbamaradt."

msgid "the download of %(url)s stopped early: %(error)s"
msgstr "a(z) %(url)s letöltése korán megszakadt: %(error)s"

msgid "%(got)s of %(want)s arrived"
msgstr "%(want)s méretből %(got)s érkezett"

msgid "the disk holding %(path)s is full."
msgstr "a(z) %(path)s helyet hordozó lemez megtelt."

msgid "Free some space and run the command again; the download resumes."
msgstr "Szabadítson fel helyet, és futtassa újra a parancsot; a letöltés folytatódik."

msgid "Check that the directory exists and is writable."
msgstr "Ellenőrizze, hogy a könyvtár létezik és írható."

msgid "%(name)s did not match its published checksum and was discarded."
msgstr "A(z) %(name)s nem egyezett a közzétett ellenőrzőösszegével, ezért el lett dobva."

msgid "Nothing was unpacked. Run the command again: the archive arrived damaged, which a second download usually fixes."
msgstr "Semmi nem lett kicsomagolva. Futtassa újra a parancsot: az archívum sérülten érkezett, amit egy második letöltés általában megold."

msgid "%(archive)s contains %(name)s, which would be written outside the install directory."
msgstr "A(z) %(archive)s tartalmazza a(z) %(name)s elemet, amely a telepítési könyvtáron kívülre íródna."

msgid "Do not install this archive; report it to the llama.cpp project."
msgstr "Ne telepítse ezt az archívumot; jelentse a llama.cpp projektnek."

msgid "%(name)s is not an archive LlamaFit knows how to unpack."
msgstr "A(z) %(name)s nem olyan archívum, amelyet a LlamaFit ki tud csomagolni."

msgid "%(name)s could not be unpacked: %(error)s"
msgstr "A(z) %(name)s nem volt kicsomagolható: %(error)s"

msgid "Delete it and run the command again to download it afresh."
msgstr "Törölje, és futtassa újra a parancsot, hogy frissen letöltődjön."

msgid "the archive holds no %(name)s."
msgstr "az archívum nem tartalmaz %(name)s elemet."

msgid "Report this; the release layout has changed."
msgstr "Jelentse ezt; a kiadás elrendezése megváltozott."

msgid "%(path)s was not installed by LlamaFit."
msgstr "A(z) %(path)s helyre nem a LlamaFit telepített."

msgid "Pass --force to replace it, or --dir to install somewhere else. LlamaFit never overwrites an installation it did not create."
msgstr "Adja meg a --force kapcsolót a cseréjéhez, vagy a --dir kapcsolót, hogy máshová telepítsen. A LlamaFit soha nem ír felül olyan telepítést, amelyet nem ő hozott létre."

msgid "%(path)s has %(free)s free; this install needs %(needed)s."
msgstr "A(z) %(path)s helyen %(free)s szabad; ehhez a telepítéshez %(needed)s kell."

msgid "Free some space, or pass --dir to install on another volume."
msgstr "Szabadítson fel helyet, vagy adja meg a --dir kapcsolót, hogy másik kötetre telepítsen."

msgid "the %(backend)s libraries are not in the installed directory."
msgstr "a(z) %(backend)s kódtárak nincsenek a telepítési könyvtárban."

msgid "no ggml backend libraries were installed; the build may be a static one."
msgstr "nem települt egyetlen ggml háttérkódtár sem; lehet, hogy a build statikus."

msgid "Your PATH could not be read, so it will not be changed."
msgstr "A PATH nem volt beolvasható, ezért nem fog megváltozni."

msgid "Add %(path)s to your user PATH (HKCU\\Environment)."
msgstr "A(z) %(path)s hozzáadása a felhasználói PATH értékéhez (HKCU\\Environment)."

msgid "To undo: run `setx PATH \"%(previous)s\"`, or remove the entry in System > About > Advanced system settings > Environment Variables."
msgstr "A visszavonáshoz: futtassa a `setx PATH \"%(previous)s\"` parancsot, vagy távolítsa el a bejegyzést itt: Rendszer > Névjegy > Speciális rendszerbeállítások > Környezeti változók."

msgid "%(path)s is already on your PATH."
msgstr "A(z) %(path)s már szerepel a PATH értékében."

msgid "Nothing to undo."
msgstr "Nincs mit visszavonni."

msgid "Append a PATH line for %(path)s to %(file)s."
msgstr "Egy PATH sor hozzáfűzése a(z) %(path)s elemhez ebben a fájlban: %(file)s."

msgid "To undo: delete the two lines marked `%(mark)s` from %(file)s."
msgstr "A visszavonáshoz: törölje a `%(mark)s` jellel jelölt két sort ebből a fájlból: %(file)s."

msgid "your PATH could not be changed: %(error)s"
msgstr "a PATH nem volt megváltoztatható: %(error)s"

msgid "To remove it later, delete %(path)s."
msgstr "A későbbi eltávolításhoz törölje ezt: %(path)s."

msgid "the most recent %(count)d llama.cpp releases hold no build."
msgstr "a llama.cpp %(count)d legutóbbi kiadása nem tartalmaz buildet."

msgid "Name one with `llamafit install llama.cpp --tag ...`."
msgstr "Nevezzen meg egyet a `llamafit install llama.cpp --tag ...` paranccsal."

msgid "could not reach GitHub at %(url)s: %(error)s"
msgstr "nem sikerült elérni a GitHubot itt: %(url)s: %(error)s"

msgid "GitHub refused the request for %(url)s: the rate limit is exhausted."
msgstr "A GitHub elutasította a(z) %(url)s címre irányuló kérést: a sebességkorlát kimerült."

msgid "Wait for the limit to reset, or set GITHUB_TOKEN to a personal access token with no scopes."
msgstr "Várja meg, míg a korlát visszaáll, vagy állítsa a GITHUB_TOKEN értékét egy hatókör nélküli személyes hozzáférési tokenre."

msgid "GitHub has no release at %(url)s."
msgstr "A GitHubon nincs kiadás itt: %(url)s."

msgid "Check the tag with `llamafit install llama.cpp --tag ...`."
msgstr "Ellenőrizze a címkét a `llamafit install llama.cpp --tag ...` paranccsal."

msgid "GitHub returned %(status)d for %(url)s."
msgstr "A GitHub %(status)d kódot adott vissza erre: %(url)s."

msgid "GitHub's answer for %(url)s was not JSON."
msgstr "A GitHub válasza a(z) %(url)s címre nem JSON volt."

msgid "GitHub's answer did not describe a release."
msgstr "A GitHub válasza nem írt le kiadást."

msgid "no llama-server answering"
msgstr "nincs válaszoló llama-server"

msgid "unexpected response: %(error)s"
msgstr "váratlan válasz: %(error)s"

msgid "%(model)s holds %(native)s tokens, fewer than the %(minimum)s asked for."
msgstr "A(z) %(model)s %(native)s tokent tart, kevesebbet, mint a kért %(minimum)s."

msgid "No configuration of this model fits this machine."
msgstr "Ennek a modellnek egyetlen beállítása sem fér el ezen a gépen."

msgid "Routed experts are held in system memory, and so are the always-on shared experts, which is what -ot ffn_.*_shexp=CPU does; attention and the KV cache stay on the card."
msgstr "Az irányított szakértők a rendszermemóriában vannak, és velük együtt a mindig aktív közös szakértők is, amit a -ot ffn_.*_shexp=CPU tesz; a figyelem és a KV gyorsítótár a kártyán marad."

msgid "Routed experts are held in system memory; attention, the KV cache and the shared experts stay on the card."
msgstr "Az irányított szakértők a rendszermemóriában vannak; a figyelem, a KV gyorsítótár és a közös szakértők a kártyán maradnak."

msgid "%(layers)s layers are on the card and the rest run on the processor."
msgstr "%(layers)s réteg a kártyán van, a többi a processzoron fut."

msgid "Nothing runs on a graphics card: every weight is in system memory."
msgstr "Semmi nem fut videokártyán: minden súly a rendszermemóriában van."

msgid "%(gpus)s is here, but nothing could read how much of it is free, so this plan was made as if it were not. The real machine will be faster than these figures."
msgstr "A(z) %(gpus)s itt van, de semmi nem tudta beolvasni, mennyi szabad belőle, ezért ez a terv úgy készült, mintha nem volna. A valódi gép gyorsabb lesz ezeknél az értékeknél."

msgid "Sized for %(context)s tokens rather than the %(requested)s asked for."
msgstr "%(context)s tokenre méretezve a kért %(requested)s helyett."

msgid "The KV cache is quantised to %(type)s to reach this context."
msgstr "A KV gyorsítótár %(type)s típusra van kvantálva, hogy ez a kontextus elérhető legyen."

msgid "Vision is off: the projector did not fit, on the card or in system memory."
msgstr "A látás ki van kapcsolva: a projektor nem fért el, sem a kártyán, sem a rendszermemóriában."

msgid "The vision projector is in system memory (--no-mmproj-offload), which costs nothing measurable for text and makes images slower."
msgstr "A látásprojektor a rendszermemóriában van (--no-mmproj-offload), ami szövegnél mérhetően semmibe nem kerül, a képeket viszont lassabbá teszi."

msgid "%(threads)s threads, not the %(available)s this processor has: the efficiency cores are left out because generation measures slower with them, and what is left is the threads the performance cores provide."
msgstr "%(threads)s szál, nem az a %(available)s, amennyivel ez a processzor rendelkezik: a hatékonysági magok kimaradnak, mert velük a generálás lassabbnak mérhető, és ami marad, az a teljesítménymagok által adott szálak száma."

msgid "Tight: %(vram)s of the graphics card is free and this needs %(needed)s, so another program can push it over. The context tier table is how a launch script recovers."
msgstr "Szűkös: a videokártyából %(vram)s szabad, ehhez pedig %(needed)s kell, így egy másik program átbillentheti. A kontextusfokozat-táblázat az, ahogy egy indítószkript ebből visszatalál."

msgid "no %(capability)s capability, which %(use_case)s needs; ask for a different use case, or add it to the entry when the model really has it"
msgstr "nincs %(capability)s képessége, amelyre a(z) %(use_case)s esetnek szüksége van; kérjen másik felhasználási esetet, vagy vegye fel a bejegyzésbe, ha a modell valóban tudja"

msgid "no %(capability)s capability; drop it from the request to see this model"
msgstr "nincs %(capability)s képessége; hagyja ki a kérésből, hogy lássa ezt a modellt"

msgid "%(size)s to download, over the %(limit)s this request allows"
msgstr "%(size)s letöltendő, több, mint a(z) %(limit)s, amennyit ez a kérés megenged"

msgid "unknown quantisation %(quant)s, so its cost in quality cannot be told"
msgstr "ismeretlen kvantálás: %(quant)s, így a minőségbeli ára nem mondható meg"

msgid "nowhere to put it: no placement fits this machine at any context"
msgstr "nincs hová tenni: egyetlen elhelyezés sem fér el ezen a gépen egyetlen kontextuson sem"

msgid "holds %(fit)s tokens at most, under the %(minimum)s asked for; lower the minimum context or free memory to see it ranked"
msgstr "legfeljebb %(fit)s tokent tart, kevesebbet a kért %(minimum)s értéknél; csökkentse a legkisebb kontextust, vagy szabadítson fel memóriát, hogy rangsorolva lássa"

msgid "generates %(tps)s tokens per second, below the %(floor)s this request asks for; lower --min-tps or choose a smaller model or quantisation"
msgstr "%(tps)s tokent generál másodpercenként, kevesebbet a(z) %(floor)s értéknél, amit ez a kérés kér; csökkentse a --min-tps értékét, vagy válasszon kisebb modellt vagy kvantálást"

msgid "generates %(tps)s tokens per second, below the %(floor)s a person reads at: a batch tool on this machine and not one to sit in front of; a smaller model or quantisation would keep up"
msgstr "%(tps)s tokent generál másodpercenként, kevesebbet a(z) %(floor)s értéknél, amennyit egy ember elolvas: ezen a gépen kötegelt munkára való eszköz, nem olyan, amely elé leülünk; egy kisebb modell vagy kvantálás lépést tartana"

msgid "unknown use case %(use_case)s"
msgstr "ismeretlen felhasználási eset: %(use_case)s"

msgid "Known use cases: %(known)s."
msgstr "Ismert felhasználási esetek: %(known)s."

msgid "unknown score part %(part)s in the weights for %(use_case)s"
msgstr "ismeretlen pontozási rész: %(part)s a(z) %(use_case)s súlyaiban"

msgid "The parts are: %(parts)s."
msgstr "A részek ezek: %(parts)s."

msgid "the weights for %(use_case)s leave out %(part)s"
msgstr "a(z) %(use_case)s súlyaiból hiányzik ez: %(part)s"

msgid "Overriding a use case means giving all four parts: %(parts)s."
msgstr "Egy felhasználási eset felülbírálása azt jelenti, hogy mind a négy részt megadja: %(parts)s."

msgid "the weight for %(part)s in %(use_case)s is below zero"
msgstr "a(z) %(part)s súlya a(z) %(use_case)s esetben nulla alatt van"

msgid "A weight says how much a part counts; it cannot count less than none."
msgstr "A súly azt mondja meg, mennyit számít egy rész; a semminél kevesebbet nem számíthat."

msgid "the weights for %(use_case)s add up to nothing"
msgstr "a(z) %(use_case)s súlyainak összege nulla"

msgid "At least one part has to count for something."
msgstr "Legalább egy résznek számítania kell valamit."

msgid "unknown preference %(prefer)s"
msgstr "ismeretlen preferencia: %(prefer)s"

msgid "Preferences: %(known)s."
msgstr "Preferenciák: %(known)s."

msgid "Install or repair the NVIDIA driver; nvidia-smi ships with it and must be on PATH."
msgstr "Telepítse vagy javítsa az NVIDIA illesztőprogramot; az nvidia-smi vele érkezik, és a PATH-ban kell lennie."

msgid "Install ROCm (Linux) to expose AMD VRAM figures; without it the GPU is listed by name only."
msgstr "Telepítse a ROCm csomagot (Linux), hogy látszódjanak az AMD VRAM értékei; enélkül a GPU csak a nevével jelenik meg."

msgid "PowerShell could not list video controllers; run from a normal user session."
msgstr "A PowerShell nem tudta listázni a videovezérlőket; futtassa normál felhasználói munkamenetből."

msgid "Install pciutils to list GPUs by name when no vendor tool is available."
msgstr "Telepítse a pciutils csomagot, hogy a GPU-k név szerint listázhatók legyenek, ha nincs gyártói eszköz."

msgid "DDR type and speed were not readable; on Linux run once with sudo (dmidecode) or accept the measured bandwidth instead."
msgstr "A DDR típusa és sebessége nem volt olvasható; Linuxon futtassa egyszer sudóval (dmidecode), vagy fogadja el helyette a mért sávszélességet."

msgid "py-cpuinfo failed; the CPU model and instruction sets are unknown."
msgstr "A py-cpuinfo hibát adott; a CPU modellje és utasításkészletei ismeretlenek."

msgid "psutil could not count the CPU cores; thread choice falls back to one core. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "A psutil nem tudta megszámolni a CPU magjait; a szálválasztás egyetlen magra esik vissza. Telepítse újra a psutilt a `pip install --force-reinstall psutil` paranccsal."

msgid "psutil could not read the memory totals; budgets cannot be computed until this works. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "A psutil nem tudta beolvasni a memória összesítéseit; amíg ez nem működik, nem számíthatók ki a keretek. Telepítse újra a psutilt a `pip install --force-reinstall psutil` paranccsal."

msgid "Could not read performance-core count from sysctl."
msgstr "A teljesítménymagok száma nem volt beolvasható a sysctl parancsból."

msgid "llama-server exists but did not report a version; the binary may be broken."
msgstr "A llama-server létezik, de nem jelentett verziót; lehet, hogy a bináris sérült."

msgid "system_profiler failed; GPU information is unavailable."
msgstr "A system_profiler hibát adott; nincs információ a GPU-ról."

msgid "Install the Vulkan tools (vulkan-tools on Linux, the vendor's Vulkan runtime on Windows) so an unsized card's memory can be read from its driver. This probe runs only when no vendor tool sized the card, so it is the last source there is."
msgstr "Telepítse a Vulkan eszközöket (Linuxon a vulkan-tools csomagot, Windowson a gyártó Vulkan futtatókörnyezetét), hogy egy méret nélküli kártya memóriája kiolvasható legyen az illesztőprogramjából. Ez a próba csak akkor fut le, ha egyetlen gyártói eszköz sem adta meg a kártya méretét, tehát ez az utolsó forrás."

msgid "No vendor tool reported the GPU's memory size; record the size in a hardware profile so budgets can be computed for this machine."
msgstr "Egyetlen gyártói eszköz sem jelentette a GPU memóriaméretét; rögzítse a méretet egy hardverprofilban, hogy a keretek kiszámíthatók legyenek ehhez a géphez."

msgid "llama.cpp installed"
msgstr "a llama.cpp telepítve van"

msgid "build %(build)s at %(path)s, backends: %(backends)s"
msgstr "%(build)s build itt: %(path)s, háttérrendszerek: %(backends)s"

msgctxt "llama.cpp build"
msgid "unknown"
msgstr "ismeretlen"

msgid "llama.cpp not found"
msgstr "a llama.cpp nem található"

msgid "no llama-server binary was found"
msgstr "nem található llama-server bináris"

msgid "Run `llamafit install llama.cpp`, which picks the right build for this machine, checks it against its published checksum, and never touches an installation LlamaFit did not create."
msgstr "Futtassa a `llamafit install llama.cpp` parancsot, amely a géphez való buildet választja, összeveti a közzétett ellenőrzőösszegével, és soha nem nyúl olyan telepítéshez, amelyet nem a LlamaFit hozott létre."

msgid "Memory size unknown"
msgstr "Ismeretlen memóriaméret"

msgid "LlamaFit could not read this machine's memory totals, so it cannot work out what will fit."
msgstr "A LlamaFit nem tudta beolvasni ennek a gépnek a memóriaösszesítéseit, ezért nem tudja kiszámítani, mi fér el rajta."

msgid "%(gpu)s: no %(backend)s backend in llama.cpp"
msgstr "%(gpu)s: nincs %(backend)s háttérrendszer a llama.cpp-ben"

msgid "llama.cpp was built with: %(backends)s"
msgstr "a llama.cpp ezekkel készült: %(backends)s"

msgctxt "backends"
msgid "unknown"
msgstr "ismeretlen"

msgid "Install a llama.cpp build with the %(backend)s or Vulkan backend to use %(gpu)s."
msgstr "Telepítsen olyan llama.cpp buildet, amelyben van %(backend)s vagy Vulkan háttérrendszer, hogy használhassa ezt: %(gpu)s."

msgid "%(gpu)s: VRAM size unknown"
msgstr "%(gpu)s: ismeretlen VRAM méret"

msgid "the vendor tool that reports memory was not available"
msgstr "a memóriát jelentő gyártói eszköz nem volt elérhető"

msgid "%(gpus)s: planned around, not planned on"
msgstr "%(gpus)s: körülötte terveztünk, nem rá"

msgid "with no reading of how much of the card is free, every budget and every speed on this machine was computed as if there were no card: they are CPU-only figures, and the real machine will be faster."
msgstr "mivel semmi nem olvasta be, mennyi szabad a kártyán, ezen a gépen minden keret és minden sebesség úgy lett kiszámítva, mintha kártya sem volna: ezek csak CPU-értékek, és a valódi gép gyorsabb lesz."

msgid "Install the Vulkan tools so the size can be read from the driver, or record it in a hardware profile (`llamafit hardware path` says where those go) and pass --profile."
msgstr "Telepítse a Vulkan eszközöket, hogy a méret kiolvasható legyen az illesztőprogramból, vagy rögzítse egy hardverprofilban (a `llamafit hardware path` megmondja, hová kerülnek), és adja meg a --profile kapcsolót."

msgid "No GPU detected"
msgstr "Nem található GPU"

msgid "models will run on the CPU only"
msgstr "a modellek csak a CPU-n fognak futni"

msgid "If a GPU is present, check that its driver tools are installed."
msgstr "Ha van GPU, ellenőrizze, hogy telepítve vannak-e az illesztőprogramjai."

msgid "RAM bandwidth assumed"
msgstr "Feltételezett RAM sávszélesség"

msgid "using %(gbps)s GB/s as a default"
msgstr "%(gbps)s GB/s használata alapértelmezésként"

msgid "Install numpy (`pip install llamafit[fast]`) so LlamaFit can measure the RAM bandwidth."
msgstr "Telepítse a numpy csomagot (`pip install llamafit[fast]`), hogy a LlamaFit meg tudja mérni a RAM sávszélességét."

msgid "Probe %(probe)s failed"
msgstr "A(z) %(probe)s próba sikertelen"

msgctxt "probe error"
msgid "unknown error"
msgstr "ismeretlen hiba"

msgid "llama-server running at %(url)s"
msgstr "a llama-server fut itt: %(url)s"

msgid "model %(model)s, context %(context)s"
msgstr "modell: %(model)s, kontextus: %(context)s"

msgctxt "model name"
msgid "unknown"
msgstr "ismeretlen"

msgid "Low disk space on %(path)s"
msgstr "Kevés a lemezterület itt: %(path)s"

msgid "%(size)s free"
msgstr "%(size)s szabad"

msgid "Most useful models need 5 to 120 GB; free space or change the downloads directory."
msgstr "A legtöbb hasznos modellhez 5-120 GB kell; szabadítson fel helyet, vagy változtassa meg a letöltési könyvtárat."

msgid "%(model)s has no %(quant)s quantisation"
msgstr "a(z) %(model)s modellnek nincs %(quant)s kvantálása"

msgid "It publishes: %(names)s"
msgstr "Ezeket teszi közzé: %(names)s"

msgid "licensed %(spdx)s, which this request does not allow"
msgstr "%(spdx)s licencű, amit ez a kérés nem enged meg"

msgid "System memory bandwidth was not measured; %(gbps).0f GB/s assumed for %(arch)s."
msgstr "A rendszermemória sávszélessége nem lett megmérve; %(gbps).0f GB/s feltételezve ehhez: %(arch)s."

msgid "%(gpu)s bandwidth is unknown; the %(backend)s fallback of %(gbps).0f GB/s stands in."
msgstr "A(z) %(gpu)s sávszélessége ismeretlen; a(z) %(backend)s %(gbps).0f GB/s tartalékértéke lép a helyébe."

msgid "No graphics card compute figure: prompt processing is estimated on the CPU."
msgstr "Nincs videokártya-számítási érték: a promptfeldolgozás a CPU-ra van becsülve."

msgid "%(gb).2f GB of routed experts is read from system memory per token at %(eff).2f of its %(raw).0f GB/s, because each token selects a different handful of experts and the read is a scatter of small blocks rather than a stream."
msgstr "%(gb).2f GB irányított szakértő olvasódik be a rendszermemóriából tokenenként, annak %(raw).0f GB/s sebességének %(eff).2f részén, mert minden token más maroknyi szakértőt választ, és az olvasás nem folyam, hanem apró blokkok szórása."

msgid "%(gb).2f GB of contiguous weights is read from system memory per token at %(eff).2f of its %(raw).0f GB/s."
msgstr "%(gb).2f GB összefüggő súly olvasódik be a rendszermemóriából tokenenként, annak %(raw).0f GB/s sebességének %(eff).2f részén."

msgid "No active parameter count was supplied; it was inferred from the weight bytes."
msgstr "Nem adtak meg aktív paraméterszámot; a súlyok bájtjaiból lett kikövetkeztetve."

msgid "%(pct).0f percent of the layers sit in system memory, so that share of the prompt arithmetic is charged to the CPU at %(tflops).2f TFLOP/s rather than to the card. Both rates come from one small dense model on one machine."
msgstr "A rétegek %(pct).0f százaléka a rendszermemóriában ül, így a prompt számításainak ez a hányada a CPU-ra terhelődik %(tflops).2f TFLOP/s sebességgel, nem a kártyára. Mindkét sebesség egyetlen kis, sűrű modellből származik, egyetlen gépen."

msgid "%(gb).1f GB of the expert set is streamed across the link once per micro-batch at %(gbps).1f GB/s. That rate was fitted on the one model whose expert set does not fit in system memory, so part of its read comes off the disk; an expert set that stays in the page cache streams about three times faster, and for one of those this term is that much too slow."
msgstr "A szakértőhalmazból %(gb).1f GB folyik át a buszon mikrökötegenként egyszer, %(gbps).1f GB/s sebességgel. Ezt a sebességet arra az egyetlen modellre illesztettük, amelynek a szakértőhalmaza nem fér el a rendszermemóriában, így az olvasás egy része a lemezről jön; egy olyan szakértőhalmaz, amely a lapgyorsítótárban marad, nagyjából háromszor gyorsabban folyik, és egy ilyennél ez a tag épp ennyivel lassabb."

msgid "%(gb).1f GB of the expert set is read out of system memory once per micro-batch at %(gbps).1f GB/s, because there is no card to stream it to."
msgstr "A szakértőhalmazból %(gb).1f GB olvasódik ki a rendszermemóriából mikrökötegenként egyszer, %(gbps).1f GB/s sebességgel, mert nincs kártya, ahová átfolyathatná."

msgid "No placement of this model on this machine could run it."
msgstr "Ennek a modellnek egyetlen elhelyezése sem tudta volna futtatni ezen a gépen."

msgid "Generation is a benchmark of this configuration, not a prediction."
msgstr "A generálás ennek a beállításnak a mérése, nem jóslat."

msgid "Generation is the formula corrected by %(factor).2f, from a benchmark of %(profile)s on this machine taken on %(date)s."
msgstr "A generálás a képlet %(factor).2f szorzóval javítva, egy %(profile)s mérésből, amely ezen a gépen %(date)s napon készült."

msgid "Prompt processing is a benchmark of this configuration."
msgstr "A promptfeldolgozás ennek a beállításnak a mérése."

msgid "Prompt processing is the formula corrected by %(factor).2f from a benchmark."
msgstr "A promptfeldolgozás a képlet, egy mérésből származó %(factor).2f szorzóval javítva."

msgid "That benchmark's command line does not record how many layers went to the card, so the correction assumes it ran at this placement."
msgstr "Annak a mérésnek a parancssora nem rögzíti, hány réteg került a kártyára, így a javítás azt feltételezi, hogy ezzel az elhelyezéssel futott."

msgid "This figure assumes nothing pages: a placement this tight often does, silently."
msgstr "Ez az érték azt feltételezi, hogy semmi nem lapoz: egy ennyire szűkös elhelyezés gyakran mégis lapoz, némán."

