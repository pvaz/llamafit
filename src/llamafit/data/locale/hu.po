# The thousands separator below is a no-break space (U+00A0), not an ordinary space
# and not an empty translation. Hungarian groups digits with a space, and the entry is
# read literally, so the space is the answer. Do not "tidy" it away.
msgctxt "thousands separator"
msgid ","
msgstr " "

msgctxt "decimal separator"
msgid "."
msgstr ","

