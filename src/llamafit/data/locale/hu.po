# Hungarian translation of LlamaFit.
# This file is distributed under the same licence as LlamaFit.
#
# NOT YET REVIEWED BY A NATIVE SPEAKER. It was written from the English template in one
# pass and it has had no second reader. By the standard docs/translations.md sets for
# every language, that is not enough: please read it line by line and correct it in a
# pull request.
#
# Hungarian glues its cases onto the word, so several messages put the placeholder
# somewhere else than the English does: "%(free)s free of %(total)s" becomes
# "%(total)s méretből %(free)s szabad", and "Source %(index)d" becomes the ordinal
# "%(index)d. forrás". A numeral is always followed by a singular noun, which is why the
# two plural forms read alike wherever the count itself is printed.
#
# "a(z)" is the usual written compromise where the definite article stands in front of a
# value nobody can see in advance: a model id or a path may begin with either a vowel or
# a consonant, and Hungarian chooses "a" or "az" accordingly.
#
msgid ""
msgstr ""
"Project-Id-Version: llamafit 0.1.0a1\n"
"Report-Msgid-Bugs-To: https://github.com/pvaz/llamafit/issues\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: hu\n"
"Language-Team: Hungarian\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "A Hugging Face %(status)d kódot adott vissza a(z) %(repo)s fájljainak listázásakor."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Nem sikerült beolvasni a(z) %(repo)s fájllistáját a Hugging Face-ről."

msgid "Check your network connection and try again."
msgstr "Ellenőrizze a hálózati kapcsolatot, és próbálja újra."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "A Hugging Face válasza a(z) %(repo)s tárolóra nem tartalmazott fájllistát."

msgid "Check that the repository id is correct and public."
msgstr "Ellenőrizze, hogy a tároló azonosítója helyes és nyilvános."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "a katalógusban %(count)d probléma van"
msgstr[1] "a katalógusban %(count)d probléma van"

msgid "Run `llamafit catalog validate` for details."
msgstr "A részletekért futtassa a `llamafit catalog validate` parancsot."

msgid "could not write %(path)s: %(error)s"
msgstr "nem sikerült írni a(z) %(path)s fájlba: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "Ellenőrizze, hogy a könyvtár írható, és van benne hely."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "a(z) %(path)s fájlban %(count)d probléma van, ezért nem frissíthető"
msgstr[1] "a(z) %(path)s fájlban %(count)d probléma van, ezért nem frissíthető"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "Futtassa a `llamafit catalog validate` parancsot, és előbb javítsa a fájlt."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "A(z) %(path)s nem volt teljesen beolvasható, ezért csak a(z) %(model)s frissítése eldobná azokat az adatokat, amelyeket a fájl olyan modellekről őriz, amelyekhez ez a futás nem nyúl: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "A teljes fájl újraépítéséhez futtassa a `llamafit catalog refresh` parancsot --model nélkül."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "Nyílt súlyú nyelvi modellek keresése, méretezése, telepítése és ellenőrzése a llama.cpp számára a saját gépén."

msgid "Print machine-readable JSON instead of tables."
msgstr "Táblázatok helyett géppel olvasható JSON kiírása."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "Részletek írása a naplókönyvtár llamafit.log fájljába, és a hibakövetések megjelenítése."

msgid "Disable colours."
msgstr "A színek kikapcsolása."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "Beszéljen ezen a nyelven, például pt_PT. Az a nyelv, amely a LlamaFit-ben nincs meg, angolra vált, és a program megmondja, melyek vannak meg."

msgid "Print the version and exit."
msgstr "A verzió kiírása és kilépés."

msgid "Unexpected error: %(error)s"
msgstr "Váratlan hiba: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "A teljes hibakövetésért futtassa újra a --verbose kapcsolóval."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "A katalógus karbantartása: fájljainak ellenőrzése, változó mezőinek frissítése."

msgid "Keep only this use case."
msgstr "Csak ennek a felhasználási esetnek a megtartása."

msgid "Keep only models with this capability (repeatable)."
msgstr "Csak az ilyen képességű modellek megtartása (többször megadható)."

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Csak ezeknek a licencazonosítóknak a megtartása (többször megadható)."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "Csak ennek a fájlnak az ellenőrzése a beépített katalógus és az egyéni felülbírálások helyett."

msgid "Did you mean: %(ids)s?"
msgstr "Erre gondolt: %(ids)s?"

msgid "Run `llamafit list` to see every model id."
msgstr "Az összes modellazonosító megtekintéséhez futtassa a `llamafit list` parancsot."

msgid "no model named %(id)s in the catalog"
msgstr "nincs %(id)s nevű modell a katalógusban"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "%(count)d katalógusprobléma található; a részletekért futtassa a `llamafit catalog validate` parancsot."
msgstr[1] "%(count)d katalógusprobléma található; a részletekért futtassa a `llamafit catalog validate` parancsot."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "Nincs találat. Próbáljon tágabb --use-case, --capability, --license, --vendor vagy --search értéket."

msgid "invalid --use-case %(value)s"
msgstr "érvénytelen --use-case érték: %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "Érvényes felhasználási esetek: %(values)s"

