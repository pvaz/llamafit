msgid "could not read %(path)s: %(error)s"
msgstr "nem sikerült beolvasni a(z) %(path)s fájlt: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "Ellenőrizze, hogy a fájl létezik és olvasható."

msgid "could not fetch %(url)s: %(error)s"
msgstr "nem sikerült letölteni a(z) %(url)s címet: %(error)s"

msgid "Check your network connection and that the URL is reachable."
msgstr "Ellenőrizze a hálózati kapcsolatot, és hogy az URL elérhető."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "A(z) %(url)s a 206 Partial Content helyett HTTP %(status)d választ adott; lehet, hogy a kiszolgáló nem támogatja a tartománykéréseket."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Győződjön meg róla, hogy az URL letölthető GGUF fájlra mutat."

