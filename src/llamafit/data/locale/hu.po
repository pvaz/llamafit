# Hungarian can show it: the plural ending on "érték".
msgid "invalid --capability value: %(values)s"
msgid_plural "invalid --capability values: %(values)s"
msgstr[0] "érvénytelen --capability érték: %(values)s"
msgstr[1] "érvénytelen --capability értékek: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "Érvényes képességek: %(values)s"

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"A modellkatalógus listázása, a megadott szűrőkkel szűkítve.\n"
"\n"
"A táblázat modellenként legfeljebb három képességet mutat, a többit +N jelöléssel, és a megjelenített Minőség oszlop szerint van rendezve; az info és a --json minden képességet megjelenít."

msgid "Keep only this vendor, case-insensitive."
msgstr "Csak ennek a gyártónak a megtartása, kis- és nagybetűk megkülönböztetése nélkül."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "Részleges egyezés az azonosítóban, a névben, a gyártóban vagy a családban, kis- és nagybetűk megkülönböztetése nélkül."

msgid "Show at most this many."
msgstr "Legfeljebb ennyi megjelenítése."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "A llamafit list --search TEXT rövidítése."

msgid "Text to match against id, name, vendor or family."
msgstr "Az azonosítóval, a névvel, a gyártóval vagy a családdal egyeztetendő szöveg."

msgid "Show one model's facts, sources and every quant it publishes."
msgstr "Egy modell adatainak, forrásainak és minden közzétett kvantálásának megjelenítése."

msgid "A catalog model id."
msgstr "Egy katalógusbeli modellazonosító."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "A katalógus YAML fájljainak ellenőrzése a séma alapján, problémánként egy sor kiírásával."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "%(count)d fájl ellenőrizve, nem található probléma."
msgstr[1] "%(count)d fájl ellenőrizve, nem található probléma."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "A katalógus fájlneveinek, méreteinek, ellenőrzőösszegeinek és GGUF adatainak frissítése a Hugging Face-ről."

msgid "Refresh only this model id."
msgstr "Csak ennek a modellazonosítónak a frissítése."

msgid "Compute the refresh but write nothing."
msgstr "A frissítés kiszámítása, de semmi kiírása."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "Kilépés 1-gyel, ha bármi változna; semmit nem módosít, ütemezett CI feladathoz."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: figyelmeztetés: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "figyelmeztetés: %(warning)s (%(count)d modell: %(models)s)"
msgstr[1] "figyelmeztetés: %(warning)s (%(count)d modell: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: hiba: %(error)s"

msgid "Hint: %(hint)s"
msgstr "Tipp: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "a frissítéshez hálózati hozzáférés kell a Hugging Face-hez; ellenőrizze a kapcsolatot és a tároló azonosítójának helyességét."

msgid "No changes."
msgstr "Nincs változás."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "Egy modell nyers katalógusbejegyzésének kiírása, alapértelmezés szerint JSON, a --yaml kapcsolóval YAML formátumban."

msgid "Print YAML instead of JSON."
msgstr "YAML kiírása JSON helyett."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "Bemutatja, mit talált a program, mi hiúsult meg, és mi tenne elérhetővé többet."

