# Hungarian translation of LlamaFit.
# This file is distributed under the same licence as LlamaFit.
#
# NOT YET REVIEWED BY A NATIVE SPEAKER. It was written from the English template in one
# pass and it has had no second reader. By the standard docs/translations.md sets for
# every language, that is not enough: please read it line by line and correct it in a
# pull request.
#
# Hungarian glues its cases onto the word, so several messages put the placeholder
# somewhere else than the English does: "%(free)s free of %(total)s" becomes
# "%(total)s méretből %(free)s szabad", and "Source %(index)d" becomes the ordinal
# "%(index)d. forrás". A numeral is always followed by a singular noun, which is why the
# two plural forms read alike wherever the count itself is printed.
#
# "a(z)" is the usual written compromise where the definite article stands in front of a
# value nobody can see in advance: a model id or a path may begin with either a vowel or
# a consonant, and Hungarian chooses "a" or "az" accordingly.
#
# A Latin identifier takes no Hungarian suffix and cannot take one, so where the
# grammar would want a case ending on a model id, a flag or a quantisation name, the
# sentence is rephrased around it and an ordinary noun — "modell", "fájl", "parancs" —
# carries the ending instead.
#
msgid ""
msgstr ""
"Project-Id-Version: llamafit 0.1.0a1\n"
"Report-Msgid-Bugs-To: https://github.com/pvaz/llamafit/issues\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: hu\n"
"Language-Team: Hungarian\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "nothing measured touches this term, so there is no equation it appears in"
msgstr "a mérések közül semmi sem érinti ezt a tagot, így nincs olyan egyenlet, amelyben szerepelne"

msgid "%(measurements)d distinct configurations for %(parameters)d free parameters; fewer points than parameters gives numbers that look precise and are arbitrary"
msgstr "%(measurements)d különböző beállítás %(parameters)d szabad paraméterre; ha kevesebb a mérési pont, mint a paraméter, az eredmény pontosnak látszik, de önkényes"

msgid "the %(measurements)d configurations do not vary independently enough to separate %(parameters)d parameters"
msgstr "a %(measurements)d beállítás nem változik egymástól elég függetlenül ahhoz, hogy %(parameters)d paraméter szétválasztható legyen"

msgid "the fit put it at %(value).3f, which its own definition does not allow; the measurements disagree with each other under section 10.1's model"
msgstr "az illesztés szerint %(value).3f, amit a saját meghatározása nem enged meg; a mérések ellentmondanak egymásnak a 10.1. szakasz modellje szerint"

msgid "it came out at %(value).3f, but another parameter of the same fit was impossible, and least squares chose them against each other"
msgstr "%(value).3f jött ki, de ugyanennek az illesztésnek egy másik paramétere lehetetlen volt, és a legkisebb négyzetek módszere egymás rovására választotta ki őket"

msgid "the estimator has no such term: section 10.1 removed the per-layer overhead, which for a 28-layer model exceeded the whole measured token"
msgstr "a becslőnek nincs ilyen tagja: a 10.1. szakasz eltávolította a rétegenkénti többletet, ami egy 28 rétegű modellnél meghaladta a teljes mért tokent"

msgid "generation (llama-bench)"
msgstr "generálás (llama-bench)"

msgid "prompt (llama-bench)"
msgstr "prompt (llama-bench)"

msgid "generation, first request"
msgstr "generálás, első kérés"

msgid "generation, 1K prompt"
msgstr "generálás, 1K prompt"

msgid "prompt, 1K request"
msgstr "prompt, 1K kérés"

msgid "peak VRAM"
msgstr "csúcs VRAM"

msgid "no graphics card"
msgstr "nincs videokártya"

msgid "%(os)s %(version)s, %(cpu)s, %(ram)s, %(gpu)s%(driver)s"
msgstr "%(os)s %(version)s, %(cpu)s, %(ram)s, %(gpu)s%(driver)s"

msgid "%(flag)s was asked for as %(wanted)s but the run reports %(actual)s"
msgstr "a(z) %(flag)s kapcsolóra %(wanted)s értéket kértünk, de a futás %(actual)s értéket jelent"

msgid "The card was full and generation came in below three fifths of the estimate: the driver was paging to system memory, which does not fail and does not appear in the log."
msgstr "A kártya tele volt, és a generálás a becslés háromötöde alá esett: az illesztőprogram a rendszermemóriába lapozott, ami nem hibázik, és nem jelenik meg a naplóban."

msgid "Peak VRAM stayed clear of the card's total, so there was nothing for the driver to page."
msgstr "A csúcs VRAM messze maradt a kártya teljes méretétől, így az illesztőprogramnak nem volt mit lapoznia."

msgid "The card was full, which a good plan is meant to be, and the speed was close enough to the estimate that nothing was paging."
msgstr "A kártya tele volt, ahogy egy jó tervnek illik, és a sebesség elég közel járt a becsléshez ahhoz, hogy semmi ne lapozzon."

msgid "No VRAM reading was taken during the run, so this configuration has not been cleared of paging; it has only not been checked."
msgstr "A futás alatt nem történt VRAM-leolvasás, így ez a beállítás nem tisztázódott a lapozás gyanúja alól; csak nem lett ellenőrizve."

msgid "The card's total memory is unknown, so a reading of what was in use says nothing about how close to full it was."
msgstr "A kártya teljes memóriája ismeretlen, így a használatban lévő rész leolvasása semmit nem mond arról, mennyire volt tele."

msgid "There was no estimate to compare the measured speed against, so the second half of the signature could not be tested."
msgstr "Nem volt becslés, amihez a mért sebességet hasonlítani lehetett volna, így az ujjlenyomat második fele nem volt vizsgálható."

msgid "llama-bench did not produce JSON"
msgstr "a llama-bench nem adott JSON kimenetet"

msgid "llama-bench JSON is not a list of results"
msgstr "a llama-bench JSON kimenete nem eredménylista"

msgid "llama-bench JSON held no readable results"
msgstr "a llama-bench JSON kimenete nem tartalmazott olvasható eredményt"

msgid "no llama-bench result rows found"
msgstr "nem található llama-bench eredménysor"

msgid "could not open %(path)s for the server log"
msgstr "nem sikerült megnyitni a(z) %(path)s fájlt a kiszolgáló naplójához"

msgid "could not start llama-server"
msgstr "nem sikerült elindítani a llama-servert"

msgid "no output"
msgstr "nincs kimenet"

msgid "llama-bench exited with code %(code)d: %(detail)s"
msgstr "a llama-bench %(code)d kóddal lépett ki: %(detail)s"

msgid "llama-bench output could not be read: %(error)s"
msgstr "a llama-bench kimenete nem volt beolvasható: %(error)s"

msgid "llama-server did not become healthy"
msgstr "a llama-server nem került működőképes állapotba"

msgid "Its whole output is in the log file `bench` named; the end says why."
msgstr "A teljes kimenete abban a naplófájlban van, amelyet a `bench` megnevezett; a vége megmondja, miért."

msgid "%(path)s was written by a newer LlamaFit (benchmark format %(found)d, this build reads %(known)d)"
msgstr "a(z) %(path)s fájlt újabb LlamaFit írta (mérési formátum: %(found)d, ez a build %(known)d formátumot olvas)"

msgid "Upgrade LlamaFit, or move the file aside to start a new one."
msgstr "Frissítse a LlamaFitet, vagy tegye félre a fájlt, hogy új induljon."

msgid "a benchmark cannot be recorded against a simulated machine"
msgstr "szimulált géphez nem rögzíthető mérés"

msgid "Run `llamafit bench` on the machine itself, without --profile."
msgstr "Futtassa a `llamafit bench` parancsot magán a gépen, --profile nélkül."

msgid "the run did not use the settings it was given: %(problems)s"
msgstr "a futás nem a neki adott beállításokat használta: %(problems)s"

msgid "Nothing was stored. A result filed under flags it was not taken with would be believed later by everything that reads it."
msgstr "Semmi nem lett eltárolva. Egy olyan kapcsolók alá iktatott eredménynek, amelyekkel nem is készült, később mindenki hinne, aki beolvassa."

msgid "a conservative default; nobody has measured this card's backend overhead"
msgstr "óvatos alapérték; ennek a kártyának a háttérrendszer-többletét még senki nem mérte meg"

msgid "measured on this card with driver %(driver)s and llama.cpp %(build)s; one machine"
msgstr "ezen a kártyán mérve, %(driver)s illesztőprogrammal és llama.cpp %(build)s verzióval; egyetlen gépen"

msgid "A hybrid placement has to say how many layers are on the graphics card."
msgstr "A hibrid elhelyezésnél meg kell adni, hány réteg kerül a videokártyára."

msgid "Pass gpu_layers, which is what -ngl would be."
msgstr "Adja meg a gpu_layers értékét, vagyis azt, ami a -ngl lenne."

msgid "LlamaFit has not read %(model)s's %(quant)s file, so it cannot size it."
msgstr "A LlamaFit nem olvasta be a(z) %(model)s modell %(quant)s fájlját, ezért nem tudja megmérni a méretét."

msgid "Run `llamafit catalog refresh` to read the file's header."
msgstr "Futtassa a `llamafit catalog refresh` parancsot a fájl fejlécének beolvasásához."

msgid "the server process before any model buffer"
msgstr "a kiszolgálófolyamat minden modellpuffer előtt"

msgid "fitted to one machine's measurements; the least certain line here"
msgstr "egyetlen gép méréseihez illesztve; ez a legbizonytalanabb sor itt"

msgid "room for one logit per vocabulary entry per token of the batch"
msgstr "hely a köteg minden tokenjéhez szótárbejegyzésenként egy logitnak"

msgid "LlamaFit cannot size a %(kv_type)s key-value cache."
msgstr "A LlamaFit nem tud %(kv_type)s típusú kulcs-érték gyorsítótárat megmérni."

msgid "Use one of: %(types)s."
msgstr "Válasszon egyet ezek közül: %(types)s."

msgid "This model's file does not say how large its key-value cache is per token."
msgstr "Ennek a modellnek a fájlja nem mondja meg, mekkora a kulcs-érték gyorsítótára tokenenként."

msgid "Refresh the catalog so the file's header is read again."
msgstr "Frissítse a katalógust, hogy a fájl fejléce újra beolvasásra kerüljön."

msgid "the attention-layer count was assumed, not counted"
msgstr "a figyelmi rétegek számát nem megszámoltuk, hanem feltételeztük"

msgid "%(arch)s allocates more cache than its header describes; see the line below"
msgstr "a(z) %(arch)s több gyorsítótárat foglal, mint amennyit a fejléce leír; lásd az alábbi sort"

msgid "what %(arch)s allocates beyond its header, measured rather than derived"
msgstr "amit a(z) %(arch)s a fejlécén felül foglal, mérve és nem levezetve"

msgid "from the architecture's state dimensions; it does not grow with context"
msgstr "az architektúra állapotdimenzióiból; nem nő a kontextussal"

msgid "the projector file itself"
msgstr "maga a projektorfájl"

msgid "the projector's own compute space, measured at 248 MiB"
msgstr "a projektor saját számítási tere, 248 MiB-ra mérve"

msgid "attention projections, feed-forward weights and norms"
msgstr "figyelmi vetítések, előrecsatolt súlyok és normalizálások"

msgid "always-on experts, which run for every token"
msgstr "mindig aktív szakértők, amelyek minden tokenhez lefutnak"

msgid "routed experts, read across the bus once per micro-batch"
msgstr "irányított szakértők, amelyeket mikrökötegenként egyszer olvas át a busz"

msgid "this model ties its output projection to its embedding table"
msgstr "ez a modell a kimeneti vetítését a beágyazási táblájához köti"

msgid "llama.cpp keeps the embedding table in memory even at full offload"
msgstr "a llama.cpp teljes kihelyezés mellett is a memóriában tartja a beágyazási táblát"

msgid "streamed from disk as it is needed, not held in memory"
msgstr "igény szerint folyamban érkezik a lemezről, nem a memóriában áll"

msgid "held in memory, since streaming from disk was turned off"
msgstr "a memóriában áll, mivel a lemezről való folyamatos olvasás ki van kapcsolva"

msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "A Hugging Face %(status)d kódot adott vissza a(z) %(repo)s fájljainak listázásakor."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Nem sikerült beolvasni a(z) %(repo)s fájllistáját a Hugging Face-ről."

msgid "Check your network connection and try again."
msgstr "Ellenőrizze a hálózati kapcsolatot, és próbálja újra."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "A Hugging Face válasza a(z) %(repo)s tárolóra nem tartalmazott fájllistát."

msgid "Check that the repository id is correct and public."
msgstr "Ellenőrizze, hogy a tároló azonosítója helyes és nyilvános."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "a katalógusban %(count)d probléma van"
msgstr[1] "a katalógusban %(count)d probléma van"

msgid "Run `llamafit catalog validate` for details."
msgstr "A részletekért futtassa a `llamafit catalog validate` parancsot."

msgid "could not write %(path)s: %(error)s"
msgstr "nem sikerült írni a(z) %(path)s fájlba: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "Ellenőrizze, hogy a könyvtár írható, és van benne hely."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "a(z) %(path)s fájlban %(count)d probléma van, ezért nem frissíthető"
msgstr[1] "a(z) %(path)s fájlban %(count)d probléma van, ezért nem frissíthető"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "Futtassa a `llamafit catalog validate` parancsot, és előbb javítsa a fájlt."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "A(z) %(path)s nem volt teljesen beolvasható, ezért csak a(z) %(model)s frissítése eldobná azokat az adatokat, amelyeket a fájl olyan modellekről őriz, amelyekhez ez a futás nem nyúl: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "A teljes fájl újraépítéséhez futtassa a `llamafit catalog refresh` parancsot --model nélkül."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "Nyílt súlyú nyelvi modellek keresése, méretezése, telepítése és ellenőrzése a llama.cpp számára a saját gépén."

msgid "With no command, llamafit opens the terminal dashboard; in a pipe, or with --json, it prints what `llamafit recommend` would."
msgstr "Parancs nélkül a llamafit megnyitja a terminál vezérlőpultját; csővezetékben vagy --json esetén azt írja ki, amit a `llamafit recommend` írna."

msgid "Print machine-readable JSON instead of tables."
msgstr "Táblázatok helyett géppel olvasható JSON kiírása."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "Részletek írása a naplókönyvtár llamafit.log fájljába, és a hibakövetések megjelenítése."

msgid "Disable colours."
msgstr "A színek kikapcsolása."

msgid "Answer for the machine this hardware profile describes instead of this one. Nothing about this machine is probed, and every answer is marked as simulated. `llamafit hardware list` names the profiles you have."
msgstr "Arra a gépre válaszoljon, amelyet ez a hardverprofil ír le, ne erre. Ebből a gépből semmit nem vizsgál meg, és minden válasz szimuláltként van megjelölve. A `llamafit hardware list` felsorolja az Ön profiljait."

msgid "Pretend the graphics card has this much memory, for example 24G. Everything else stays as scanned, and every answer is marked as simulated."
msgstr "Tegyen úgy, mintha a videokártyának ennyi memóriája volna, például 24G. Minden más marad a beolvasottnak megfelelően, és minden válasz szimuláltként van megjelölve."

msgid "Pretend the machine has this much system memory, for example 128GiB. Every answer is marked as simulated."
msgstr "Tegyen úgy, mintha a gépnek ennyi rendszermemóriája volna, például 128GiB. Minden válasz szimuláltként van megjelölve."

msgid "Pretend the processor has this many physical cores. Every answer is marked as simulated."
msgstr "Tegyen úgy, mintha a processzornak ennyi fizikai magja volna. Minden válasz szimuláltként van megjelölve."

msgid "Plan, report and score no context longer than this. It caps the model's own length; it does not describe a machine."
msgstr "Ennél hosszabb kontextust ne tervezzen, ne jelentsen és ne pontozzon. A modell saját hosszát korlátozza; nem gépet ír le."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "Beszéljen ezen a nyelven, például pt_PT. Az a nyelv, amely a LlamaFit-ben nincs meg, angolra vált, és a program megmondja, melyek vannak meg."

msgid "Print the version and exit."
msgstr "A verzió kiírása és kilépés."

msgid "the output's encoding"
msgstr "a kimenet kódolása"

msgid "%(count)d character could not be written in %(encoding)s and is shown as ?."
msgid_plural "%(count)d characters could not be written in %(encoding)s and are shown as ?."
msgstr[0] "%(count)d karaktert nem lehetett %(encoding)s kódolással kiírni, ezért ? jelenik meg helyette."
msgstr[1] "%(count)d karaktert nem lehetett %(encoding)s kódolással kiírni, ezért ? jelenik meg helyettük."

msgid "Set PYTHONUTF8=1 in the environment and run again: Python then writes UTF-8, which carries every language."
msgstr "Állítsa be a PYTHONUTF8=1 értéket a környezetben, és futtassa újra: a Python ekkor UTF-8-at ír, ami minden nyelvet elbír."

msgid "%(option)s is an option of llamafit itself, so it goes before the command: `llamafit %(option)s %(rest)s`."
msgstr "A(z) %(option)s magának a llamafitnek a kapcsolója, ezért a parancs elé kerül: `llamafit %(option)s %(rest)s`."

msgid "Unexpected error: %(error)s"
msgstr "Váratlan hiba: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "A teljes hibakövetésért futtassa újra a --verbose kapcsolóval."

msgid "A catalog model id."
msgstr "Egy katalógusbeli modellazonosító."

msgid "Benchmark this quantisation instead of the planned one."
msgstr "A tervezett helyett ennek a kvantálásnak a mérése."

msgid "Size for this many tokens."
msgstr "Méretezés ennyi tokenre."

msgid "Set the micro-batch by hand; the budget is rebuilt around it."
msgstr "A mikroköteg kézi beállítása; a keret köréje épül újra."

msgid ""
"Measure a model on this machine and show the measurement beside the estimate.\n"
"\n"
"Runs llama-bench and a real server at the planned flags, stores the result with the conditions it was taken under, and flags a configuration the driver was paging. With --calibrate, fits the estimator's constants to this machine from every stored result and says by name which ones the measurements do not determine."
msgstr ""
"Megmér egy modellt ezen a gépen, és a mérést a becslés mellé teszi.\n"
"\n"
"Lefuttatja a llama-benchet és egy valódi kiszolgálót a tervezett kapcsolókkal, eltárolja az eredményt azokkal a körülményekkel együtt, amelyek között készült, és megjelöli azt a beállítást, amelynél az illesztőprogram lapozott. A --calibrate kapcsolóval minden eltárolt eredményből erre a gépre illeszti a becslő állandóit, és néven nevezi azokat, amelyeket a mérések nem határoznak meg."

msgid "Measure prompt processing at every micro-batch of the ladder, not only the planned one. Section 10.2 has two free parameters and one micro-batch is one equation, so without this the prompt half of a calibration cannot be fitted at all."
msgstr "A promptfeldolgozás mérése a létra minden mikrökötegénél, nem csak a tervezettnél. A 10.2. szakasznak két szabad paramétere van, és egy mikroköteg egy egyenlet, ezért enélkül a kalibráció promptra vonatkozó fele egyáltalán nem illeszthető."

msgid "Run llama-bench only. Faster, and it gives up the paging check, the buffer sizes and the tool-call test, all of which need a real server."
msgstr "Csak a llama-bench futtatása. Gyorsabb, de lemond a lapozásvizsgálatról, a pufferméretekről és az eszközhívás-tesztről, amelyekhez valódi kiszolgáló kell."

msgid "Print the result without writing it to the database."
msgstr "Az eredmény kiírása anélkül, hogy az adatbázisba kerülne."

msgid "Print the commands that would run, and run nothing."
msgstr "A lefutó parancsok kiírása anélkül, hogy bármi lefutna."

msgid "Fit the estimator's constants to this machine from every result."
msgstr "A becslő állandóinak illesztése erre a gépre minden eredményből."

msgid "List what is already stored and stop."
msgstr "A már eltárolt adatok felsorolása, majd leállás."

msgid "`llamafit bench` needs a model to measure"
msgstr "a `llamafit bench` parancsnak kell egy modell, amit megmérhet"

msgid "Try `llamafit bench <model>`, `--calibrate` on its own, or `--show`."
msgstr "Próbálja a `llamafit bench <model>` parancsot, a `--calibrate` kapcsolót önmagában, vagy a `--show` kapcsolót."

msgid "llama.cpp was not found, so there is nothing to benchmark with"
msgstr "a llama.cpp nem található, így nincs mivel mérni"

msgid "Run `llamafit doctor` to see where it was looked for."
msgstr "Futtassa a `llamafit doctor` parancsot, hogy lássa, hol kereste."

msgid "%(path)s has llama-server but no llama-bench"
msgstr "a(z) %(path)s helyen van llama-server, de nincs llama-bench"

msgid "Some release archives leave it out; a full build has it beside the server."
msgstr "Néhány kiadási archívumból kimarad; egy teljes build a kiszolgáló mellett tartalmazza."

msgid "this host is simulated, and a simulated machine cannot be measured"
msgstr "ez a gép szimulált, egy szimulált gépet pedig nem lehet megmérni"

msgid "Run `llamafit bench` on the machine itself."
msgstr "Futtassa a `llamafit bench` parancsot magán a gépen."

msgid "the model file is not on this machine: %(path)s"
msgstr "a modell fájlja nincs ezen a gépen: %(path)s"

msgid "Download it first; `llamafit plan` shows the path the command line uses."
msgstr "Előbb töltse le; a `llamafit plan` megmutatja azt az útvonalat, amelyet a parancssor használ."

msgid "Would run:"
msgstr "Ez futna le:"

msgid "Nothing has been measured on this machine yet."
msgstr "Ezen a gépen még semmit nem mértek meg."

msgid "Stored measurements"
msgstr "Eltárolt mérések"

msgid "model"
msgstr "modell"

msgid "kind"
msgstr "fajta"

msgid "gen tok/s"
msgstr "gen tok/s"

msgid "prompt tok/s"
msgstr "prompt tok/s"

msgid "taken"
msgstr "mérve"

msgid "flags"
msgstr "kapcsolók"

msgid "Nothing was written to the database, so no estimate will be relabelled."
msgstr "Semmi nem került az adatbázisba, így egyetlen becslés címkéje sem változik meg."

msgid "Estimated against measured"
msgstr "Becsült a mérttel szemben"

msgid "figure"
msgstr "mérőszám"

msgid "context"
msgstr "kontextus"

msgid "micro-batch"
msgstr "mikroköteg"

msgid "estimated"
msgstr "becsült"

msgid "measured"
msgstr "mért"

msgid "ratio"
msgstr "arány"

msgid "The plan sizes this configuration for %(context)s tokens and estimates %(tps)s generated tokens per second there. Nothing above ran at that context, so that figure is reported and not compared."
msgstr "A terv ezt a beállítást %(context)s tokenre méretezi, és ott %(tps)s generált tokent becsül másodpercenként. A fentiek közül semmi nem futott ezen a kontextuson, ezért ez az érték csak jelentve van, összehasonlítva nem."

msgid "%(count)d figure is outside the 0.8 to 1.25 band an uncalibrated formula is expected to land in."
msgid_plural "%(count)d figures are outside the 0.8 to 1.25 band an uncalibrated formula is expected to land in."
msgstr[0] "%(count)d érték esik kívül azon a 0,8 és 1,25 közötti sávon, amelyben egy kalibrálatlan képlettől elvárható, hogy landoljon."
msgstr[1] "%(count)d érték esik kívül azon a 0,8 és 1,25 közötti sávon, amelyben egy kalibrálatlan képlettől elvárható, hogy landoljon."

msgid "This configuration was paging."
msgstr "Ez a beállítás lapozott."

msgid "This configuration was not paging."
msgstr "Ez a beállítás nem lapozott."

msgid "Paging could not be checked."
msgstr "A lapozást nem lehetett ellenőrizni."

msgid "Peak VRAM was %(percent)s percent of the card, and generation was %(speed)s percent of the estimate."
msgstr "A csúcs VRAM a kártya %(percent)s százaléka volt, a generálás pedig a becslés %(speed)s százaléka."

msgid "Peak VRAM was %(percent)s percent of the card. Generation was not compared with the estimate."
msgstr "A csúcs VRAM a kártya %(percent)s százaléka volt. A generálás nem lett a becsléshez hasonlítva."

msgid "The largest context on the ladder that would not page is %(tokens)s."
msgstr "A létra legnagyobb olyan kontextusa, amely nem lapozna: %(tokens)s."

msgid "Calibration"
msgstr "Kalibráció"

msgid "constant"
msgstr "állandó"

msgid "value"
msgstr "érték"

msgid "from"
msgstr "forrás"

msgid "%(base)s + %(slope)s per 1K"
msgstr "%(base)s + %(slope)s 1K-nként"

msgid "%(count)d measured context"
msgid_plural "%(count)d measured contexts"
msgstr[0] "%(count)d mért kontextus"
msgstr[1] "%(count)d mért kontextus"

msgid "Nothing was fitted. Every line below says what its constant was missing; a calibration made from less than that would look precise and be arbitrary."
msgstr "Semmi nem lett illesztve. Az alábbi sorok mindegyike megmondja, mi hiányzott az állandójához; az ennél kevesebből készült kalibráció pontosnak látszana, és önkényes lenne."

msgid "%(name)s was not fitted: %(reason)s"
msgstr "a(z) %(name)s nem lett illesztve: %(reason)s"

msgid "%(count)d measured configuration"
msgid_plural "%(count)d measured configurations"
msgstr[0] "%(count)d mért beállítás"
msgstr[1] "%(count)d mért beállítás"

msgid "What the model is for. It sets the score weights, the speed target and the context a candidate is measured against."
msgstr "Mire való a modell. Ez szabja meg a pontozás súlyait, a sebességcélt és azt a kontextust, amelyhez egy jelöltet mérünk."

msgid "Capability the model must have; a model without it is excluded "
msgstr "Képesség, amellyel a modellnek rendelkeznie kell; az enélküli modell kimarad."

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Csak ezeknek a licencazonosítóknak a megtartása (többször megadható)."

msgid "balanced, quality or speed: moves a tenth of the weight between quality and speed. It leans the board; it does not replace the weights."
msgstr "balanced, quality vagy speed: a súly egytizedét mozgatja a minőség és a sebesség között. Megdönti a táblát; nem váltja fel a súlyokat."

msgid "Exclude anything larger to download, for example 40G or 7.5GiB."
msgstr "Az ennél nagyobb letöltések kizárása, például 40G vagy 7.5GiB."

msgid "The worst verdict to list: comfortable, fits or tight."
msgstr "A legrosszabb felsorolandó ítélet: comfortable, fits vagy tight."

msgid "Exclude candidates generating fewer tokens per second than this, in place of the speed a person reads at. Pass 0 when nobody is waiting on the tokens."
msgstr "Azoknak a jelölteknek a kizárása, amelyek ennél kevesebb tokent adnak másodpercenként, az olvasási sebesség helyett. Adjon meg 0-t, ha senki nem várja a tokeneket."

msgid "Order the rows drawn: score, speed, quality, context, size, prompt, card, ram, fit, model or quant, largest or best first unless :asc says otherwise. The # column keeps the ranking."
msgstr "A megrajzolt sorok rendezése: score, speed, quality, context, size, prompt, card, ram, fit, model vagy quant; a nagyobb, illetve a jobb elöl, hacsak a :asc mást nem mond. A # oszlop a rangsort őrzi."

msgid "Draw only rows whose id, name or quantisation contains this text."
msgstr "Csak azoknak a soroknak a megrajzolása, amelyek azonosítója, neve vagy kvantálása tartalmazza ezt a szöveget."

msgid "Draw only rows whose file is already on this machine."
msgstr "Csak azoknak a soroknak a megrajzolása, amelyek fájlja már ezen a gépen van."

msgid "Draw only rows that run this way: gpu, moe-offload, hybrid or cpu."
msgstr "Csak azoknak a soroknak a megrajzolása, amelyek így futnak: gpu, moe-offload, hybrid vagy cpu."

msgid "Draw only rows at or above this verdict: comfortable, fits or tight. The ranking is unchanged and a hidden row is still counted."
msgstr "Csak az ettől az ítélettől felfelé eső sorok megrajzolása: comfortable, fits vagy tight. A rangsor nem változik, és egy elrejtett sor is beleszámít."

msgid "Draw exactly these columns, comma-separated, in this order, named as --json names them: rank, model, quant, size, have, score, quality, gen, prompt, confidence, mode, vram, ram, verdict, context."
msgstr "Pontosan ezeknek az oszlopoknak a megrajzolása, vesszővel elválasztva, ebben a sorrendben, úgy nevezve, ahogy a --json nevezi őket: rank, model, quant, size, have, score, quality, gen, prompt, confidence, mode, vram, ram, verdict, context."

msgid "Draw every column whatever the terminal's width; a cell that does not fit folds."
msgstr "Minden oszlop megrajzolása a terminál szélességétől függetlenül; a be nem férő cella tördelődik."

msgid "Leave the candidates that were not ranked off the table. The reasons are still printed under it."
msgstr "A rangsorba nem került jelöltek kihagyása a táblázatból. Az okok ettől még megjelennek alatta."

msgid "invalid --min-fit %(value)s"
msgstr "érvénytelen --min-fit érték: %(value)s"

msgid "Valid values: %(values)s"
msgstr "Érvényes értékek: %(values)s"

msgid "invalid --prefer %(value)s"
msgstr "érvénytelen --prefer érték: %(value)s"

msgid "invalid --runs %(value)s"
msgstr "érvénytelen --runs érték: %(value)s"

msgid "invalid --sort %(value)s"
msgstr "érvénytelen --sort érték: %(value)s"

msgid "invalid --columns %(value)s"
msgstr "érvénytelen --columns érték: %(value)s"

msgid ""
"Rank the catalog for what you want to do on this machine.\n"
"\n"
"Every candidate is planned, sized and estimated here, so the first run scans the machine. Speeds compare candidates at 8K tokens of context; --explain expands a row into the scores, the weights, the budget and the speed breakdown that produced it."
msgstr ""
"Rangsorolja a katalógust aszerint, amit ezen a gépen tenni szeretne.\n"
"\n"
"Itt minden jelölt megtervezésre, méretezésre és becslésre kerül, ezért az első futás végigméri a gépet. A sebességek 8K token kontextuson hasonlítják össze a jelölteket; a --explain kibontja egy sorból azokat a pontszámokat, súlyokat, kereteket és sebességbontást, amelyek létrehozták."

msgid "Exclude candidates that cannot hold at least this many tokens."
msgstr "Azoknak a jelölteknek a kizárása, amelyek nem tudnak legalább ennyi tokent tartani."

msgid "Show at most this many rows."
msgstr "Legfeljebb ennyi sor megjelenítése."

msgid "Show every quantisation instead of the best one per model."
msgstr "Minden kvantálás megjelenítése a modellenkénti legjobb helyett."

msgid "Expand every row shown into the scores, weights, budget and speed breakdown behind it. Combine with --limit 1 for one model."
msgstr "Minden megjelenített sor kibontása a mögötte álló pontszámokra, súlyokra, keretre és sebességbontásra. Egyetlen modellhez használja a --limit 1 kapcsolóval."

msgid "Plan without a vision projector, freeing its memory."
msgstr "Tervezés látásprojektor nélkül, felszabadítva annak memóriáját."

msgid ""
"Rank every model by how well it uses this machine, whatever it is for.\n"
"\n"
"No use case, no weights and no score: this is the memory question on its own. Models are sized for 32K tokens of context, and the context column is the largest each one holds in the mode shown."
msgstr ""
"Rangsorol minden modellt aszerint, milyen jól használja ki ezt a gépet, bármire is való.\n"
"\n"
"Nincs felhasználási eset, nincsenek súlyok és nincs pontszám: ez pusztán a memória kérdése. A modellek 32K token kontextusra vannak méretezve, és a kontextusoszlop a megjelenített módban a legnagyobbat mutatja, amelyet az adott modell tart."

msgid "Only the configurations that use the machine well: at least half its memory held in weights, and no pool past four fifths."
msgstr "Csak azok a beállítások, amelyek jól kihasználják a gépet: a memória legalább fele súlyokban, és egyik készlet sem négyötödnél teltebb."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "A katalógus karbantartása: fájljainak ellenőrzése, változó mezőinek frissítése."

msgid "Keep only this use case."
msgstr "Csak ennek a felhasználási esetnek a megtartása."

msgid "Keep only models with this capability (repeatable)."
msgstr "Csak az ilyen képességű modellek megtartása (többször megadható)."

msgid "Show only this quantisation, matched case-insensitively, in both tables."
msgstr "Csak ennek a kvantálásnak a megjelenítése, kis- és nagybetűk megkülönböztetése nélkül, mindkét táblázatban."

msgid "Size every quantisation for this many tokens instead of the usual 32,768."
msgstr "Minden kvantálás méretezése ennyi tokenre a szokásos 32 768 helyett."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "Csak ennek a fájlnak az ellenőrzése a beépített katalógus és az egyéni felülbírálások helyett."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "Nincs találat. Próbáljon tágabb --use-case, --capability, --license, --vendor vagy --search értéket."

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"A modellkatalógus listázása, a megadott szűrőkkel szűkítve.\n"
"\n"
"A táblázat modellenként legfeljebb három képességet mutat, a többit +N jelöléssel, és a megjelenített Minőség oszlop szerint van rendezve; az info és a --json minden képességet megjelenít."

msgid "Keep only this vendor, case-insensitive."
msgstr "Csak ennek a gyártónak a megtartása, kis- és nagybetűk megkülönböztetése nélkül."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "Részleges egyezés az azonosítóban, a névben, a gyártóban vagy a családban, kis- és nagybetűk megkülönböztetése nélkül."

msgid "Show at most this many."
msgstr "Legfeljebb ennyi megjelenítése."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "A llamafit list --search TEXT rövidítése."

msgid "Text to match against id, name, vendor or family."
msgstr "Az azonosítóval, a névvel, a gyártóval vagy a családdal egyeztetendő szöveg."

msgid ""
"Show one model: its facts, the quants it publishes, and what each would cost on this machine.\n"
"\n"
"The last table is sized against this machine, so the first run scans it. One line per quantisation; plan opens one of those rows into the memory budget, the context ladder and the command line."
msgstr ""
"Egyetlen modell megjelenítése: adatai, az általa közzétett kvantálások, és hogy ezen a gépen melyik mibe kerülne.\n"
"\n"
"Az utolsó táblázat ehhez a géphez van méretezve, ezért az első futás végigméri. Kvantálásonként egy sor; a plan az egyik sort kibontja a memóriakeretre, a kontextuslétrára és a parancssorra."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "A katalógus YAML fájljainak ellenőrzése a séma alapján, problémánként egy sor kiírásával."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "%(count)d fájl ellenőrizve, nem található probléma."
msgstr[1] "%(count)d fájl ellenőrizve, nem található probléma."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "A katalógus fájlneveinek, méreteinek, ellenőrzőösszegeinek és GGUF adatainak frissítése a Hugging Face-ről."

msgid "Refresh only this model id."
msgstr "Csak ennek a modellazonosítónak a frissítése."

msgid "Compute the refresh but write nothing."
msgstr "A frissítés kiszámítása, de semmi kiírása."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "Kilépés 1-gyel, ha bármi változna; semmit nem módosít, ütemezett CI feladathoz."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: figyelmeztetés: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "figyelmeztetés: %(warning)s (%(count)d modell: %(models)s)"
msgstr[1] "figyelmeztetés: %(warning)s (%(count)d modell: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: hiba: %(error)s"

msgid "Hint: %(hint)s"
msgstr "Tipp: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "a frissítéshez hálózati hozzáférés kell a Hugging Face-hez; ellenőrizze a kapcsolatot és a tároló azonosítójának helyességét."

msgid "No changes."
msgstr "Nincs változás."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "Egy modell nyers katalógusbejegyzésének kiírása, alapértelmezés szerint JSON, a --yaml kapcsolóval YAML formátumban."

msgid "Print YAML instead of JSON."
msgstr "YAML kiírása JSON helyett."

msgid "Did you mean: %(ids)s?"
msgstr "Erre gondolt: %(ids)s?"

msgid "Run `llamafit list` to see every model id."
msgstr "Az összes modellazonosító megtekintéséhez futtassa a `llamafit list` parancsot."

msgid "no model named %(id)s in the catalog"
msgstr "nincs %(id)s nevű modell a katalógusban"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "%(count)d katalógusprobléma található; a részletekért futtassa a `llamafit catalog validate` parancsot."
msgstr[1] "%(count)d katalógusprobléma található; a részletekért futtassa a `llamafit catalog validate` parancsot."

msgid "invalid --use-case %(value)s"
msgstr "érvénytelen --use-case érték: %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "Érvényes felhasználási esetek: %(values)s"

msgid "invalid %(option)s value: %(values)s"
msgid_plural "invalid %(option)s values: %(values)s"
msgstr[0] "érvénytelen %(option)s érték: %(values)s"
msgstr[1] "érvénytelen %(option)s értékek: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "Érvényes képességek: %(values)s"

msgid "%(option)s is not a size: %(value)s"
msgstr "a(z) %(option)s nem méret: %(value)s"

msgid "Sizes look like 8G, 7.5GiB or 512M; a bare number is bytes."
msgstr "A méret így néz ki: 8G, 7.5GiB vagy 512M; a puszta szám bájtot jelent."

msgid "%(ceiling)s %(max)s is below %(floor)s %(min)s"
msgstr "%(ceiling)s %(max)s kisebb, mint %(floor)s %(min)s"

msgid "Raise %(ceiling)s, or lower %(floor)s."
msgstr "Emelje a(z) %(ceiling)s értékét, vagy csökkentse a(z) %(floor)s értékét."

msgid "`llamafit %(command)s` reports on the machine LlamaFit is running on"
msgstr "a `llamafit %(command)s` arról a gépről ad jelentést, amelyen a LlamaFit fut"

msgid "Drop --profile, --memory, --ram and --cpu-cores. To see the machine a profile describes, run `llamafit hardware show NAME --as-host`."
msgstr "Hagyja el a --profile, --memory, --ram és --cpu-cores kapcsolókat. Ha azt a gépet szeretné látni, amelyet egy profil leír, futtassa a `llamafit hardware show NAME --as-host` parancsot."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "Bemutatja, mit talált a program, mi hiúsult meg, és mi tenne elérhetővé többet."

msgid "Hardware profiles: describe a machine in a file and score models against it."
msgstr "Hardverprofilok: írjon le egy gépet egy fájlban, és pontozza hozzá a modelleket."

msgid "Validate only this file instead of every bundled and user profile."
msgstr "Csak ennek a fájlnak az ellenőrzése az összes beépített és saját profil helyett."

msgid "A profile name, or a path to a profile file."
msgstr "Egy profil neve vagy egy profilfájl útvonala."

msgid "%(count)d hardware profile problem found; run `llamafit hardware validate` for details."
msgid_plural "%(count)d hardware profile problems found; run `llamafit hardware validate` for details."
msgstr[0] "%(count)d hardverprofil-probléma található; a részletekért futtassa a `llamafit hardware validate` parancsot."
msgstr[1] "%(count)d hardverprofil-probléma található; a részletekért futtassa a `llamafit hardware validate` parancsot."

msgid "List the hardware profiles LlamaFit has: the bundled ones and your own."
msgstr "Felsorolja a LlamaFit hardverprofiljait: a beépítetteket és az Önéit."

msgid "No hardware profiles. Run `llamafit hardware path` to see where yours would go."
msgstr "Nincs hardverprofil. Futtassa a `llamafit hardware path` parancsot, hogy lássa, hová kerülnének az Önéi."

msgid ""
"Show one profile; with --as-host, the machine it stands in for.\n"
"\n"
"A host built from a profile is marked as simulated, in the table and in the JSON, so a what-if is never mistaken for a scan of this machine."
msgstr ""
"Megjelenít egy profilt; az --as-host kapcsolóval azt a gépet, amelyet helyettesít.\n"
"\n"
"A profilból felépített gép szimuláltként van megjelölve a táblázatban és a JSON-ban is, hogy egy feltételezést soha ne lehessen összetéveszteni ennek a gépnek a beolvasásával."

msgid "Show the host this profile substitutes, as `llamafit system` would."
msgstr "Annak a gépnek a megjelenítése, amelyet ez a profil helyettesít, úgy, ahogy a `llamafit system` mutatná."

msgid "Check hardware profile files against the schema, printing one line per problem."
msgstr "Hardverprofil-fájlok ellenőrzése a séma alapján, problémánként egy sor kiírásával."

msgid "Print the directory your own hardware profiles go in."
msgstr "Kiírja azt a könyvtárat, amelybe az Ön saját hardverprofiljai kerülnek."

msgid "It does not exist yet; create it and put a %(suffix)s file in it."
msgstr "Még nem létezik; hozza létre, és tegyen bele egy %(suffix)s kiterjesztésű fájlt."

msgid "Install what it takes to run a model: llama.cpp itself, and the weights."
msgstr "Telepíti, ami egy modell futtatásához kell: magát a llama.cpp-t és a súlyokat."

msgid "Fetch this quantisation instead of the first the catalog publishes."
msgstr "Ennek a kvantálásnak a letöltése a katalógus által közzétett első helyett."

msgid "Put the files here instead of under the configured downloads directory."
msgstr "A fájlok ide kerüljenek a beállított letöltési könyvtár helyett."

msgid "Use at most this much bandwidth, for example 5M. Shared across every worker, so the figure is the figure whatever --workers says."
msgstr "Legfeljebb ennyi sávszélesség használata, például 5M. Az összes munkaszál osztozik rajta, így az érték független attól, mit mond a --workers."

msgid "How many requests to keep in flight. More is not always faster, and a home connection is shared with whoever else is using it."
msgstr "Hány kérés legyen egyszerre úton. A több nem mindig gyorsabb, és egy otthoni kapcsolaton osztozik mindenkivel, aki éppen használja."

msgid "Do not ask before starting."
msgstr "Ne kérdezzen az indítás előtt."

msgid "Show what would be fetched and stop before fetching it."
msgstr "Megmutatja, mit töltene le, és leáll, mielőtt letöltené."

msgid "Fetch only the weights, not the vision projector or the draft model."
msgstr "Csak a súlyok letöltése, a látásprojektoré és a vázlatmodellé nem."

msgid "Re-read files that are already here and check them against the catalog."
msgstr "A már itt lévő fájlok újraolvasása és összevetése a katalógussal."

msgid "Fetch files the catalog holds no checksum for. Nothing will be able to tell you whether they arrived intact."
msgstr "Olyan fájlok letöltése, amelyekhez a katalógusnak nincs ellenőrzőösszege. Semmi nem fogja tudni megmondani, hogy épségben érkeztek-e meg."

msgid "Show at most this many entries."
msgstr "Legfeljebb ennyi bejegyzés megjelenítése."

msgid "Download a model's weights, resuming anything an earlier run left and checking every file against the catalog's checksum."
msgstr "Letölti egy modell súlyait, folytatva, amit egy korábbi futás hagyott, és minden fájlt összevetve a katalógus ellenőrzőösszegével."

msgid "Start the download?"
msgstr "Induljon a letöltés?"

msgid "Show what has been downloaded, newest first."
msgstr "Megmutatja, mi lett letöltve, a legújabbal kezdve."

msgid "Nothing has been downloaded yet."
msgstr "Még semmi nem lett letöltve."

msgid "Install this backend instead of the one chosen for your GPU: cuda, vulkan, hip, sycl, metal or cpu."
msgstr "Ennek a háttérrendszernek a telepítése a GPU-jához választott helyett: cuda, vulkan, hip, sycl, metal vagy cpu."

msgid "Install here instead of ~/.llamafit/llama.cpp."
msgstr "Telepítés ide a ~/.llamafit/llama.cpp helyett."

msgid "Install this release tag, for example b6100, not the latest."
msgstr "Ennek a kiadási címkének a telepítése, például b6100, nem a legutóbbié."

msgid "invalid --backend %(value)s"
msgstr "érvénytelen --backend érték: %(value)s"

msgid "Valid backends: %(values)s"
