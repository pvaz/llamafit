msgstr "A(z) %(model)s nem tesz közzé %(quant)s kvantálást."

msgid "It publishes: %(quants)s"
msgstr "Ezeket teszi közzé: %(quants)s"

msgid "the catalog does not record how big %(quant)s is."
msgstr "a katalógus nem rögzíti, mekkora a(z) %(quant)s."

msgid "Run `llamafit catalog refresh` to fill in the sizes."
msgstr "Futtassa a `llamafit catalog refresh` parancsot a méretek kitöltéséhez."

msgid "the catalog holds no checksum for %(files)s."
msgid_plural "the catalog holds no checksums for %(files)s."
msgstr[0] "a katalógusnak nincs ellenőrzőösszege ehhez: %(files)s."
msgstr[1] "a katalógusnak nincs ellenőrzőösszege ezekhez: %(files)s."

