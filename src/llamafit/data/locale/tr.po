msgstr "Ağ bağlantınızı denetleyin ve sürdürmek için komutu yeniden çalıştırın."

msgid "%(file)s needs authorisation (HTTP %(status)d)."
msgstr "%(file)s yetkilendirme istiyor (HTTP %(status)d)."

msgid "This repository is gated. Accept its terms on Hugging Face and set HF_TOKEN to a token that can read it."
msgstr "Bu depo kapalıdır. Koşullarını Hugging Face üzerinde kabul edin ve HF_TOKEN değerini onu okuyabilen bir belirtece ayarlayın."

msgid "%(file)s is not at %(url)s any more (HTTP 404)."
msgstr "%(file)s artık %(url)s adresinde değil (HTTP 404)."

