msgstr "%(gpu)s kullanmak için %(backend)s ya da Vulkan arka ucuna sahip bir llama.cpp derlemesi kurun."

msgid "%(gpu)s: VRAM size unknown"
msgstr "%(gpu)s: VRAM boyutu bilinmiyor"

