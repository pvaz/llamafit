msgstr "modelin üstverisini taşıyan parça eksik: %(key)s %(numbers)s alındı, birinin 0 olması bekleniyordu"

msgid "Pass every shard of the split model, including the first."
msgstr "Bölünmüş modelin ilki dâhil tüm parçalarını verin."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "eksik parça kümesi: %(key)s 0 ile %(last)d arasında bekleniyordu, %(numbers)s alındı"

msgid "Pass each shard of the split model exactly once."
msgstr "Bölünmüş modelin her parçasını tam olarak bir kez verin."

msgid "incomplete shard set: the model declares %(tensors)s and its %(shards)s hold %(held)d between them"
msgstr "eksik parça kümesi: model %(tensors)s bildiriyor ve %(shards)s parçası aralarında %(held)d tutuyor"

msgid "%(count)d tensor"
msgid_plural "%(count)d tensors"
msgstr[0] "%(count)d tensör"
msgstr[1] "%(count)d tensör"

msgid "Check your network connection and that the URL is reachable."
msgstr "Ağ bağlantınızı ve URL'ye erişilebildiğini denetleyin."

