msgstr "%(size)s boş"

msgid "Most useful models need 5 to 120 GB; free space or change the downloads directory."
msgstr "İşe yarar modellerin çoğu 5 ile 120 GB arasında yer ister; yer açın ya da indirme dizinini değiştirin."

msgid "%(model)s has no %(quant)s quantisation"
msgstr "%(model)s modelinde %(quant)s nicemlemesi yok"

