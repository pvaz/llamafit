msgid_plural "%(path)s already holds %(count)d files that LlamaFit did not install."
msgstr[0] "%(path)s konumunda LlamaFit'in kurmadığı %(count)d dosya zaten var."
msgstr[1] "%(path)s konumunda LlamaFit'in kurmadığı %(count)d dosya zaten var."

msgid "%(name)s has no published checksum, so it cannot be verified."
msgstr "%(name)s için yayımlanmış sağlama toplamı yok, bu yüzden doğrulanamıyor."

msgid "Pass --allow-unverified to install it anyway, knowing the archive is unchecked."
msgstr "Arşivin denetlenmediğini bilerek yine de kurmak için --allow-unverified verin."

msgid "could not download %(url)s: %(error)s"
msgstr "%(url)s indirilemedi: %(error)s"

msgid "the connection was closed"
msgstr "bağlantı kapandı"

msgid "Run the command again; it continues from where it stopped."
msgstr "Komutu yeniden çalıştırın; kaldığı yerden sürer."

msgid "the download of %(url)s stopped early: %(error)s"
msgstr "%(url)s indirmesi erken durdu: %(error)s"

msgid "%(got)s of %(want)s arrived"
msgstr "%(want)s içinden %(got)s geldi"

msgid "the disk holding %(path)s is full."
msgstr "%(path)s konumunu tutan disk dolu."

msgid "Free some space and run the command again; the download resumes."
msgstr "Yer açın ve komutu yeniden çalıştırın; indirme sürer."

msgid "Check that the directory exists and is writable."
msgstr "Dizinin var olduğunu ve yazılabilir olduğunu denetleyin."

msgid "%(name)s did not match its published checksum and was discarded."
msgstr "%(name)s, yayımlanmış sağlama toplamıyla eşleşmedi ve atıldı."

msgid "Nothing was unpacked. Run the command again: the archive arrived damaged, which a second download usually fixes."
msgstr "Hiçbir şey açılmadı. Komutu yeniden çalıştırın: arşiv bozuk geldi, ikinci bir indirme bunu genellikle düzeltir."

msgid "%(archive)s contains %(name)s, which would be written outside the install directory."
msgstr "%(archive)s, kurulum dizininin dışına yazılacak olan %(name)s ögesini içeriyor."

msgid "Do not install this archive; report it to the llama.cpp project."
msgstr "Bu arşivi kurmayın; llama.cpp projesine bildirin."

msgid "%(name)s is not an archive LlamaFit knows how to unpack."
msgstr "%(name)s, LlamaFit'in açmayı bildiği bir arşiv değil."

msgid "%(name)s could not be unpacked: %(error)s"
msgstr "%(name)s açılamadı: %(error)s"

msgid "Delete it and run the command again to download it afresh."
msgstr "Silin ve baştan indirilmesi için komutu yeniden çalıştırın."

msgid "the archive holds no %(name)s."
msgstr "arşivde %(name)s yok."

msgid "Report this; the release layout has changed."
msgstr "Bunu bildirin; yayın düzeni değişmiş."

msgid "%(path)s was not installed by LlamaFit."
msgstr "%(path)s LlamaFit tarafından kurulmamış."

msgid "Pass --force to replace it, or --dir to install somewhere else. LlamaFit never overwrites an installation it did not create."
msgstr "Değiştirmek için --force, başka bir yere kurmak için --dir verin. LlamaFit kendi oluşturmadığı bir kurulumun üzerine hiçbir zaman yazmaz."

msgid "%(path)s has %(free)s free; this install needs %(needed)s."
msgstr "%(path)s üzerinde %(free)s boş var; bu kurulum %(needed)s istiyor."

msgid "Free some space, or pass --dir to install on another volume."
msgstr "Yer açın ya da başka bir birime kurmak için --dir verin."

msgid "the %(backend)s libraries are not in the installed directory."
msgstr "%(backend)s kitaplıkları kurulum dizininde değil."

msgid "no ggml backend libraries were installed; the build may be a static one."
msgstr "hiçbir ggml arka uç kitaplığı kurulmadı; derleme statik olabilir."

msgid "Your PATH could not be read, so it will not be changed."
msgstr "PATH değeriniz okunamadı, bu yüzden değiştirilmeyecek."

msgid "Add %(path)s to your user PATH (HKCU\\Environment)."
msgstr "%(path)s kullanıcı PATH değerinize eklenecek (HKCU\\Environment)."

msgid "To undo: run `setx PATH \"%(previous)s\"`, or remove the entry in System > About > Advanced system settings > Environment Variables."
msgstr "Geri almak için: `setx PATH \"%(previous)s\"` çalıştırın ya da Sistem > Hakkında > Gelişmiş sistem ayarları > Ortam Değişkenleri yolundan kaydı kaldırın."

msgid "%(path)s is already on your PATH."
msgstr "%(path)s zaten PATH değerinizde."

msgid "Nothing to undo."
msgstr "Geri alınacak bir şey yok."

msgid "Append a PATH line for %(path)s to %(file)s."
msgstr "%(file)s dosyasına %(path)s için bir PATH satırı eklenecek."

msgid "To undo: delete the two lines marked `%(mark)s` from %(file)s."
msgstr "Geri almak için: %(file)s dosyasından `%(mark)s` ile imlenmiş iki satırı silin."

msgid "your PATH could not be changed: %(error)s"
msgstr "PATH değeriniz değiştirilemedi: %(error)s"

msgid "To remove it later, delete %(path)s."
msgstr "Sonradan kaldırmak için %(path)s ögesini silin."

msgid "the most recent %(count)d llama.cpp releases hold no build."
msgstr "llama.cpp'nin en son %(count)d yayınında derleme yok."

msgid "Name one with `llamafit install llama.cpp --tag ...`."
msgstr "`llamafit install llama.cpp --tag ...` ile birini adlandırın."

msgid "could not reach GitHub at %(url)s: %(error)s"
msgstr "%(url)s adresinde GitHub'a ulaşılamadı: %(error)s"

msgid "GitHub refused the request for %(url)s: the rate limit is exhausted."
msgstr "GitHub, %(url)s isteğini geri çevirdi: hız sınırı tükendi."

msgid "Wait for the limit to reset, or set GITHUB_TOKEN to a personal access token with no scopes."
msgstr "Sınırın sıfırlanmasını bekleyin ya da GITHUB_TOKEN değerini kapsamı olmayan kişisel bir erişim belirtecine ayarlayın."

msgid "GitHub has no release at %(url)s."
msgstr "GitHub'da %(url)s adresinde yayın yok."

msgid "Check the tag with `llamafit install llama.cpp --tag ...`."
msgstr "Etiketi `llamafit install llama.cpp --tag ...` ile denetleyin."

msgid "GitHub returned %(status)d for %(url)s."
msgstr "GitHub, %(url)s için %(status)d döndürdü."

msgid "GitHub's answer for %(url)s was not JSON."
msgstr "GitHub'ın %(url)s için verdiği yanıt JSON değildi."

msgid "GitHub's answer did not describe a release."
msgstr "GitHub'ın yanıtı bir yayını anlatmıyordu."

msgid "no llama-server answering"
msgstr "yanıt veren llama-server yok"

msgid "unexpected response: %(error)s"
msgstr "beklenmeyen yanıt: %(error)s"

msgid "%(model)s holds %(native)s tokens, fewer than the %(minimum)s asked for."
msgstr "%(model)s %(native)s token tutuyor; bu, istenen %(minimum)s değerinden az."

msgid "No configuration of this model fits this machine."
msgstr "Bu modelin hiçbir yapılandırması bu makineye sığmıyor."

msgid "Routed experts are held in system memory, and so are the always-on shared experts, which is what -ot ffn_.*_shexp=CPU does; attention and the KV cache stay on the card."
msgstr "Yönlendirilen uzmanlar sistem belleğinde tutulur; her zaman etkin olan ortak uzmanlar da öyle, ki -ot ffn_.*_shexp=CPU tam bunu yapar; dikkat ve KV önbelleği kartta kalır."

msgid "Routed experts are held in system memory; attention, the KV cache and the shared experts stay on the card."
msgstr "Yönlendirilen uzmanlar sistem belleğinde tutulur; dikkat, KV önbelleği ve ortak uzmanlar kartta kalır."

msgid "%(layers)s layers are on the card and the rest run on the processor."
msgstr "%(layers)s katman kartta, geri kalanı işlemcide çalışır."

msgid "Nothing runs on a graphics card: every weight is in system memory."
msgstr "Hiçbir şey ekran kartında çalışmıyor: her ağırlık sistem belleğinde."

msgid "%(gpus)s is here, but nothing could read how much of it is free, so this plan was made as if it were not. The real machine will be faster than these figures."
msgstr "%(gpus)s burada, ama hiçbir şey ne kadarının boş olduğunu okuyamadı; bu yüzden bu plan kart yokmuş gibi yapıldı. Gerçek makine bu değerlerden hızlı olacak."

msgid "Sized for %(context)s tokens rather than the %(requested)s asked for."
msgstr "İstenen %(requested)s yerine %(context)s token için boyutlandırıldı."

msgid "The KV cache is quantised to %(type)s to reach this context."
msgstr "Bu bağlama ulaşmak için KV önbelleği %(type)s türüne nicemlendi."

msgid "Vision is off: the projector did not fit, on the card or in system memory."
msgstr "Görü kapalı: yansıtıcı ne karta ne de sistem belleğine sığdı."

msgid "The vision projector is in system memory (--no-mmproj-offload), which costs nothing measurable for text and makes images slower."
msgstr "Görü yansıtıcısı sistem belleğinde (--no-mmproj-offload); bu metin için ölçülebilir bir bedel getirmez, görüntüleri ise yavaşlatır."

msgid "%(threads)s threads, not the %(available)s this processor has: the efficiency cores are left out because generation measures slower with them, and what is left is the threads the performance cores provide."
msgstr "Bu işlemcideki %(available)s değil, %(threads)s iş parçacığı: verimlilik çekirdekleri dışarıda bırakılıyor, çünkü onlarla üretim daha yavaş ölçülüyor; geriye performans çekirdeklerinin verdiği iş parçacıkları kalıyor."

msgid "Tight: %(vram)s of the graphics card is free and this needs %(needed)s, so another program can push it over. The context tier table is how a launch script recovers."
msgstr "Sıkışık: ekran kartının %(vram)s kadarı boş ve bu %(needed)s istiyor; başka bir program onu sınırın ötesine itebilir. Bağlam basamağı tablosu, bir başlatma betiğinin bundan nasıl kurtulduğudur."

msgid "no %(capability)s capability, which %(use_case)s needs; ask for a different use case, or add it to the entry when the model really has it"
msgstr "%(use_case)s için gereken %(capability)s yeteneği yok; başka bir kullanım alanı isteyin ya da model gerçekten bu yeteneğe sahipse kaydına ekleyin"

msgid "no %(capability)s capability; drop it from the request to see this model"
msgstr "%(capability)s yeteneği yok; bu modeli görmek için onu isteğinizden çıkarın"

msgid "%(size)s to download, over the %(limit)s this request allows"
msgstr "indirilecek %(size)s, bu isteğin izin verdiği %(limit)s değerinin üzerinde"

msgid "unknown quantisation %(quant)s, so its cost in quality cannot be told"
msgstr "bilinmeyen nicemleme %(quant)s, bu yüzden kalitedeki bedeli söylenemiyor"

msgid "nowhere to put it: no placement fits this machine at any context"
msgstr "koyacak yer yok: hiçbir yerleştirme bu makineye hiçbir bağlamda sığmıyor"

msgid "holds %(fit)s tokens at most, under the %(minimum)s asked for; lower the minimum context or free memory to see it ranked"
msgstr "en çok %(fit)s token tutuyor; bu, istenen %(minimum)s değerinin altında. En küçük bağlamı düşürün ya da sıralanmış görmek için bellek boşaltın"

msgid "generates %(tps)s tokens per second, below the %(floor)s this request asks for; lower --min-tps or choose a smaller model or quantisation"
msgstr "saniyede %(tps)s token üretiyor; bu, bu isteğin istediği %(floor)s değerinin altında. --min-tps değerini düşürün ya da daha küçük bir model veya nicemleme seçin"

msgid "generates %(tps)s tokens per second, below the %(floor)s a person reads at: a batch tool on this machine and not one to sit in front of; a smaller model or quantisation would keep up"
msgstr "saniyede %(tps)s token üretiyor; bu, bir insanın okuduğu %(floor)s değerinin altında: bu makinede karşısına oturulacak değil, toplu iş aracıdır; daha küçük bir model ya da nicemleme yetişirdi"

msgid "unknown use case %(use_case)s"
msgstr "bilinmeyen kullanım alanı %(use_case)s"

msgid "Known use cases: %(known)s."
msgstr "Bilinen kullanım alanları: %(known)s."

msgid "unknown score part %(part)s in the weights for %(use_case)s"
msgstr "%(use_case)s ağırlıklarında bilinmeyen puan bölümü %(part)s"

msgid "The parts are: %(parts)s."
msgstr "Bölümler şunlar: %(parts)s."

msgid "the weights for %(use_case)s leave out %(part)s"
msgstr "%(use_case)s ağırlıklarında %(part)s eksik"

msgid "Overriding a use case means giving all four parts: %(parts)s."
msgstr "Bir kullanım alanını geçersiz kılmak, dört bölümün hepsini vermek demektir: %(parts)s."

msgid "the weight for %(part)s in %(use_case)s is below zero"
msgstr "%(use_case)s içindeki %(part)s ağırlığı sıfırın altında"

msgid "A weight says how much a part counts; it cannot count less than none."
msgstr "Ağırlık, bir bölümün ne kadar saydığını söyler; hiçten az sayamaz."

msgid "the weights for %(use_case)s add up to nothing"
msgstr "%(use_case)s ağırlıklarının toplamı sıfır"

msgid "At least one part has to count for something."
msgstr "En az bir bölümün bir şey sayması gerekir."

msgid "unknown preference %(prefer)s"
msgstr "bilinmeyen yeğleme %(prefer)s"

msgid "Preferences: %(known)s."
msgstr "Yeğlemeler: %(known)s."

msgid "Install or repair the NVIDIA driver; nvidia-smi ships with it and must be on PATH."
msgstr "NVIDIA sürücüsünü kurun ya da onarın; nvidia-smi onunla birlikte gelir ve PATH üzerinde olmalıdır."

msgid "Install ROCm (Linux) to expose AMD VRAM figures; without it the GPU is listed by name only."
msgstr "AMD VRAM değerlerinin görünmesi için ROCm kurun (Linux); onsuz GPU yalnızca adıyla listelenir."

msgid "PowerShell could not list video controllers; run from a normal user session."
msgstr "PowerShell görüntü denetleyicilerini listeleyemedi; normal bir kullanıcı oturumundan çalıştırın."

msgid "Install pciutils to list GPUs by name when no vendor tool is available."
msgstr "Üretici aracı yokken GPU'ları adıyla listelemek için pciutils kurun."

msgid "DDR type and speed were not readable; on Linux run once with sudo (dmidecode) or accept the measured bandwidth instead."
msgstr "DDR türü ve hızı okunamadı; Linux'ta bir kez sudo ile (dmidecode) çalıştırın ya da bunun yerine ölçülen bant genişliğini kabul edin."

msgid "py-cpuinfo failed; the CPU model and instruction sets are unknown."
msgstr "py-cpuinfo başarısız oldu; CPU modeli ve komut kümeleri bilinmiyor."

msgid "psutil could not count the CPU cores; thread choice falls back to one core. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil CPU çekirdeklerini sayamadı; iş parçacığı seçimi tek çekirdeğe döner. psutil'i `pip install --force-reinstall psutil` ile yeniden kurun."

msgid "psutil could not read the memory totals; budgets cannot be computed until this works. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil bellek toplamlarını okuyamadı; bu çalışana kadar bütçeler hesaplanamaz. psutil'i `pip install --force-reinstall psutil` ile yeniden kurun."

msgid "Could not read performance-core count from sysctl."
msgstr "Performans çekirdeği sayısı sysctl'den okunamadı."

msgid "llama-server exists but did not report a version; the binary may be broken."
msgstr "llama-server var ama bir sürüm bildirmedi; ikili dosya bozuk olabilir."

msgid "system_profiler failed; GPU information is unavailable."
msgstr "system_profiler başarısız oldu; GPU bilgisi yok."

msgid "Install the Vulkan tools (vulkan-tools on Linux, the vendor's Vulkan runtime on Windows) so an unsized card's memory can be read from its driver. This probe runs only when no vendor tool sized the card, so it is the last source there is."
msgstr "Boyutu okunamayan bir kartın belleği sürücüsünden okunabilsin diye Vulkan araçlarını kurun (Linux'ta vulkan-tools, Windows'ta üreticinin Vulkan çalışma zamanı). Bu yoklama yalnızca hiçbir üretici aracı kartı boyutlandıramadığında çalışır, yani var olan son kaynaktır."

msgid "No vendor tool reported the GPU's memory size; record the size in a hardware profile so budgets can be computed for this machine."
msgstr "GPU'nun bellek boyutunu hiçbir üretici aracı bildirmedi; bu makine için bütçelerin hesaplanabilmesi adına boyutu bir donanım profiline kaydedin."

msgid "llama.cpp installed"
msgstr "llama.cpp kurulu"

msgid "build %(build)s at %(path)s, backends: %(backends)s"
msgstr "%(path)s içinde %(build)s derlemesi, arka uçlar: %(backends)s"

msgctxt "llama.cpp build"
msgid "unknown"
msgstr "bilinmiyor"

msgid "llama.cpp not found"
msgstr "llama.cpp bulunamadı"

msgid "no llama-server binary was found"
msgstr "llama-server ikili dosyası bulunamadı"

msgid "Run `llamafit install llama.cpp`, which picks the right build for this machine, checks it against its published checksum, and never touches an installation LlamaFit did not create."
msgstr "`llamafit install llama.cpp` çalıştırın; bu makine için doğru derlemeyi seçer, onu yayımlanmış sağlama toplamına göre denetler ve LlamaFit'in oluşturmadığı bir kuruluma hiç dokunmaz."

msgid "Memory size unknown"
msgstr "Bellek boyutu bilinmiyor"

msgid "LlamaFit could not read this machine's memory totals, so it cannot work out what will fit."
msgstr "LlamaFit bu makinenin bellek toplamlarını okuyamadı, bu yüzden neyin sığacağını hesaplayamıyor."

msgid "%(gpu)s: no %(backend)s backend in llama.cpp"
msgstr "%(gpu)s: llama.cpp içinde %(backend)s arka ucu yok"

msgid "llama.cpp was built with: %(backends)s"
msgstr "llama.cpp şununla derlendi: %(backends)s"

msgctxt "backends"
msgid "unknown"
msgstr "bilinmiyor"

msgid "Install a llama.cpp build with the %(backend)s or Vulkan backend to use %(gpu)s."
msgstr "%(gpu)s kullanmak için %(backend)s ya da Vulkan arka ucuna sahip bir llama.cpp derlemesi kurun."

msgid "%(gpu)s: VRAM size unknown"
msgstr "%(gpu)s: VRAM boyutu bilinmiyor"

msgid "the vendor tool that reports memory was not available"
msgstr "belleği bildiren üretici aracı yoktu"

msgid "%(gpus)s: planned around, not planned on"
msgstr "%(gpus)s: üzerine değil, çevresine planlandı"

msgid "with no reading of how much of the card is free, every budget and every speed on this machine was computed as if there were no card: they are CPU-only figures, and the real machine will be faster."
msgstr "kartın ne kadarının boş olduğu okunamadığı için bu makinedeki her bütçe ve her hız hiç kart yokmuş gibi hesaplandı: bunlar yalnızca CPU değerleridir ve gerçek makine daha hızlı olacak."

msgid "Install the Vulkan tools so the size can be read from the driver, or record it in a hardware profile (`llamafit hardware path` says where those go) and pass --profile."
msgstr "Boyutun sürücüden okunabilmesi için Vulkan araçlarını kurun ya da boyutu bir donanım profiline kaydedip (`llamafit hardware path` bunların nereye gittiğini söyler) --profile verin."

