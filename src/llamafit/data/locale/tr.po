msgstr "%(path)s okunamadı: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "Dosyanın var olduğunu ve okunabildiğini denetleyin."

msgid "could not fetch %(url)s: %(error)s"
msgstr "%(url)s alınamadı: %(error)s"

msgid "Check your network connection and that the URL is reachable."
msgstr "Ağ bağlantınızı ve URL'ye erişilebildiğini denetleyin."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s, 206 Partial Content yerine HTTP %(status)d döndürdü; sunucu aralık isteklerini desteklemiyor olabilir."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "URL'nin indirilebilir bir GGUF dosyasına işaret ettiğini doğrulayın."

