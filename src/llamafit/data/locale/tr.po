msgstr "%(program)s: bulunamadı"

msgid "no output"
msgstr "çıktı yok"

msgid "exit code %(code)d: %(detail)s"
msgstr "çıkış kodu %(code)d: %(detail)s"

msgid "llama.cpp not found: no llama-server on PATH, in LLAMA_CPP_PATH or in the usual directories"
msgstr "llama.cpp bulunamadı: PATH üzerinde, LLAMA_CPP_PATH içinde ya da alışılmış dizinlerde llama-server yok"

msgid "no ggml backend libraries found next to llama-server; the build may be static"
msgstr "llama-server yanında ggml arka uç kitaplıkları bulunamadı; derleme statik olabilir"

msgid "no llama-server answering"
msgstr "yanıt veren llama-server yok"

msgid "unexpected response: %(error)s"
msgstr "beklenmeyen yanıt: %(error)s"

msgid "Install or repair the NVIDIA driver; nvidia-smi ships with it and must be on PATH."
msgstr "NVIDIA sürücüsünü kurun ya da onarın; nvidia-smi onunla birlikte gelir ve PATH üzerinde olmalıdır."

msgid "Install ROCm (Linux) to expose AMD VRAM figures; without it the GPU is listed by name only."
msgstr "AMD VRAM değerlerinin görünmesi için ROCm kurun (Linux); onsuz GPU yalnızca adıyla listelenir."

msgid "PowerShell could not list video controllers; run from a normal user session."
msgstr "PowerShell görüntü denetleyicilerini listeleyemedi; normal bir kullanıcı oturumundan çalıştırın."

msgid "Install pciutils to list GPUs by name when no vendor tool is available."
msgstr "Üretici aracı yokken GPU'ları adıyla listelemek için pciutils kurun."

msgid "DDR type and speed were not readable; on Linux run once with sudo (dmidecode) or accept the measured bandwidth instead."
msgstr "DDR türü ve hızı okunamadı; Linux'ta bir kez sudo ile (dmidecode) çalıştırın ya da bunun yerine ölçülen bant genişliğini kabul edin."

msgid "py-cpuinfo failed; the CPU model and instruction sets are unknown."
msgstr "py-cpuinfo başarısız oldu; CPU modeli ve komut kümeleri bilinmiyor."

msgid "psutil could not count the CPU cores; thread choice falls back to one core. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil CPU çekirdeklerini sayamadı; iş parçacığı seçimi tek çekirdeğe döner. psutil'i `pip install --force-reinstall psutil` ile yeniden kurun."

msgid "psutil could not read the memory totals; budgets cannot be computed until this works. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil bellek toplamlarını okuyamadı; bu çalışana kadar bütçeler hesaplanamaz. psutil'i `pip install --force-reinstall psutil` ile yeniden kurun."

msgid "Could not read performance-core count from sysctl."
msgstr "Performans çekirdeği sayısı sysctl'den okunamadı."

msgid "llama-server exists but did not report a version; the binary may be broken."
msgstr "llama-server var ama bir sürüm bildirmedi; ikili dosya bozuk olabilir."

msgid "system_profiler failed; GPU information is unavailable."
msgstr "system_profiler başarısız oldu; GPU bilgisi yok."

msgid "No vendor tool reported the GPU's memory size; record the size in a hardware profile so budgets can be computed for this machine."
msgstr "GPU'nun bellek boyutunu hiçbir üretici aracı bildirmedi; bu makine için bütçelerin hesaplanabilmesi adına boyutu bir donanım profiline kaydedin."

msgid "llama.cpp installed"
msgstr "llama.cpp kurulu"

