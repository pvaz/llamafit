msgstr "%(path)s üzerindeki boş alan ölçülemedi: %(error)s"

msgid "Check that the download directory's volume is available."
msgstr "İndirme dizininin bulunduğu birimin erişilebilir olduğunu denetleyin."

msgid "%(model)s has no downloadable source in the catalog."
msgstr "%(model)s için katalogda indirilebilir bir kaynak yok."

msgid "Only Hugging Face sources can be installed; this entry has none."
msgstr "Yalnızca Hugging Face kaynakları kurulabilir; bu kayıtta hiç yok."

msgid "the catalog has no file list for %(model)s %(quant)s."
msgstr "katalogda %(model)s %(quant)s için dosya listesi yok."

msgid "Run `llamafit catalog refresh` to fill in the file names."
msgstr "Dosya adlarının doldurulması için `llamafit catalog refresh` çalıştırın."

msgid "%(model)s publishes no quantisations."
msgstr "%(model)s hiçbir nicemleme yayımlamıyor."

msgid "%(model)s does not publish a %(quant)s quantisation."
msgstr "%(model)s, %(quant)s nicemlemesi yayımlamıyor."

msgid "It publishes: %(quants)s"
msgstr "Şunları yayımlıyor: %(quants)s"

msgid "the catalog does not record how big %(quant)s is."
msgstr "katalog %(quant)s nicemlemesinin ne kadar büyük olduğunu kaydetmiyor."

msgid "Run `llamafit catalog refresh` to fill in the sizes."
msgstr "Boyutların doldurulması için `llamafit catalog refresh` çalıştırın."

msgid "the catalog holds no checksum for %(files)s."
msgid_plural "the catalog holds no checksums for %(files)s."
msgstr[0] "katalogda %(files)s için sağlama toplamı yok."
msgstr[1] "katalogda %(files)s için sağlama toplamı yok."

msgid "Run `llamafit catalog refresh` to fetch them, or pass --allow-unverified to download anyway and check the files yourself."
msgstr "Onları almak için `llamafit catalog refresh` çalıştırın ya da yine de indirip dosyaları kendiniz denetlemek için --allow-unverified verin."

