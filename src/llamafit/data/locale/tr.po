msgstr "%(file)s: sunucu daha az bağlantı istedi; %(count)d kullanılıyor."

msgid "%(file)s: this server will not serve byte ranges; fetching it in one stream."
msgstr "%(file)s: bu sunucu bayt aralığı sunmuyor; tek akışta indiriliyor."

