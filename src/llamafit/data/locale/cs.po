msgstr "Změřit propustnost RAM znovu místo načtení hodnoty uložené pro tento počítač a novou si nechat."

msgid "%(url)s answered a range request with the whole file."
msgstr "%(url)s odpověděl na rozsahový požadavek celým souborem."

msgid "%(url)s is rate-limiting this download (HTTP %(status)d)."
msgstr "%(url)s toto stahování omezuje rychlostí (HTTP %(status)d)."

msgid "Check your network connection and run the command again to resume."
msgstr "Zkontrolujte síťové připojení a spusťte příkaz znovu, aby se navázalo."

msgid "%(file)s needs authorisation (HTTP %(status)d)."
msgstr "%(file)s vyžaduje autorizaci (HTTP %(status)d)."

msgid "This repository is gated. Accept its terms on Hugging Face and set HF_TOKEN to a token that can read it."
msgstr "Tento repozitář je uzavřený. Přijměte jeho podmínky na Hugging Face a nastavte HF_TOKEN na token, který jej může číst."

msgid "%(file)s is not at %(url)s any more (HTTP 404)."
msgstr "%(file)s už na %(url)s není (HTTP 404)."

msgid "Run `llamafit catalog refresh` to pick up the repository's current files."
msgstr "Spusťte `llamafit catalog refresh`, aby se převzaly aktuální soubory repozitáře."

msgid "%(url)s returned HTTP %(status)d."
msgstr "%(url)s vrátil HTTP %(status)d."

msgid "Confirm the URL points at a downloadable file."
msgstr "Ověřte, že URL ukazuje na stažitelný soubor."

msgid "%(url)s did not say how big %(file)s is."
msgstr "%(url)s neuvedl, jak velký %(file)s je."

msgid "%(file)s is %(actual)s on the server but the catalog says %(expected)s; the repository has been re-uploaded since the catalog was refreshed."
msgstr "%(file)s má na serveru %(actual)s, ale katalog uvádí %(expected)s; repozitář byl od obnovení katalogu nahrán znovu."

msgid "Run `llamafit catalog refresh` and try again."
msgstr "Spusťte `llamafit catalog refresh` a zkuste to znovu."

msgid "%(file)s: the server sent %(actual)d bytes of a %(expected)d byte range."
msgstr "%(file)s: server poslal %(actual)d bajtů z rozsahu o %(expected)d bajtech."

msgid "Run the command again; the parts that did arrive are kept."
msgstr "Spusťte příkaz znovu; části, které dorazily, se zachovávají."

msgid "Stopped."
msgstr "Zastaveno."

msgid "%(file)s: the server asked for fewer connections; using %(count)d."
msgstr "%(file)s: server požádal o méně spojení; používá se %(count)d."

msgid "%(file)s: this server will not serve byte ranges; fetching it in one stream."
msgstr "%(file)s: tento server neobsluhuje bajtové rozsahy; stahuje se jedním proudem."

msgid "%(file)s does not match its checksum; fetching it again."
msgstr "%(file)s neodpovídá svému kontrolnímu součtu; stahuje se znovu."

msgid "Check that the download directory is writable."
msgstr "Zkontrolujte, že do adresáře pro stahování lze zapisovat."

msgid "%(needed)s is needed for this model but %(path)s has only %(free)s free, %(short)s short of what is wanted with %(headroom)s left spare."
msgstr "Pro tento model je potřeba %(needed)s, ale v %(path)s je volných jen %(free)s, o %(short)s méně, než je třeba, aby zbyla rezerva %(headroom)s."

msgid "Free some space, or choose another directory with --dir, or a smaller quantisation with --quant."
msgstr "Uvolněte místo, nebo zvolte jiný adresář přes --dir, případně menší kvantizaci přes --quant."

msgid "could not measure the free space on %(path)s: %(error)s"
msgstr "nepodařilo se změřit volné místo v %(path)s: %(error)s"

msgid "Check that the download directory's volume is available."
msgstr "Zkontrolujte, že je svazek s adresářem pro stahování dostupný."

msgid "%(model)s has no downloadable source in the catalog."
msgstr "%(model)s nemá v katalogu žádný stažitelný zdroj."

msgid "Only Hugging Face sources can be installed; this entry has none."
msgstr "Instalovat lze jen zdroje z Hugging Face; tento záznam žádný nemá."

msgid "the catalog has no file list for %(model)s %(quant)s."
msgstr "katalog nemá seznam souborů pro %(model)s %(quant)s."

msgid "Run `llamafit catalog refresh` to fill in the file names."
msgstr "Spusťte `llamafit catalog refresh`, aby se doplnily názvy souborů."

msgid "%(model)s publishes no quantisations."
msgstr "%(model)s nevydává žádné kvantizace."

msgid "%(model)s does not publish a %(quant)s quantisation."
msgstr "%(model)s nevydává kvantizaci %(quant)s."

msgid "It publishes: %(quants)s"
msgstr "Vydává: %(quants)s"

msgid "the catalog does not record how big %(quant)s is."
msgstr "katalog nezaznamenává, jak velká %(quant)s je."

msgid "Run `llamafit catalog refresh` to fill in the sizes."
msgstr "Spusťte `llamafit catalog refresh`, aby se doplnily velikosti."

msgid "the catalog holds no checksum for %(files)s."
msgid_plural "the catalog holds no checksums for %(files)s."
msgstr[0] "katalog nemá kontrolní součet pro %(files)s."
msgstr[1] "katalog nemá kontrolní součty pro %(files)s."
msgstr[2] "katalog nemá kontrolní součty pro %(files)s."

msgid "Run `llamafit catalog refresh` to fetch them, or pass --allow-unverified to download anyway and check the files yourself."
msgstr "Spusťte `llamafit catalog refresh`, aby se stáhly, nebo předejte --allow-unverified, stáhněte to i tak a soubory si zkontrolujte sami."

msgid "%(done)s of %(total)s"
msgstr "%(done)s z %(total)s"

msgid "%(rate)s/s"
msgstr "%(rate)s/s"

msgid "Fetching %(file)s (%(size)s)"
msgstr "Stahuje se %(file)s (%(size)s)"

msgid "Checking %(file)s against its checksum"
msgstr "Kontroluje se %(file)s proti svému kontrolnímu součtu"

msgid "Done: %(file)s"
msgstr "Hotovo: %(file)s"

msgid "could not create %(path)s: %(error)s"
msgstr "nepodařilo se vytvořit %(path)s: %(error)s"

msgid "Check that the download directory is writable and has room."
msgstr "Zkontrolujte, že do adresáře pro stahování lze zapisovat a že je v něm místo."

msgid "could not move %(source)s into place: %(error)s"
msgstr "nepodařilo se přesunout %(source)s na místo: %(error)s"

msgid "could not record progress in %(path)s: %(error)s"
msgstr "nepodařilo se zaznamenat postup do %(path)s: %(error)s"

msgid "could not fetch %(url)s: %(error)s"
msgstr "nepodařilo se stáhnout %(url)s: %(error)s"

msgid "Stopped before the checksum was finished."
msgstr "Zastaveno dřív, než se kontrolní součet dopočítal."

msgid "could not read %(path)s: %(error)s"
msgstr "nepodařilo se přečíst %(path)s: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "Zkontrolujte, že soubor existuje a lze jej číst."

msgid "%(file)s is %(actual)d bytes, but the catalog says %(expected)d"
msgstr "%(file)s má %(actual)d bajtů, ale katalog uvádí %(expected)d"

msgid "The transfer was cut short. Run the command again to fetch it properly."
msgstr "Přenos byl useknut. Spusťte příkaz znovu, aby se soubor stáhl pořádně."

msgid "%(file)s does not match the checksum the catalog holds."
msgstr "%(file)s neodpovídá kontrolnímu součtu, který katalog drží."

msgid "Expected %(expected)s but the file hashes to %(actual)s. The bad copy has been deleted; run the command again to fetch it."
msgstr "Očekáváno %(expected)s, ale soubor má otisk %(actual)s. Vadná kopie byla smazána; spusťte příkaz znovu, aby se stáhla."

msgid "Command: %(command)s"
msgstr "Příkaz: %(command)s"

msgid "truncated GGUF header: wanted %(wanted)d byte at offset %(offset)d, got %(got)d"
msgid_plural "truncated GGUF header: wanted %(wanted)d bytes at offset %(offset)d, got %(got)d"
msgstr[0] "useknutá hlavička GGUF: chtěl se %(wanted)d bajt na offsetu %(offset)d, získáno %(got)d"
msgstr[1] "useknutá hlavička GGUF: chtěly se %(wanted)d bajty na offsetu %(offset)d, získáno %(got)d"
msgstr[2] "useknutá hlavička GGUF: chtělo se %(wanted)d bajtů na offsetu %(offset)d, získáno %(got)d"

msgid "The file may still be downloading, or the URL may not be a GGUF file."
msgstr "Soubor se možná ještě stahuje, nebo na této URL není soubor GGUF."

msgid "unknown GGUF value type %(type)d at offset %(offset)d"
msgstr "neznámý typ hodnoty GGUF %(type)d na offsetu %(offset)d"

msgid "This file may use a newer GGUF metadata type than LlamaFit supports."
msgstr "Tento soubor možná používá novější typ metadat GGUF, než LlamaFit podporuje."

msgid "not a GGUF file: bad magic %(magic)s at offset 0"
msgstr "toto není soubor GGUF: chybná signatura %(magic)s na offsetu 0"

msgid "Check that this file is actually a .gguf model."
msgstr "Zkontrolujte, že je tento soubor opravdu model .gguf."

msgid "unsupported GGUF version %(version)d at offset 4"
msgstr "nepodporovaná verze GGUF %(version)d na offsetu 4"

msgid "LlamaFit supports GGUF versions %(versions)s."
msgstr "LlamaFit podporuje verze GGUF %(versions)s."

msgid "A memory budget built without these tensors would be too small, so none is built. If llama.cpp loads the file, LlamaFit's tensor-size table is missing the type."
msgstr "Rozpočet paměti sestavený bez těchto tenzorů by byl příliš malý, takže se žádný nesestavuje. Pokud llama.cpp soubor načte, chybí ten typ v tabulce velikostí tenzorů LlamaFitu."

msgid "%(type)d (%(count)d tensor, first %(name)s)"
msgid_plural "%(type)d (%(count)d tensors, first %(name)s)"
msgstr[0] "%(type)d (%(count)d tenzor, první %(name)s)"
msgstr[1] "%(type)d (%(count)d tenzory, první %(name)s)"
msgstr[2] "%(type)d (%(count)d tenzorů, první %(name)s)"

msgid "cannot size this GGUF file: %(count)d tensor uses a GGML type LlamaFit does not know: %(details)s"
msgid_plural "cannot size this GGUF file: %(count)d tensors use GGML types LlamaFit does not know: %(details)s"
msgstr[0] "tento soubor GGUF nelze změřit: %(count)d tenzor používá typ GGML, který LlamaFit nezná: %(details)s"
msgstr[1] "tento soubor GGUF nelze změřit: %(count)d tenzory používají typy GGML, které LlamaFit nezná: %(details)s"
msgstr[2] "tento soubor GGUF nelze změřit: %(count)d tenzorů používá typy GGML, které LlamaFit nezná: %(details)s"

msgid "%(count)d shard"
msgid_plural "%(count)d shards"
msgstr[0] "%(count)d část"
msgstr[1] "%(count)d části"
msgstr[2] "%(count)d částí"

msgid "these GGUF files are not one split model: they disagree about '%(key)s', declaring %(values)s"
msgstr "tyto soubory GGUF nejsou jeden rozdělený model: neshodnou se na '%(key)s' a uvádějí %(values)s"

msgid "Pass the shards of one model, not of several."
msgstr "Předejte části jednoho modelu, ne několika."

msgid "no GGUF header to read facts from"
msgstr "není žádná hlavička GGUF, ze které by šlo přečíst údaje"

msgid "Pass the model's file, or every shard of a split model."
msgstr "Předejte soubor modelu, nebo všechny části rozděleného modelu."

msgid "%(count)d GGUF file of the %(total)d given carries no '%(key)s' key, so its place in a split model cannot be established"
msgid_plural "%(count)d GGUF files of the %(total)d given carry no '%(key)s' key, so their place in a split model cannot be established"
msgstr[0] "%(count)d soubor GGUF z %(total)d zadaných nenese klíč '%(key)s', takže jeho místo v rozděleném modelu nelze určit"
msgstr[1] "%(count)d soubory GGUF z %(total)d zadaných nenesou klíč '%(key)s', takže jejich místo v rozděleném modelu nelze určit"
msgstr[2] "%(count)d souborů GGUF z %(total)d zadaných nenese klíč '%(key)s', takže jejich místo v rozděleném modelu nelze určit"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "Předejte buď jeden nerozdělený soubor samostatně, nebo všechny části jednoho rozděleného modelu."

msgid "incomplete shard set: the model declares %(shards)s and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "neúplná sada částí: model uvádí %(shards)s a dorazilo %(arrived)d (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "Předejte všechny části rozděleného modelu."

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "chybí část s metadaty modelu: získáno %(key)s %(numbers)s, očekávalo se, že jedno z nich bude 0"

msgid "Pass every shard of the split model, including the first."
msgstr "Předejte všechny části rozděleného modelu, včetně první."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "neúplná sada částí: očekáváno %(key)s od 0 do %(last)d, získáno %(numbers)s"

msgid "Pass each shard of the split model exactly once."
msgstr "Předejte každou část rozděleného modelu právě jednou."

msgid "incomplete shard set: the model declares %(tensors)s and its %(shards)s hold %(held)d between them"
msgstr "neúplná sada částí: model uvádí %(tensors)s a jeho %(shards)s jich dohromady drží %(held)d"

msgid "%(count)d tensor"
msgid_plural "%(count)d tensors"
msgstr[0] "%(count)d tenzor"
msgstr[1] "%(count)d tenzory"
msgstr[2] "%(count)d tenzorů"

msgid "Check your network connection and that the URL is reachable."
msgstr "Zkontrolujte síťové připojení a dostupnost této URL."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "%(url)s vrátil HTTP %(status)d místo 206 Partial Content; server možná nepodporuje rozsahové požadavky."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Ověřte, že URL ukazuje na stažitelný soubor GGUF."

msgctxt "CPU model"
msgid "unknown"
msgstr "neznámý"

msgid "nvidia-smi returned no GPUs"
msgstr "nvidia-smi nevrátil žádné GPU"

msgid "rocm-smi returned no cards"
msgstr "rocm-smi nevrátil žádnou kartu"

msgid "system_profiler returned no displays"
msgstr "system_profiler nevrátil žádný displej"

msgid "WMI returned no video controllers"
msgstr "WMI nevrátilo žádný videokontrolér"

msgid "lspci found no display controllers"
msgstr "lspci nenašlo žádný videokontrolér"

msgid "vulkaninfo reported no discrete device with a memory heap"
msgstr "vulkaninfo nehlásil žádné samostatné zařízení s pamětí"

