msgid ""
msgstr ""
"Project-Id-Version: llamafit 0.1.0a1\n"
"Report-Msgid-Bugs-To: https://github.com/pvaz/llamafit/issues\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Language: cs\n"
"Language-Team: Czech\n"
"Plural-Forms: nplurals=3; plural=(n==1) ? 0 : (n>=2 && n<=4) ? 1 : 2;\n"

msgid "nothing measured touches this term, so there is no equation it appears in"
msgstr "žádné měření se tohoto členu nedotýká, takže neexistuje rovnice, ve které by vystupoval"

msgid "%(measurements)d distinct configurations for %(parameters)d free parameters; fewer points than parameters gives numbers that look precise and are arbitrary"
msgstr "%(measurements)d různých konfigurací na %(parameters)d volných parametrů; méně bodů než parametrů dává čísla, která vypadají přesně a jsou libovolná"

msgid "the %(measurements)d configurations do not vary independently enough to separate %(parameters)d parameters"
msgstr "těchto %(measurements)d konfigurací se nemění dost nezávisle na to, aby šlo oddělit %(parameters)d parametrů"

msgid "the fit put it at %(value)s, which its own definition does not allow; the measurements disagree with each other under section 10.1's model"
msgstr "proložení jej určilo na %(value)s, což jeho vlastní definice nedovoluje; měření si podle modelu z oddílu 10.1 vzájemně odporují"

msgid "it came out at %(value)s, but another parameter of the same fit was impossible, and least squares chose them against each other"
msgstr "vyšel na %(value)s, ale jiný parametr téhož proložení byl nemožný a metoda nejmenších čtverců je zvolila proti sobě"

msgid "the estimator has no such term: section 10.1 removed the per-layer overhead, which for a 28-layer model exceeded the whole measured token"
msgstr "odhadovač takový člen nemá: oddíl 10.1 odstranil režii na vrstvu, která u modelu s 28 vrstvami převyšovala celý změřený token"

msgid "generation (llama-bench)"
msgstr "generování (llama-bench)"

msgid "prompt (llama-bench)"
msgstr "prompt (llama-bench)"

msgid "generation, first request"
msgstr "generování, první požadavek"

msgid "generation, 1K prompt"
msgstr "generování, prompt 1K"

msgid "prompt, 1K request"
msgstr "prompt, požadavek 1K"

msgid "peak VRAM"
msgstr "špička VRAM"

msgid "no graphics card"
msgstr "žádná grafická karta"

msgid "%(os)s %(version)s, %(cpu)s, %(ram)s, %(gpu)s%(driver)s"
msgstr "%(os)s %(version)s, %(cpu)s, %(ram)s, %(gpu)s%(driver)s"

msgid "%(flag)s was asked for as %(wanted)s but the run reports %(actual)s"
msgstr "%(flag)s bylo požadováno jako %(wanted)s, ale běh hlásí %(actual)s"

msgid "The card was full and generation came in below three fifths of the estimate: the driver was paging to system memory, which does not fail and does not appear in the log."
msgstr "Karta byla plná a generování kleslo pod tři pětiny odhadu: ovladač stránkoval do systémové paměti, což neselže a neobjeví se v protokolu."

msgid "Peak VRAM stayed clear of the card's total, so there was nothing for the driver to page."
msgstr "Špička VRAM zůstala pod celkovou pamětí karty, takže ovladač neměl co stránkovat."

msgid "The card was full, which a good plan is meant to be, and the speed was close enough to the estimate that nothing was paging."
msgstr "Karta byla plná, což dobrý plán má být, a rychlost byla dost blízko odhadu na to, aby se nic nestránkovalo."

msgid "No VRAM reading was taken during the run, so this configuration has not been cleared of paging; it has only not been checked."
msgstr "Během běhu se VRAM neodečítala, takže tato konfigurace nebyla ze stránkování vyloučena; jen nebyla zkontrolována."

msgid "The card's total memory is unknown, so a reading of what was in use says nothing about how close to full it was."
msgstr "Celková paměť karty je neznámá, takže údaj o tom, kolik jí bylo použito, neříká nic o tom, jak blízko k plnému stavu to bylo."

msgid "There was no estimate to compare the measured speed against, so the second half of the signature could not be tested."
msgstr "Nebyl k dispozici odhad, se kterým by šlo změřenou rychlost porovnat, takže druhou polovinu signatury nešlo ověřit."

msgid "llama-bench did not produce JSON"
msgstr "llama-bench nevytvořil JSON"

msgid "llama-bench JSON is not a list of results"
msgstr "JSON z llama-bench není seznam výsledků"

msgid "llama-bench JSON held no readable results"
msgstr "JSON z llama-bench neobsahoval čitelné výsledky"

msgid "no llama-bench result rows found"
msgstr "nenalezeny žádné řádky s výsledky llama-bench"

msgid "could not open %(path)s for the server log"
msgstr "nepodařilo se otevřít %(path)s pro protokol serveru"

msgid "could not start llama-server"
msgstr "nepodařilo se spustit llama-server"

msgid "no output"
msgstr "žádný výstup"

msgid "llama-bench exited with code %(code)d: %(detail)s"
msgstr "llama-bench skončil s kódem %(code)d: %(detail)s"

msgid "llama-bench output could not be read: %(error)s"
msgstr "výstup llama-bench se nepodařilo přečíst: %(error)s"

msgid "llama-server did not become healthy"
msgstr "llama-server se nedostal do zdravého stavu"

msgid "Its whole output is in the log file `bench` named; the end says why."
msgstr "Celý jeho výstup je v souboru protokolu, který `bench` uvedl; konec říká proč."

msgid "%(path)s was written by a newer LlamaFit (benchmark format %(found)d, this build reads %(known)d)"
msgstr "%(path)s zapsal novější LlamaFit (formát benchmarku %(found)d, toto sestavení čte %(known)d)"

msgid "Upgrade LlamaFit, or move the file aside to start a new one."
msgstr "Aktualizujte LlamaFit, nebo soubor odložte stranou a začněte nový."

msgid "a benchmark cannot be recorded against a simulated machine"
msgstr "benchmark nelze zaznamenat proti simulovanému počítači"

msgid "Run `llamafit bench` on the machine itself, without --profile."
msgstr "Spusťte `llamafit bench` přímo na tom počítači, bez --profile."

msgid "the run did not use the settings it was given: %(problems)s"
msgstr "běh nepoužil nastavení, která dostal: %(problems)s"

msgid "Nothing was stored. A result filed under flags it was not taken with would be believed later by everything that reads it."
msgstr "Nic nebylo uloženo. Výsledku uloženému pod jinými přepínači, než s jakými byl pořízen, by později věřilo všechno, co jej čte."

msgid "a conservative default; nobody has measured this card's backend overhead"
msgstr "konzervativní výchozí hodnota; režii backendu této karty nikdo nezměřil"

msgid "measured on this card with driver %(driver)s and llama.cpp %(build)s; one machine"
msgstr "změřeno na této kartě s ovladačem %(driver)s a llama.cpp %(build)s; jeden počítač"

msgid "A hybrid placement has to say how many layers are on the graphics card."
msgstr "Hybridní umístění musí říct, kolik vrstev je na grafické kartě."

msgid "Pass gpu_layers, which is what -ngl would be."
msgstr "Předejte gpu_layers, což je hodnota pro -ngl."

msgid "LlamaFit has not read %(model)s's %(quant)s file, so it cannot size it."
msgstr "LlamaFit nepřečetl soubor %(quant)s modelu %(model)s, takže jeho velikost neumí určit."

msgid "Run `llamafit catalog refresh` to read the file's header."
msgstr "Spusťte `llamafit catalog refresh`, aby se hlavička souboru přečetla."

msgid "the server process before any model buffer"
msgstr "proces serveru před jakýmkoli bufferem modelu"

msgid "fitted to one machine's measurements; the least certain line here"
msgstr "proloženo měřeními jednoho počítače; nejméně jistý řádek zde"

msgid "room for one logit per vocabulary entry per token of the batch"
msgstr "místo pro jeden logit na položku slovníku a token dávky"

msgid "LlamaFit cannot size a %(kv_type)s key-value cache."
msgstr "LlamaFit neumí určit velikost KV cache typu %(kv_type)s."

msgid "Use one of: %(types)s."
msgstr "Použijte jeden z: %(types)s."

msgid "This model's file does not say how large its key-value cache is per token."
msgstr "Soubor tohoto modelu neuvádí, jak velkou KV cache má na token."

msgid "Refresh the catalog so the file's header is read again."
msgstr "Obnovte katalog, aby se hlavička souboru přečetla znovu."

msgid "the attention-layer count was assumed, not counted"
msgstr "počet pozornostních vrstev byl odhadnut, ne spočítán"

msgid "%(arch)s allocates more cache than its header describes; see the line below"
msgstr "%(arch)s alokuje víc cache, než popisuje jeho hlavička; viz řádek níže"

msgid "what %(arch)s allocates beyond its header, measured rather than derived"
msgstr "co %(arch)s alokuje nad rámec své hlavičky, změřeno, ne odvozeno"

msgid "from the architecture's state dimensions; it does not grow with context"
msgstr "ze stavových rozměrů architektury; neroste s kontextem"

msgid "the projector file itself"
msgstr "samotný soubor projektoru"

msgid "the projector's own compute space, measured at 248 MiB"
msgstr "vlastní výpočetní prostor projektoru, změřeno na 248 MiB"

msgid "attention projections, feed-forward weights and norms"
msgstr "projekce pozornosti, váhy dopředné vrstvy a normy"

msgid "always-on experts, which run for every token"
msgstr "stále zapnutí experti, kteří běží pro každý token"

msgid "routed experts, read across the bus once per micro-batch"
msgstr "směrovaní experti, čtení přes sběrnici jednou na mikrodávku"

msgid "this model ties its output projection to its embedding table"
msgstr "tento model váže svou výstupní projekci na tabulku embeddingů"

msgid "llama.cpp keeps the embedding table in memory even at full offload"
msgstr "llama.cpp drží tabulku embeddingů v paměti i při plném přesunu na GPU"

msgid "streamed from disk as it is needed, not held in memory"
msgstr "streamováno z disku podle potřeby, nedrženo v paměti"

msgid "held in memory, since streaming from disk was turned off"
msgstr "drženo v paměti, protože streamování z disku bylo vypnuto"

msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "Hugging Face vrátil %(status)d při výpisu souborů pro %(repo)s."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Nepodařilo se z Hugging Face načíst výpis souborů pro %(repo)s."

msgid "Check your network connection and try again."
msgstr "Zkontrolujte síťové připojení a zkuste to znovu."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "Odpověď Hugging Face pro %(repo)s neobsahovala výpis souborů."

msgid "Check that the repository id is correct and public."
msgstr "Zkontrolujte, že je identifikátor repozitáře správný a repozitář veřejný."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "katalog má %(count)d problém"
msgstr[1] "katalog má %(count)d problémy"
msgstr[2] "katalog má %(count)d problémů"

msgid "Run `llamafit catalog validate` for details."
msgstr "Podrobnosti získáte příkazem `llamafit catalog validate`."

msgid "could not write %(path)s: %(error)s"
msgstr "nepodařilo se zapsat %(path)s: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "Zkontrolujte, že do adresáře lze zapisovat a že je v něm místo."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "%(path)s má %(count)d problém a nelze jej obnovit"
msgstr[1] "%(path)s má %(count)d problémy a nelze jej obnovit"
msgstr[2] "%(path)s má %(count)d problémů a nelze jej obnovit"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "Nejprve spusťte `llamafit catalog validate` a soubor opravte."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "Soubor %(path)s se nepodařilo přečíst celý, takže obnovení pouze %(model)s by zahodilo údaje, které si drží o modelech, jichž se tento běh nedotkne: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "Spusťte `llamafit catalog refresh` bez --model, aby se přestavěl celý soubor."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "Najděte, změřte, nainstalujte a ověřte LLM s otevřenými vahami pro llama.cpp na vlastním počítači."

msgid "With no command, llamafit opens the terminal dashboard; in a pipe, or with --json, it prints what `llamafit recommend` would."
msgstr "Bez příkazu otevře llamafit terminálovou nástěnku; v rouře nebo s --json vypíše to, co by vypsal `llamafit recommend`."

msgid "Print machine-readable JSON instead of tables."
msgstr "Vypisovat strojově čitelný JSON místo tabulek."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "Zapisovat podrobnosti do llamafit.log v adresáři protokolů a zobrazovat výpisy zásobníku."

msgid "Disable colours."
msgstr "Vypnout barvy."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "Mluvit tímto jazykem, například pt_PT. U jazyka, který LlamaFit nemá, se vrátí k angličtině a řekne, které jazyky má."

msgid "Print the version and exit."
msgstr "Vypsat verzi a skončit."

msgid "the output's encoding"
msgstr "kódování výstupu"

msgid "%(count)d character could not be written in %(encoding)s and is shown as ?."
msgid_plural "%(count)d characters could not be written in %(encoding)s and are shown as ?."
msgstr[0] "%(count)d znak nešlo zapsat v kódování %(encoding)s a zobrazuje se jako ?."
msgstr[1] "%(count)d znaky nešlo zapsat v kódování %(encoding)s a zobrazují se jako ?."
msgstr[2] "%(count)d znaků nešlo zapsat v kódování %(encoding)s a zobrazuje se jako ?."

msgid "Set PYTHONUTF8=1 in the environment and run again: Python then writes UTF-8, which carries every language."
msgstr "Nastavte v prostředí PYTHONUTF8=1 a spusťte znovu: Python pak zapisuje UTF-8, které unese každý jazyk."

msgid "%(option)s is an option of llamafit itself, so it goes before the command: `llamafit %(option)s %(rest)s`."
msgstr "%(option)s je volba samotného llamafit, takže patří před příkaz: `llamafit %(option)s %(rest)s`."

msgid "Unexpected error: %(error)s"
msgstr "Neočekávaná chyba: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "Spusťte znovu s --verbose pro úplný výpis zásobníku."

msgid "A catalog model id."
msgstr "Identifikátor modelu z katalogu."

msgid "Benchmark this quantisation instead of the planned one."
msgstr "Změřit tuto kvantizaci místo plánované."

msgid "Size for this many tokens."
msgstr "Dimenzovat na tento počet tokenů."

msgid "Set the micro-batch by hand; the budget is rebuilt around it."
msgstr "Nastavit mikrodávku ručně; rozpočet se kolem ní přestaví."

msgid ""
"Measure a model on this machine and show the measurement beside the estimate.\n"
"\n"
"Runs llama-bench and a real server at the planned flags, stores the result with the conditions it was taken under, and flags a configuration the driver was paging. With --calibrate, fits the estimator's constants to this machine from every stored result and says by name which ones the measurements do not determine."
msgstr ""
"Změřit model na tomto počítači a ukázat měření vedle odhadu.\n"
"\n"
"Spustí llama-bench a skutečný server s plánovanými přepínači, uloží výsledek s podmínkami, za jakých byl pořízen, a označí konfiguraci, u které ovladač stránkoval. S --calibrate proloží konstanty odhadovače tomuto počítači ze všech uložených výsledků a jmenovitě řekne, které z nich měření neurčují."

msgid "Measure prompt processing at every micro-batch of the ladder, not only the planned one. Section 10.2 has two free parameters and one micro-batch is one equation, so without this the prompt half of a calibration cannot be fitted at all."
msgstr "Měřit zpracování promptu při každé mikrodávce žebříčku, ne jen při plánované. Oddíl 10.2 má dva volné parametry a jedna mikrodávka je jedna rovnice, takže bez tohoto nelze promptovou polovinu kalibrace vůbec proložit."

msgid "Run llama-bench only. Faster, and it gives up the paging check, the buffer sizes and the tool-call test, all of which need a real server."
msgstr "Spustit jen llama-bench. Rychlejší, ale vzdává se kontroly stránkování, velikostí bufferů a testu volání nástrojů, což vše potřebuje skutečný server."

msgid "Print the result without writing it to the database."
msgstr "Vypsat výsledek a nezapisovat jej do databáze."

msgid "Print the commands that would run, and run nothing."
msgstr "Vypsat příkazy, které by se spustily, a nic nespouštět."

msgid "Fit the estimator's constants to this machine from every result."
msgstr "Proložit konstanty odhadovače tomuto počítači ze všech výsledků."

msgid "List what is already stored and stop."
msgstr "Vypsat, co je již uloženo, a skončit."

msgid "`llamafit bench` needs a model to measure"
msgstr "`llamafit bench` potřebuje model, který má změřit"

msgid "Try `llamafit bench <model>`, `--calibrate` on its own, or `--show`."
msgstr "Zkuste `llamafit bench <model>`, samotné `--calibrate`, nebo `--show`."

msgid "llama.cpp was not found, so there is nothing to benchmark with"
msgstr "llama.cpp nebyl nalezen, takže není čím měřit"

msgid "Run `llamafit doctor` to see where it was looked for."
msgstr "Spusťte `llamafit doctor` a uvidíte, kde se hledal."

msgid "%(path)s has llama-server but no llama-bench"
msgstr "%(path)s má llama-server, ale ne llama-bench"

msgid "Some release archives leave it out; a full build has it beside the server."
msgstr "Některé archivy vydání jej vynechávají; plné sestavení jej má vedle serveru."

msgid "this host is simulated, and a simulated machine cannot be measured"
msgstr "tento počítač je simulovaný a simulovaný počítač nelze měřit"

msgid "Run `llamafit bench` on the machine itself."
msgstr "Spusťte `llamafit bench` přímo na tom počítači."

msgid "the model file is not on this machine: %(path)s"
msgstr "soubor modelu není na tomto počítači: %(path)s"

msgid "Download it first; `llamafit plan` shows the path the command line uses."
msgstr "Nejprve jej stáhněte; `llamafit plan` ukazuje cestu, kterou příkazová řádka používá."

msgid "Would run:"
msgstr "Spustilo by se:"

msgid "Nothing has been measured on this machine yet."
msgstr "Na tomto počítači zatím nebylo nic změřeno."

msgid "Stored measurements"
msgstr "Uložená měření"

msgid "model"
msgstr "model"

msgid "kind"
msgstr "druh"

msgid "gen tok/s"
msgstr "gen tok/s"

msgid "prompt tok/s"
msgstr "prompt tok/s"

msgid "taken"
msgstr "pořízeno"

msgid "flags"
msgstr "přepínače"

msgid "Nothing was written to the database, so no estimate will be relabelled."
msgstr "Do databáze se nic nezapsalo, takže se žádný odhad nepřeznačí."

msgid "Estimated against measured"
msgstr "Odhad proti měření"

msgid "figure"
msgstr "veličina"

msgid "context"
msgstr "kontext"

msgid "micro-batch"
msgstr "mikrodávka"

msgid "estimated"
msgstr "odhad"

msgid "measured"
msgstr "změřeno"

msgid "ratio"
msgstr "poměr"

msgid "The plan sizes this configuration for %(context)s tokens and estimates %(tps)s generated tokens per second there. Nothing above ran at that context, so that figure is reported and not compared."
msgstr "Plán dimenzuje tuto konfiguraci na %(context)s tokenů a odhaduje tam %(tps)s vygenerovaných tokenů za sekundu. Nic výše na tomto kontextu neběželo, takže se tento údaj jen uvádí a neporovnává."

msgid "%(count)d figure is outside the 0.8 to 1.25 band an uncalibrated formula is expected to land in."
msgid_plural "%(count)d figures are outside the 0.8 to 1.25 band an uncalibrated formula is expected to land in."
msgstr[0] "%(count)d údaj je mimo pásmo 0,8 až 1,25, do kterého má nekalibrovaný vzorec padnout."
msgstr[1] "%(count)d údaje jsou mimo pásmo 0,8 až 1,25, do kterého má nekalibrovaný vzorec padnout."
msgstr[2] "%(count)d údajů je mimo pásmo 0,8 až 1,25, do kterého má nekalibrovaný vzorec padnout."

msgid "This configuration was paging."
msgstr "Tato konfigurace stránkovala."

msgid "This configuration was not paging."
msgstr "Tato konfigurace nestránkovala."

msgid "Paging could not be checked."
msgstr "Stránkování nešlo zkontrolovat."

msgid "Peak VRAM was %(percent)s percent of the card, and generation was %(speed)s percent of the estimate."
msgstr "Špička VRAM byla %(percent)s procent karty a generování bylo %(speed)s procent odhadu."

msgid "Peak VRAM was %(percent)s percent of the card. Generation was not compared with the estimate."
msgstr "Špička VRAM byla %(percent)s procent karty. Generování se s odhadem neporovnávalo."

msgid "The largest context on the ladder that would not page is %(tokens)s."
msgstr "Největší kontext na žebříčku, který by nestránkoval, je %(tokens)s."

msgid "Calibration"
msgstr "Kalibrace"

msgid "constant"
msgstr "konstanta"

msgid "value"
msgstr "hodnota"

msgid "from"
msgstr "z"

msgid "%(base)s + %(slope)s per 1K"
msgstr "%(base)s + %(slope)s na 1K"

msgid "%(count)d measured context"
msgid_plural "%(count)d measured contexts"
msgstr[0] "%(count)d změřený kontext"
msgstr[1] "%(count)d změřené kontexty"
msgstr[2] "%(count)d změřených kontextů"

msgid "Nothing was fitted. Every line below says what its constant was missing; a calibration made from less than that would look precise and be arbitrary."
msgstr "Nic nebylo proloženo. Každý řádek níže říká, co jeho konstantě chybělo; kalibrace udělaná z méně by vypadala přesně a byla by libovolná."

msgid "%(name)s was not fitted: %(reason)s"
msgstr "%(name)s nebyl proložen: %(reason)s"

msgid "%(count)d measured configuration"
msgid_plural "%(count)d measured configurations"
msgstr[0] "%(count)d změřená konfigurace"
msgstr[1] "%(count)d změřené konfigurace"
msgstr[2] "%(count)d změřených konfigurací"

msgid "What the model is for. It sets the score weights, the speed target and the context a candidate is measured against."
msgstr "K čemu je model určen. Nastavuje váhy skóre, cílovou rychlost a kontext, proti kterému se kandidát měří."

msgid "Capability the model must have; a model without it is excluded "
msgstr "Schopnost, kterou model musí mít; model bez ní je vyloučen "

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Ponechat jen tyto identifikátory licencí (lze opakovat)."

msgid "balanced, quality or speed: moves a tenth of the weight between quality and speed. It leans the board; it does not replace the weights."
msgstr "balanced, quality nebo speed: přesune desetinu váhy mezi kvalitou a rychlostí. Nakloní žebříček; váhy nenahrazuje."

msgid "Exclude anything larger to download, for example 40G or 7.5GiB."
msgstr "Vyloučit vše větší ke stažení, například 40G nebo 7.5GiB."

msgid "The worst verdict to list: comfortable, fits or tight."
msgstr "Nejhorší verdikt, který se ještě vypíše: comfortable, fits nebo tight."

msgid "invalid --min-fit %(value)s"
msgstr "neplatná hodnota --min-fit: %(value)s"

msgid "Valid values: %(values)s"
msgstr "Platné hodnoty: %(values)s"

msgid "invalid --prefer %(value)s"
msgstr "neplatná hodnota --prefer: %(value)s"

msgid "invalid --runs %(value)s"
msgstr "neplatná hodnota --runs: %(value)s"

msgid "invalid --sort %(value)s"
msgstr "neplatná hodnota --sort: %(value)s"

msgid "invalid --columns %(value)s"
msgstr "neplatná hodnota --columns: %(value)s"

msgid ""
"Rank the catalog for what you want to do on this machine.\n"
"\n"
"Every candidate is planned, sized and estimated here, so the first run scans the machine. Speeds compare candidates at 8K tokens of context; --explain expands a row into the scores, the weights, the budget and the speed breakdown that produced it."
msgstr ""
"Seřadit katalog podle toho, co chcete na tomto počítači dělat.\n"
"\n"
"Každý kandidát se tu naplánuje, změří a odhadne, takže první běh počítač prohledá. Rychlosti porovnávají kandidáty při 8K tokenech kontextu; --explain rozbalí řádek do skóre, vah, rozpočtu a rozpisu rychlosti, ze kterých vznikl."

msgid "Exclude candidates that cannot hold at least this many tokens."
msgstr "Vyloučit kandidáty, kteří neudrží aspoň tolik tokenů."

msgid "Show at most this many rows."
msgstr "Zobrazit nejvýše tolik řádků."

msgid "Show every quantisation instead of the best one per model."
msgstr "Zobrazit každou kvantizaci místo té nejlepší na model."

msgid "Expand every row shown into the scores, weights, budget and speed breakdown behind it. Combine with --limit 1 for one model."
msgstr "Rozbalit každý zobrazený řádek do skóre, vah, rozpočtu a rozpisu rychlosti, které za ním stojí. Spojte s --limit 1 pro jeden model."

msgid "Plan without a vision projector, freeing its memory."
msgstr "Plánovat bez vizuálního projektoru a uvolnit jeho paměť."

msgid "Nothing was ranked. Every candidate is listed below with the reason; widen the request or free some memory."
msgstr "Nic nebylo seřazeno. Každý kandidát je níže vypsán s důvodem; rozšiřte požadavek nebo uvolněte paměť."

msgid ""
"Rank every model by how well it uses this machine, whatever it is for.\n"
"\n"
"No use case, no weights and no score: this is the memory question on its own. Models are sized for 32K tokens of context, and the context column is the largest each one holds in the mode shown."
msgstr ""
"Seřadit každý model podle toho, jak dobře využívá tento počítač, ať je určen k čemukoli.\n"
"\n"
"Žádný případ použití, žádné váhy a žádné skóre: tohle je otázka paměti samotná. Modely se dimenzují na 32K tokenů kontextu a sloupec kontextu je největší, který každý z nich v zobrazeném režimu udrží."

msgid "Only the configurations that use the machine well: at least half its memory held in weights, and no pool past four fifths."
msgstr "Jen konfigurace, které počítač využívají dobře: aspoň polovina jeho paměti ve vahách a žádný fond nad čtyři pětiny."

msgid "Nothing fits this machine at that threshold. Try --min-fit tight, or drop --perfect."
msgstr "Na tomto prahu se na tento počítač nevejde nic. Zkuste --min-fit tight, nebo vynechte --perfect."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "Údržba katalogu: kontrola jeho souborů, obnovení proměnlivých polí."

msgid "Keep only this use case."
msgstr "Ponechat jen tento případ použití."

msgid "Keep only models with this capability (repeatable)."
msgstr "Ponechat jen modely s touto schopností (lze opakovat)."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "Zkontrolovat jen tento soubor místo vestavěného katalogu a vlastních úprav."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "Žádný model neodpovídá. Zkuste širší --use-case, --capability, --license, --vendor nebo --search."

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"Vypsat katalog modelů zúžený zadanými filtry.\n"
"\n"
"Tabulka ukazuje nejvýše tři schopnosti na model plus značku +N pro zbytek a je seřazena podle zobrazeného sloupce Kvalita; info nebo --json má všechny schopnosti."

msgid "Keep only this vendor, case-insensitive."
msgstr "Ponechat jen tohoto dodavatele, bez ohledu na velikost písmen."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "Hledání podřetězce v identifikátoru, názvu, dodavateli nebo rodině, bez ohledu na velikost písmen."

msgid "Show at most this many."
msgstr "Zobrazit nejvýše tolik položek."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "Zkratka pro llamafit list --search TEXT."

msgid "Text to match against id, name, vendor or family."
msgstr "Text hledaný v identifikátoru, názvu, dodavateli nebo rodině."

msgid ""
"Show one model: its facts, the quants it publishes, and what each would cost on this machine.\n"
"\n"
"The last table is sized against this machine, so the first run scans it. One line per quantisation; plan opens one of those rows into the memory budget, the context ladder and the command line."
msgstr ""
"Zobrazit jeden model: jeho údaje, kvantizace, které vydává, a kolik by každá na tomto počítači stála.\n"
"\n"
"Poslední tabulka je dimenzovaná na tento počítač, takže první běh jej prohledá. Jeden řádek na kvantizaci; plan otevře jeden z těch řádků do rozpočtu paměti, žebříčku kontextů a příkazové řádky."

msgid "Show only this quantisation, matched case-insensitively, in both tables."
msgstr "Zobrazit jen tuto kvantizaci, bez ohledu na velikost písmen, v obou tabulkách."

msgid "Size every quantisation for this many tokens instead of the usual 32,768."
msgstr "Dimenzovat každou kvantizaci na tento počet tokenů místo obvyklých 32 768."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "Zkontrolovat soubory YAML katalogu proti schématu a vypsat jeden řádek na každý problém."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "Zkontrolován %(count)d soubor, žádné problémy nenalezeny."
msgstr[1] "Zkontrolovány %(count)d soubory, žádné problémy nenalezeny."
msgstr[2] "Zkontrolováno %(count)d souborů, žádné problémy nenalezeny."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "Obnovit názvy souborů, velikosti, kontrolní součty a údaje GGUF pro katalog z Hugging Face."

msgid "Refresh only this model id."
msgstr "Obnovit jen tento identifikátor modelu."

msgid "Compute the refresh but write nothing."
msgstr "Spočítat obnovení, ale nic nezapisovat."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "Skončit s kódem 1, pokud by se něco změnilo; nic nemění, pro naplánovanou úlohu CI."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: varování: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "varování: %(warning)s (%(count)d model: %(models)s)"
msgstr[1] "varování: %(warning)s (%(count)d modely: %(models)s)"
msgstr[2] "varování: %(warning)s (%(count)d modelů: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: chyba: %(error)s"

msgid "Hint: %(hint)s"
msgstr "Tip: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "obnovení potřebuje síťový přístup k Hugging Face; zkontrolujte připojení a správnost identifikátoru repozitáře."

msgid "No changes."
msgstr "Žádné změny."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "Vypsat surový katalogový záznam jednoho modelu, ve výchozím stavu jako JSON nebo jako YAML s --yaml."

msgid "Print YAML instead of JSON."
msgstr "Vypisovat YAML místo JSON."

msgid "Did you mean: %(ids)s?"
msgstr "Nemysleli jste: %(ids)s?"

msgid "Run `llamafit list` to see every model id."
msgstr "Spusťte `llamafit list` a uvidíte všechny identifikátory modelů."

msgid "no model named %(id)s in the catalog"
msgstr "v katalogu není žádný model s názvem %(id)s"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "Nalezen %(count)d problém v katalogu; podrobnosti získáte příkazem `llamafit catalog validate`."
msgstr[1] "Nalezeny %(count)d problémy v katalogu; podrobnosti získáte příkazem `llamafit catalog validate`."
msgstr[2] "Nalezeno %(count)d problémů v katalogu; podrobnosti získáte příkazem `llamafit catalog validate`."

msgid "invalid --use-case %(value)s"
msgstr "neplatná hodnota --use-case: %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "Platné případy použití: %(values)s"

msgid "invalid %(option)s value: %(values)s"
msgid_plural "invalid %(option)s values: %(values)s"
msgstr[0] "neplatná hodnota %(option)s: %(values)s"
msgstr[1] "neplatné hodnoty %(option)s: %(values)s"
msgstr[2] "neplatné hodnoty %(option)s: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "Platné schopnosti: %(values)s"

msgid "%(option)s is not a size: %(value)s"
msgstr "%(option)s není velikost: %(value)s"

msgid "Sizes look like 8G, 7.5GiB or 512M; a bare number is bytes."
msgstr "Velikosti vypadají jako 8G, 7.5GiB nebo 512M; holé číslo jsou bajty."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "Vysvětlit, co bylo zjištěno, co selhalo a co by odemklo víc."

msgid "Hardware profiles: describe a machine in a file and score models against it."
msgstr "Hardwarové profily: popište počítač v souboru a hodnoťte modely proti němu."

msgid "Validate only this file instead of every bundled and user profile."
msgstr "Zkontrolovat jen tento soubor místo všech vestavěných a uživatelských profilů."

msgid "A profile name, or a path to a profile file."
msgstr "Název profilu, nebo cesta k souboru profilu."

msgid "%(count)d hardware profile problem found; run `llamafit hardware validate` for details."
msgid_plural "%(count)d hardware profile problems found; run `llamafit hardware validate` for details."
msgstr[0] "Nalezen %(count)d problém v hardwarových profilech; podrobnosti získáte příkazem `llamafit hardware validate`."
msgstr[1] "Nalezeny %(count)d problémy v hardwarových profilech; podrobnosti získáte příkazem `llamafit hardware validate`."
msgstr[2] "Nalezeno %(count)d problémů v hardwarových profilech; podrobnosti získáte příkazem `llamafit hardware validate`."

msgid "List the hardware profiles LlamaFit has: the bundled ones and your own."
msgstr "Vypsat hardwarové profily, které LlamaFit má: vestavěné i vaše vlastní."

msgid "No hardware profiles. Run `llamafit hardware path` to see where yours would go."
msgstr "Žádné hardwarové profily. Spusťte `llamafit hardware path` a uvidíte, kam by vaše patřily."

msgid ""
"Show one profile; with --as-host, the machine it stands in for.\n"
"\n"
"A host built from a profile is marked as simulated, in the table and in the JSON, so a what-if is never mistaken for a scan of this machine."
msgstr ""
"Zobrazit jeden profil; s --as-host počítač, který zastupuje.\n"
"\n"
"Počítač sestavený z profilu je označen jako simulovaný, v tabulce i v JSON, aby se úvaha co kdyby nikdy nezaměnila s prohlídkou tohoto počítače."

msgid "Show the host this profile substitutes, as `llamafit system` would."
msgstr "Zobrazit počítač, který tento profil nahrazuje, tak jak by to udělal `llamafit system`."

msgid "Check hardware profile files against the schema, printing one line per problem."
msgstr "Zkontrolovat soubory hardwarových profilů proti schématu a vypsat jeden řádek na každý problém."

msgid "Print the directory your own hardware profiles go in."
msgstr "Vypsat adresář, do kterého patří vaše vlastní hardwarové profily."

msgid "It does not exist yet; create it and put a %(suffix)s file in it."
msgstr "Zatím neexistuje; vytvořte jej a vložte do něj soubor %(suffix)s."

msgid "Install what it takes to run a model: llama.cpp itself, and the weights."
msgstr "Nainstalovat, co je k běhu modelu potřeba: samotný llama.cpp a váhy."

msgid "Install this backend instead of the one chosen for your GPU: cuda, vulkan, hip, sycl, metal or cpu."
msgstr "Nainstalovat tento backend místo toho, který byl vybrán pro vaše GPU: cuda, vulkan, hip, sycl, metal nebo cpu."

msgid "Install here instead of ~/.llamafit/llama.cpp."
msgstr "Nainstalovat sem místo do ~/.llamafit/llama.cpp."

msgid "Install this release tag, for example b6100, not the latest."
msgstr "Nainstalovat toto vydání, například b6100, ne to nejnovější."

msgid "invalid --backend %(value)s"
msgstr "neplatná hodnota --backend: %(value)s"

msgid "Valid backends: %(values)s"
msgstr "Platné backendy: %(values)s"

msgid "release %(tag)s publishes no %(backend)s build for %(os)s %(arch)s."
msgstr "vydání %(tag)s nevydává sestavení %(backend)s pro %(os)s %(arch)s."

msgid "Leave --backend out and LlamaFit will choose a published one."
msgstr "Vynechte --backend a LlamaFit vybere některé z vydaných."

msgid "release %(tag)s publishes nothing for %(os)s %(arch)s."
msgstr "vydání %(tag)s nevydává nic pro %(os)s %(arch)s."

msgid "Build llama.cpp from source; see the project's own instructions."
msgstr "Sestavte llama.cpp ze zdrojů; viz pokyny samotného projektu."

msgid "Release"
msgstr "Vydání"

msgid "%(tag)s (build %(build)s)"
msgstr "%(tag)s (sestavení %(build)s)"

msgid "Backend"
msgstr "Backend"

msgid "Archive"
msgstr "Archiv"

msgid "Also"
msgstr "Také"

msgid "Download"
msgstr "Stažení"

msgid "%(size)s (%(done)s already on disk)"
msgstr "%(size)s (%(done)s už na disku)"

msgid "Checksum"
msgstr "Kontrolní součet"

msgid "published, checked before anything is unpacked"
msgstr "zveřejněn, kontroluje se dřív, než se cokoli rozbalí"

msgid "none published"
msgstr "žádný zveřejněn"

msgid "Install into"
msgstr "Nainstalovat do"

msgid "Directory"
msgstr "Adresář"

msgid "Free space"
msgstr "Volné místo"

msgid "Free space (cache)"
msgstr "Volné místo (cache)"

msgid "%(free)s on %(path)s, %(needed)s needed"
msgstr "%(free)s v %(path)s, potřeba %(needed)s"

msgid "will be created"
msgstr "bude vytvořen"

msgid "exists and is empty"
msgstr "existuje a je prázdný"

msgid "holds %(tag)s, installed by LlamaFit; it will be replaced"
msgstr "obsahuje %(tag)s nainstalovaný LlamaFitem; bude nahrazen"

msgid "installed by LlamaFit; it will be replaced"
msgstr "nainstalováno LlamaFitem; bude nahrazeno"

msgid "was not installed by LlamaFit"
msgstr "nebylo nainstalováno LlamaFitem"

msgid "Downloading"
msgstr "Stahování"

msgid "Installed llama.cpp %(tag)s into %(path)s."
msgstr "llama.cpp %(tag)s nainstalován do %(path)s."

msgid "Replaced %(tag)s."
msgstr "Nahrazeno %(tag)s."

msgid "Backends found in it: %(backends)s"
msgstr "Nalezené backendy: %(backends)s"

msgid "none"
msgstr "žádné"

msgid "Check it with `llamafit doctor`."
msgstr "Zkontrolujte to příkazem `llamafit doctor`."

msgid "Change your PATH?"
msgstr "Změnit PATH?"

msgid "PATH left alone."
msgstr "PATH ponechána beze změny."

msgid "PATH changed. Open a new terminal for it to take effect."
msgstr "PATH změněna. Otevřete nový terminál, aby se to projevilo."

msgid ""
"Download a published llama.cpp build and install it into ~/.llamafit/llama.cpp.\n"
"\n"
"The plan is printed before anything is written. The archive's checksum is verified before it is unpacked, an interrupted download continues where it stopped, and a directory LlamaFit did not create is never overwritten."
msgstr ""
"Stáhnout vydané sestavení llama.cpp a nainstalovat je do ~/.llamafit/llama.cpp.\n"
"\n"
"Plán se vypíše dřív, než se cokoli zapíše. Kontrolní součet archivu se ověří před rozbalením, přerušené stahování pokračuje tam, kde skončilo, a adresář, který LlamaFit nevytvořil, se nikdy nepřepíše."

msgid "Offer to add the bin directory to your PATH, showing the undo first."
msgstr "Nabídnout přidání adresáře bin do PATH a nejdřív ukázat, jak to vzít zpět."

msgid "Install over a directory LlamaFit did not create. Ask yourself twice."
msgstr "Nainstalovat přes adresář, který LlamaFit nevytvořil. Rozmyslete si to dvakrát."

msgid "Install an archive that publishes no checksum. Nothing can be checked."
msgstr "Nainstalovat archiv, který nevydává kontrolní součet. Nedá se nic ověřit."

msgid "Print the plan and write nothing."
msgstr "Vypsat plán a nic nezapisovat."

msgid "Do not ask; assume yes."
msgstr "Neptat se; předpokládat ano."

msgid "Install this?"
msgstr "Nainstalovat?"

msgid "Nothing was written."
msgstr "Nic nebylo zapsáno."

msgid "Fetch this quantisation instead of the first the catalog publishes."
msgstr "Stáhnout tuto kvantizaci místo první, kterou katalog vydává."

msgid "Put the files here instead of under the configured downloads directory."
msgstr "Uložit soubory sem místo do nastaveného adresáře pro stahování."

msgid "Use at most this much bandwidth, for example 5M. Shared across every worker, so the figure is the figure whatever --workers says."
msgstr "Využívat nejvýše tolik šířky pásma, například 5M. Sdílí se mezi všemi pracovníky, takže hodnota platí bez ohledu na --workers."

msgid "How many requests to keep in flight. More is not always faster, and a home connection is shared with whoever else is using it."
msgstr "Kolik požadavků držet současně. Víc není vždy rychleji a domácí připojení sdílíte s tím, kdo je zrovna používá."

msgid "Do not ask before starting."
msgstr "Neptat se před začátkem."

msgid "Show what would be fetched and stop before fetching it."
msgstr "Zobrazit, co by se stáhlo, a před stažením skončit."

msgid "Fetch only the weights, not the vision projector or the draft model."
msgstr "Stáhnout jen váhy, ne vizuální projektor ani návrhový model."

msgid "Re-read files that are already here and check them against the catalog."
msgstr "Znovu přečíst soubory, které tu už jsou, a zkontrolovat je proti katalogu."

msgid "Fetch files the catalog holds no checksum for. Nothing will be able to tell you whether they arrived intact."
msgstr "Stáhnout soubory, pro které katalog nemá kontrolní součet. Nic vám nedokáže říct, jestli dorazily nepoškozené."

msgid "Show at most this many entries."
msgstr "Zobrazit nejvýše tolik položek."

msgid "already here"
msgstr "už tady"

msgid "to fetch"
msgstr "ke stažení"

msgid "About to download"
msgstr "Chystá se stažení"

msgid "File"
msgstr "Soubor"

msgid "Role"
msgstr "Role"

msgid "Size"
msgstr "Velikost"

msgid "Status"
msgstr "Stav"

msgid "%(name)s %(quant)s from %(repo)s"
msgstr "%(name)s %(quant)s z %(repo)s"

msgid "%(count)d file, %(total)s in all, %(needed)s still to fetch."
msgid_plural "%(count)d files, %(total)s in all, %(needed)s still to fetch."
msgstr[0] "%(count)d soubor, celkem %(total)s, zbývá stáhnout %(needed)s."
msgstr[1] "%(count)d soubory, celkem %(total)s, zbývá stáhnout %(needed)s."
msgstr[2] "%(count)d souborů, celkem %(total)s, zbývá stáhnout %(needed)s."

msgid "Into %(path)s, which has %(free)s free; %(after)s would be left."
msgstr "Do %(path)s, kde je volných %(free)s; zbylo by %(after)s."

msgid "The catalog holds no checksum for %(files)s."
msgid_plural "The catalog holds no checksums for %(files)s."
msgstr[0] "Katalog nemá kontrolní součet pro %(files)s."
msgstr[1] "Katalog nemá kontrolní součty pro %(files)s."
msgstr[2] "Katalog nemá kontrolní součty pro %(files)s."

msgid "Download a model's weights, resuming anything an earlier run left and checking every file against the catalog's checksum."
msgstr "Stáhnout váhy modelu, navázat na to, co zbylo z dřívějšího běhu, a zkontrolovat každý soubor proti kontrolnímu součtu z katalogu."

msgid "%(model)s %(quant)s is already here; nothing to do."
msgstr "%(model)s %(quant)s tu už je; není co dělat."

msgid "Start the download?"
msgstr "Zahájit stahování?"

msgid "Stopped. What arrived is kept; run `llamafit install model %(model)s` again to carry on from there."
msgstr "Zastaveno. Co dorazilo, se zachovává; spusťte `llamafit install model %(model)s` znovu a naváže se odtud."

msgid "%(count)d file, %(size)s, checked against the catalog."
