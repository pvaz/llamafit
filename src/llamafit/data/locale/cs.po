msgstr "žádné osazené paměťové moduly"

msgid "no SPMemoryDataType"
msgstr "žádný SPMemoryDataType"

msgid "%(program)s: timed out after %(seconds)s second"
msgid_plural "%(program)s: timed out after %(seconds)s seconds"
msgstr[0] "%(program)s: vypršel čas po %(seconds)s sekundě"
msgstr[1] "%(program)s: vypršel čas po %(seconds)s sekundách"
msgstr[2] "%(program)s: vypršel čas po %(seconds)s sekundách"

msgid "empty command"
msgstr "prázdný příkaz"

msgid "%(program)s: %(error)s"
msgstr "%(program)s: %(error)s"

msgid "%(program)s: not found"
msgstr "%(program)s: nenalezen"

msgid "exit code %(code)d: %(detail)s"
msgstr "návratový kód %(code)d: %(detail)s"

msgid "no hardware profile file at %(path)s"
msgstr "v %(path)s není žádný soubor hardwarového profilu"

msgid "Run `llamafit hardware list` to see the profiles LlamaFit has."
msgstr "Spusťte `llamafit hardware list` a uvidíte profily, které LlamaFit má."

msgid "%(path)s is not a valid hardware profile: %(details)s"
msgstr "%(path)s není platný hardwarový profil: %(details)s"

msgid "Run `llamafit hardware validate FILE` for the whole list."
msgstr "Celý seznam získáte příkazem `llamafit hardware validate FILE`."

msgid "no hardware profile named %(name)s"
msgstr "žádný hardwarový profil se jménem %(name)s"

msgid "Profiles LlamaFit has: %(names)s"
msgstr "Profily, které LlamaFit má: %(names)s"

msgid "Run `llamafit hardware path` to see where your own profiles go."
msgstr "Spusťte `llamafit hardware path` a uvidíte, kam patří vaše vlastní profily."

msgid "this machine has no graphics card, so there is no VRAM to override"
msgstr "tento počítač nemá grafickou kartu, takže není žádná VRAM, kterou by šlo přepsat"

msgid "Describe the whole machine in a hardware profile and pass --profile."
msgstr "Popište celý počítač v hardwarovém profilu a předejte --profile."

msgid "this machine has one memory pool shared with the graphics card"
msgstr "tento počítač má jeden fond paměti sdílený s grafickou kartou"

msgid "Use --ram to resize the pool; --memory would change only half of it."
msgstr "Velikost fondu změňte přes --ram; --memory by změnilo jen jeho polovinu."

msgid "%(option)s needs a value above zero"
msgstr "%(option)s potřebuje hodnotu větší než nula"

msgid "no build number in the version output: %(text)s"
msgstr "ve výstupu s verzí není číslo sestavení: %(text)s"

msgid "llama.cpp not found: no llama-server on PATH, in LLAMA_CPP_PATH or in the usual directories"
msgstr "llama.cpp nenalezen: žádný llama-server v PATH, v LLAMA_CPP_PATH ani v obvyklých adresářích"

msgid "no ggml backend libraries found next to llama-server; the build may be static"
msgstr "vedle llama-server nebyly nalezeny žádné knihovny backendů ggml; sestavení může být statické"

msgid "%(path)s is a file, not a directory."
msgstr "%(path)s je soubor, ne adresář."

msgid "%(path)s cannot be read: %(error)s"
msgstr "%(path)s nelze přečíst: %(error)s"

msgid "%(path)s has a marker file that cannot be read."
msgstr "%(path)s má soubor se značkou, který nelze přečíst."

msgid "%(path)s already holds %(count)d file that LlamaFit did not install."
msgid_plural "%(path)s already holds %(count)d files that LlamaFit did not install."
msgstr[0] "%(path)s už obsahuje %(count)d soubor, který LlamaFit nenainstaloval."
msgstr[1] "%(path)s už obsahuje %(count)d soubory, které LlamaFit nenainstaloval."
msgstr[2] "%(path)s už obsahuje %(count)d souborů, které LlamaFit nenainstaloval."

msgid "%(name)s has no published checksum, so it cannot be verified."
msgstr "%(name)s nemá zveřejněný kontrolní součet, takže jej nelze ověřit."

msgid "Pass --allow-unverified to install it anyway, knowing the archive is unchecked."
msgstr "Předejte --allow-unverified a nainstalujte jej i tak, s vědomím, že archiv není zkontrolovaný."

msgid "could not download %(url)s: %(error)s"
msgstr "nepodařilo se stáhnout %(url)s: %(error)s"

msgid "the connection was closed"
msgstr "spojení bylo uzavřeno"

msgid "Run the command again; it continues from where it stopped."
msgstr "Spusťte příkaz znovu; naváže tam, kde skončil."

msgid "the download of %(url)s stopped early: %(error)s"
msgstr "stahování %(url)s skončilo předčasně: %(error)s"

msgid "%(got)s of %(want)s arrived"
msgstr "dorazilo %(got)s z %(want)s"

msgid "the disk holding %(path)s is full."
msgstr "disk, na kterém je %(path)s, je plný."

msgid "Free some space and run the command again; the download resumes."
msgstr "Uvolněte místo a spusťte příkaz znovu; stahování naváže."

msgid "Check that the directory exists and is writable."
msgstr "Zkontrolujte, že adresář existuje a že do něj lze zapisovat."

msgid "%(name)s did not match its published checksum and was discarded."
msgstr "%(name)s neodpovídal svému zveřejněnému kontrolnímu součtu a byl zahozen."

msgid "Nothing was unpacked. Run the command again: the archive arrived damaged, which a second download usually fixes."
msgstr "Nic nebylo rozbaleno. Spusťte příkaz znovu: archiv dorazil poškozený, což druhé stažení obvykle spraví."

msgid "%(archive)s contains %(name)s, which would be written outside the install directory."
msgstr "%(archive)s obsahuje %(name)s, který by se zapsal mimo instalační adresář."

msgid "Do not install this archive; report it to the llama.cpp project."
msgstr "Tento archiv neinstalujte; nahlaste to projektu llama.cpp."

msgid "%(name)s is not an archive LlamaFit knows how to unpack."
msgstr "%(name)s není archiv, který by LlamaFit uměl rozbalit."

msgid "%(name)s could not be unpacked: %(error)s"
msgstr "%(name)s se nepodařilo rozbalit: %(error)s"

msgid "Delete it and run the command again to download it afresh."
msgstr "Smažte jej a spusťte příkaz znovu, aby se stáhl nanovo."

msgid "the archive holds no %(name)s."
msgstr "archiv neobsahuje %(name)s."

msgid "Report this; the release layout has changed."
msgstr "Nahlaste to; rozvržení vydání se změnilo."

msgid "%(path)s was not installed by LlamaFit."
msgstr "%(path)s nenainstaloval LlamaFit."

msgid "Pass --force to replace it, or --dir to install somewhere else. LlamaFit never overwrites an installation it did not create."
msgstr "Předejte --force a nahraďte jej, nebo --dir a nainstalujte jinam. LlamaFit nikdy nepřepisuje instalaci, kterou sám nevytvořil."

msgid "%(path)s has %(free)s free; this install needs %(needed)s."
msgstr "V %(path)s je volných %(free)s; tato instalace potřebuje %(needed)s."

msgid "Free some space, or pass --dir to install on another volume."
msgstr "Uvolněte místo, nebo předejte --dir a nainstalujte na jiný svazek."

msgid "the %(backend)s libraries are not in the installed directory."
msgstr "knihovny %(backend)s nejsou v nainstalovaném adresáři."

msgid "no ggml backend libraries were installed; the build may be a static one."
msgstr "nebyly nainstalovány žádné knihovny backendů ggml; sestavení může být statické."

msgid "Your PATH could not be read, so it will not be changed."
msgstr "Vaši PATH nešlo přečíst, takže se nezmění."

msgid "Add %(path)s to your user PATH (HKCU\\Environment)."
msgstr "Přidat %(path)s do vaší uživatelské PATH (HKCU\\Environment)."

msgid "To undo: run `setx PATH \"%(previous)s\"`, or remove the entry in System > About > Advanced system settings > Environment Variables."
msgstr "Vzít zpět: spusťte `setx PATH \"%(previous)s\"`, nebo odstraňte položku v Systém > Informace > Upřesnit nastavení systému > Proměnné prostředí."

msgid "%(path)s is already on your PATH."
msgstr "%(path)s už ve vaší PATH je."

msgid "Nothing to undo."
msgstr "Není co vracet."

msgid "Append a PATH line for %(path)s to %(file)s."
msgstr "Připojit řádek s PATH pro %(path)s do %(file)s."

msgid "To undo: delete the two lines marked `%(mark)s` from %(file)s."
msgstr "Vzít zpět: smažte z %(file)s dva řádky označené `%(mark)s`."

msgid "your PATH could not be changed: %(error)s"
msgstr "vaši PATH se nepodařilo změnit: %(error)s"

msgid "To remove it later, delete %(path)s."
msgstr "Pokud to budete chtít později odstranit, smažte %(path)s."

msgid "the most recent %(count)d llama.cpp releases hold no build."
msgstr "posledních %(count)d vydání llama.cpp neobsahuje žádné sestavení."

msgid "Name one with `llamafit install llama.cpp --tag ...`."
msgstr "Jmenujte některé příkazem `llamafit install llama.cpp --tag ...`."

msgid "could not reach GitHub at %(url)s: %(error)s"
msgstr "nepodařilo se spojit s GitHubem na %(url)s: %(error)s"

msgid "GitHub refused the request for %(url)s: the rate limit is exhausted."
msgstr "GitHub odmítl požadavek na %(url)s: limit požadavků je vyčerpán."

msgid "Wait for the limit to reset, or set GITHUB_TOKEN to a personal access token with no scopes."
msgstr "Počkejte, až se limit obnoví, nebo nastavte GITHUB_TOKEN na osobní přístupový token bez rozsahů."

msgid "GitHub has no release at %(url)s."
msgstr "GitHub nemá na %(url)s žádné vydání."

msgid "Check the tag with `llamafit install llama.cpp --tag ...`."
msgstr "Zkontrolujte značku příkazem `llamafit install llama.cpp --tag ...`."

msgid "GitHub returned %(status)d for %(url)s."
msgstr "GitHub vrátil %(status)d pro %(url)s."

msgid "GitHub's answer for %(url)s was not JSON."
msgstr "Odpověď GitHubu pro %(url)s nebyla JSON."

msgid "GitHub's answer did not describe a release."
msgstr "Odpověď GitHubu nepopisovala vydání."

msgid "no llama-server answering"
msgstr "žádný llama-server neodpovídá"

msgid "unexpected response: %(error)s"
msgstr "neočekávaná odpověď: %(error)s"

msgid "%(model)s holds %(native)s tokens, fewer than the %(minimum)s asked for."
msgstr "%(model)s udrží %(native)s tokenů, méně než požadovaných %(minimum)s."

msgid "No configuration of this model fits this machine."
msgstr "Žádná konfigurace tohoto modelu se na tento počítač nevejde."

msgid "Routed experts are held in system memory, and so are the always-on shared experts, which is what -ot ffn_.*_shexp=CPU does; attention and the KV cache stay on the card."
msgstr "Směrovaní experti jsou drženi v systémové paměti a stejně tak stále zapnutí sdílení experti, což je to, co dělá -ot ffn_.*_shexp=CPU; pozornost a KV cache zůstávají na kartě."

msgid "Routed experts are held in system memory; attention, the KV cache and the shared experts stay on the card."
msgstr "Směrovaní experti jsou drženi v systémové paměti; pozornost, KV cache a sdílení experti zůstávají na kartě."

msgid "%(layers)s layers are on the card and the rest run on the processor."
msgstr "%(layers)s vrstev je na kartě a zbytek běží na procesoru."

msgid "Nothing runs on a graphics card: every weight is in system memory."
msgstr "Na grafické kartě neběží nic: všechny váhy jsou v systémové paměti."

msgid "%(gpus)s is here, but nothing could read how much of it is free, so this plan was made as if it were not. The real machine will be faster than these figures."
msgstr "%(gpus)s tu je, ale nic nedokázalo přečíst, kolik z ní je volné, takže se tento plán udělal, jako by tu nebyla. Skutečný počítač bude rychlejší než tyto údaje."

msgid "Sized for %(context)s tokens rather than the %(requested)s asked for."
msgstr "Dimenzováno na %(context)s tokenů místo požadovaných %(requested)s."

msgid "The KV cache is quantised to %(type)s to reach this context."
msgstr "KV cache je kvantizována na %(type)s, aby se tohoto kontextu dosáhlo."

msgid "Vision is off: the projector did not fit, on the card or in system memory."
msgstr "Vidění je vypnuté: projektor se nevešel, ani na kartu, ani do systémové paměti."

msgid "The vision projector is in system memory (--no-mmproj-offload), which costs nothing measurable for text and makes images slower."
msgstr "Vizuální projektor je v systémové paměti (--no-mmproj-offload), což u textu nestojí nic měřitelného a obrázky zpomaluje."

msgid "%(threads)s threads, not the %(available)s this processor has: the efficiency cores are left out because generation measures slower with them, and what is left is the threads the performance cores provide."
msgstr "%(threads)s vláken, ne %(available)s, která tento procesor má: úsporná jádra se vynechávají, protože s nimi generování měří pomaleji, a co zbývá, jsou vlákna výkonných jader."

msgid "Tight: %(vram)s of the graphics card is free and this needs %(needed)s, so another program can push it over. The context tier table is how a launch script recovers."
msgstr "Těsně: na grafické kartě je volných %(vram)s a tohle potřebuje %(needed)s, takže jiný program to může překlopit. Tabulka úrovní kontextu je způsob, jak se z toho spouštěcí skript dostane."

msgid "no %(capability)s capability, which %(use_case)s needs; ask for a different use case, or add it to the entry when the model really has it"
msgstr "chybí schopnost %(capability)s, kterou %(use_case)s potřebuje; požádejte o jiný případ použití, nebo ji do záznamu doplňte, pokud ji model opravdu má"

msgid "no %(capability)s capability; drop it from the request to see this model"
msgstr "chybí schopnost %(capability)s; vypusťte ji z požadavku, ať je tento model vidět"

msgid "%(size)s to download, over the %(limit)s this request allows"
msgstr "%(size)s ke stažení, přes %(limit)s, které tento požadavek dovoluje"

msgid "unknown quantisation %(quant)s, so its cost in quality cannot be told"
msgstr "neznámá kvantizace %(quant)s, takže nelze říct, co stojí na kvalitě"

msgid "nowhere to put it: no placement fits this machine at any context"
msgstr "není kam to dát: žádné umístění se na tento počítač nevejde při žádném kontextu"

msgid "no run mode supports this model on this machine"
msgstr "žádný režim běhu tento model na tomto počítači nepodporuje"

msgid "needs more memory than this machine has, even at its smallest context"
msgstr "potřebuje víc paměti, než tento počítač má, i při nejmenším kontextu"

msgid "holds %(fit)s tokens at most, under the %(minimum)s asked for; lower the minimum context or free memory to see it ranked"
msgstr "udrží nejvýše %(fit)s tokenů, méně než požadovaných %(minimum)s; snižte minimální kontext nebo uvolněte paměť, ať se zařadí"

msgid "no speed estimate, so it cannot be ranked against models that have one"
msgstr "žádný odhad rychlosti, takže jej nelze zařadit vedle modelů, které jej mají"

msgid "unknown use case %(use_case)s"
msgstr "neznámý případ použití %(use_case)s"

msgid "Known use cases: %(known)s."
msgstr "Známé případy použití: %(known)s."

msgid "unknown score part %(part)s in the weights for %(use_case)s"
msgstr "neznámá část skóre %(part)s ve vahách pro %(use_case)s"

msgid "The parts are: %(parts)s."
msgstr "Části jsou: %(parts)s."

msgid "the weights for %(use_case)s leave out %(part)s"
msgstr "váhy pro %(use_case)s vynechávají %(part)s"

msgid "Overriding a use case means giving all four parts: %(parts)s."
msgstr "Přepsat případ použití znamená zadat všechny čtyři části: %(parts)s."

msgid "the weight for %(part)s in %(use_case)s is below zero"
msgstr "váha pro %(part)s v %(use_case)s je pod nulou"

msgid "A weight says how much a part counts; it cannot count less than none."
msgstr "Váha říká, jak moc část počítá; nemůže počítat míň než vůbec."

msgid "the weights for %(use_case)s add up to nothing"
msgstr "váhy pro %(use_case)s dávají dohromady nic"

msgid "At least one part has to count for something."
msgstr "Aspoň jedna část musí něco vážit."

msgid "unknown preference %(prefer)s"
msgstr "neznámá preference %(prefer)s"

msgid "Preferences: %(known)s."
msgstr "Preference: %(known)s."

msgid "Install or repair the NVIDIA driver; nvidia-smi ships with it and must be on PATH."
msgstr "Nainstalujte nebo opravte ovladač NVIDIA; nvidia-smi se dodává s ním a musí být v PATH."

msgid "Install ROCm (Linux) to expose AMD VRAM figures; without it the GPU is listed by name only."
msgstr "Nainstalujte ROCm (Linux), aby byly vidět údaje o VRAM karet AMD; bez něj se GPU vypíše jen jménem."

msgid "PowerShell could not list video controllers; run from a normal user session."
msgstr "PowerShell nedokázal vypsat videokontroléry; spusťte to z běžné uživatelské relace."

msgid "Install pciutils to list GPUs by name when no vendor tool is available."
msgstr "Nainstalujte pciutils, aby šlo vypsat GPU jménem, když není k dispozici nástroj výrobce."

msgid "DDR type and speed were not readable; on Linux run once with sudo (dmidecode) or accept the measured bandwidth instead."
msgstr "Typ a takt DDR nešly přečíst; na Linuxu spusťte jednou se sudo (dmidecode), nebo přijměte místo toho změřenou propustnost."

msgid "py-cpuinfo failed; the CPU model and instruction sets are unknown."
msgstr "py-cpuinfo selhalo; model CPU a instrukční sady jsou neznámé."

msgid "psutil could not count the CPU cores; thread choice falls back to one core. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil nedokázal spočítat jádra CPU; volba počtu vláken se vrací k jednomu jádru. Přeinstalujte psutil příkazem `pip install --force-reinstall psutil`."

msgid "psutil could not read the memory totals; budgets cannot be computed until this works. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil nedokázal přečíst celkovou paměť; dokud to nebude fungovat, nelze spočítat rozpočty. Přeinstalujte psutil příkazem `pip install --force-reinstall psutil`."

msgid "Could not read performance-core count from sysctl."
msgstr "Nepodařilo se ze sysctl přečíst počet výkonných jader."

msgid "llama-server exists but did not report a version; the binary may be broken."
msgstr "llama-server existuje, ale neuvedl verzi; spustitelný soubor může být poškozený."

msgid "system_profiler failed; GPU information is unavailable."
msgstr "system_profiler selhal; informace o GPU nejsou k dispozici."

msgid "Install the Vulkan tools (vulkan-tools on Linux, the vendor's Vulkan runtime on Windows) so an unsized card's memory can be read from its driver. This probe runs only when no vendor tool sized the card, so it is the last source there is."
msgstr "Nainstalujte nástroje Vulkan (vulkan-tools na Linuxu, běhové prostředí Vulkan od výrobce na Windows), aby šlo velikost paměti nezměřené karty přečíst z jejího ovladače. Tato sonda běží jen tehdy, když kartu nezměřil žádný nástroj výrobce, takže je posledním zdrojem, který je."

msgid "No vendor tool reported the GPU's memory size; record the size in a hardware profile so budgets can be computed for this machine."
msgstr "Žádný nástroj výrobce neuvedl velikost paměti GPU; zapište tuto velikost do hardwarového profilu, aby šlo pro tento počítač spočítat rozpočty."

msgid "llama.cpp installed"
msgstr "llama.cpp nainstalován"

msgid "build %(build)s at %(path)s, backends: %(backends)s"
msgstr "sestavení %(build)s v %(path)s, backendy: %(backends)s"

msgctxt "llama.cpp build"
msgid "unknown"
msgstr "neznámé"

msgid "llama.cpp not found"
msgstr "llama.cpp nenalezen"

msgid "no llama-server binary was found"
msgstr "spustitelný soubor llama-server nebyl nalezen"

msgid "Run `llamafit install llama.cpp`, which picks the right build for this machine, checks it against its published checksum, and never touches an installation LlamaFit did not create."
msgstr "Spusťte `llamafit install llama.cpp`, který vybere správné sestavení pro tento počítač, zkontroluje je proti zveřejněnému kontrolnímu součtu a nikdy nesáhne na instalaci, kterou LlamaFit nevytvořil."

msgid "Memory size unknown"
msgstr "Velikost paměti neznámá"

msgid "LlamaFit could not read this machine's memory totals, so it cannot work out what will fit."
msgstr "LlamaFit nedokázal přečíst celkovou paměť tohoto počítače, takže nemůže zjistit, co se vejde."

msgid "%(gpu)s: no %(backend)s backend in llama.cpp"
msgstr "%(gpu)s: v llama.cpp není backend %(backend)s"

msgid "llama.cpp was built with: %(backends)s"
msgstr "llama.cpp byl sestaven s backendy: %(backends)s"

msgctxt "backends"
msgid "unknown"
msgstr "neznámé"

msgid "Install a llama.cpp build with the %(backend)s or Vulkan backend to use %(gpu)s."
msgstr "Nainstalujte sestavení llama.cpp s backendem %(backend)s nebo Vulkan, abyste mohli použít %(gpu)s."

msgid "%(gpu)s: VRAM size unknown"
msgstr "%(gpu)s: velikost VRAM neznámá"

msgid "the vendor tool that reports memory was not available"
msgstr "nástroj výrobce, který hlásí paměť, nebyl k dispozici"

msgid "%(gpus)s: planned around, not planned on"
msgstr "%(gpus)s: plánováno kolem ní, ne na ni"

msgid "with no reading of how much of the card is free, every budget and every speed on this machine was computed as if there were no card: they are CPU-only figures, and the real machine will be faster."
msgstr "bez údaje o tom, kolik paměti karty je volné, se každý rozpočet a každá rychlost na tomto počítači počítaly, jako by žádná karta nebyla: jsou to údaje jen pro CPU a skutečný počítač bude rychlejší."

msgid "Install the Vulkan tools so the size can be read from the driver, or record it in a hardware profile (`llamafit hardware path` says where those go) and pass --profile."
msgstr "Nainstalujte nástroje Vulkan, aby šlo velikost přečíst z ovladače, nebo ji zapište do hardwarového profilu (`llamafit hardware path` říká, kam patří) a předejte --profile."

msgid "No GPU detected"
msgstr "Nezjištěno žádné GPU"

msgid "models will run on the CPU only"
msgstr "modely poběží jen na CPU"

msgid "If a GPU is present, check that its driver tools are installed."
msgstr "Pokud je GPU přítomné, zkontrolujte, že jsou nainstalované nástroje jeho ovladače."

msgid "RAM bandwidth assumed"
msgstr "Propustnost RAM předpokládána"

msgid "using %(gbps)s GB/s as a default"
msgstr "používá se výchozí hodnota %(gbps)s GB/s"

msgid "Install numpy (`pip install llamafit[fast]`) so LlamaFit can measure the RAM bandwidth."
msgstr "Nainstalujte numpy (`pip install llamafit[fast]`), aby LlamaFit mohl změřit propustnost RAM."

msgid "Probe %(probe)s failed"
msgstr "Sonda %(probe)s selhala"

msgctxt "probe error"
msgid "unknown error"
msgstr "neznámá chyba"

msgid "llama-server running at %(url)s"
msgstr "llama-server běží na %(url)s"

msgid "model %(model)s, context %(context)s"
msgstr "model %(model)s, kontext %(context)s"

msgctxt "model name"
msgid "unknown"
msgstr "neznámý"

msgid "Low disk space on %(path)s"
msgstr "Málo místa na disku v %(path)s"

msgid "%(size)s free"
msgstr "volných %(size)s"

msgid "Most useful models need 5 to 120 GB; free space or change the downloads directory."
msgstr "Většina užitečných modelů potřebuje 5 až 120 GB; uvolněte místo nebo změňte adresář pro stahování."

msgid "licensed %(spdx)s, which this request does not allow"
msgstr "licencováno jako %(spdx)s, což tento požadavek nedovoluje"

msgid "no placement of it fits this machine at any context"
msgstr "žádné jeho umístění se na tento počítač nevejde při žádném kontextu"

msgid "System memory bandwidth was not measured; %(gbps)s GB/s assumed for %(arch)s."
msgstr "Propustnost systémové paměti nebyla změřena; pro %(arch)s se předpokládá %(gbps)s GB/s."

msgid "%(gpu)s bandwidth is unknown; the %(backend)s fallback of %(gbps)s GB/s stands in."
msgstr "Propustnost %(gpu)s je neznámá; zastupuje ji záložní hodnota %(gbps)s GB/s pro %(backend)s."

msgid "No graphics card compute figure: prompt processing is estimated on the CPU."
msgstr "Žádný údaj o výkonu grafické karty: zpracování promptu se odhaduje na CPU."

msgid "%(gb)s GB of routed experts is read from system memory per token at %(eff)s of its %(raw)s GB/s, because each token selects a different handful of experts and the read is a scatter of small blocks rather than a stream."
msgstr "%(gb)s GB směrovaných expertů se na token čte ze systémové paměti při %(eff)s z jejích %(raw)s GB/s, protože každý token vybírá jinou hrstku expertů a čtení je rozptyl malých bloků, ne proud."

msgid "%(gb)s GB of contiguous weights is read from system memory per token at %(eff)s of its %(raw)s GB/s."
msgstr "%(gb)s GB souvislých vah se na token čte ze systémové paměti při %(eff)s z jejích %(raw)s GB/s."

msgid "No active parameter count was supplied; it was inferred from the weight bytes."
msgstr "Nebyl zadán počet aktivních parametrů; odvodil se z bajtů vah."

msgid "%(pct)s percent of the layers sit in system memory, so that share of the prompt arithmetic is charged to the CPU at %(tflops)s TFLOP/s rather than to the card. Both rates come from one small dense model on one machine."
msgstr "%(pct)s procent vrstev sedí v systémové paměti, takže se tento podíl počítání promptu účtuje CPU při %(tflops)s TFLOP/s, a ne kartě. Obě rychlosti pocházejí z jednoho malého hustého modelu na jednom počítači."

msgid "%(gb)s GB of the expert set is streamed across the link once per micro-batch at %(gbps)s GB/s. That rate was fitted on the one model whose expert set does not fit in system memory, so part of its read comes off the disk; an expert set that stays in the page cache streams about three times faster, and for one of those this term is that much too slow."
msgstr "%(gb)s GB sady expertů se jednou na mikrodávku streamuje přes linku při %(gbps)s GB/s. Ta rychlost byla proložena na jediném modelu, jehož sada expertů se do systémové paměti nevejde, takže se část jejího čtení bere z disku; sada expertů, která zůstane ve stránkové cache, streamuje asi třikrát rychleji, a u takové je tento člen právě o tolik pomalejší."

msgid "%(gb)s GB of the expert set is read out of system memory once per micro-batch at %(gbps)s GB/s, because there is no card to stream it to."
msgstr "%(gb)s GB sady expertů se jednou na mikrodávku čte ze systémové paměti při %(gbps)s GB/s, protože není karta, na kterou by se streamovalo."

msgid "No placement of this model on this machine could run it."
msgstr "Žádné umístění tohoto modelu na tento počítač by jej nespustilo."

msgid "Generation is a benchmark of this configuration, not a prediction."
msgstr "Generování je benchmark této konfigurace, ne předpověď."

msgid "Generation is the formula corrected by %(factor)s, from a benchmark of %(profile)s on this machine taken on %(date)s."
msgstr "Generování je vzorec opravený o %(factor)s, z benchmarku %(profile)s na tomto počítači pořízeného %(date)s."

msgid "Prompt processing is a benchmark of this configuration."
msgstr "Zpracování promptu je benchmark této konfigurace."

msgid "Prompt processing is the formula corrected by %(factor)s from a benchmark."
msgstr "Zpracování promptu je vzorec opravený o %(factor)s z benchmarku."

msgid "That benchmark's command line does not record how many layers went to the card, so the correction assumes it ran at this placement."
msgstr "Příkazová řádka toho benchmarku nezaznamenává, kolik vrstev šlo na kartu, takže oprava předpokládá, že běžel při tomto umístění."

msgid "This figure assumes nothing pages: a placement this tight often does, silently."
msgstr "Tento údaj předpokládá, že se nic nestránkuje: takhle těsné umístění často stránkuje, potichu."

