msgstr "py-cpuinfo selhalo; model CPU a instrukční sady jsou neznámé."

msgid "psutil could not count the CPU cores; thread choice falls back to one core. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil nedokázal spočítat jádra CPU; volba počtu vláken se vrací k jednomu jádru. Přeinstalujte psutil příkazem `pip install --force-reinstall psutil`."

msgid "psutil could not read the memory totals; budgets cannot be computed until this works. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "psutil nedokázal přečíst celkovou paměť; dokud to nebude fungovat, nelze spočítat rozpočty. Přeinstalujte psutil příkazem `pip install --force-reinstall psutil`."

msgid "Could not read performance-core count from sysctl."
msgstr "Nepodařilo se ze sysctl přečíst počet výkonných jader."

msgid "llama-server exists but did not report a version; the binary may be broken."
msgstr "llama-server existuje, ale neuvedl verzi; spustitelný soubor může být poškozený."

msgid "system_profiler failed; GPU information is unavailable."
msgstr "system_profiler selhal; informace o GPU nejsou k dispozici."

msgid "No vendor tool reported the GPU's memory size; record the size in a hardware profile so budgets can be computed for this machine."
msgstr "Žádný nástroj výrobce neuvedl velikost paměti GPU; zapište tuto velikost do hardwarového profilu, aby šlo pro tento počítač spočítat rozpočty."

