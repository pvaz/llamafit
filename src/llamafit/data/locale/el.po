msgstr "άγνωστος τύπος τιμής GGUF %(type)d στη θέση %(offset)d"

msgid "This file may use a newer GGUF metadata type than LlamaFit supports."
msgstr "Αυτό το αρχείο μπορεί να χρησιμοποιεί νεότερο τύπο μεταδεδομένων GGUF από όσους υποστηρίζει το LlamaFit."

msgid "not a GGUF file: bad magic %(magic)s at offset 0"
msgstr "δεν είναι αρχείο GGUF: εσφαλμένη υπογραφή %(magic)s στη θέση 0"

msgid "Check that this file is actually a .gguf model."
msgstr "Ελέγξτε ότι αυτό το αρχείο είναι όντως μοντέλο .gguf."

msgid "unsupported GGUF version %(version)d at offset 4"
msgstr "μη υποστηριζόμενη έκδοση GGUF %(version)d στη θέση 4"

msgid "LlamaFit supports GGUF versions %(versions)s."
msgstr "Το LlamaFit υποστηρίζει τις εκδόσεις GGUF %(versions)s."

msgid "these GGUF files are not one split model: they disagree about '%(key)s', declaring %(values)s"
msgstr "αυτά τα αρχεία GGUF δεν είναι ένα διαιρεμένο μοντέλο: διαφωνούν ως προς το '%(key)s', δηλώνοντας %(values)s"

msgid "Pass the shards of one model, not of several."
msgstr "Δώστε τα τμήματα ενός μοντέλου, όχι πολλών."

msgid "no GGUF header to read facts from"
msgstr "δεν υπάρχει κεφαλίδα GGUF από την οποία να διαβαστούν στοιχεία"

msgid "Pass the model's file, or every shard of a split model."
msgstr "Δώστε το αρχείο του μοντέλου, ή κάθε τμήμα ενός διαιρεμένου μοντέλου."

msgid "%(count)d of %(total)d GGUF files carry no '%(key)s' key, so their place in a split model cannot be established"
msgstr "%(count)d από %(total)d αρχεία GGUF δεν φέρουν το κλειδί '%(key)s', οπότε δεν μπορεί να προσδιοριστεί η θέση τους σε ένα διαιρεμένο μοντέλο"

msgid "Pass a single unsplit file on its own, or every shard of one split model."
msgstr "Δώστε ένα μόνο αδιαίρετο αρχείο, ή κάθε τμήμα ενός διαιρεμένου μοντέλου."

msgid "incomplete shard set: the model declares %(declared)d shards and %(arrived)d arrived (%(key)s %(numbers)s)"
msgstr "ελλιπές σύνολο τμημάτων: το μοντέλο δηλώνει %(declared)d τμήματα και έφτασαν %(arrived)d (%(key)s %(numbers)s)"

msgid "Pass every shard of the split model."
msgstr "Δώστε κάθε τμήμα του διαιρεμένου μοντέλου."

msgid "the shard holding the model's metadata is missing: got %(key)s %(numbers)s, expected one of them to be 0"
msgstr "λείπει το τμήμα που φέρει τα μεταδεδομένα του μοντέλου: ελήφθη %(key)s %(numbers)s, ενώ αναμενόταν ένα από αυτά να είναι 0"

msgid "Pass every shard of the split model, including the first."
msgstr "Δώστε κάθε τμήμα του διαιρεμένου μοντέλου, μαζί με το πρώτο."

msgid "incomplete shard set: expected %(key)s 0 to %(last)d, got %(numbers)s"
msgstr "ελλιπές σύνολο τμημάτων: αναμενόταν %(key)s από 0 έως %(last)d, ελήφθη %(numbers)s"

msgid "Pass each shard of the split model exactly once."
msgstr "Δώστε κάθε τμήμα του διαιρεμένου μοντέλου ακριβώς μία φορά."

msgid "incomplete shard set: the model declares %(declared)d tensors and its %(shards)d shards hold %(held)d between them"
msgstr "ελλιπές σύνολο τμημάτων: το μοντέλο δηλώνει %(declared)d τανυστές και τα %(shards)d τμήματά του κρατούν συνολικά %(held)d"

msgid "could not read %(path)s: %(error)s"
msgstr "δεν ήταν δυνατή η ανάγνωση του %(path)s: %(error)s"

msgid "Check that the file exists and is readable."
msgstr "Ελέγξτε ότι το αρχείο υπάρχει και είναι αναγνώσιμο."

msgid "could not fetch %(url)s: %(error)s"
msgstr "δεν ήταν δυνατή η λήψη του %(url)s: %(error)s"

msgid "Check your network connection and that the URL is reachable."
msgstr "Ελέγξτε τη σύνδεσή σας στο δίκτυο και ότι το URL είναι προσβάσιμο."

msgid "%(url)s returned HTTP %(status)d instead of 206 Partial Content; the server may not support range requests."
msgstr "Το %(url)s επέστρεψε HTTP %(status)d αντί για 206 Partial Content· ο διακομιστής μπορεί να μην υποστηρίζει αιτήματα εύρους."

msgid "Confirm the URL points at a downloadable GGUF file."
msgstr "Επιβεβαιώστε ότι το URL δείχνει σε αρχείο GGUF που μπορεί να ληφθεί."

msgctxt "CPU model"
msgid "unknown"
msgstr "άγνωστο"

msgid "nvidia-smi returned no GPUs"
msgstr "το nvidia-smi δεν επέστρεψε καμία GPU"

msgid "rocm-smi returned no cards"
msgstr "το rocm-smi δεν επέστρεψε καμία κάρτα"

msgid "system_profiler returned no displays"
msgstr "το system_profiler δεν επέστρεψε καμία οθόνη"

msgid "WMI returned no video controllers"
msgstr "το WMI δεν επέστρεψε ελεγκτές βίντεο"

msgid "lspci found no display controllers"
msgstr "το lspci δεν βρήκε ελεγκτές οθόνης"

msgid "no populated memory modules"
msgstr "καμία κατειλημμένη μονάδα μνήμης"

msgid "no SPMemoryDataType"
msgstr "χωρίς SPMemoryDataType"

msgid "empty command"
msgstr "κενή εντολή"

msgid "%(program)s: timed out after %(seconds)ss"
msgstr "%(program)s: έληξε το χρονικό όριο μετά από %(seconds)s δευτερόλεπτα"

msgid "%(program)s: %(error)s"
msgstr "%(program)s: %(error)s"

msgid "%(program)s: not found"
msgstr "%(program)s: δεν βρέθηκε"

msgid "no output"
msgstr "χωρίς έξοδο"

msgid "exit code %(code)d: %(detail)s"
msgstr "κωδικός εξόδου %(code)d: %(detail)s"

msgid "llama.cpp not found: no llama-server on PATH, in LLAMA_CPP_PATH or in the usual directories"
msgstr "το llama.cpp δεν βρέθηκε: δεν υπάρχει llama-server στο PATH, στο LLAMA_CPP_PATH ή στους συνήθεις φακέλους"

msgid "no ggml backend libraries found next to llama-server; the build may be static"
msgstr "δεν βρέθηκαν βιβλιοθήκες υποσυστημάτων ggml δίπλα στο llama-server· η δόμηση μπορεί να είναι στατική"

msgid "no llama-server answering"
msgstr "κανένας llama-server δεν απαντά"

msgid "unexpected response: %(error)s"
msgstr "απροσδόκητη απόκριση: %(error)s"

msgid "Install or repair the NVIDIA driver; nvidia-smi ships with it and must be on PATH."
msgstr "Εγκαταστήστε ή επιδιορθώστε το πρόγραμμα οδήγησης NVIDIA· το nvidia-smi το συνοδεύει και πρέπει να βρίσκεται στο PATH."

msgid "Install ROCm (Linux) to expose AMD VRAM figures; without it the GPU is listed by name only."
msgstr "Εγκαταστήστε το ROCm (Linux) για να εμφανιστούν τα μεγέθη VRAM της AMD· χωρίς αυτό η GPU παρατίθεται μόνο με το όνομά της."

msgid "PowerShell could not list video controllers; run from a normal user session."
msgstr "Το PowerShell δεν μπόρεσε να παραθέσει τους ελεγκτές βίντεο· εκτελέστε το από κανονική συνεδρία χρήστη."

msgid "Install pciutils to list GPUs by name when no vendor tool is available."
msgstr "Εγκαταστήστε το pciutils ώστε οι GPU να παρατίθενται με το όνομά τους όταν δεν υπάρχει εργαλείο κατασκευαστή."

msgid "DDR type and speed were not readable; on Linux run once with sudo (dmidecode) or accept the measured bandwidth instead."
msgstr "Ο τύπος και η ταχύτητα της DDR δεν ήταν αναγνώσιμα· στο Linux εκτελέστε μία φορά με sudo (dmidecode) ή δεχτείτε το μετρημένο εύρος ζώνης."

msgid "py-cpuinfo failed; the CPU model and instruction sets are unknown."
msgstr "Το py-cpuinfo απέτυχε· το μοντέλο της CPU και τα σύνολα εντολών είναι άγνωστα."

msgid "psutil could not count the CPU cores; thread choice falls back to one core. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "Το psutil δεν μπόρεσε να μετρήσει τους πυρήνες της CPU· η επιλογή νημάτων επιστρέφει σε έναν πυρήνα. Επανεγκαταστήστε το psutil με `pip install --force-reinstall psutil`."

msgid "psutil could not read the memory totals; budgets cannot be computed until this works. Reinstall psutil with `pip install --force-reinstall psutil`."
msgstr "Το psutil δεν μπόρεσε να διαβάσει τα σύνολα μνήμης· δεν μπορούν να υπολογιστούν προϋπολογισμοί μέχρι να δουλέψει αυτό. Επανεγκαταστήστε το psutil με `pip install --force-reinstall psutil`."

msgid "Could not read performance-core count from sysctl."
msgstr "Δεν ήταν δυνατή η ανάγνωση του πλήθους πυρήνων απόδοσης από το sysctl."

msgid "llama-server exists but did not report a version; the binary may be broken."
msgstr "Το llama-server υπάρχει αλλά δεν ανέφερε έκδοση· το εκτελέσιμο μπορεί να είναι χαλασμένο."

msgid "system_profiler failed; GPU information is unavailable."
msgstr "Το system_profiler απέτυχε· δεν υπάρχουν πληροφορίες για τη GPU."

msgid "No vendor tool reported the GPU's memory size; record the size in a hardware profile so budgets can be computed for this machine."
msgstr "Κανένα εργαλείο κατασκευαστή δεν ανέφερε το μέγεθος μνήμης της GPU· καταγράψτε το μέγεθος σε ένα προφίλ υλικού ώστε να μπορούν να υπολογιστούν προϋπολογισμοί για αυτό το μηχάνημα."

msgid "llama.cpp installed"
msgstr "το llama.cpp είναι εγκατεστημένο"

msgid "build %(build)s at %(path)s, backends: %(backends)s"
msgstr "δόμηση %(build)s στο %(path)s, υποσυστήματα: %(backends)s"

msgctxt "llama.cpp build"
msgid "unknown"
msgstr "άγνωστη"

msgid "llama.cpp not found"
msgstr "το llama.cpp δεν βρέθηκε"

msgid "no llama-server binary was found"
msgstr "δεν βρέθηκε εκτελέσιμο llama-server"

msgid "Install llama.cpp (LlamaFit phase 2 will do this: `llamafit install llama.cpp`); until then download a release from https://github.com/ggml-org/llama.cpp/releases and put its bin directory on PATH or in LLAMA_CPP_PATH."
msgstr "Εγκαταστήστε το llama.cpp (η φάση 2 του LlamaFit θα το κάνει αυτό: `llamafit install llama.cpp`)· μέχρι τότε κατεβάστε μια έκδοση από το https://github.com/ggml-org/llama.cpp/releases και βάλτε τον φάκελο bin της στο PATH ή στο LLAMA_CPP_PATH."

msgid "Memory size unknown"
msgstr "Άγνωστο μέγεθος μνήμης"

msgid "LlamaFit could not read this machine's memory totals, so it cannot work out what will fit."
msgstr "Το LlamaFit δεν μπόρεσε να διαβάσει τα σύνολα μνήμης αυτού του μηχανήματος, οπότε δεν μπορεί να υπολογίσει τι χωράει."

msgid "%(gpu)s: no %(backend)s backend in llama.cpp"
msgstr "%(gpu)s: δεν υπάρχει υποσύστημα %(backend)s στο llama.cpp"

msgid "llama.cpp was built with: %(backends)s"
msgstr "το llama.cpp δομήθηκε με: %(backends)s"

msgctxt "backends"
msgid "unknown"
msgstr "άγνωστα"

msgid "Install a llama.cpp build with the %(backend)s or Vulkan backend to use %(gpu)s."
msgstr "Εγκαταστήστε μια δόμηση του llama.cpp με το υποσύστημα %(backend)s ή Vulkan για να χρησιμοποιήσετε τη %(gpu)s."

msgid "%(gpu)s: VRAM size unknown"
msgstr "%(gpu)s: άγνωστο μέγεθος VRAM"

msgid "the vendor tool that reports memory was not available"
msgstr "το εργαλείο του κατασκευαστή που αναφέρει τη μνήμη δεν ήταν διαθέσιμο"

msgid "No GPU detected"
msgstr "Δεν εντοπίστηκε GPU"

msgid "models will run on the CPU only"
msgstr "τα μοντέλα θα εκτελούνται μόνο στη CPU"

msgid "If a GPU is present, check that its driver tools are installed."
msgstr "Αν υπάρχει GPU, ελέγξτε ότι τα εργαλεία του προγράμματος οδήγησής της είναι εγκατεστημένα."

msgid "RAM bandwidth assumed"
msgstr "Το εύρος ζώνης της RAM θεωρήθηκε δεδομένο"

msgid "using %(gbps)s GB/s as a default"
msgstr "χρησιμοποιείται %(gbps)s GB/s ως προεπιλογή"

msgid "Install numpy (`pip install llamafit[fast]`) so LlamaFit can measure the RAM bandwidth."
msgstr "Εγκαταστήστε το numpy (`pip install llamafit[fast]`) ώστε το LlamaFit να μπορεί να μετρήσει το εύρος ζώνης της RAM."

msgid "Probe %(probe)s failed"
msgstr "Η ανίχνευση %(probe)s απέτυχε"

msgid "unknown error"
msgstr "άγνωστο σφάλμα"

msgid "llama-server running at %(url)s"
msgstr "ο llama-server εκτελείται στο %(url)s"

msgid "model %(model)s, context %(context)s"
msgstr "μοντέλο %(model)s, πλαίσιο %(context)s"

