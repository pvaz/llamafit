msgid "%(term)s is not a filter; the terms are %(terms)s, and anything else is text to look for."
msgstr "Το %(term)s δεν είναι φίλτρο· οι όροι είναι %(terms)s, και οτιδήποτε άλλο είναι κείμενο προς αναζήτηση."

msgid "fit>= takes one of %(values)s"
msgstr "το fit>= δέχεται ένα από %(values)s"

msgid "runs= takes one of %(values)s"
msgstr "το runs= δέχεται ένα από %(values)s"

msgid "%(term)s needs a number"
msgstr "το %(term)s χρειάζεται αριθμό"

msgid "%(term)s needs a size such as 8G, 7.5GiB or 512M"
msgstr "το %(term)s χρειάζεται μέγεθος όπως 8G, 7.5GiB ή 512M"

msgctxt "board filter"
msgid "every candidate"
msgstr "κάθε υποψήφιο"

msgctxt "board filter"
msgid "the ones with room to spare"
msgstr "όσους αφήνουν χώρο"

msgctxt "board filter"
msgid "the ones that fit"
msgstr "όσους χωρούν"

