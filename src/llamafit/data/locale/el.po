msgstr "%(profile)s: %(flags)s"

msgid "%(baseline)s from the curator, less %(penalty)s for this quantisation, plus %(bonus)s because %(use_case)s is the job it was built for."
msgstr "%(baseline)s από τον επιμελητή, μείον %(penalty)s για αυτόν τον κβαντισμό, συν %(bonus)s επειδή το %(use_case)s είναι η δουλειά για την οποία φτιάχτηκε."

msgid "%(baseline)s from the curator, less %(penalty)s for this quantisation; it lists %(use_case)s but was not built for it."
msgstr "%(baseline)s από τον επιμελητή, μείον %(penalty)s για αυτόν τον κβαντισμό· αναφέρει το %(use_case)s αλλά δεν φτιάχτηκε γι' αυτό."

msgid "%(gen)s tokens per second against the %(target)s this use case asks for, less %(penalty)s because it reads a prompt at %(prompt)s."
msgstr "%(gen)s tokens ανά δευτερόλεπτο έναντι των %(target)s που ζητά αυτή η περίπτωση χρήσης, μείον %(penalty)s επειδή διαβάζει ένα prompt με %(prompt)s."

msgid "%(gen)s tokens per second against the %(target)s this use case asks for."
msgstr "%(gen)s tokens ανά δευτερόλεπτο έναντι των %(target)s που ζητά αυτή η περίπτωση χρήσης."

msgid "Its weights hold %(weights)s of this machine's %(memory)s and the tightest pool is %(share)s full. The score wants at least %(low)s of the memory taken and no more than %(high)s of any one pool."
msgstr "Τα βάρη του κρατούν %(weights)s από τα %(memory)s αυτού του μηχανήματος και η πιο στενή δεξαμενή είναι %(share)s γεμάτη. Η βαθμολογία θέλει τουλάχιστον %(low)s της μνήμης πιασμένη και όχι πάνω από %(high)s καμίας δεξαμενής."

msgid "Holds %(fit)s tokens of the %(requested)s this request is scored against."
msgstr "Κρατά %(fit)s tokens από τα %(requested)s ως προς τα οποία βαθμολογείται αυτό το αίτημα."

msgid "Score %(total)s"
msgstr "Βαθμολογία %(total)s"

