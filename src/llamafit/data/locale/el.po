msgid "Hugging Face returned %(status)d while listing files for %(repo)s."
msgstr "Το Hugging Face επέστρεψε %(status)d κατά την παράθεση των αρχείων του %(repo)s."

msgid "Could not read the file listing for %(repo)s from Hugging Face."
msgstr "Δεν ήταν δυνατή η ανάγνωση της λίστας αρχείων του %(repo)s από το Hugging Face."

msgid "Check your network connection and try again."
msgstr "Ελέγξτε τη σύνδεσή σας στο δίκτυο και δοκιμάστε ξανά."

msgid "Hugging Face's response for %(repo)s did not include a file listing."
msgstr "Η απάντηση του Hugging Face για το %(repo)s δεν περιλάμβανε λίστα αρχείων."

msgid "Check that the repository id is correct and public."
msgstr "Ελέγξτε ότι το αναγνωριστικό του αποθετηρίου είναι σωστό και δημόσιο."

msgid "the catalog has %(count)d problem"
msgid_plural "the catalog has %(count)d problems"
msgstr[0] "ο κατάλογος έχει %(count)d πρόβλημα"
msgstr[1] "ο κατάλογος έχει %(count)d προβλήματα"

msgid "Run `llamafit catalog validate` for details."
msgstr "Εκτελέστε `llamafit catalog validate` για λεπτομέρειες."

msgid "could not write %(path)s: %(error)s"
msgstr "δεν ήταν δυνατή η εγγραφή του %(path)s: %(error)s"

msgid "Check that the directory is writable and has room."
msgstr "Ελέγξτε ότι ο φάκελος είναι εγγράψιμος και έχει χώρο."

msgid "%(path)s has %(count)d problem and cannot be refreshed"
msgid_plural "%(path)s has %(count)d problems and cannot be refreshed"
msgstr[0] "το %(path)s έχει %(count)d πρόβλημα και δεν μπορεί να ανανεωθεί"
msgstr[1] "το %(path)s έχει %(count)d προβλήματα και δεν μπορεί να ανανεωθεί"

msgid "Run `llamafit catalog validate` and fix the file first."
msgstr "Εκτελέστε `llamafit catalog validate` και διορθώστε πρώτα το αρχείο."

msgid "%(path)s could not be read in full, so refreshing only %(model)s would drop facts it records for models this run leaves alone: %(details)s"
msgstr "Το %(path)s δεν ήταν δυνατό να διαβαστεί ολόκληρο, οπότε η ανανέωση μόνο του %(model)s θα πετούσε στοιχεία που καταγράφει για μοντέλα τα οποία αυτή η εκτέλεση δεν αγγίζει: %(details)s"

msgid "Run `llamafit catalog refresh` without --model to rebuild the whole file."
msgstr "Εκτελέστε `llamafit catalog refresh` χωρίς --model για να ξαναχτιστεί ολόκληρο το αρχείο."

msgid "Find, size, install and verify open-weight LLMs for llama.cpp on your own machine."
msgstr "Βρείτε, μετρήστε, εγκαταστήστε και επαληθεύστε γλωσσικά μοντέλα ανοικτών βαρών για το llama.cpp στο δικό σας μηχάνημα."

msgid "Print machine-readable JSON instead of tables."
msgstr "Εκτυπώνει JSON αναγνώσιμο από μηχανή αντί για πίνακες."

msgid "Write details to llamafit.log in the log directory and show tracebacks."
msgstr "Γράφει λεπτομέρειες στο llamafit.log μέσα στον φάκελο καταγραφής και εμφανίζει τα ίχνη κλήσεων."

msgid "Disable colours."
msgstr "Απενεργοποιεί τα χρώματα."

msgid "Speak this language, for example pt_PT. A language LlamaFit does not have falls back to English, and it says which ones it does have."
msgstr "Μιλά αυτή τη γλώσσα, για παράδειγμα pt_PT. Μια γλώσσα που δεν έχει το LlamaFit επιστρέφει στα αγγλικά, και αναφέρει ποιες γλώσσες έχει."

msgid "Print the version and exit."
msgstr "Εκτυπώνει την έκδοση και τερματίζει."

msgid "Unexpected error: %(error)s"
msgstr "Απροσδόκητο σφάλμα: %(error)s"

msgid "Run again with --verbose for the full traceback."
msgstr "Εκτελέστε ξανά με --verbose για το πλήρες ίχνος κλήσεων."

msgid "Maintain the catalog: validate its files, refresh volatile fields."
msgstr "Συντηρεί τον κατάλογο: επικυρώνει τα αρχεία του, ανανεώνει τα μεταβλητά πεδία."

msgid "Keep only this use case."
msgstr "Κρατά μόνο αυτή την περίπτωση χρήσης."

msgid "Keep only models with this capability (repeatable)."
msgstr "Κρατά μόνο τα μοντέλα με αυτή τη δυνατότητα (επαναλαμβανόμενο)."

msgid "Keep only these licence identifiers (repeatable)."
msgstr "Κρατά μόνο αυτά τα αναγνωριστικά αδειών (επαναλαμβανόμενο)."

msgid "Validate only this file instead of the bundled catalog and custom overrides."
msgstr "Επικυρώνει μόνο αυτό το αρχείο αντί για τον ενσωματωμένο κατάλογο και τις προσαρμογές."

msgid "Did you mean: %(ids)s?"
msgstr "Μήπως εννοούσατε: %(ids)s;"

msgid "Run `llamafit list` to see every model id."
msgstr "Εκτελέστε `llamafit list` για να δείτε όλα τα αναγνωριστικά μοντέλων."

msgid "no model named %(id)s in the catalog"
msgstr "δεν υπάρχει μοντέλο με όνομα %(id)s στον κατάλογο"

msgid "%(count)d catalog problem found; run `llamafit catalog validate` for details."
msgid_plural "%(count)d catalog problems found; run `llamafit catalog validate` for details."
msgstr[0] "Βρέθηκε %(count)d πρόβλημα στον κατάλογο· εκτελέστε `llamafit catalog validate` για λεπτομέρειες."
msgstr[1] "Βρέθηκαν %(count)d προβλήματα στον κατάλογο· εκτελέστε `llamafit catalog validate` για λεπτομέρειες."

msgid "No models matched. Try a broader --use-case, --capability, --license, --vendor or --search."
msgstr "Κανένα μοντέλο δεν ταιριάζει. Δοκιμάστε ευρύτερο --use-case, --capability, --license, --vendor ή --search."

msgid "invalid --use-case %(value)s"
msgstr "μη έγκυρη τιμή --use-case: %(value)s"

msgid "Valid use cases: %(values)s"
msgstr "Έγκυρες περιπτώσεις χρήσης: %(values)s"

msgid "invalid --capability value: %(values)s"
msgid_plural "invalid --capability values: %(values)s"
msgstr[0] "μη έγκυρη τιμή --capability: %(values)s"
msgstr[1] "μη έγκυρες τιμές --capability: %(values)s"

msgid "Valid capabilities: %(values)s"
msgstr "Έγκυρες δυνατότητες: %(values)s"

msgid ""
"List the model catalog, narrowed by any filters given.\n"
"\n"
"The table shows at most three capabilities per model, plus a +N marker for the rest, and is sorted by the Quality column shown; info or --json has every capability."
msgstr ""
"Παραθέτει τον κατάλογο μοντέλων, περιορισμένο από τα φίλτρα που δόθηκαν.\n"
"\n"
"Ο πίνακας δείχνει το πολύ τρεις δυνατότητες ανά μοντέλο, συν έναν δείκτη +N για τις υπόλοιπες, και ταξινομείται κατά τη στήλη Ποιότητα που εμφανίζεται· το info ή το --json έχουν όλες τις δυνατότητες."

msgid "Keep only this vendor, case-insensitive."
msgstr "Κρατά μόνο αυτόν τον κατασκευαστή, χωρίς διάκριση πεζών-κεφαλαίων."

msgid "Case-insensitive substring match on id, name, vendor or family."
msgstr "Ταίριασμα υποσυμβολοσειράς σε αναγνωριστικό, όνομα, κατασκευαστή ή οικογένεια, χωρίς διάκριση πεζών-κεφαλαίων."

msgid "Show at most this many."
msgstr "Δείχνει το πολύ τόσα."

msgid "Shorthand for llamafit list --search TEXT."
msgstr "Συντομογραφία για llamafit list --search TEXT."

msgid "Text to match against id, name, vendor or family."
msgstr "Κείμενο προς αντιστοίχιση με αναγνωριστικό, όνομα, κατασκευαστή ή οικογένεια."

msgid "Show one model's facts, sources and every quant it publishes."
msgstr "Δείχνει τα στοιχεία ενός μοντέλου, τις πηγές του και κάθε κβαντισμό που δημοσιεύει."

msgid "A catalog model id."
msgstr "Ένα αναγνωριστικό μοντέλου του καταλόγου."

msgid "Validate catalog YAML files against the schema, printing one line per problem."
msgstr "Επικυρώνει τα αρχεία YAML του καταλόγου ως προς το σχήμα, εκτυπώνοντας μία γραμμή ανά πρόβλημα."

msgid "%(count)d file checked, no problems found."
msgid_plural "%(count)d files checked, no problems found."
msgstr[0] "Ελέγχθηκε %(count)d αρχείο, δεν βρέθηκαν προβλήματα."
msgstr[1] "Ελέγχθηκαν %(count)d αρχεία, δεν βρέθηκαν προβλήματα."

msgid "Refresh file names, sizes, checksums and GGUF facts for the catalog from Hugging Face."
msgstr "Ανανεώνει ονόματα αρχείων, μεγέθη, αθροίσματα ελέγχου και στοιχεία GGUF του καταλόγου από το Hugging Face."

msgid "Refresh only this model id."
msgstr "Ανανεώνει μόνο αυτό το αναγνωριστικό μοντέλου."

msgid "Compute the refresh but write nothing."
msgstr "Υπολογίζει την ανανέωση χωρίς να γράψει τίποτα."

msgid "Exit 1 if anything would change; changes nothing, for a scheduled CI job."
msgstr "Τερματίζει με 1 αν κάτι επρόκειτο να αλλάξει· δεν αλλάζει τίποτα, για προγραμματισμένη εργασία CI."

msgid "%(model)s: warning: %(warning)s"
msgstr "%(model)s: προειδοποίηση: %(warning)s"

msgid "warning: %(warning)s (%(count)d model: %(models)s)"
msgid_plural "warning: %(warning)s (%(count)d models: %(models)s)"
msgstr[0] "προειδοποίηση: %(warning)s (%(count)d μοντέλο: %(models)s)"
msgstr[1] "προειδοποίηση: %(warning)s (%(count)d μοντέλα: %(models)s)"

msgid "%(model)s: error: %(error)s"
msgstr "%(model)s: σφάλμα: %(error)s"

msgid "Hint: %(hint)s"
msgstr "Υπόδειξη: %(hint)s"

msgid "refresh needs network access to Hugging Face; check your connection and that the repository id is correct."
msgstr "η ανανέωση χρειάζεται πρόσβαση δικτύου στο Hugging Face· ελέγξτε τη σύνδεσή σας και ότι το αναγνωριστικό του αποθετηρίου είναι σωστό."

msgid "No changes."
msgstr "Καμία αλλαγή."

msgid "Print one model's raw catalog entry, as JSON by default or as YAML with --yaml."
msgstr "Εκτυπώνει την ακατέργαστη εγγραφή καταλόγου ενός μοντέλου, ως JSON από προεπιλογή ή ως YAML με --yaml."

msgid "Print YAML instead of JSON."
msgstr "Εκτυπώνει YAML αντί για JSON."

msgid "Explain what was detected, what failed, and what would unlock more."
msgstr "Εξηγεί τι εντοπίστηκε, τι απέτυχε και τι θα ξεκλείδωνε περισσότερα."

