msgid "B"
msgstr "B"

msgctxt "size"
msgid "unknown"
msgstr "άγνωστο"

msgid "profile must be a name, not a path: %(value)s"
msgstr "το profile πρέπει να είναι όνομα, όχι διαδρομή: %(value)s"

msgid "Ask GET /api/v1/profiles for the names this machine has."
msgstr "Ζητήστε GET /api/v1/profiles για τα ονόματα που έχει αυτό το μηχάνημα."

msgid "unknown query parameter: %(names)s"
msgstr "άγνωστη παράμετρος ερωτήματος: %(names)s"

msgid "This endpoint takes: %(names)s"
msgstr "Αυτό το σημείο πρόσβασης δέχεται: %(names)s"

msgid "invalid prefer %(value)s"
msgstr "μη έγκυρη τιμή prefer: %(value)s"

msgid "invalid sort %(value)s"
msgstr "μη έγκυρη τιμή sort: %(value)s"

msgid "%(host)s:%(port)d is not this machine only. Anyone who can reach this computer on that port can read everything the dashboard shows -- your hardware, your disks, your file paths and the models you have downloaded. There is no password, because LlamaFit is meant for the person sitting at the keyboard. Press Ctrl+C now if you did not mean this."
msgstr "Το %(host)s:%(port)d δεν είναι μόνο αυτό το μηχάνημα. Όποιος μπορεί να φτάσει αυτόν τον υπολογιστή σε αυτή τη θύρα μπορεί να διαβάσει όλα όσα δείχνει ο πίνακας ελέγχου -- το υλικό σας, τους δίσκους σας, τις διαδρομές των αρχείων σας και τα μοντέλα που έχετε κατεβάσει. Δεν υπάρχει κωδικός, επειδή το LlamaFit προορίζεται για το άτομο που κάθεται στο πληκτρολόγιο. Πατήστε Ctrl+C τώρα αν δεν το εννοούσατε."

msgid "the web dashboard needs FastAPI and uvicorn, which are not installed"
msgstr "ο πίνακας ελέγχου ιστού χρειάζεται τα FastAPI και uvicorn, που δεν είναι εγκατεστημένα"

msgid "Install them with: pip install \"llamafit[web]\""
msgstr "Εγκαταστήστε τα με: pip install \"llamafit[web]\""

msgid "%(host)s is not a loopback address, and the dashboard has no authentication"
msgstr "το %(host)s δεν είναι διεύθυνση loopback, και ο πίνακας ελέγχου δεν έχει έλεγχο ταυτότητας"

msgid "Leave --host alone to serve this machine only, or pass it to mean it."
msgstr "Αφήστε το --host ως έχει για να εξυπηρετεί μόνο αυτό το μηχάνημα, ή δώστε το εννοώντας το."

